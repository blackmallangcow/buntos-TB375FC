#
# TB375FC 첫 부팅(2a·2b)용 initramfs의 /init. busybox sh로 돈다. LK가 init_boot의 램디스크를 initrd로 넘기면
# 커널이 이것을 PID 1로 띄운다.
# - proc·sys·devtmpfs·devpts·tmpfs(/run)·configfs·pstore·debugfs를 붙이고 initramfs의 모듈을 올린다
# - 직전 부팅의 pstore 기록을 /run/buntos/pstore에 떠 두고(지우지 않는다) 콘솔 기록의 끝을 보인다
# - 커널, 명령줄, 장치 트리, CPU의 EL(설계안 12.1절), 화면을 알리고 LK가 넘긴 트리를 /run/buntos/fdt.dtb에 뜬다
# - 명령줄에 root=가 있으면 그 파티션을 /sysroot에 붙여 switch_root로 넘어간다(try_root). /proc·/sys·/dev·/run을 함께
#   옮기므로 /run/buntos의 기록이 진짜 루트에 남는다. 안드로이드 파티션은 건드리지 않는다
# - 못 넘어가면(장치 없음, 붙지 않음, init이 돌지 못함) 까닭을 남기고 root=가 없을 때와 똑같이 이어 간다.
#   기기에서는 이 길이 유일한 구조 수단이라, 되돌릴 수 없는 switch_root 앞에서 모든 실패를 먼저 걸러 낸다
# - /etc/inittab을 만들어 busybox init에 넘긴다. busybox init이 console=의 화면(tty0)과 UART(ttyS0)에 셸을 띄우고
#   "/init --late"를 한 번 돌린다
# - --late: USB 가젯(usb-gadget: ACM + NCM, 기기 172.16.42.1/24)을 띄우고 ttyGS0에 셸을 더한다.
#   nvdata·nvcfg·persist를 GPT 파티션 이름으로 찾아 /mnt/vendor/<이름>에 읽기 전용으로 붙인다(Wi-Fi 보정값이 nvdata에 있다)
# 진행은 /dev/kmsg로 알린다. 커널이 모든 콘솔(simpledrm 화면, UART)과 dmesg, pstore에 함께 남기고, 같은 글을
# /run/buntos/boot.log에도 적는다. 화면 콘솔(fbcon)에 한글 글꼴이 없어 기기에 찍는 글은 영어로 쓴다.
# PID 1이 끝나면 커널이 panic하므로 set -e를 쓰지 않는다. 한 단계가 실패해도 다음으로 넘어간다.
#
# 커널 명령줄 옵션:
#   root=PARTLABEL=<이름>|PARTUUID=<값>|UUID=<값>|/dev/<장치>  넘어갈 루트. 없으면 넘어가지 않는다
#   rootfstype=<형식>      없으면 mount가 찾는다
#   rootflags=<옵션>       mount -o에 더한다
#   rw, ro                 rw가 하나라도 있으면 rw, 없으면 ro (커널 기본값과 같다)
#   init=<경로>            새 루트의 init (기본 /sbin/init)
#   buntos.wait=<초>       루트 장치와, --late가 UDC와 nvdata를 기다리는 시간 (기본 30)
#   buntos.usbnet=ncm|ecm  가젯의 네트워크 함수 (기본 ncm)
#   buntos.telnet=1        가젯 네트워크(172.16.42.1:23)에 암호 없는 telnetd를 띄운다
#   buntos.debug=1         set -x

export PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root TERM=linux ENV=/etc/profile
log=/run/buntos/boot.log

say() {
	echo "$*" >>"$log"
	echo "<5>bunt-init: $*" >/dev/kmsg 2>/dev/null || echo "bunt-init: $*"
}

# 넘어가지 못한 까닭. quiet여도 화면에 보이도록 커널 기록의 수준을 높인다
fail() {
	echo "$*" >>"$log"
	echo "<3>bunt-init: $*" >/dev/kmsg 2>/dev/null || echo "bunt-init: $*"
}

# 커널 명령줄을 낱말 하나씩 낸다. 순정 트리의 /chosen bootargs처럼 탭이 섞여 있어도 나눈다
words() {
	tr -s ' \t' '\n' </proc/cmdline
}

# 커널 명령줄의 값을 나온 차례대로 모두 낸다
args() {
	words | sed -n "s/^$1=//p"
}

# 커널 명령줄의 값. 여러 번 나오면 마지막 것, 없으면 $2
arg() {
	local v
	v=$(args "$1" | tail -n 1)
	echo "${v:-$2}"
}

# 셸을 띄울 콘솔: console=의 장치 가운데 열리는 것 (UART 포트가 없으면 ttyS0 노드는 있어도 열리지 않는다)
consoles() {
	local list t seen=
	list=$(args console | sed 's/,.*//')
	for t in ${list:-tty0 ttyS0}; do
		case " $seen " in *" $t "*) continue ;; esac
		[ -c "/dev/$t" ] && stty -F "/dev/$t" >/dev/null 2>&1 && seen="$seen $t"
	done
	echo $seen
}

# 직전 부팅의 기록을 떠 둔다. /sys/fs/pstore의 파일을 지우면 백엔드의 기록도 지워지므로 건드리지 않는다
keep_pstore() {
	local f n=0
	mkdir -p /run/buntos/pstore
	for f in /sys/fs/pstore/*; do
		[ -f "$f" ] || continue
		cp "$f" /run/buntos/pstore/ && n=$((n + 1))
		say "pstore: ${f##*/} ($(wc -c <"$f") bytes)"
	done
	if [ "$n" = 0 ]; then
		say "pstore: no records from the previous boot (backend: $(cat /sys/module/pstore/parameters/backend 2>/dev/null || echo none))"
		return
	fi
	say "pstore: copied $n records to /run/buntos/pstore"
	for f in /run/buntos/pstore/console-ramoops*; do
		[ -f "$f" ] || continue
		say "previous boot console, last lines (${f##*/}):"
		tail -n 12 "$f" | while IFS= read -r l; do say "| $l"; done
	done
}

# uevent의 값으로 블록 장치를 찾는다. udev가 없어 /dev/disk/by-*가 없다
part_by() {
	local u
	for u in /sys/class/block/*/uevent; do
		grep -qxF "$1=$2" "$u" 2>/dev/null || continue
		echo "/dev/$(sed -n 's/^DEVNAME=//p' "$u")"
		return 0
	done
	return 1
}

# GPT 파티션 이름으로 블록 장치를 찾는다
part() {
	part_by PARTNAME "$1"
}

# 보정값이 든 파티션을 읽기 전용으로 붙인다. 블록 장치부터 읽기 전용으로 두고(쓰기가 커널에서 막힌다),
# ext4는 noload로 저널을 되살리지 않는다. 읽기 전용으로 두지 못했으면 ext4 ro,noload만 쓴다
mount_ro() {
	local dev dir="/mnt/vendor/$1" ok=
	if ! dev=$(part "$1"); then
		say "$1: no partition"
		return 1
	fi
	mkdir -p "$dir"
	if blockdev --setro "$dev"; then
		mount -t ext4 -o ro,noload "$dev" "$dir" 2>/dev/null || mount -o ro "$dev" "$dir" && ok=1
	else
		mount -t ext4 -o ro,noload "$dev" "$dir" && ok=1
	fi
	if [ -n "$ok" ]; then
		say "$1: $dev mounted read-only on $dir"
	else
		say "$1: could not mount $dev"
	fi
}

late() {
	local wait_s
	wait_s=$(arg buntos.wait 30)
	(
		if /usr/libexec/buntos/usb-gadget "TB375FC initramfs"; then
			echo "ttyGS0::respawn:/bin/sh" >>/etc/inittab && kill -HUP 1
			if [ "$(arg buntos.telnet)" = 1 ] && telnetd -b 172.16.42.1 -l /bin/sh; then
				say "telnetd: 172.16.42.1:23, no password"
			fi
		fi
	) &
	(
		i=0
		while [ "$i" -lt "$wait_s" ] && ! part nvdata >/dev/null; do
			sleep 1
			i=$((i + 1))
		done
		for p in nvdata nvcfg persist; do
			mount_ro "$p"
		done
		# MediaTek이 Wi-Fi NVRAM(보정값·MAC)을 두는 자리 (안드로이드 관례, 기기에서 확인한다)
		f=/mnt/vendor/nvdata/APCFG/APRDEB/WIFI
		[ -f "$f" ] && say "wifi calibration: $f ($(wc -c <"$f") bytes)"
	) &
	wait
}

# 명령줄에서 넘어갈 루트를 고른다(root_spec). LK가 자기 root=를 덧붙일 수 있으므로(순정 트리의 /chosen은 root=/dev/ram이다)
# 마지막 값을 그대로 믿지 않는다. 우리만 쓰는 꼴(PARTLABEL=, PARTUUID=, UUID=)의 마지막 값을 먼저 고르고, 없으면 /dev/
# 경로의 마지막 값을 고른다. 램디스크, 안드로이드의 dm, 커널의 별칭은 버린다
pick_root() {
	local v tagged='' path=''
	for v in $(args root); do
		case $v in
		PARTLABEL=?* | PARTUUID=?* | UUID=?*) tagged=$v ;;
		/dev/ram* | /dev/dm-* | /dev/root | /dev/nfs) say "root: ignoring root=$v" ;;
		/dev/?*) path=$v ;;
		*) say "root: ignoring root=$v (unknown form)" ;;
		esac
	done
	root_spec=${tagged:-$path}
}

# root= 값의 블록 장치를 낸다. 아직 없으면 실패한다. sysfs 항목이 devtmpfs 노드보다 먼저 보일 수 있어 노드까지 본다
root_device() {
	local dev
	case $1 in
	PARTLABEL=*) dev=$(part "${1#*=}") ;;
	PARTUUID=*) dev=$(part_by PARTUUID "$(echo "${1#*=}" | tr 'A-F' 'a-f')") ;;
	UUID=*) dev=$(findfs "$1" 2>/dev/null) ;;
	*) dev=$1 ;;
	esac
	[ -b "$dev" ] && echo "$dev"
}

# 찾지 못했을 때 볼 목록: 장치 이름, GPT 이름, GPT UUID
block_list() {
	local u
	for u in /sys/class/block/*/uevent; do
		[ -f "$u" ] || continue
		sed -n 's/^DEVNAME=//p; s/^PARTNAME=/name=/p; s/^PARTUUID=/uuid=/p' "$u" | tr '\n' ' '
		echo
	done >/run/buntos/block.txt
}

# 새 루트에서 init이 돌 수 있는지 미리 본다. switch_root는 initramfs를 지운 뒤에 exec하므로 그 뒤의 실패는 PID 1의 죽음(패닉)이고
# 되돌릴 수 없다. 경로를 /sysroot 앞에 붙여 보면 절대 경로 심볼릭 링크를 여기 루트에서 풀게 되므로 새 루트 안에서 본다.
# - run-init -n: switch_root와 같은 코드의 시험 운전. 새 루트가 다른 파일 시스템인지, rootfs가 ramfs·tmpfs인지, init에 실행
#   권한이 있는지 본다
# - 머리 20바이트: arm64 ELF나 #!여야 한다. 그 밖에는 exec가 ENOEXEC로 실패한다. 다음 단계의 chroot(execvp)는 ENOEXEC이면 새 루트의
#   /bin/sh로 다시 돌려 통과하므로 따로 본다. 새 루트 안에서 경로를 풀려고 initramfs의 busybox를 /proc/1/root로 부른다
# - LD_TRACE_LOADED_OBJECTS: 실제로 exec하되 ELF 로더가 라이브러리만 찾고 init을 돌리지 않고 끝난다(ldd와 같다). 스크립트면
#   인터프리터가 이렇게 끝난다. 로더·인터프리터·라이브러리가 없으면 여기서 걸린다. 정적 링크한 init은 실제로 돌므로(busybox init은
#   PID 1이 아니면 곧 끝난다) 시간을 제한한다
check_init() {
	local out rc head
	if ! command -v switch_root >/dev/null; then
		fail "root: no switch_root in this initramfs"
		return 1
	fi
	if ! out=$(run-init -n /sysroot "$1" 2>&1); then
		fail "root: init $1: $(echo "$out" | tail -n 1)"
		return 1
	fi
	mkdir -p /sysroot/proc 2>/dev/null
	if ! out=$(mount -t proc proc /sysroot/proc 2>&1); then
		fail "root: no /proc in the new root: $out"
		return 1
	fi
	head=$(chroot /sysroot /proc/1/root/bin/busybox od -An -tx1 -N 20 "$1" 2>/dev/null | tr -d ' \n')
	umount /sysroot/proc
	case $head in
	7f454c460201????????????????????????b700 | 2321*) ;;
	*)
		fail "root: init $1 is not an arm64 program or a script (starts with '${head:-nothing}')"
		return 1
		;;
	esac
	out=$(LD_TRACE_LOADED_OBJECTS=1 timeout -s KILL 10 chroot /sysroot "$1" 2>&1 </dev/null)
	rc=$?
	case $rc in
	126 | 127)
		fail "root: init $1 cannot run: $(echo "$out" | tail -n 1)"
		return 1
		;;
	137) say "root: init $1: the check timed out, going on" ;;
	1[3-9][0-9] | 2[0-9][0-9])
		fail "root: init $1 died in the check (status $rc): $(echo "$out" | tail -n 1)"
		return 1
		;;
	esac
	case $out in
	*"not found"*)
		fail "root: init $1 cannot run: $(echo "$out" | grep -m 1 'not found')"
		return 1
		;;
	esac
}

# UFS에는 안드로이드 파티션이 함께 있다. 어떤 루트로 넘어가든 systemd가 파티션 표를 고치거나 GPT 형식으로 파티션을 붙이지
# 못하게 막는다. 보드 프로필(mkosi.postinst.chroot)도 같은 것을 막지만, 이 줄은 다른 보드의 이미지를 잘못 구웠을 때도 듣는다.
# 유닛은 /run/systemd/system의 /dev/null 링크로(systemctl mask --runtime과 같다), 생성기는 systemd.generator(7)의 방법으로 가린다
guard_disks() {
	local u
	mkdir -p /run/systemd/system /run/systemd/system-generators /run/repart.d
	for u in systemd-repart.service systemd-repart.socket systemd-repart@.service; do
		ln -sf /dev/null "/run/systemd/system/$u"
	done
	ln -sf /dev/null /run/systemd/system-generators/systemd-gpt-auto-generator
	ln -sf /dev/null /run/repart.d/10-root.conf
}

# /proc·/sys·/dev·/run을 새 루트로 옮긴다. 그 아래 마운트(/dev/pts, /sys/kernel/config·debug, /sys/fs/pstore)도 따라간다.
# systemd는 이미 붙어 있는 것을 그대로 쓴다(mount_setup). 그래서 main이 systemd와 같은 옵션으로 붙인다.
# 하나라도 실패하면 모두 되돌린다. /dev와 /run이 돌아온 뒤에야 say를 쓸 수 있다
move_mounts() {
	local m u moved='' err
	for m in /sys /dev /run /proc; do
		mkdir -p "/sysroot$m" 2>/dev/null
		if ! err=$(mount --move "$m" "/sysroot$m" 2>&1); then
			for u in $moved; do
				mount --move "/sysroot$u" "$u"
			done
			fail "root: could not move $m to the new root: $err"
			return 1
		fi
		moved="$m $moved"
	done
}

# 넘어가지 못하고 돌아올 때 붙인 루트를 뗀다
leave_root() {
	umount /sysroot || say "root: could not unmount /sysroot"
}

# root=의 파티션으로 넘어간다. 넘어가면 돌아오지 않는다. 돌아오면 까닭을 남긴 뒤이고, 아무것도 고치지 않았다.
# 이때 도는 프로세스는 이 셸뿐이다(가젯, udhcpd, nvdata는 --late의 일이라 실패 길에서만 돈다)
try_root() {
	local dev='' fstype flags mode=ro init v i=0 wait_s err
	pick_root
	if [ -z "$root_spec" ]; then
		fail "root: no usable root= on the command line"
		return 1
	fi
	wait_s=$(arg buntos.wait 30)
	say "root: looking for $root_spec (up to ${wait_s}s)"
	until dev=$(root_device "$root_spec"); do
		if [ "$i" -ge "$wait_s" ]; then
			block_list
			fail "root: $root_spec not found within ${wait_s}s;" \
				"$(wc -l </run/buntos/block.txt) block devices in /run/buntos/block.txt"
			return 1
		fi
		sleep 1
		i=$((i + 1))
	done
	fstype=$(arg rootfstype)
	flags=$(arg rootflags)
	# LK가 ro를 덧붙여도 우리가 준 rw를 따른다
	if words | grep -qx rw; then mode=rw; fi
	mkdir -p /sysroot
	say "root: found $dev after ${i}s; mounting (${fstype:-auto}, $mode${flags:+,$flags})"
	# shellcheck disable=SC2086 # -t와 형식은 낱말 둘이다
	if ! err=$(mount ${fstype:+-t $fstype} -o "$mode${flags:+,$flags}" "$dev" /sysroot 2>&1); then
		fail "root: could not mount $dev: $err (kernel log: dmesg)"
		return 1
	fi
	# 안드로이드식 init=/init는 이 루트에 없다
	init=/sbin/init
	for v in $(args init); do
		case $v in
		/init) say "root: ignoring init=/init" ;;
		*) init=$v ;;
		esac
	done
	if ! check_init "$init"; then
		leave_root
		return 1
	fi
	[ -d "/sysroot/usr/lib/modules/$ver" ] || [ -d "/sysroot/lib/modules/$ver" ] ||
		fail "root: warning: the new root has no modules for $ver"
	guard_disks
	say "root: switching to $dev, init $init"
	if ! move_mounts; then
		leave_root
		return 1
	fi
	unset ENV
	export HOME=/
	exec switch_root /sysroot "$init"
}

main() {
	mkdir -p /proc /sys /dev /run /tmp /root
	# 옵션은 systemd의 mount_setup과 같다. 넘어간 뒤에 systemd가 이 마운트를 그대로 쓴다
	mount -t proc -o nosuid,noexec,nodev proc /proc
	mount -t sysfs -o nosuid,noexec,nodev sysfs /sys
	mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev
	mkdir -p /dev/pts
	mount -t devpts -o nosuid,noexec,mode=620,gid=5 devpts /dev/pts
	# 기록을 진짜 루트에 남기려고 /run을 rootfs가 아닌 tmpfs에 둔다. switch_root는 rootfs의 내용을 지운다
	mount -t tmpfs -o nosuid,nodev,mode=0755,size=20%,nr_inodes=800k tmpfs /run
	mkdir -p /run/buntos
	[ "$(arg buntos.debug)" = 1 ] && set -x

	say "buntOS TB375FC initramfs ($(cat /etc/buntos/initramfs 2>/dev/null))"
	say "kernel: $(cat /proc/version)"
	fold -s -w 200 /proc/cmdline | while IFS= read -r l; do say "cmdline: $l"; done
	say "device tree: model '$(tr -d '\0' </proc/device-tree/model 2>/dev/null)'," \
		"compatible '$(tr '\0' ' ' </proc/device-tree/compatible 2>/dev/null)'"
	# LK가 고친 뒤의 트리. 우리 트리의 무엇을 바꾸는지 견준다(설계안 2.2절)
	cp /sys/firmware/fdt /run/buntos/fdt.dtb 2>/dev/null && say "device tree from LK saved to /run/buntos/fdt.dtb"
	if [ -f /etc/buntos/vendor_boot ]; then
		say "vendor_boot: $(cat /etc/buntos/vendor_boot)"
	else
		say "vendor_boot: no buntOS marker (the stock vendor_boot may be in use)"
	fi
	l=$(dmesg | grep -m 1 -E 'CPU\(s\) started at EL[0-9]|started in inconsistent modes' | sed 's/^\[[^]]*\] //')
	say "${l:-CPU: no EL line in dmesg}"
	l=$(dmesg | grep -m 1 'kvm \[' | sed 's/^\[[^]]*\] //')
	say "${l:-kvm: no message}$([ -e /dev/kvm ] && echo ', /dev/kvm present')"

	ver=$(uname -r)
	if [ -d "/lib/modules/$ver" ]; then
		ok=
		bad=
		for m in $(grep -v '^#' /etc/buntos/modules); do
			if modprobe -q "$m"; then ok="$ok $m"; else bad="$bad $m"; fi
		done
		say "modules ($ver):${ok:- none}${bad:+ / failed:$bad}"
	elif [ -d /lib/modules ]; then
		say "modules: built for $(ls /lib/modules | tr '\n' ' ')but the kernel is $ver"
	fi

	mount -t configfs -o nosuid,noexec,nodev configfs /sys/kernel/config 2>/dev/null
	mount -t debugfs -o nosuid,noexec,nodev debugfs /sys/kernel/debug 2>/dev/null
	if mount -t pstore -o nosuid,noexec,nodev pstore /sys/fs/pstore 2>/dev/null; then
		keep_pstore
	else
		say "pstore: could not mount (CONFIG_PSTORE)"
	fi
	if [ -e /sys/class/graphics/fb0 ]; then
		say "display: $(cat /sys/class/graphics/fb0/name) $(cat /sys/class/graphics/fb0/virtual_size)"
	else
		say "display: no framebuffer (simple-framebuffer node, simpledrm)"
	fi

	# root=가 없으면 아무 말 없이 지금처럼 이어 간다
	if [ -n "$(args root)" ]; then
		try_root || fail "root: staying in the initramfs (shells on the consoles and USB)"
	fi

	cons=$(consoles)
	{
		for t in $cons; do
			echo "$t::respawn:/bin/sh"
		done
		echo "::once:/init --late"
		echo "::ctrlaltdel:/sbin/reboot"
		echo "::shutdown:/bin/sync"
	} >/etc/inittab
	say "shells on: ${cons:-none}; log: $log"
	exec /sbin/init
}

if [ "$1" = --late ]; then
	late
else
	main
fi
