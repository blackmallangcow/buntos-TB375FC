# GPU 드라이버(panthor)를 로그인 화면 전에 올리고 렌더 노드를 기다린다. 안 뜨면 컴포지터는 CPU로 그린다
[Unit]
Description=Load the GPU driver before the login screen
Before=greetd.service
After=systemd-udevd.service local-fs.target buntos-display.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=25
ExecStart=/sbin/modprobe panthor
ExecStartPost=/bin/sh -c 'for i in $(seq 1 100); do [ -e /dev/dri/renderD128 ] && exit 0; sleep 0.1; done; exit 0'
ExecStartPost=-/usr/bin/udevadm settle --timeout=5

[Install]
WantedBy=greetd.service
