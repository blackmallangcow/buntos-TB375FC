#
# 비디오 디코더의 드라이버를 올린다. 명령줄의 modprobe.blacklist가 자동 적재를 막고 이 스크립트가 차례를 정한다.
#
# 순정 비디오 펌웨어는 프레임마다 전압 요청 블록(DVFSRC)에 전압 단계를 묻고, 그 블록이 꺼져 있으면 끝없이
# 기다린다. 그래서 mtk-dvfsrc가 먼저다. 그다음 펌웨어가 도는 비디오 코프로세서(mt6897-vcp), 끝으로 디코더
# (mt6897-vdec)다. 디코더는 세션이 열릴 때만 코프로세서를 켠다.
#
# 디코더 노드가 꺼진 커널이면 아무것도 하지 않는다. 드라이버가 안 뜨면 Firefox는 소프트웨어로 푼다.
set -u

tree=/sys/firmware/devicetree/base/soc
[ "$(tr -d '\0' 2>/dev/null <"$tree/video-codec@16000000/status")" = okay ] || exit 0

modprobe mtk-dvfsrc || exit 1
# 전압 요청 블록이 붙은 뒤에야 디코더가 붙는다
for _ in $(seq 1 50); do
	[ -e /sys/bus/platform/drivers/mtk-dvfsrc/1c00f000.system-controller ] && break
	sleep 0.1
done
modprobe mt6897-vcp || exit 1
modprobe mt6897-vdec || exit 1

for _ in $(seq 1 50); do
	for name in /sys/class/video4linux/video*/name; do
		[ "$(cat "$name" 2>/dev/null)" = mt6897-vdec ] && exit 0
	done
	sleep 0.1
done
echo "video-up: no mt6897-vdec video device" >&2
exit 1
