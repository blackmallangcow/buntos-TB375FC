# 충전 드라이버를 올린다. 감시(charge-guard)가 먼저 돈다. TCPC는 충전기가 자리를 잡은 뒤에 올린다
C=/sys/class/power_supply/mt6375-charger
# 9 V 계약을 받기 전에 차지 펌프의 입력 한계가 써 있어야 한다. 칩의 리셋 값(VAC OVP 6.5 V)으로는 9 V에서 입력 FET가
# 열린다. 드라이버는 한계를 쓰고 읽어 맞춘 뒤에 upm6720-direct를 만든다
modprobe nu2115_charger
modprobe mt6375
modprobe mt6375_charger
sleep 3
if [ -e /sys/class/power_supply/upm6720-direct ]; then
	modprobe tcpci_mt6375
else
	echo "차지 펌프의 입력 한계를 쓰지 못해 TCPC를 올리지 않는다. PD 계약 없이 충전한다" >&2
fi
# 서비스를 멈췄다 다시 켜면 충전이 막힌 채다
[ -w $C/charge_behaviour ] && echo auto > $C/charge_behaviour
exit 0
