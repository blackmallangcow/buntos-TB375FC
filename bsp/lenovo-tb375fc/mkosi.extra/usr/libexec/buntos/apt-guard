#
# apt가 우리가 넣은 것을 망가뜨리지 못하게 한다. 무엇을 지키는지는 /etc/buntos/apt-guard.conf에 있다.
#
# 우리 바이너리와 모듈은 dpkg가 모르는 파일이라 apt에게는 의존성이 없다. 그래서 위험은 덮어쓰기보다
# "아무도 안 쓰는 줄 알고 라이브러리를 지우는 것"이다. 막는 것은 넷이고, 그래도 일이 나면 알린다.
#
#   install   꾸러미 buntos-runtime을 만들어 바이너리가 쓰는 라이브러리를 의존성으로 잡고, 고정(hold)과
#             경로 돌리기(dpkg-divert)를 건다. 이미지를 만들 때와 기기에서 한 번 돌린다
#   refresh   바이너리를 바꾼 뒤 buntos-runtime의 의존성을 다시 계산한다
#   pre       apt가 dpkg를 부르기 전: 해시를 재고 btrfs 스냅숏을 만든다 (DPkg::Pre-Invoke)
#   post      dpkg가 끝난 뒤: 해시를 비교하고 라이브러리를 확인해 알린다 (DPkg::Post-Invoke)
#   check     지금 상태를 확인한다. 문제가 있으면 1로 끝난다
#   sums      지켜 보는 파일의 해시를 출력한다
#   list      스냅숏 목록
#   restore   post가 알린 파일을 가장 새 스냅숏에서 되돌린다
#   rollback <스냅숏>  다음 부팅부터 루트 전체를 그 스냅숏으로 돌린다
#
# 곧바로 하고 싶으면 BUNTOS_APT_NO_SNAPSHOT=1 apt-get ...으로 스냅숏을 건너뛴다.
set -uo pipefail

# 패키지 매니저의 packagekitd에서도 불린다
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

CONF=/etc/buntos/apt-guard.conf
RUN=/run/buntos-apt-guard
STATE=/var/lib/buntos/apt-guard
LOG=/var/log/buntos-apt-guard.log
META=buntos-runtime

GUARD_PATHS=() GUARD_ELF=() GUARD_LIBS=() GUARD_DEPENDS=() GUARD_HOLD=() GUARD_DIVERT=() GUARD_UNITS=()
GUARD_KEEP=3 GUARD_MIN_FREE_GB=3
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

say() {
	echo "apt-guard: $*" >&2
	echo "$(date '+%F %T') $*" >>"$LOG" 2>/dev/null
}

die() {
	say "$*"
	exit 1
}

in_chroot() {
	command -v systemd-detect-virt >/dev/null && systemd-detect-virt --quiet --chroot
}

# 이미지를 만들 때는 로그를 남기지 않는다
in_chroot && LOG=/dev/null

# 루트가 btrfs 서브볼륨이면 dev와 sub를 채운다. 예: /dev/sdc83[/buntos-full] btrfs
root_parse() {
	local src fstype
	read -r src fstype < <(findmnt -nro SOURCE,FSTYPE /)
	[ "${fstype:-}" = btrfs ] || return 1
	case "$src" in
	*\[/*\]) ;;
	*) return 1 ;;
	esac
	dev=${src%%\[*}
	sub=${src#*\[/}
	sub=${sub%\]}
}

top_mount() {
	mkdir -p "$RUN/top" && mount -o subvolid=5 "$dev" "$RUN/top"
}

top_umount() {
	umount "$RUN/top" 2>/dev/null
	rmdir "$RUN/top" 2>/dev/null
}

snapshot_names() {
	find "$RUN/top/snapshots" -mindepth 1 -maxdepth 1 -name 'apt-*' -printf '%f\n' 2>/dev/null | sort
}

# 이름이 곧 시각이다: apt-20261105-041500. 스냅숏 뿌리의 mtime은 원본의 것을 물려받아 쓸 수 없다
snapshot_age() {
	local n=$1 when
	when=$(date -d "${n:4:8} ${n:13:2}:${n:15:2}:${n:17:2}" +%s 2>/dev/null) || {
		echo 999999
		return
	}
	echo $(($(date +%s) - when))
}

# 0: 있다(새로 만들었거나 방금 만든 것이 있다), 1: 못 만들었다, 2: 스냅숏을 쓰는 루트가 아니다
snapshot() {
	local dev sub free newest name rc=0 old
	root_parse || return 2
	free=$(df --output=avail -BG / | awk 'NR == 2 { print int($1) }')
	if [ "${free:-0}" -lt "$GUARD_MIN_FREE_GB" ]; then
		say "루트 여유가 ${free:-0}GB뿐이다(${GUARD_MIN_FREE_GB}GB 필요)"
		return 1
	fi
	top_mount || return 1
	mkdir -p "$RUN/top/snapshots"
	newest=$(snapshot_names | tail -n 1)
	if [ -n "$newest" ] && [ "$(snapshot_age "$newest")" -lt 600 ]; then
		say "10분 안에 만든 스냅숏 $newest 를 그대로 쓴다"
	else
		name=apt-$(date +%Y%m%d-%H%M%S)
		if btrfs subvolume snapshot -r "$RUN/top/$sub" "$RUN/top/snapshots/$name" >/dev/null; then
			say "스냅숏 $name 을 만들었다"
			snapshot_names | head -n "-$GUARD_KEEP" | while read -r old; do
				btrfs subvolume delete "$RUN/top/snapshots/$old" >/dev/null && say "오래된 스냅숏 $old 를 지웠다"
			done
		else
			rc=1
		fi
	fi
	top_umount
	return $rc
}

guard_files() {
	local p
	for p in "${GUARD_PATHS[@]}"; do
		[ -e "$p" ] && find "$p" -xdev -type f 2>/dev/null
	done | sort -u
}

sums() {
	guard_files | xargs -r -d '\n' sha256sum 2>/dev/null
}

unit_states() {
	[ "${#GUARD_UNITS[@]}" -gt 0 ] || return 0
	systemctl list-unit-files --no-legend --no-pager "${GUARD_UNITS[@]}" 2>/dev/null | awk '{ print $1, $2 }' | sort
}

is_elf() {
	[ "$(head -c 4 "$1" 2>/dev/null | od -An -tx1 | tr -d ' ')" = 7f454c46 ]
}

# 앞에 있고 뒤에는 없거나 해시가 달라진 경로. sha256sum 줄은 해시 64자, 공백 둘, 경로다
sums_gone_or_changed() {
	awk 'NR == FNR { after[substr($0, 67)] = substr($0, 1, 64); next }
	     after[substr($0, 67)] != substr($0, 1, 64) { print substr($0, 67) }' "$2" "$1"
}

sums_new() {
	awk 'NR == FNR { before[substr($0, 67)] = 1; next }
	     !(substr($0, 67) in before) { print substr($0, 67) }' "$1" "$2"
}

# 라이브러리가 사라진 바이너리와, 다른 곳에서 읽히게 된 라이브러리. 문제 수를 돌려준다
check_runtime() {
	local bad=0 f miss entry lib want got
	for f in "${GUARD_ELF[@]}"; do
		if [ ! -f "$f" ] || ! is_elf "$f"; then
			continue
		fi
		miss=$(ldd "$f" 2>/dev/null | awk '/not found/ { print $1 }' | tr '\n' ' ')
		if [ -n "$miss" ]; then
			say "$f 가 찾지 못하는 라이브러리: $miss"
			bad=$((bad + 1))
		fi
	done
	for entry in "${GUARD_LIBS[@]}"; do
		lib=${entry%%=*}
		want=${entry#*=}
		got=$(ldconfig -p | awk -v l="$lib" '$1 == l { print $NF; exit }')
		case "$got" in
		"$want"*) ;;
		*)
			say "$lib 를 $want 가 아니라 '${got:-없음}' 에서 읽는다"
			bad=$((bad + 1))
			;;
		esac
	done
	if [ ! -s "/usr/lib/modules/$(uname -r)/modules.dep" ] && ! in_chroot; then
		say "지금 커널의 모듈 목록(modules.dep)이 없다"
		bad=$((bad + 1))
	fi
	return "$bad"
}

cmd_pre() {
	local rc
	in_chroot && return 0
	mkdir -p "$RUN" "$STATE"
	: >"$RUN/not-restarted"
	sums >"$RUN/before.sha256"
	unit_states >"$RUN/before.units"
	[ "${BUNTOS_APT_NO_SNAPSHOT:-}" = 1 ] && return 0
	snapshot
	rc=$?
	if [ "$rc" = 1 ]; then
		say "스냅숏을 만들지 못해 여기서 멈춘다. 그래도 하려면 BUNTOS_APT_NO_SNAPSHOT=1 을 붙인다"
		return 1
	fi
	return 0
}

cmd_post() {
	local changed added units late
	in_chroot && return 0
	[ -s "$RUN/before.sha256" ] || return 0
	mkdir -p "$STATE"
	sums >"$RUN/after.sha256"
	changed=$(sums_gone_or_changed "$RUN/before.sha256" "$RUN/after.sha256")
	added=$(sums_new "$RUN/before.sha256" "$RUN/after.sha256")
	if [ -n "$changed" ]; then
		printf '%s\n' "$changed" >"$STATE/changed"
		say "이번 apt가 우리 파일을 바꿨다. 되돌리려면 apt-guard restore:"
		printf '%s\n' "$changed" | sed 's/^/  /' >&2
		printf '%s\n' "$changed" >>"$LOG"
	fi
	if [ -n "$added" ]; then
		say "이번 apt가 지켜 보는 경로에 파일을 더했다:"
		printf '%s\n' "$added" | sed 's/^/  /' >&2
		printf '%s\n' "$added" >>"$LOG"
	fi
	units=$(unit_states | diff "$RUN/before.units" - 2>/dev/null | grep '^[<>]')
	if [ -n "$units" ]; then
		say "서비스 켜짐 상태가 바뀌었다:"
		printf '%s\n' "$units" | sed 's/^/  /' >&2
	fi
	check_runtime
	late=$(sort -u "$RUN/not-restarted" 2>/dev/null | tr '\n' ' ')
	[ -z "$late" ] || say "다시 시작하지 않은 서비스(새 판은 다음 부팅부터): $late"
	rm -f "$RUN/before.sha256" "$RUN/after.sha256" "$RUN/before.units"
	return 0
}

cmd_check() {
	local bad=0 g pkg state n
	check_runtime
	bad=$?
	if ! dpkg-query -W -f '${db:Status-Abbrev}' "$META" 2>/dev/null | grep -q '^[ih]i'; then
		say "꾸러미 $META 가 없다. apt-guard install"
		bad=$((bad + 1))
	fi
	for g in "${GUARD_HOLD[@]}"; do
		pkg=$(dpkg-query -W -f '${db:Status-Abbrev} ${Package}\n' "$g" 2>/dev/null | awk '$1 ~ /^[ih]i$/ { print $2 }')
		[ -n "$pkg" ] || continue
		for n in $pkg; do
			state=$(dpkg-query -W -f '${db:Status-Want}' "$n" 2>/dev/null)
			if [ "$state" != hold ]; then
				say "$n 이 고정되어 있지 않다"
				bad=$((bad + 1))
			fi
		done
	done
	if [ -s "$STATE/changed" ]; then
		say "아직 되돌리지 않은 파일이 있다($STATE/changed). apt-guard restore"
		bad=$((bad + 1))
	fi
	[ "$bad" = 0 ] && say "문제 없다"
	[ "$bad" = 0 ]
}

# 바이너리의 직접 의존 라이브러리(DT_NEEDED)를 꾸러미 이름으로 바꾼다. 이 기기에는 readelf가 없다
needed_packages() {
	python3 -I - "$@" <<'PY'
import os, re, struct, subprocess, sys

def needed(path):
    with open(path, 'rb') as f:
        d = f.read()
    if d[:4] != b'\x7fELF' or d[4] != 2:
        return []
    e = '<' if d[5] == 1 else '>'
    phoff = struct.unpack_from(e + 'Q', d, 32)[0]
    phentsize, phnum = struct.unpack_from(e + 'HH', d, 54)
    loads, dyn = [], None
    for i in range(phnum):
        t, _, off, va, _, fsz, _, _ = struct.unpack_from(e + 'IIQQQQQQ', d, phoff + i * phentsize)
        if t == 1:
            loads.append((va, off, fsz))
        elif t == 2:
            dyn = (off, fsz)
    if not dyn:
        return []
    names, strtab = [], None
    for i in range(dyn[1] // 16):
        tag, val = struct.unpack_from(e + 'qQ', d, dyn[0] + i * 16)
        if tag == 0:
            break
        if tag == 1:
            names.append(val)
        elif tag == 5:
            strtab = val
    base = next(o + strtab - v for v, o, s in loads if v <= strtab < v + s)
    return [d[base + n:d.index(b'\0', base + n)].decode() for n in names]

def owner(path):
    tried = {path, os.path.realpath(path)}
    for p in list(tried):
        if p.startswith('/lib/'):
            tried.add('/usr' + p)
        elif p.startswith('/usr/lib/'):
            tried.add(p[4:])
    for p in tried:
        r = subprocess.run(['dpkg', '-S', p], capture_output=True, text=True).stdout
        if r:
            return r.split(':')[0].split(',')[0].strip()
    return None

cache = subprocess.run(['ldconfig', '-p'], capture_output=True, text=True).stdout
pkgs = set()
for path in sys.argv[1:]:
    if not os.path.isfile(path):
        continue
    for lib in needed(path):
        m = re.search(r'^\s*' + re.escape(lib) + r' \(.*?\) => (\S+)', cache, re.M)
        if not m:
            print(f'{path}: {lib}를 찾지 못했다', file=sys.stderr)
            continue
        o = owner(m.group(1))
        if o:
            pkgs.add(o)
print('\n'.join(sorted(pkgs)))
PY
}

cmd_refresh() {
	local want have dir list p
	list=$(needed_packages "${GUARD_ELF[@]}") || die "라이브러리 목록을 만들지 못했다"
	for p in "${GUARD_DEPENDS[@]}"; do
		dpkg-query -W -f '${db:Status-Abbrev}' "$p" 2>/dev/null | grep -q '^[ih]i' && list+=$'\n'"$p"
	done
	want=$(printf '%s\n' "$list" | sed '/^$/d' | sort -u | paste -sd, | sed 's/,/, /g')
	[ -n "$want" ] || die "의존성이 하나도 없다. 바이너리가 없는 이미지다"
	have=$(dpkg-query -W -f '${Depends}' "$META" 2>/dev/null) || true
	if [ "$want" = "$have" ]; then
		say "$META 는 그대로다"
		return 0
	fi
	dir=$(mktemp -d)
	mkdir -p "$dir/pkg/DEBIAN"
	cat >"$dir/pkg/DEBIAN/control" <<CONTROL
Package: $META
Version: $(date +%Y%m%d%H%M%S)
Architecture: $(dpkg --print-architecture)
Maintainer: buntOS contributors <noreply@buntos.invalid>
Section: metapackages
Priority: optional
Depends: $want
Description: libraries and tools that the buntOS binaries need
 The buntOS binaries are not owned by dpkg, so apt does not know what they
 use. This package holds it in place. Made by /usr/libexec/buntos/apt-guard.
CONTROL
	dpkg-deb --root-owner-group --build "$dir/pkg" "$dir/$META.deb" >/dev/null || die "꾸러미를 만들지 못했다"
	dpkg -i "$dir/$META.deb" >/dev/null || die "$META 를 설치하지 못했다"
	# dpkg -i는 고정을 풀어 놓는다
	apt-mark hold "$META" >/dev/null
	rm -rf "$dir"
	say "$META 의 의존성을 새로 잡았다"
}

cmd_install() {
	local p g base=/usr/share/buntos/base-packages
	for p in "${GUARD_DIVERT[@]}"; do
		[ -e "$p" ] || continue
		dpkg-divert --quiet --local --no-rename --divert "$p.dpkg-dist" --add "$p" || die "$p 를 돌리지 못했다"
	done
	cmd_refresh || return 1
	# 패키지 매니저의 목록에서 뺀다 (packages/src/installed.rs)
	if [ -e "$base" ] && ! grep -qxF "$META" "$base"; then
		echo "$META" >>"$base"
	fi
	for g in "${GUARD_HOLD[@]}"; do
		dpkg-query -W -f '${db:Status-Abbrev} ${Package}\n' "$g" 2>/dev/null | awk '$1 ~ /^[ih]i$/ { print $2 }' |
			xargs -r apt-mark hold >/dev/null
	done
	say "설치했다"
}

cmd_list() {
	local dev sub
	root_parse || die "스냅숏을 쓰는 루트가 아니다"
	top_mount || die "맨 위 서브볼륨을 붙이지 못했다"
	snapshot_names
	top_umount
}

cmd_restore() {
	local dev sub newest path src bad=0
	[ -s "$STATE/changed" ] || {
		say "되돌릴 파일이 없다"
		return 0
	}
	root_parse || die "스냅숏을 쓰는 루트가 아니다"
	top_mount || die "맨 위 서브볼륨을 붙이지 못했다"
	newest=$(snapshot_names | tail -n 1)
	if [ -z "$newest" ]; then
		top_umount
		die "스냅숏이 없다"
	fi
	while read -r path; do
		src=$RUN/top/snapshots/$newest$path
		if [ -e "$src" ] && cp -a --remove-destination "$src" "$path"; then
			say "되돌렸다: $path"
		else
			say "되돌리지 못했다: $path"
			bad=1
		fi
	done <"$STATE/changed"
	top_umount
	[ "$bad" = 0 ] && rm -f "$STATE/changed"
	return "$bad"
}

cmd_rollback() {
	local dev sub name=${1:-} old
	[ -n "$name" ] || die "어느 스냅숏인지 준다. apt-guard list"
	root_parse || die "스냅숏을 쓰는 루트가 아니다"
	top_mount || die "맨 위 서브볼륨을 붙이지 못했다"
	if [ ! -d "$RUN/top/snapshots/$name" ]; then
		top_umount
		die "스냅숏 $name 이 없다"
	fi
	old=$sub.before-rollback-$(date +%Y%m%d-%H%M%S)
	if ! mv "$RUN/top/$sub" "$RUN/top/$old"; then
		top_umount
		die "지금 루트의 이름을 바꾸지 못했다"
	fi
	if ! btrfs subvolume snapshot "$RUN/top/snapshots/$name" "$RUN/top/$sub" >/dev/null; then
		mv "$RUN/top/$old" "$RUN/top/$sub"
		top_umount
		die "스냅숏을 풀지 못해 그대로 두었다"
	fi
	sync
	top_umount
	say "다음 부팅부터 $name 으로 뜬다. /home도 그때로 돌아간다. 지금 것은 맨 위 서브볼륨의 $old 에 남는다"
}

case "${1:-}" in
pre) cmd_pre ;;
post) cmd_post ;;
check) cmd_check ;;
sums) sums ;;
install) cmd_install ;;
refresh) cmd_refresh ;;
list) cmd_list ;;
restore) cmd_restore ;;
rollback) cmd_rollback "${2:-}" ;;
*)
	sed -n '/^#   install/,/^# 곧바로/p' "$0" | sed 's/^# \{0,1\}//' >&2
	exit 2
	;;
esac
