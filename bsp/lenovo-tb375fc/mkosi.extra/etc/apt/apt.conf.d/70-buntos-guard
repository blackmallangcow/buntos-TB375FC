// apt가 dpkg를 부르기 전에 스냅숏과 해시를 남기고, 끝나면 우리 파일이 그대로인지 본다 (apt-guard).
// 패키지 매니저와 앱 스토어도 libapt를 쓰므로 함께 걸린다.
DPkg::Pre-Invoke { "[ ! -x /usr/libexec/buntos/apt-guard ] || /usr/libexec/buntos/apt-guard pre"; };
DPkg::Post-Invoke { "[ ! -x /usr/libexec/buntos/apt-guard ] || /usr/libexec/buntos/apt-guard post || true"; };

// 고친 설정 파일을 묻지 않고 그대로 둔다. 꾸러미의 새 판은 .dpkg-dist로 남는다
Dpkg::Options { "--force-confdef"; "--force-confold"; };
