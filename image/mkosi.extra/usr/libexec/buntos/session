# buntOS 그래픽 세션을 시작한다. tty1 로그인 셸에서 실행된다 (/etc/profile.d/buntos-session.sh).

# 표시 언어. 시스템 설정이 고른 언어를 ~/.config/environment.d/에 적는다 (기본은 한국어)
LANG=$(cat "${XDG_CONFIG_HOME:-$HOME/.config}"/environment.d/*.conf 2>/dev/null | sed -n 's/^LANG=//p' | tail -n 1)
export LANG="${LANG:-ko_KR.UTF-8}"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=buntOS
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24
# 컴포지터가 아직 dmabuf를 지원하지 않아 GTK는 CPU로 그린다
export GSK_RENDERER=cairo

exec systemd-cat --identifier=bunt-comp bunt-comp
