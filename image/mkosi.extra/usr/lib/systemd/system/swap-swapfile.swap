# 디스크의 스왑 파일을 켠다(설계안 8.1절). 파일은 buntos-swapfile.service가 처음 켤 때 만든다

[Unit]
Description=Swap file
Documentation=file:/usr/libexec/buntos/swapfile
Wants=buntos-swapfile.service
After=buntos-swapfile.service
ConditionPathExists=/swap/swapfile

[Swap]
What=/swap/swapfile

[Install]
WantedBy=swap.target
