# fcitx5 기본 설정. Ctrl+Space와 한/영 키는 bunt-comp가 먼저 받아 입력 소스를 바꾸므로
# 입력 칸에 포커스가 없어도 동작한다. 여기 적은 키는 컴포지터 없이 띄웠을 때를 위한 것이다

[Hotkey]
EnumerateWithTriggerKeys=True

[Hotkey/TriggerKeys]
0=Control+space
1=Hangul

# 왼쪽 Shift만 눌렀다 떼면 첫 입력 소스(영문)와 지금 입력 소스를 오가는 fcitx5 기본 단축키를 끈다(빈 목록).
# macOS에는 없는 동작이라, 쌍자음을 치려다 Shift만 떼면 한글 모드가 영문으로 바뀌었다. 수정 키만으로 바꾸는
# 단축키(⌃⇧ 등)는 컴포지터가 시스템 설정의 키보드 단축키대로 한다
[Hotkey/AltTriggerKeys]

[Behavior]
# macOS처럼 입력 소스는 앱마다가 아니라 전체에 하나다
ShareInputState=All
ActiveByDefault=False
PreeditEnabledByDefault=True
# 바꿀 때 글자 커서 옆에 잠깐 입력 소스를 보인다 (macOS의 입력 소스 표시기)
ShowInputMethodInformation=True
CompactInputMethodInformation=True
DefaultPageSize=9

# 입력 소스는 셸의 메뉴바가 보이므로 fcitx5 자체 트레이 항목(StatusNotifierItem)은 끈다
[Behavior/DisabledAddons]
0=notificationitem
