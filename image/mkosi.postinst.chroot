#!/bin/bash
# SPDX-FileCopyrightText: 2026 buntOS contributors
# SPDX-License-Identifier: GPL-3.0-or-later
#
# mkosi가 패키지 설치 뒤 이미지 안(chroot)에서 실행한다.
set -euo pipefail

# 로캘: 한국어와 영어를 기본 이미지에 넣는다 (ARCHITECTURE 7장)
sed -i -E 's/^# *(ko_KR\.UTF-8 UTF-8)/\1/; s/^# *(en_US\.UTF-8 UTF-8)/\1/' /etc/locale.gen
locale-gen

# 패키지 설치 뒤에 넣은 파일을 반영한다: GSettings 기본값(90_buntos.gschema.override)과
# 자체 앱과 셸의 아이콘. 아이콘 캐시가 낡으면 GTK가 새 아이콘을 찾지 못한다
glib-compile-schemas /usr/share/glib-2.0/schemas
gtk-update-icon-cache --quiet --force /usr/share/icons/hicolor

# 네트워크는 NetworkManager가 맡는다. 설정 없이 켜져 있던 systemd-networkd는 끈다
systemctl disable systemd-networkd.service systemd-networkd.socket

# 가상 기기에서는 잠자기를 끈다. 잠든 VM을 깨울 장치가 없다 (buntos-vm-sleep.service)
systemctl enable buntos-vm-sleep.service

# 패키지 매니저(bunt-packages)가 제거 목록에서 뺄 패키지. 이미지에 든 것은 시스템의 일부라 지우게 하지 않는다
dpkg-query --show --showformat='${Package}\n' | sort -u >/usr/share/buntos/base-packages

# Flathub. 저장소 파일은 Flathub가 내는 것 그대로다(https://dl.flathub.org/repo/flathub.flatpakrepo, 서명 키가 들어
# 있다). 이미지를 만들 때 넣으므로 첫 부팅에 인터넷이 없어도 되고, 사용자가 지우면 다시 생기지 않는다.
# 작은 시험 이미지에는 flatpak이 없다
if command -v flatpak >/dev/null; then
	flatpak remote-add --system --if-not-exists flathub /usr/share/buntos/flathub.flatpakrepo
fi

# 패키지를 설치한 뒤에 넣은 .desktop(패키지 매니저)도 파일 형식의 앱 목록에 들어가게 한다
if command -v update-desktop-database >/dev/null; then
	update-desktop-database --quiet /usr/share/applications
fi

# 앱 스토어는 GNOME Software이고, 모든 앱과 메뉴 막대에는 "앱 스토어"로 보인다. 나머지는 꾸러미의 파일 그대로다.
# /usr/local/share가 /usr/share보다 먼저 읽히므로 같은 이름의 이 파일이 꾸러미의 것을 가린다
store=/usr/share/applications/org.gnome.Software.desktop
if [[ -e "$store" ]]; then
	awk '
		/^\[/ { entry = ($0 == "[Desktop Entry]") }
		entry && /^Name\[/ { next }
		entry && /^Name=/ { print "Name=Software"; print "Name[ko]=앱 스토어"; next }
		{ print }
	' "$store" >/usr/local/share/applications/org.gnome.Software.desktop
fi

# 에이전트 데몬은 처음 붙을 때 뜬다 (소켓 활성화). 자체 컴포넌트를 빌드하지 않은 이미지에는 없다
if [[ -e /usr/lib/systemd/user/buntd-agent.socket ]]; then
	systemctl --global enable buntd-agent.socket
fi

# 로그인 화면(greetd와 bunt-greeter). 이미지에는 사용자 계정이 없다: 처음 켜면 로그인 화면이 계정을
# 만들고(buntd-setup), 시험·개발용 VM은 부팅 때 자격 증명 buntos.account로 미리 만든다
# (buntos-account.service). VT1은 로그인 화면이 쓰므로 tty1의 텍스트 로그인을 막는다. mkosi의
# Autologin=yes가 거기에 root 자동 로그인을 붙이기 때문이다(직렬 콘솔의 root 자동 로그인은 남는다).
# 자체 컴포넌트를 빌드하지 않은 이미지에는 로그인 화면이 없으므로 greetd를 끈다
if [[ -x /usr/bin/bunt-greeter ]]; then
	systemctl enable greetd.service buntos-account.service
	systemctl mask getty@tty1.service
else
	systemctl disable greetd.service
fi
