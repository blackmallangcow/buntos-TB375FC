# 시험·개발용 계정을 systemd 자격 증명 buntos.account로 미리 만든다. 정규 계정이 이미 있으면 아무것도
# 하지 않는다. 형식은 한 줄 "계정 이름:별칭:암호"다 (예: buntos:buntOS:buntos). VM에는 SMBIOS로
# 넘긴다: -smbios type=11,value=io.systemd.credential:buntos.account=buntos:buntOS:buntos

[Unit]
Description=buntOS account from the buntos.account credential
ConditionCredential=buntos.account
After=systemd-sysusers.service local-fs.target
Before=greetd.service systemd-user-sessions.service

[Service]
Type=oneshot
ImportCredential=buntos.account
ExecStart=/usr/libexec/buntos/buntd-setup --credential
ProtectSystem=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
