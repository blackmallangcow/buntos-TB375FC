// 시험용: 2b부터 하나씩 켜는 노드. 기기에서 확인한 뒤 보드 dts로 옮긴다.

// LK가 켜 둔 화면은 mmpll에서 나오는 클럭으로 돈다. 커널에는 화면 드라이버가 없어 이 사용자를 모르므로,
// 같은 PLL을 쓰는 UFS가 클럭을 내리면 사용자가 0이 되어 PLL을 끈다. simpledrm이 잡아 둔다.
&framebuffer0 {
	clocks = <&apmixedsys CLK_APMIXED_MMPLL>;
};

// 6.1 핀, 6.2 클럭
&pio {
	status = "okay";
};

&apmixedsys {
	status = "okay";
};

&topckgen {
	status = "okay";
};

&vlpckgen {
	status = "okay";
};

&pericfg_ao {
	status = "okay";
};

&ufscfg_ao {
	status = "okay";
};

&ufscfg_pdn {
	status = "okay";
};

// 6.3 SPMI, 6.4 MT6363·MT6319, 6.5 MT6368. M 버스의 PMIC만 켠다. MT6685(@9)와 P 버스는 보드 dts대로 꺼져 있다.
&spmi {
	status = "okay";
};

// 6.7 USB 가젯. xhci0은 보드 dts대로 꺼 둔다.
&ssusb {
	status = "okay";
};

&xsphy {
	status = "okay";
};

// 6.6 UFS. 안드로이드 파티션과 nvdata가 있으니 읽기만 한다.
&ufsphy {
	status = "okay";
};

&ufshci {
	status = "okay";
};

// 7. 2c 입력. 터치와 펜(spi2), 홀 센서(gpio-keys), 포고 키보드(uart3). vddio_1v8은 패널과 터치의 I/O 전원이다.
&vddio_1v8 {
	status = "okay";
};

&spi2 {
	status = "okay";
};

&{/gpio-keys} {
	status = "okay";
};

&uart3 {
	status = "okay";
};

// 볼륨 내림 키
&keypad {
	status = "okay";
};

// 9.1, 9.2 2d. 드라이버는 명령줄의 modprobe.blacklist로 막고 손으로 올린다. 6.10 RTC도 MT6685와 함께 켠다.
&spm {
	status = "okay";
};

&mt6685 {
	status = "okay";
};

&mt6685_rtc {
	status = "okay";
};

&mt6363_vcn13 {
	status = "okay";
};

&mt6363_vrfio18 {
	status = "okay";
};

&mt6368_vant18 {
	status = "okay";
};

&mt6368_vcn33_1 {
	status = "okay";
};

&mt6368_vcn33_2 {
	status = "okay";
};

&consys {
	status = "okay";
};

&wifi {
	status = "okay";
};

&bluetooth {
	status = "okay";
};

// 9.4 2e 열과 게이지. efuse는 LK의 퓨즈 사본을 읽는다(lk-private.dtsi).
&efuse {
	status = "okay";
};

&lvts_ap {
	status = "okay";
};

&lvts_mcu {
	status = "okay";
};

&imp_iic_wrap_s {
	status = "okay";
};

&i2c7 {
	status = "okay";
};

// 9.4 2·3단계. GPU 전원은 요청하지 않는다.
&lvts_apu {
	status = "okay";
};

&lvts_gpu {
	status = "okay";
};

&gpueb_mbox {
	status = "okay";
};

&gpueb {
	status = "okay";
};

// 9.4 4단계. panthor는 명령줄의 modprobe.blacklist로 막고 손으로 올린다.
&gpu {
	status = "okay";
};

// 9.3 A 충전 읽기만. 모듈은 명령줄의 modprobe.blacklist로 막고 손으로 올린다.
&imp_iic_wrap_n {
	status = "okay";
};

&imp_iic_wrap_en {
	status = "okay";
};

&i2c5 {
	status = "okay";
};

&i2c10 {
	status = "okay";
};

&mt6375 {
	status = "okay";
};

// 9.3 B 충전 넘겨받기. 모듈은 명령줄의 modprobe.blacklist로 막고, 멈추는 스크립트를 건 뒤에 손으로 올린다.
&battery {
	status = "okay";
};

&mt6375 {
	charger {
		monitored-battery = <&battery>;
		mediatek,fuel-gauge = <&fuel_gauge>;
	};
};

// 9.3 C 인터럽트와 TCPC, 싱크만. tcpci_mt6375는 명령줄로 막고 시간 제한을 걸어 손으로 올린다.
&mt6375 {
	interrupt-parent = <&pio>;
	interrupts = <7 IRQ_TYPE_LEVEL_LOW>;

	charger {
		mediatek,usb-port = <&mt6375_tcpc>;
	};
};

&mt6375_tcpc {
	status = "okay";
};

// 8절 3단계, 9.3 C: TCPC의 VBUS 레귤레이터가 이 입력 FET 스위치를 입력으로 잡는다. 켜지 않는다.
&charge_pump_65 {
	status = "okay";
};

// 9.3 F USB 커넥터 과열 보호. 센서는 모듈이고 충전 드라이버가 10초마다 읽는다
&mt6363_adc {
	status = "okay";
};

&usb_conn_ntc {
	status = "okay";
};

&mt6375 {
	charger {
		mediatek,connector-thermal-zone = "usb-conn-thermal";
		mediatek,vbus-protect-gpios = <&pio 179 GPIO_ACTIVE_HIGH>;
	};
};

// 9.5 2c 2차 화면. 드라이버 넷은 명령줄의 modprobe.blacklist로 막고 손으로 올린다(체크리스트 9.5의 1~4단계).
// 화면 도메인은 첫 소비자 전에 simple-framebuffer가 잡는다. 패널 노드를 켜므로 fw_devlink가 simpledrm을 붙들지 않게 panel을 꺼진 노드로 돌린다.
/ {
	// simpledrm은 화면의 실제 크기(mm)를 panel이 가리키는 노드에서 읽는다. 꺼진 노드에는 fw_devlink가 걸리지 않으므로 크기만 적어 둔다
	panel_size: tb375fc-panel-size {
		status = "disabled";
		width-mm = <273>;
		height-mm = <171>;
	};
};

&framebuffer0 {
	panel = <&panel_size>;
	power-domains = <&scpsys MT6897_POWER_DOMAIN_DIS0_SHUTDOWN>,
			<&scpsys MT6897_POWER_DOMAIN_DIS1_SHUTDOWN>,
			<&scpsys MT6897_POWER_DOMAIN_OVL0_SHUTDOWN>,
			<&scpsys MT6897_POWER_DOMAIN_OVL1_SHUTDOWN>;
};

&scpsys {
	power-domain@MT6897_POWER_DOMAIN_MM_INFRA {
		reg = <MT6897_POWER_DOMAIN_MM_INFRA>;
		clocks = <&topckgen CLK_TOP_MMINFRA>;
		clock-names = "mm_infra";
		#address-cells = <1>;
		#size-cells = <0>;
		#power-domain-cells = <1>;

		power-domain@MT6897_POWER_DOMAIN_DIS0_SHUTDOWN {
			reg = <MT6897_POWER_DOMAIN_DIS0_SHUTDOWN>;
			clocks = <&topckgen CLK_TOP_DISP0>;
			clock-names = "disp";
			#address-cells = <1>;
			#size-cells = <0>;
			#power-domain-cells = <1>;

			power-domain@MT6897_POWER_DOMAIN_OVL0_SHUTDOWN {
				reg = <MT6897_POWER_DOMAIN_OVL0_SHUTDOWN>;
				clocks = <&topckgen CLK_TOP_OVL0>;
				clock-names = "ovl";
				#power-domain-cells = <0>;
			};
		};

		// 비디오 디코더(docs/tb375fc/video-decode.md 1단계). 소비자는 larb4뿐이고, 부팅 때는 꺼진 채로 둔다
		power-domain@MT6897_POWER_DOMAIN_VDE0 {
			reg = <MT6897_POWER_DOMAIN_VDE0>;
			clocks = <&topckgen CLK_TOP_VDEC>;
			clock-names = "vde";
			#address-cells = <1>;
			#size-cells = <0>;
			#power-domain-cells = <1>;

			power-domain@MT6897_POWER_DOMAIN_VDE1 {
				reg = <MT6897_POWER_DOMAIN_VDE1>;
				clocks = <&topckgen CLK_TOP_VDEC>;
				clock-names = "vde1";
				#power-domain-cells = <0>;
			};
		};

		// 앞 카메라(docs/tb375fc/camera.md 2단계). 순정의 클럭 목록을 따른다: 기본 클럭은 켜기 전에, 이름에 '-'가 있는
		// 클럭(카메라 클럭 블록의 GALS·larb 게이트)은 켠 뒤 버스 보호를 풀기 전에 켠다. 소비자는 꺼 둔 시험 노드뿐이라
		// 부팅 때는 꺼진 채로 둔다. 순정의 "ccu"는 topckgen 19번(camtg7)을 가리키는데, CCU의 클럭은 VLP 19번(ccusys)이다
		power-domain@MT6897_POWER_DOMAIN_CAM_VCORE {
			reg = <MT6897_POWER_DOMAIN_CAM_VCORE>;
			clocks = <&topckgen CLK_TOP_CAM>,
				 <&topckgen CLK_TOP_DPE>,
				 <&vlpckgen CLK_VLP_CCUSYS>,
				 <&topckgen CLK_TOP_CCU_AHB>,
				 <&cam_vcore CLK_CAM_VCORE_MM0_SUBCOMMON_DCM_DIS>;
			clock-names = "cam", "dpe", "ccu", "ccu_ahb", "cam_vcore-0";
			#address-cells = <1>;
			#size-cells = <0>;
			#power-domain-cells = <1>;

			power-domain@MT6897_POWER_DOMAIN_CAM_MAIN {
				reg = <MT6897_POWER_DOMAIN_CAM_MAIN>;
				clocks = <&camsys_main CLK_CAM_MAIN_CAM2MM0_GALS>,
					 <&camsys_main CLK_CAM_MAIN_CAM2MM1_GALS>,
					 <&camsys_main CLK_CAM_MAIN_CAM2MM2_GALS>,
					 <&camsys_main CLK_CAM_MAIN_CAM2SYS_GALS>,
					 <&camsys_main CLK_CAM_MAIN_LARB13>,
					 <&camsys_main CLK_CAM_MAIN_LARB14>,
					 <&camsys_main CLK_CAM_MAIN_LARB27>,
					 <&camsys_main CLK_CAM_MAIN_LARB29>;
				clock-names = "cam_main-0", "cam_main-1", "cam_main-2",
					      "cam_main-3", "cam_main-4", "cam_main-5",
					      "cam_main-6", "cam_main-7";
				// 순정의 cam-main-supply. 늘 켜 두는 vmm이다
				domain-supply = <&mt6319_6_vbuck1>;
				#power-domain-cells = <0>;
			};
		};

		// VCP의 도메인(2단계). LK가 켜 둔 채 넘기지만 꺼진 도메인으로 등록하고, 소비자(vcp 노드)는 꺼 둔 채 부팅한다
		power-domain@MT6897_POWER_DOMAIN_MM_PROC_DORMANT {
			reg = <MT6897_POWER_DOMAIN_MM_PROC_DORMANT>;
			clocks = <&topckgen CLK_TOP_MMUP>;
			clock-names = "mmup";
			#power-domain-cells = <0>;
		};

		power-domain@MT6897_POWER_DOMAIN_DIS1_SHUTDOWN {
			reg = <MT6897_POWER_DOMAIN_DIS1_SHUTDOWN>;
			clocks = <&topckgen CLK_TOP_DISP1>;
			clock-names = "disp1";
			#address-cells = <1>;
			#size-cells = <0>;
			#power-domain-cells = <1>;

			power-domain@MT6897_POWER_DOMAIN_OVL1_SHUTDOWN {
				reg = <MT6897_POWER_DOMAIN_OVL1_SHUTDOWN>;
				clocks = <&topckgen CLK_TOP_OVL1>;
				clock-names = "ovl1";
				#power-domain-cells = <0>;
			};
		};
	};

	// CSI 수신부의 아날로그 쪽. 순정에서도 부모가 없고 클럭도 없다
	power-domain@MT6897_POWER_DOMAIN_CSI_RX {
		reg = <MT6897_POWER_DOMAIN_CSI_RX>;
		#power-domain-cells = <0>;
	};
};

&camsys_main {
	status = "okay";
};

&cam_vcore {
	status = "okay";
};

/ {
	// 앞 카메라 2단계의 시험 노드. 꺼 둔 채 부팅하고, 시험 모듈(.handoff의 camtest)이 손으로 올릴 때만 이 노드로 장치를 만든다
	camera-power-test {
		compatible = "buntos,mt6897-camera-power-test";
		power-domains = <&scpsys MT6897_POWER_DOMAIN_CSI_RX>,
				<&scpsys MT6897_POWER_DOMAIN_CAM_MAIN>;
		power-domain-names = "csi-rx", "cam-main";
		clocks = <&camsys_main CLK_CAM_MAIN_CAM>,
			 <&camsys_main CLK_CAM_MAIN_SENINF>,
			 <&camsys_main CLK_CAM_MAIN_CAMTG>,
			 <&camsys_main CLK_CAM_MAIN_CAMSV_TOP>,
			 <&camsys_main CLK_CAM_MAIN_CAMSV_A>;
		clock-names = "cam", "seninf", "camtg", "camsv", "camsv-a";
		status = "disabled";
	};
};

