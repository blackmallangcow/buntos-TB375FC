/*
 * Lenovo Xiaoxin Pad Pro 12.7 (2025, TB375FC)
 *
 * Copyright (c) 2026 buntOS contributors
 */

/dts-v1/;
#include <dt-bindings/spmi/spmi.h>
#include "mt6897.dtsi"

/ {
	model = "Lenovo Xiaoxin Pad Pro 12.7 (TB375FC)";
	compatible = "lenovo,tb375fc", "mediatek,mt6897";

	aliases {
		serial0 = &uart0;
		spmi0 = &spmi_m;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:921600n8";

		/*
		 * The bootloader drives the panel over both DSI links with DSC
		 * and scans out one 2944x1840 buffer. TODO(2a): the base is
		 * from the community port's bootloader log; confirm it on the
		 * device before enabling this and framebuffer_mem.
		 */
		framebuffer0: framebuffer@fc16f000 {
			compatible = "simple-framebuffer";
			reg = <0 0xfc16f000 0 (2944 * 1840 * 4)>;
			width = <2944>;
			height = <1840>;
			stride = <(2944 * 4)>;
			format = "a8r8g8b8";
			status = "disabled";
		};
	};

	memory@40000000 {
		device_type = "memory";
		/* The bootloader fills in the real size (8 or 12 GiB) */
		reg = <0 0x40000000 0 0x40000000>;
	};
};

&reserved_memory {
	/* The bootloader's three-buffer allocation behind framebuffer0 */
	framebuffer_mem: framebuffer@fc16f000 {
		reg = <0 0xfc16f000 0 0x3e90000>;
		no-map;
		status = "disabled";
	};

	/* TODO(2a): confirm this gap survives warm reboots, then enable */
	ramoops@48090000 {
		compatible = "ramoops";
		reg = <0 0x48090000 0 0xe0000>;
		record-size = <0x20000>;
		console-size = <0x40000>;
		pmsg-size = <0x80000>;
		status = "disabled";
	};
};

/*
 * MT6319 buck PMICs, as in the stock tree. Their users there: 6/vbuck1
 * the ISP and camera power domains, 6/vbuck3 (proc1 and proc4),
 * 7/vbuck1 (proc2) and 6/vbuck4 (proc3) the CPU DVFS that the MCUPM
 * drives, 8/vbuck3 UFS VCCQ; 7/vbuck3 has none. Buck 2 is paired with
 * buck 1 on all three. Nothing claims these rails yet, so all of them
 * stay on through the unused regulator cleanup. The driver picks the
 * paired bucks by SID as on MT8195 boards, which does not match this
 * board, so no operating modes are allowed.
 */
&spmi_m {
	mt6319_6: pmic@6 {
		compatible = "mediatek,mt6319-regulator", "mediatek,mt6315-regulator";
		reg = <0x6 SPMI_USID>;

		regulators {
			mt6319_6_vbuck1: vbuck1 {
				regulator-name = "vmm";
				regulator-min-microvolt = <300000>;
				regulator-max-microvolt = <1193750>;
				regulator-enable-ramp-delay = <256>;
				regulator-always-on;
			};

			mt6319_6_vbuck3: vbuck3 {
				regulator-name = "vproc1";
				regulator-min-microvolt = <300000>;
				regulator-max-microvolt = <1193750>;
				regulator-enable-ramp-delay = <256>;
				regulator-always-on;
			};

			mt6319_6_vbuck4: vbuck4 {
				regulator-name = "vproc3";
				regulator-min-microvolt = <300000>;
				regulator-max-microvolt = <1193750>;
				regulator-enable-ramp-delay = <256>;
				regulator-always-on;
			};
		};
	};

	mt6319_7: pmic@7 {
		compatible = "mediatek,mt6319-regulator", "mediatek,mt6315-regulator";
		reg = <0x7 SPMI_USID>;

		regulators {
			mt6319_7_vbuck1: vbuck1 {
				regulator-name = "vproc2";
				regulator-min-microvolt = <300000>;
				regulator-max-microvolt = <1193750>;
				regulator-enable-ramp-delay = <256>;
				regulator-always-on;
			};

			mt6319_7_vbuck3: vbuck3 {
				regulator-name = "mt6319_7_vbuck3";
				regulator-min-microvolt = <300000>;
				regulator-max-microvolt = <1193750>;
				regulator-enable-ramp-delay = <256>;
				regulator-always-on;
			};
		};
	};

	mt6319_8: pmic@8 {
		compatible = "mediatek,mt6319-regulator", "mediatek,mt6315-regulator";
		reg = <0x8 SPMI_USID>;

		regulators {
			mt6319_8_vbuck3: vbuck3 {
				regulator-name = "vufs_vccq";
				regulator-min-microvolt = <300000>;
				regulator-max-microvolt = <1193750>;
				regulator-enable-ramp-delay = <256>;
				regulator-always-on;
			};
		};
	};
};

/* Debug UART, GPIO207 (TX) and GPIO208 (RX) */
&uart0 {
	status = "okay";
};
