// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
/*
 * MediaTek MT6897 (Dimensity 8300, sold as MT8792 in tablets) SoC
 *
 * Copyright (c) 2026 buntOS contributors
 *
 * Register and interrupt values come from the SoC device tree in the
 * Lenovo TB373FU/TB375FC stock firmware and were checked against the
 * MediaTek downstream mt6897.dts and the community port
 * https://github.com/u0n0u/tb375fc-linux. Blocks that need the missing
 * clock, pinctrl and power domain drivers are described but disabled.
 */

#include <dt-bindings/clock/mediatek,mt6897-clock.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/reset/mediatek,mt6897-resets.h>

/ {
	compatible = "mediatek,mt6897";
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	clk26m: oscillator-26m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "clk26m";
	};

	clk13m: fixed-factor-clock-13m {
		compatible = "fixed-factor-clock";
		#clock-cells = <0>;
		clocks = <&clk26m>;
		clock-div = <2>;
		clock-mult = <1>;
		clock-output-names = "clk13m";
	};

	/* The stock firmware gives 32000 Hz, not 32768 */
	clk32k: oscillator-32k {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32000>;
		clock-output-names = "clk32k";
	};

	/* On-chip ultra low power oscillator, the osc_dN dividers' parent */
	ulposc: oscillator-ulposc {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <588000000>;
		clock-output-names = "ulposc";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a510";
			reg = <0x000>;
			enable-method = "psci";
			performance-domains = <&performance 0>;
			capacity-dmips-mhz = <338>;
			cpu-idle-states = <&cpu_off_l &cluster_off_l>;
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a510";
			reg = <0x100>;
			enable-method = "psci";
			performance-domains = <&performance 0>;
			capacity-dmips-mhz = <338>;
			cpu-idle-states = <&cpu_off_l &cluster_off_l>;
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a510";
			reg = <0x200>;
			enable-method = "psci";
			performance-domains = <&performance 0>;
			capacity-dmips-mhz = <338>;
			cpu-idle-states = <&cpu_off_l &cluster_off_l>;
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a510";
			reg = <0x300>;
			enable-method = "psci";
			performance-domains = <&performance 0>;
			capacity-dmips-mhz = <338>;
			cpu-idle-states = <&cpu_off_l &cluster_off_l>;
		};

		cpu4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a715";
			reg = <0x400>;
			enable-method = "psci";
			performance-domains = <&performance 1>;
			capacity-dmips-mhz = <1080>;
			cpu-idle-states = <&cpu_off_m &cluster_off_m>;
		};

		cpu5: cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a715";
			reg = <0x500>;
			enable-method = "psci";
			performance-domains = <&performance 1>;
			capacity-dmips-mhz = <1080>;
			cpu-idle-states = <&cpu_off_m &cluster_off_m>;
		};

		cpu6: cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a715";
			reg = <0x600>;
			enable-method = "psci";
			performance-domains = <&performance 1>;
			capacity-dmips-mhz = <1080>;
			cpu-idle-states = <&cpu_off_m &cluster_off_m>;
		};

		cpu7: cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-a715";
			reg = <0x700>;
			enable-method = "psci";
			performance-domains = <&performance 2>;
			capacity-dmips-mhz = <1024>;
			cpu-idle-states = <&cpu_off_b &cluster_off_b>;
		};

		/* One DynamIQ cluster; the three DVFS domains are performance-domains */
		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};

				core1 {
					cpu = <&cpu1>;
				};

				core2 {
					cpu = <&cpu2>;
				};

				core3 {
					cpu = <&cpu3>;
				};

				core4 {
					cpu = <&cpu4>;
				};

				core5 {
					cpu = <&cpu5>;
				};

				core6 {
					cpu = <&cpu6>;
				};

				core7 {
					cpu = <&cpu7>;
				};
			};
		};

		/*
		 * Only the CPU and cluster power-down states. The deeper MCUSYS
		 * and system states are coordinated by the SPM and need its
		 * driver first.
		 */
		idle-states {
			entry-method = "psci";

			cpu_off_l: cpu-off-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00010000>;
				local-timer-stop;
				entry-latency-us = <126>;
				exit-latency-us = <251>;
				min-residency-us = <5700>;
			};

			cpu_off_m: cpu-off-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00010000>;
				local-timer-stop;
				entry-latency-us = <77>;
				exit-latency-us = <179>;
				min-residency-us = <2520>;
			};

			cpu_off_b: cpu-off-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00010000>;
				local-timer-stop;
				entry-latency-us = <52>;
				exit-latency-us = <129>;
				min-residency-us = <1890>;
			};

			cluster_off_l: cluster-off-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010001>;
				local-timer-stop;
				entry-latency-us = <143>;
				exit-latency-us = <420>;
				min-residency-us = <5700>;
			};

			cluster_off_m: cluster-off-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010001>;
				local-timer-stop;
				entry-latency-us = <82>;
				exit-latency-us = <253>;
				min-residency-us = <3020>;
			};

			cluster_off_b: cluster-off-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010001>;
				local-timer-stop;
				entry-latency-us = <46>;
				exit-latency-us = <150>;
				min-residency-us = <2460>;
			};
		};
	};

	pmu-a510 {
		compatible = "arm,cortex-a510-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
	};

	pmu-a715 {
		compatible = "arm,cortex-a715-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH &ppi_cluster1>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	/*
	 * The bootloader adds its fixed carve-outs (ATF, TEE, GenieZone,
	 * connsys, framebuffer, ...) here at boot.
	 */
	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
	};

	timer: timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_HIGH 0>;
		clock-frequency = <13000000>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		dma-ranges = <0 0 0 0 0x10 0>;

		/* CPU DVFS in the MCUPM, one register bank per frequency domain */
		performance: performance-controller@11bc10 {
			compatible = "mediatek,cpufreq-hw";
			reg = <0 0x0011bc10 0 0x120>,
			      <0 0x0011bd30 0 0x120>,
			      <0 0x0011be50 0 0x120>;
			#performance-domain-cells = <1>;
		};

		/*
		 * Unlike MT8183..MT8195 the GIC is not at 0x0c000000: that
		 * range is MCUSYS (mcucfg, CPU PLLs, MCUPM at 0x0c070000).
		 * Both the shipped SoC tree and the tree the bootloader hands
		 * to the kernel use this base, as does the community port.
		 */
		gic: interrupt-controller@c400000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <4>;
			#redistributor-regions = <1>;
			interrupt-parent = <&gic>;
			interrupt-controller;
			reg = <0 0x0c400000 0 0x40000>,
			      <0 0x0c440000 0 0x200000>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH 0>;

			ppi-partitions {
				ppi_cluster0: interrupt-partition-0 {
					affinity = <&cpu0 &cpu1 &cpu2 &cpu3>;
				};

				ppi_cluster1: interrupt-partition-1 {
					affinity = <&cpu4 &cpu5 &cpu6 &cpu7>;
				};
			};
		};

		/*
		 * The clock controllers stay off in 2a, which runs on the clocks
		 * the bootloader left on. TODO(2b): enable all six together with
		 * pio and SPMI, keeping clk_ignore_unused on the command line.
		 */
		topckgen: clock-controller@10000000 {
			compatible = "mediatek,mt6897-topckgen", "syscon";
			reg = <0 0x10000000 0 0x1000>;
			mediatek,hardware-voter = <&hwv>;
			#clock-cells = <1>;
			status = "disabled";
		};

		/*
		 * 232 GPIOs and the five EINT blocks. EINTs 232-249 have no
		 * pin; the driver gives them virtual GPIOs (the SPMI rcs
		 * interrupt is EINT 248). TODO(2b): enable together with SPMI.
		 */
		pio: pinctrl@10005000 {
			compatible = "mediatek,mt6897-pinctrl";
			reg = <0 0x10005000 0 0x1000>,
			      <0 0x11b20000 0 0x1000>,
			      <0 0x11c00000 0 0x1000>,
			      <0 0x11d30000 0 0x1000>,
			      <0 0x11d40000 0 0x1000>,
			      <0 0x11d50000 0 0x1000>,
			      <0 0x11ea0000 0 0x1000>,
			      <0 0x11eb0000 0 0x1000>,
			      <0 0x11f20000 0 0x1000>,
			      <0 0x11f30000 0 0x1000>,
			      <0 0x11ce0000 0 0x1000>,
			      <0 0x11de0000 0 0x1000>,
			      <0 0x11e90000 0 0x1000>,
			      <0 0x11fe0000 0 0x1000>,
			      <0 0x1c01e000 0 0x1000>;
			reg-names = "base", "rt", "rm", "bl", "bm", "br",
				    "lb", "lt", "tm", "tl", "eint-e", "eint-s",
				    "eint-w", "eint-n", "eint-c";
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pio 0 0 232>;
			interrupt-controller;
			interrupts = <GIC_SPI 309 IRQ_TYPE_LEVEL_HIGH 0>;
			#interrupt-cells = <2>;
			status = "disabled";
		};

		apmixedsys: clock-controller@1000c000 {
			compatible = "mediatek,mt6897-apmixedsys", "syscon";
			reg = <0 0x1000c000 0 0x1000>;
			mediatek,hardware-voter = <&hwv>;
			#clock-cells = <1>;
			status = "disabled";
		};

		/*
		 * Hardware voter: collects the clock votes of the AP and the
		 * remote processors, and switches some PLLs, muxes and gates.
		 */
		hwv: syscon@10320000 {
			compatible = "mediatek,mt6897-hwv", "syscon";
			reg = <0 0x10320000 0 0x2000>;
		};

		/*
		 * 8250_mtk needs a "bus" clock next to "baud". uart0 is the 2a
		 * console, so it keeps clk26m there and does not wait for the
		 * clock controllers. TODO(2b): <&pericfg_ao CLK_PERI_AO_UART0>.
		 */
		uart0: serial@11001000 {
			compatible = "mediatek,mt6897-uart", "mediatek,mt6577-uart";
			reg = <0 0x11001000 0 0x1000>;
			interrupts = <GIC_SPI 250 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk26m>, <&clk26m>;
			clock-names = "baud", "bus";
			status = "disabled";
		};

		uart1: serial@11002000 {
			compatible = "mediatek,mt6897-uart", "mediatek,mt6577-uart";
			reg = <0 0x11002000 0 0x1000>;
			interrupts = <GIC_SPI 251 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk26m>, <&pericfg_ao CLK_PERI_AO_UART1>;
			clock-names = "baud", "bus";
			status = "disabled";
		};

		uart2: serial@11003000 {
			compatible = "mediatek,mt6897-uart", "mediatek,mt6577-uart";
			reg = <0 0x11003000 0 0x1000>;
			interrupts = <GIC_SPI 252 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk26m>, <&pericfg_ao CLK_PERI_AO_UART2>;
			clock-names = "baud", "bus";
			status = "disabled";
		};

		/*
		 * UART3 reaches its pads or the UART hub, which this SoC has
		 * but MT6897 boards do not use (stock uarthub-disable).
		 */
		uart3: serial@11004000 {
			compatible = "mediatek,mt6897-uart", "mediatek,mt6577-uart";
			reg = <0 0x11004000 0 0x1000>;
			interrupts = <GIC_SPI 253 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk26m>, <&pericfg_ao CLK_PERI_AO_UART3>;
			clock-names = "baud", "bus";
			mediatek,syscon-pad-mode = <&pericfg_ao 0x50>;
			status = "disabled";
		};

		/*
		 * The SPI masters take their clock from a topckgen mux behind a
		 * pericfg_ao gate. As in the stock tree, spi0-2 run from
		 * mainpll_d6_d2 and spi3-7 from univpll_d6_d2. The stock
		 * mediatek,tickdly sample delays have no mainline property.
		 * TODO(2c): enable with pio and the clock controllers.
		 */
		spi0: spi@11010000 {
			compatible = "mediatek,mt6897-spi", "mediatek,mt6991-spi";
			reg = <0 0x11010000 0 0x100>;
			interrupts = <GIC_SPI 242 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_MAINPLL_D6_D2>,
				 <&topckgen CLK_TOP_SPI0>,
				 <&pericfg_ao CLK_PERI_AO_SPI0_BCLK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			mediatek,pad-select = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		spi1: spi@11011000 {
			compatible = "mediatek,mt6897-spi", "mediatek,mt6991-spi";
			reg = <0 0x11011000 0 0x100>;
			interrupts = <GIC_SPI 243 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_MAINPLL_D6_D2>,
				 <&topckgen CLK_TOP_SPI1>,
				 <&pericfg_ao CLK_PERI_AO_SPI1_BCLK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			mediatek,pad-select = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		spi2: spi@11012000 {
			compatible = "mediatek,mt6897-spi", "mediatek,mt6991-spi";
			reg = <0 0x11012000 0 0x100>;
			interrupts = <GIC_SPI 244 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_MAINPLL_D6_D2>,
				 <&topckgen CLK_TOP_SPI2>,
				 <&pericfg_ao CLK_PERI_AO_SPI2_BCLK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			mediatek,pad-select = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		spi3: spi@11013000 {
			compatible = "mediatek,mt6897-spi", "mediatek,mt6991-spi";
			reg = <0 0x11013000 0 0x100>;
			interrupts = <GIC_SPI 245 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_UNIVPLL_D6_D2>,
				 <&topckgen CLK_TOP_SPI3>,
				 <&pericfg_ao CLK_PERI_AO_SPI3_BCLK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			mediatek,pad-select = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		spi4: spi@11014000 {
			compatible = "mediatek,mt6897-spi", "mediatek,mt6991-spi";
			reg = <0 0x11014000 0 0x100>;
			interrupts = <GIC_SPI 246 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_UNIVPLL_D6_D2>,
				 <&topckgen CLK_TOP_SPI4>,
				 <&pericfg_ao CLK_PERI_AO_SPI4_BCLK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			mediatek,pad-select = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		spi5: spi@11015000 {
			compatible = "mediatek,mt6897-spi", "mediatek,mt6991-spi";
			reg = <0 0x11015000 0 0x100>;
			interrupts = <GIC_SPI 247 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_UNIVPLL_D6_D2>,
				 <&topckgen CLK_TOP_SPI5>,
				 <&pericfg_ao CLK_PERI_AO_SPI5_BCLK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			mediatek,pad-select = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		spi6: spi@11016000 {
			compatible = "mediatek,mt6897-spi", "mediatek,mt6991-spi";
			reg = <0 0x11016000 0 0x100>;
			interrupts = <GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_UNIVPLL_D6_D2>,
				 <&topckgen CLK_TOP_SPI6>,
				 <&pericfg_ao CLK_PERI_AO_SPI6_BCLK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			mediatek,pad-select = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		spi7: spi@11017000 {
			compatible = "mediatek,mt6897-spi", "mediatek,mt6991-spi";
			reg = <0 0x11017000 0 0x100>;
			interrupts = <GIC_SPI 249 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_UNIVPLL_D6_D2>,
				 <&topckgen CLK_TOP_SPI7>,
				 <&pericfg_ao CLK_PERI_AO_SPI7_BCLK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			mediatek,pad-select = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		pericfg_ao: clock-controller@11036000 {
			compatible = "mediatek,mt6897-pericfg-ao", "syscon";
			reg = <0 0x11036000 0 0x1000>;
			mediatek,hardware-voter = <&hwv>;
			#clock-cells = <1>;
			status = "disabled";
		};

		/*
		 * The stock wakeup glue (pericfg_ao 0x200, vendor version 103)
		 * is a different layout from the mainline version 103 (MT8195
		 * IP0), so mediatek,syscon-wakeup and wakeup-source are left out.
		 */
		ssusb: usb@11201000 {
			compatible = "mediatek,mt6897-mtu3", "mediatek,mtu3";
			reg = <0 0x11201000 0 0x2e00>, <0 0x11203e00 0 0x100>;
			reg-names = "mac", "ippc";
			interrupts = <GIC_SPI 160 IRQ_TYPE_LEVEL_HIGH 0>;
			phys = <&u2port0 PHY_TYPE_USB2>, <&u3port0 PHY_TYPE_USB3>;
			/*
			 * MT6897 has no separate ref, mcu or dma clock (the
			 * stock tree gives none); clk26m keeps their places.
			 */
			clocks = <&topckgen CLK_TOP_USB_TOP>, <&clk26m>, <&clk26m>,
				 <&clk26m>, <&topckgen CLK_TOP_SSUSB_XHCI>,
				 <&pericfg_ao CLK_PERI_AO_SSUSB0_FRMCNT>;
			clock-names = "sys_ck", "ref_ck", "mcu_ck", "dma_ck",
				      "xhci_ck", "frmcnt_ck";
			maximum-speed = "super-speed";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			status = "disabled";

			xhci0: usb@11200000 {
				compatible = "mediatek,mt6897-xhci", "mediatek,mtk-xhci";
				reg = <0 0x11200000 0 0x1000>;
				reg-names = "mac";
				interrupts = <GIC_SPI 161 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&clk26m>;
				clock-names = "sys_ck";
				status = "disabled";
			};
		};

		/*
		 * A newer M-PHY revision ("mphy-ver = <1>" in the stock tree)
		 * that takes no clocks and no power sequence from the kernel.
		 * Its reset (ufscfg_ao, MT6897_UFSAO_RST_UFS_MPHY) is left out:
		 * the vendor kernel does not use it either.
		 */
		ufsphy: ufs-phy@112a0000 {
			compatible = "mediatek,mt6897-ufsphy";
			reg = <0 0x112a0000 0 0x10000>;
			#phy-cells = <0>;
			status = "disabled";
		};

		/*
		 * No power domain: the compatible implies the RTFF MTCMOS
		 * power control through the SiP call. The two OPPs are the
		 * vendor's low and high parents of the ufs mux (mainpll_d4_d2,
		 * mmpll_d6) and the aes_ufsfde mux (univpll_d6, mainpll_d4)
		 * behind the main and aes gates; nothing scales them yet.
		 * MCQ also needs the queue interrupts SPI 177-184, which the
		 * UFS binding does not take yet, so start in single doorbell
		 * mode.
		 */
		ufshci: ufshci@112b0000 {
			compatible = "mediatek,mt6897-ufshci";
			reg = <0 0x112b0000 0 0x3000>;
			interrupts = <GIC_SPI 168 IRQ_TYPE_LEVEL_HIGH 0>;
			phys = <&ufsphy>;
			clocks = <&ufscfg_pdn CLK_UFSPDN_UFSHCI_UFS>,
				 <&ufscfg_pdn CLK_UFSPDN_UFSHCI_AES>,
				 <&ufscfg_ao CLK_UFSAO_UNIPRO_SYS>,
				 <&ufscfg_ao CLK_UFSAO_UNIPRO_TX_SYM>,
				 <&ufscfg_ao CLK_UFSAO_UNIPRO_RX_SYM0>,
				 <&ufscfg_ao CLK_UFSAO_UNIPRO_RX_SYM1>;
			clock-names = "main", "aes", "unipro_sysclk", "tx_symbol",
				      "rx_symbol0", "rx_symbol1";
			operating-points-v2 = <&ufs_opp_table>;
			resets = <&ufscfg_pdn MT6897_UFSPDN_RST_UFS_UNIPRO>,
				 <&ufscfg_pdn MT6897_UFSPDN_RST_UFS_CRYPTO>,
				 <&ufscfg_pdn MT6897_UFSPDN_RST_UFSHCI>;
			reset-names = "unipro", "crypto", "hci";
			mediatek,ufs-disable-mcq;
			status = "disabled";

			ufs_opp_table: opp-table {
				compatible = "operating-points-v2";

				opp-273000000 {
					opp-hz = /bits/ 64 <273000000>,
						 /bits/ 64 <416000000>,
						 /bits/ 64 <0>,
						 /bits/ 64 <0>,
						 /bits/ 64 <0>,
						 /bits/ 64 <0>;
				};

				opp-458333313 {
					opp-hz = /bits/ 64 <458333313>,
						 /bits/ 64 <546000000>,
						 /bits/ 64 <0>,
						 /bits/ 64 <0>,
						 /bits/ 64 <0>,
						 /bits/ 64 <0>;
				};
			};
		};

		ufscfg_ao: clock-controller@112b8000 {
			compatible = "mediatek,mt6897-ufscfg-ao", "syscon";
			reg = <0 0x112b8000 0 0x1000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			status = "disabled";
		};

		ufscfg_pdn: clock-controller@112bb000 {
			compatible = "mediatek,mt6897-ufscfg-pdn", "syscon";
			reg = <0 0x112bb000 0 0x1000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			status = "disabled";
		};

		xsphy: xs-phy@11e43000 {
			compatible = "mediatek,mt6897-xsphy", "mediatek,xsphy";
			reg = <0 0x11e43000 0 0x200>;
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			status = "disabled";

			/*
			 * The stock eye settings. The stock internal resistor
			 * calibration (0x25, or the efuse value when set) is left
			 * out: on MT6897 it sits in a field that the mainline
			 * driver does not write.
			 */
			u2port0: usb-phy@11e40000 {
				reg = <0 0x11e40000 0 0x400>;
				clocks = <&clk26m>;
				clock-names = "ref";
				mediatek,eye-vrt = <7>;
				mediatek,eye-term = <3>;
				#phy-cells = <1>;
			};

			u3port0: usb-phy@11e43400 {
				reg = <0 0x11e43400 0 0x500>;
				clocks = <&clk26m>;
				clock-names = "ref";
				#phy-cells = <1>;
			};
		};

		/* TOPRGU, already running when the bootloader hands over */
		watchdog: watchdog@1c00a000 {
			compatible = "mediatek,mt6897-wdt", "mediatek,mt6589-wdt";
			reg = <0 0x1c00a000 0 0x100>;
		};

		vlpckgen: clock-controller@1c013000 {
			compatible = "mediatek,mt6897-vlpckgen", "syscon";
			reg = <0 0x1c013000 0 0x1000>;
			#clock-cells = <1>;
			status = "disabled";
		};

		/*
		 * SPMI 2.0 arbiter with two buses, laid out like MT8196. The
		 * vendor register tables match the upstream MT8195 data. All
		 * six PMICs sit on the M bus (the firmware sets no
		 * spmi-dev-mask): MT6363 @4, MT6368 @5, MT6319 @6-8 and
		 * MT6685 @9. The P bus has nothing on it and stays off.
		 * The driver needs an spmiN alias for each bus.
		 * TODO(2b): enable with pio. MT6897 has no PMIF clock gates
		 * (MT8195 has them in infracfg_ao, fed by pwrap_ulposc), so the
		 * PMIF clocks are the VLP pwrap_ulposc mux itself.
		 */
		spmi: spmi-arbiter@1cc00000 {
			compatible = "mediatek,mt6897-spmi", "mediatek,mt8196-spmi";
			ranges = <0 0 0x1cc00000 0x7000>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			spmi_m: spmi@4000 {
				reg = <0x4000 0x900>, <0x1000 0x100>;
				reg-names = "pmif", "spmimst";
				interrupts-extended = <&pio 248 IRQ_TYPE_LEVEL_HIGH>;
				interrupt-names = "rcs";
				interrupt-controller;
				#interrupt-cells = <3>;
				clocks = <&vlpckgen CLK_VLP_PWRAP_ULPOSC>,
					 <&vlpckgen CLK_VLP_PWRAP_ULPOSC>,
					 <&vlpckgen CLK_VLP_SPMI_M_MST>;
				clock-names = "pmif_sys_ck", "pmif_tmr_ck", "spmimst_clk_mux";
				#address-cells = <2>;
				#size-cells = <0>;
			};

			spmi_p: spmi@6000 {
				reg = <0x6000 0x900>, <0x0 0x100>;
				reg-names = "pmif", "spmimst";
				status = "disabled";
			};
		};

		/*
		 * TODO(2a): the stock kernel does not use the upstream SYST driver,
		 * so enable this broadcast timer only after a first boot works.
		 * Until then the hrtimer broadcast covers deep idle.
		 */
		systimer: timer@1cc10000 {
			compatible = "mediatek,mt6897-timer", "mediatek,mt6765-timer";
			reg = <0 0x1cc10000 0 0x1000>;
			interrupts = <GIC_SPI 330 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk13m>;
			status = "disabled";
		};
	};
};
