			compatible = "mediatek,mt6897-imp-iic-wrap-n", "syscon";
			reg = <0 0x11f02000 0 0x1000>;
			#clock-cells = <1>;
			status = "disabled";
		};

		/*
		 * The display, MDP and video codec clock gates. These blocks only
		 * answer while their power domain is on, so a consumer powers its
		 * domain before it enables a gate. The nodes have no power-domains:
		 * the VEN and MDP domains need gates of these blocks to come up, and
		 * runtime PM would power a domain up and down at probe, with mm-infra
		 * and the screen. The driver touches neither the blocks nor the
		 * domains at probe.
		 *
		 * The display has a dispsys and an ovlsys for each half of the
		 * screen, and these four do the routing as well. A layer starts in
		 * an ovlsys, crosses to its dispsys and leaves there on a DSI link.
		 * The picture quality blocks and the IOMMU stay out of the path: the
		 * scanout memory has to be contiguous and below 4 GiB.
		 * TODO(2c display): enable with the display pipeline. The interrupts
		 * of disp_mutex1 and ovl_mutex1 follow from the distance of the other
		 * blocks; the driver does not use them.
		 */
		dispsys0: syscon@14000000 {
			compatible = "mediatek,mt6897-dispsys0", "syscon";
			reg = <0 0x14000000 0 0x1000>;
			mediatek,hardware-voter = <&hwv>;
			#clock-cells = <1>;
			status = "disabled";
		};

		disp_mutex0: mutex@14001000 {
			compatible = "mediatek,mt6897-disp-mutex";
			reg = <0 0x14001000 0 0x1000>;
			interrupts = <GIC_SPI 354 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&scpsys MT6897_POWER_DOMAIN_DIS0_SHUTDOWN>;
			clocks = <&dispsys0 CLK_DISPSYS0_DISP_MUTEX0>,
				 <&dispsys0 CLK_DISPSYS0_DISPSYS_CONFIG>,
				 <&dispsys0 CLK_DISPSYS0_DISP_DLI_ASYNC0>,
				 <&dispsys0 CLK_DISPSYS0_DISP_DLI_ASYNC1>,
				 <&dispsys0 CLK_DISPSYS0_DISP_DLI_ASYNC2>,
				 <&dispsys0 CLK_DISPSYS0_DISP_DLI_ASYNC3>,
				 <&dispsys0 CLK_DISPSYS0_DISP_DLI_ASYNC4>,
				 <&dispsys0 CLK_DISPSYS0_DISP_DLI_ASYNC5>,
				 <&dispsys0 CLK_DISPSYS0_DISP_DLO_ASYNC0>,
				 <&dispsys0 CLK_DISPSYS0_DISP_DLO_ASYNC1>,
				 <&dispsys0 CLK_DISPSYS0_DISP_RELAY0>,
				 <&dispsys0 CLK_DISPSYS0_26M_CLK>,
				 <&dispsys0 CLK_DISPSYS0_SMI_SUB_COMM0>,
				 <&mminfra CLK_MMINFRA_GCE_D>,
				 <&mminfra CLK_MMINFRA_GCE_M>,
				 <&mminfra CLK_MMINFRA_SMI>,
				 <&mminfra CLK_MMINFRA_GCE_26M>;
			status = "disabled";
		};

		dsc0: dsc@1400c000 {
			compatible = "mediatek,mt6897-disp-dsc";
			reg = <0 0x1400c000 0 0x1000>;
			interrupts = <GIC_SPI 366 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&scpsys MT6897_POWER_DOMAIN_DIS0_SHUTDOWN>;
			clocks = <&dispsys0 CLK_DISPSYS0_DISP_DSC_WRAP0>;
			status = "disabled";
		};

