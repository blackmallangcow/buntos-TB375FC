		ovl_mutex0: mutex@14401000 {
			compatible = "mediatek,mt6897-ovlsys-mutex";
			reg = <0 0x14401000 0 0x1000>;
			interrupts = <GIC_SPI 386 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&scpsys MT6897_POWER_DOMAIN_OVL0_SHUTDOWN>;
			clocks = <&ovlsys0 CLK_OVLSYS0_DISP_MUTEX0>,
				 <&ovlsys0 CLK_OVLSYS0_CONFIG>,
				 <&ovlsys0 CLK_OVLSYS0_DISP_DLI_ASYNC0>,
				 <&ovlsys0 CLK_OVLSYS0_DISP_DLI_ASYNC1>,
				 <&ovlsys0 CLK_OVLSYS0_DISP_DLI_ASYNC2>,
				 <&ovlsys0 CLK_OVLSYS0_DISP_DLO_ASYNC0>,
				 <&ovlsys0 CLK_OVLSYS0_DISP_DLO_ASYNC1>,
				 <&ovlsys0 CLK_OVLSYS0_DISP_DLO_ASYNC2>,
				 <&ovlsys0 CLK_OVLSYS0_DISP_DLO_ASYNC3>,
				 <&ovlsys0 CLK_OVLSYS0_DISP_DLO_ASYNC4>,
				 <&ovlsys0 CLK_OVLSYS0_DISP_DLO_ASYNC5>,
				 <&ovlsys0 CLK_OVLSYS0_DISP_DLO_ASYNC6>,
				 <&ovlsys0 CLK_OVLSYS0_SMI_SUB_COMMON0>;
			status = "disabled";
		};

		ovl_2l0: ovl@14402000 {
			compatible = "mediatek,mt6897-disp-ovl-2l";
			reg = <0 0x14402000 0 0x1000>;
			interrupts = <GIC_SPI 387 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&scpsys MT6897_POWER_DOMAIN_OVL0_SHUTDOWN>;
			clocks = <&ovlsys0 CLK_OVLSYS0_OVL0_2L>;
			status = "disabled";
		};

		ovlsys1: syscon@14600000 {
			compatible = "mediatek,mt6897-ovlsys1", "syscon";
			reg = <0 0x14600000 0 0x1000>;
			mediatek,hardware-voter = <&hwv>;
			#clock-cells = <1>;
			status = "disabled";
		};

		ovl_mutex1: mutex@14601000 {
			compatible = "mediatek,mt6897-ovlsys-mutex";
			reg = <0 0x14601000 0 0x1000>;
			interrupts = <GIC_SPI 430 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&scpsys MT6897_POWER_DOMAIN_OVL1_SHUTDOWN>;
			clocks = <&ovlsys1 CLK_OVLSYS1_DISP_MUTEX0>,
				 <&ovlsys1 CLK_OVLSYS1_CONFIG>,
				 <&ovlsys1 CLK_OVLSYS1_DISP_DLI_ASYNC0>,
				 <&ovlsys1 CLK_OVLSYS1_DISP_DLI_ASYNC1>,
				 <&ovlsys1 CLK_OVLSYS1_DISP_DLI_ASYNC2>,
				 <&ovlsys1 CLK_OVLSYS1_DISP_DLO_ASYNC0>,
				 <&ovlsys1 CLK_OVLSYS1_DISP_DLO_ASYNC1>,
				 <&ovlsys1 CLK_OVLSYS1_DISP_DLO_ASYNC2>,
				 <&ovlsys1 CLK_OVLSYS1_DISP_DLO_ASYNC3>,
				 <&ovlsys1 CLK_OVLSYS1_DISP_DLO_ASYNC4>,
				 <&ovlsys1 CLK_OVLSYS1_DISP_DLO_ASYNC5>,
				 <&ovlsys1 CLK_OVLSYS1_DISP_DLO_ASYNC6>,
				 <&ovlsys1 CLK_OVLSYS1_SMI_SUB_COMMON0>;
			status = "disabled";
		};

		ovl_2l1: ovl@14602000 {
			compatible = "mediatek,mt6897-disp-ovl-2l";
			reg = <0 0x14602000 0 0x1000>;
			interrupts = <GIC_SPI 431 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&scpsys MT6897_POWER_DOMAIN_OVL1_SHUTDOWN>;
			clocks = <&ovlsys1 CLK_OVLSYS1_OVL0_2L>;
			status = "disabled";
		};

		/*
		 * Video decoder: a front end (LAT) behind larb5 and the display-side
		 * IOMMU, and a core behind larb4 and the MDP IOMMU. The firmware of
		 * the video coprocessor parses the bitstream and drives the
		 * registers. The kernel gives power, clocks, memory and interrupts.
		 * The two IOMMUs share one page table; the child node only makes
		 * the display-side one aware of the front end.
		 */
		vdec: video-codec@16000000 {
			compatible = "mediatek,mt6897-vcodec-dec";
			reg = <0 0x16000000 0 0x1000>,
			      <0 0x1602f000 0 0x1000>,
			      <0 0x16020000 0 0x1000>,
			      <0 0x16021000 0 0x1000>,
			      <0 0x16023000 0 0x1000>,
			      <0 0x16025000 0 0x4000>,
			      <0 0x16010000 0 0x1000>,
			      <0 0x16011000 0 0x400>,
			      <0 0x1600f000 0 0x1000>,
			      <0 0x16004000 0 0x1000>,
			      <0 0x16012000 0 0x1000>,
			      <0 0x16022000 0 0x1000>,
			      <0 0x16015800 0 0x1000>;
			reg-names = "base", "sys", "vld", "mc", "mv", "misc",
				    "lat-misc", "lat-vld", "soc-gcon",
				    "racing-ctrl", "lat-avc-vld", "avc-vld",
				    "av1-vld";
			interrupts = <GIC_SPI 701 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 704 IRQ_TYPE_LEVEL_HIGH 0>;
			interrupt-names = "core", "lat";
			clocks = <&vdecsys_soc CLK_VDE1_VDEC_CKEN>,
				 <&vdecsys_soc CLK_VDE1_LAT_CKEN>,
				 <&vdecsys CLK_VDE2_VDEC_CKEN>,
				 <&topckgen CLK_TOP_VDEC>;
			clock-names = "soc", "lat", "core", "sel";
			power-domains = <&scpsys MT6897_POWER_DOMAIN_VDE0>,
					<&scpsys MT6897_POWER_DOMAIN_VDE1>;
			power-domain-names = "lat", "core";
			iommus = <&mdp_iommu M4U_PORT_L4_HW_VDEC_MC_EXT>,
				 <&mdp_iommu M4U_PORT_L4_HW_VDEC_UFO_EXT>,
				 <&mdp_iommu M4U_PORT_L4_HW_VDEC_PP_EXT>,
				 <&mdp_iommu M4U_PORT_L4_HW_VDEC_UFO_ENC_EXT>,
				 <&mdp_iommu M4U_PORT_L4_HW_VDEC_PRED_RD_EXT>,
				 <&mdp_iommu M4U_PORT_L4_HW_VDEC_PRED_WR_EXT>,
				 <&mdp_iommu M4U_PORT_L4_HW_VDEC_PPWRAP_EXT>,
				 <&mdp_iommu M4U_PORT_L4_HW_VDEC_TILE_EXT>,
				 <&mdp_iommu M4U_PORT_L4_HW_VDEC_VLD_EXT>,
				 <&mdp_iommu M4U_PORT_L4_HW_VDEC_VLD2_EXT>,
				 <&mdp_iommu M4U_PORT_L4_HW_VDEC_AVC_MV_EXT>;
			mediatek,vcp = <&vcp>;
			status = "disabled";

			lat {
				compatible = "mediatek,mt6897-vcodec-dec-lat";
				iommus = <&disp_iommu M4U_PORT_L5_HW_VDEC_LAT0_VLD_EXT>,
					 <&disp_iommu M4U_PORT_L5_HW_VDEC_LAT0_VLD2_EXT>,
					 <&disp_iommu M4U_PORT_L5_HW_VDEC_LAT0_AVC_MV_EXT>,
					 <&disp_iommu M4U_PORT_L5_HW_VDEC_LAT0_MC_EXT>,
					 <&disp_iommu M4U_PORT_L5_HW_VDEC_LAT0_PRED_RD_EXT>,
					 <&disp_iommu M4U_PORT_L5_HW_VDEC_LAT0_TILE_EXT>,
					 <&disp_iommu M4U_PORT_L5_HW_VDEC_LAT0_WDMA_EXT>,
					 <&disp_iommu M4U_PORT_L5_HW_VDEC_LAT0_UFO_ENC_EXT>,
					 <&disp_iommu M4U_PORT_L5_HW_VDEC_LAT0_UFO_ENC_C_EXT>;
			};
		};

		/*
		 * Video decoder front end. The larb answers only while the VDE0
		 * domain is on; its clocks are the gates of the front end.
		 */
		larb5: larb@1600d000 {
			compatible = "mediatek,mt6897-smi-larb";
			reg = <0 0x1600d000 0 0x1000>;
			mediatek,larb-id = <5>;
			mediatek,smi = <&smi_disp_common>;
			clocks = <&vdecsys_soc CLK_VDE1_VDEC_CKEN>,
				 <&vdecsys_soc CLK_VDE1_LAT_CKEN>;
			clock-names = "apb", "smi";
			power-domains = <&scpsys MT6897_POWER_DOMAIN_VDE0>;
			status = "disabled";
		};

		vdecsys_soc: clock-controller@1600f000 {
			compatible = "mediatek,mt6897-vdecsys-soc", "syscon";
			reg = <0 0x1600f000 0 0x1000>;
			#clock-cells = <1>;
			status = "disabled";
		};

		/*
		 * Video decoder core. The larb answers only while the VDE1
		 * domain is on, and its clock is the gate of the core.
		 */
		larb4: larb@1602e000 {
			compatible = "mediatek,mt6897-smi-larb";
			reg = <0 0x1602e000 0 0x1000>;
			mediatek,larb-id = <4>;
			mediatek,smi = <&smi_mdp_common>;
			clocks = <&vdecsys CLK_VDE2_VDEC_CKEN>,
				 <&vdecsys CLK_VDE2_VDEC_CKEN>;
			clock-names = "apb", "smi";
			power-domains = <&scpsys MT6897_POWER_DOMAIN_VDE1>;
			status = "disabled";
		};

		vdecsys: clock-controller@1602f000 {
			compatible = "mediatek,mt6897-vdecsys", "syscon";
			reg = <0 0x1602f000 0 0x1000>;
			#clock-cells = <1>;
			status = "disabled";
		};

		vencsys: clock-controller@17000000 {
			compatible = "mediatek,mt6897-vencsys", "syscon";
			reg = <0 0x17000000 0 0x1000>;
			#clock-cells = <1>;
			status = "disabled";
		};

		vencsys_c1: clock-controller@17800000 {
			compatible = "mediatek,mt6897-vencsys-c1", "syscon";
			reg = <0 0x17800000 0 0x1000>;
			#clock-cells = <1>;
			status = "disabled";
		};

		/*
		 * Camera clock blocks. They answer only while their power domains
		 * are on, and the CAM_VCORE and CAM_MAIN domains take gates of
		 * them to come up, so they carry no power-domains property.
		 */
		camsys_main: clock-controller@1a000000 {
			compatible = "mediatek,mt6897-camsys-main", "syscon";
			reg = <0 0x1a000000 0 0x1000>;
			#clock-cells = <1>;
			status = "disabled";
		};

		/*
		 * Sensor interface, the CSI-2 receiver. The second region holds
		 * the CSI RX analog front ends, the D-PHY and the CSI-2 MACs.
		 */
		seninf: seninf@1a00e000 {
			compatible = "mediatek,mt6897-seninf";
			reg = <0 0x1a00e000 0 0x18000>, <0 0x11c80000 0 0x30000>;
			reg-names = "base", "ana-rx";
			interrupts = <GIC_SPI 502 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&camsys_main CLK_CAM_MAIN_SENINF>,
				 <&camsys_main CLK_CAM_MAIN_CAM>,
				 <&camsys_main CLK_CAM_MAIN_CAMTG>,
				 <&topckgen CLK_TOP_CAMTM>,
				 <&topckgen CLK_TOP_SENINF>;
			clock-names = "seninf", "cam", "camtg", "camtm", "csi";
			assigned-clocks = <&topckgen CLK_TOP_SENINF>;
			assigned-clock-rates = <312000000>;
			power-domains = <&scpsys MT6897_POWER_DOMAIN_CAM_MAIN>,
					<&scpsys MT6897_POWER_DOMAIN_CSI_RX>;
			power-domain-names = "cam-main", "csi-rx";
			nvmem-cells = <&csi_trim0>;
			nvmem-cell-names = "csi0";
			mediatek,vcp = <&vcp>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				seninf_port0: port@0 {
					reg = <0>;
				};
			};
		};

		cam_vcore: clock-controller@1b204000 {
			compatible = "mediatek,mt6897-cam-vcore", "syscon";
			reg = <0 0x1b204000 0 0x1000>;
			#clock-cells = <1>;
			status = "disabled";
		};

		/*
		 * System Power Manager. A domain joins here with its first
		 * consumer. The driver does not touch a domain at probe and
		 * cannot touch one that is not listed, which keeps the display
		 * domains as the bootloader left them while the screen runs on
		 * simple-framebuffer. Before any consumer under mm-infra joins,
		 * the framebuffer has to hold the display domains with
		 * power-domains: genpd powers mm-infra off with its last user.
		 * TODO(2d): enable with the first consumer.
		 */
		spm: syscon@1c001000 {
			compatible = "mediatek,mt6897-scpsys", "syscon", "simple-mfd";
			reg = <0 0x1c001000 0 0x1000>;
			status = "disabled";

			scpsys: power-controller {
				compatible = "mediatek,mt6897-power-controller";
				access-controllers = <&ifr_bus>, <&vlpcfg_bus>;
				mediatek,hardware-voter = <&hwv>;
				#address-cells = <1>;
				#size-cells = <0>;
				#power-domain-cells = <1>;

				power-domain@MT6897_POWER_DOMAIN_AUDIO {
					reg = <MT6897_POWER_DOMAIN_AUDIO>;
					clocks = <&topckgen CLK_TOP_AUD_INTBUS>,
						 <&pericfg_ao CLK_PERI_AO_AUDIO_SLV_CK>,
						 <&pericfg_ao CLK_PERI_AO_AUDIO_MST_CK>,
						 <&pericfg_ao CLK_PERI_AO_AUDIO_INTBUS_CK>;
					clock-names = "audio", "audio-0", "audio-1", "audio-2";
					#power-domain-cells = <0>;
				};

				power-domain@MT6897_POWER_DOMAIN_CONN {
					reg = <MT6897_POWER_DOMAIN_CONN>;
					#power-domain-cells = <0>;
				};
			};
		};

		/*
		 * Wi-Fi and Bluetooth/GNSS common part. The bootloader looks these
		 * nodes up by their paths, without their unit addresses, and does
		 * not read their status. Only when it finds consys, wifi, gps and
		 * connscp, all of them, does it carve out the firmware memory, load
		 * the firmware and write emi-addr here and memory-region in the
		 * wifi node, so the sizes below are what it reads. gps and connscp
		 * stay out of this tree until the bring-up, which keeps the
		 * bootloader away from all of this before then.
		 * TODO(2d): add them and enable these.
		 */
		wifi: wifi@18000000 {
			compatible = "mediatek,mt6897-wifi";
			reg = <0 0x18000000 0 0x700000>,
			      <0 0x10001000 0 0x1000>;
			interrupts = <GIC_SPI 889 IRQ_TYPE_LEVEL_HIGH 0>;
			mediatek,connsys = <&consys>;
			emi-size = <0x1400000>;
			emi-alignment = <0x1000000>;
			emi-max-addr = <0xc0000000>;
			status = "disabled";
		};

		consys: consys@18001000 {
			compatible = "mediatek,mt6897-consys";
			reg = <0 0x18001000 0 0x1000>,
			      <0 0x11b20000 0 0x1000>;
			reg-names = "cfg-on", "iocfg-rt";
			power-domains = <&scpsys MT6897_POWER_DOMAIN_CONN>;
			emi-addr = /bits/ 64 <0>;
			emi-size = <0xc00000>;
			ro-emi-size = <0x680000>;
			rw-emi-size = <0x480000>;
			ro-bt-emi-size = <0x2e0000>;
			ro-gps-emi-size = <0xa0000>;
			ro-wifi-emi-size = <0x300000>;
			emi-alignment = <0x100000>;
			emi-max-addr = <0x90000000>;
			status = "disabled";
		};

		/*
		 * The Bluetooth radio. The bootloader has no use for this node;
		 * what it loads for it depends on the consys and wifi nodes above.
		 * TODO(2d): enable this after those.
		 */
		bluetooth: bluetooth@18800000 {
			compatible = "mediatek,mt6897-bluetooth";
			reg = <0 0x18800000 0 0x21000>,
			      <0 0x18000000 0 0x80000>;
			reg-names = "bgf", "conn";
			interrupts = <GIC_SPI 614 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 891 IRQ_TYPE_LEVEL_HIGH 0>;
			interrupt-names = "sw", "bus-hang";
			mediatek,connsys = <&consys>;
			status = "disabled";
		};

		/*
		 * Mali-G615 MC6. Power, clocks and voltages are the GPUEB's. No
		 * dma-coherent: the vendor kernel needs a TF-A call to keep the
		 * DSU up for it, which nothing here makes. No ASN hash either.
		 */
		gpu: gpu@13000000 {
			compatible = "mediatek,mt6897-mali", "arm,mali-valhall-csf";
			reg = <0 0x13000000 0 0x480000>;
			clocks = <&gpueb 0>, <&gpueb 1>;
			clock-names = "core", "stacks";
			interrupts = <GIC_SPI 586 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 585 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 584 IRQ_TYPE_LEVEL_HIGH 0>;
			interrupt-names = "job", "mmu", "gpu";
			nvmem-cells = <&gpu_shader_present>;
			nvmem-cell-names = "shader-present";
			power-domains = <&gpueb>;
			#cooling-cells = <2>;
			status = "disabled";
		};

		/*
		 * The name matters: the boot firmware adds the shared memory to the
		 * node at /soc/gpueb. The firmware itself comes from the gpueb
		 * partition, loaded and started by the boot firmware.
		 */
		gpueb: gpueb@13c2fd1c {
			compatible = "mediatek,mt6897-gpufreq";
			reg = <0 0x13c2fd1c 0 0x64>,
			      <0 0x1c001f00 0 0x4>;
			reg-names = "gpr", "mfg0-pwr";
			mboxes = <&gpueb_mbox 0>, <&gpueb_mbox 1>, <&gpueb_mbox 2>,
				 <&gpueb_mbox 3>, <&gpueb_mbox 4>, <&gpueb_mbox 5>,
				 <&gpueb_mbox 7>;
			mbox-names = "fast-dvfs-event", "gpufreq", "sleep", "timer",
				     "fhctl", "ccf", "fast-dvfs";
			#clock-cells = <1>;
			#nvmem-cell-cells = <0>;
			#power-domain-cells = <0>;
			status = "disabled";

			gpu_shader_present: shader-present {
			};
		};

		gpueb_mbox: mailbox@13c2fd80 {
			compatible = "mediatek,mt6897-gpueb-mbox";
			reg = <0 0x13c2fd80 0 0x280>,
			      <0 0x13c62000 0 0x7c>;
			reg-names = "data", "ctl";
			interrupts = <GIC_SPI 588 IRQ_TYPE_LEVEL_HIGH 0>;
			#mbox-cells = <1>;
			status = "disabled";
		};

		lvts_gpu: thermal-sensor@13ff0000 {
			compatible = "mediatek,mt6897-lvts-gpu";
			reg = <0 0x13ff0000 0 0x1000>;
			interrupts = <GIC_SPI 592 IRQ_TYPE_LEVEL_HIGH 0>;
			nvmem-cells = <&lvts_calib1>, <&lvts_calib2>,
				      <&lvts_calib3>, <&lvts_calib4>;
			nvmem-cell-names = "lvts-calib-data-1", "lvts-calib-data-2",
					   "lvts-calib-data-3", "lvts-calib-data-4";
			#thermal-sensor-cells = <1>;
			status = "disabled";
		};

		lvts_apu: thermal-sensor@19004000 {
			compatible = "mediatek,mt6897-lvts-apu";
			reg = <0 0x19004000 0 0x1000>;
			interrupts = <GIC_SPI 635 IRQ_TYPE_LEVEL_HIGH 0>;
			nvmem-cells = <&lvts_calib1>, <&lvts_calib2>,
				      <&lvts_calib3>, <&lvts_calib4>;
			nvmem-cell-names = "lvts-calib-data-1", "lvts-calib-data-2",
					   "lvts-calib-data-3", "lvts-calib-data-4";
			#thermal-sensor-cells = <1>;
			status = "disabled";
		};

		/* TOPRGU, already running when the bootloader hands over */
		watchdog: watchdog@1c00a000 {
			compatible = "mediatek,mt6897-wdt", "mediatek,mt6589-wdt";
			reg = <0 0x1c00a000 0 0x100>;
		};

		/* Bus protection registers, disabled like ifr_bus */
		vlpcfg_bus: syscon@1c00c000 {
			compatible = "mediatek,mt6897-vlpcfg-bus", "syscon";
			reg = <0 0x1c00c000 0 0x1000>;
			status = "disabled";
		};

		keypad: keypad@1c00e000 {
			compatible = "mediatek,mt6897-keypad", "mediatek,mt6779-keypad";
			reg = <0 0x1c00e000 0 0x1000>;
			interrupts = <GIC_SPI 138 IRQ_TYPE_EDGE_RISING 0>;
			clocks = <&clk26m>;
			clock-names = "kpd";
			status = "disabled";
		};

		/*
		 * Collects the requests for core voltage and memory clock. The
		 * stock video firmware asks it for a voltage level before it
		 * decodes a frame. The secure monitor turns it on when the
		 * driver asks; until then voltage and memory clock stay where
		 * the bootloader left them.
		 */
		dvfsrc: system-controller@1c00f000 {
			compatible = "mediatek,mt6897-dvfsrc";
			reg = <0 0x1c00f000 0 0x1000>;
			clocks = <&vlpckgen CLK_VLP_DVFSRC>;
			status = "disabled";
		};

		vlpckgen: clock-controller@1c013000 {
			compatible = "mediatek,mt6897-vlpckgen", "syscon";
			reg = <0 0x1c013000 0 0x1000>;
			#clock-cells = <1>;
			status = "disabled";
		};

		/*
		 * SPMI 2.0 arbiter with two buses, laid out like MT8196. The
		 * vendor register tables match the upstream MT8195 data. All
		 * six PMICs sit on the M bus (the firmware sets no
		 * spmi-dev-mask): MT6363 @4, MT6368 @5, MT6319 @6-8 and
		 * MT6685 @9. The P bus has nothing on it and stays off.
		 * The driver needs an spmiN alias for each bus.
		 * TODO(2b): enable with pio. MT6897 has no PMIF clock gates
		 * (MT8195 has them in infracfg_ao, fed by pwrap_ulposc), so the
		 * PMIF clocks are the VLP pwrap_ulposc mux itself.
		 */
		spmi: spmi-arbiter@1cc00000 {
			compatible = "mediatek,mt6897-spmi", "mediatek,mt8196-spmi";
			ranges = <0 0 0x1cc00000 0x7000>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			spmi_m: spmi@4000 {
				reg = <0x4000 0x900>, <0x1000 0x100>;
				reg-names = "pmif", "spmimst";
				interrupts-extended = <&pio 248 IRQ_TYPE_LEVEL_HIGH>;
				interrupt-names = "rcs";
				interrupt-controller;
				#interrupt-cells = <3>;
				clocks = <&vlpckgen CLK_VLP_PWRAP_ULPOSC>,
					 <&vlpckgen CLK_VLP_PWRAP_ULPOSC>,
					 <&vlpckgen CLK_VLP_SPMI_M_MST>;
				clock-names = "pmif_sys_ck", "pmif_tmr_ck", "spmimst_clk_mux";
				#address-cells = <2>;
				#size-cells = <0>;
			};

			spmi_p: spmi@6000 {
				reg = <0x6000 0x900>, <0x0 0x100>;
				reg-names = "pmif", "spmimst";
				status = "disabled";
			};
		};

		/*
		 * TODO(2a): the stock kernel does not use the upstream SYST driver,
		 * so enable this broadcast timer only after a first boot works.
		 * Until then the hrtimer broadcast covers deep idle.
		 */
		systimer: timer@1cc10000 {
			compatible = "mediatek,mt6897-timer", "mediatek,mt6765-timer";
			reg = <0 0x1cc10000 0 0x1000>;
			interrupts = <GIC_SPI 330 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk13m>;
		};

		mminfra: clock-controller@1e800000 {
			compatible = "mediatek,mt6897-mminfra", "syscon";
			reg = <0 0x1e800000 0 0x1000>;
			mediatek,hardware-voter = <&hwv>;
			#clock-cells = <1>;
			status = "disabled";
		};

		/*
		 * The display-side common and IOMMU. Most of the display runs
		 * through them from the bootloader on, with the MMU bits of its
		 * larb ports cleared. The only master named here is the front
		 * end of the video decoder (larb5), and neither driver writes
		 * anything before it attaches.
		 */
		smi_disp_common: smi@1e801000 {
			compatible = "mediatek,mt6897-smi-common";
			reg = <0 0x1e801000 0 0x1000>;
			clocks = <&mminfra CLK_MMINFRA_GCE_D>,
				 <&mminfra CLK_MMINFRA_GCE_M>,
				 <&mminfra CLK_MMINFRA_SMI>,
				 <&mminfra CLK_MMINFRA_GCE_26M>;
			clock-names = "apb", "smi", "gals0", "gals1";
			power-domains = <&scpsys MT6897_POWER_DOMAIN_MM_INFRA>;
			status = "disabled";
		};

		disp_iommu: iommu@1e802000 {
			compatible = "mediatek,mt6897-iommu-disp";
			reg = <0 0x1e802000 0 0x1000>;
			interrupts = <GIC_SPI 442 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&mminfra CLK_MMINFRA_SMI>;
			clock-names = "bclk";
			power-domains = <&scpsys MT6897_POWER_DOMAIN_MM_INFRA>;
			mediatek,larbs = <&larb5>;
			#iommu-cells = <1>;
			status = "disabled";
		};

		/*
		 * The display runs through this common and this IOMMU from the
		 * bootloader on, with the MMU bits of its larb ports cleared
		 * (larb1, larb20 and larb32 are on this side). Neither driver
		 * writes anything before a master attaches.
		 */
		smi_mdp_common: smi@1e80f000 {
			compatible = "mediatek,mt6897-smi-common";
			reg = <0 0x1e80f000 0 0x1000>;
			clocks = <&mminfra CLK_MMINFRA_GCE_D>,
				 <&mminfra CLK_MMINFRA_GCE_M>,
				 <&mminfra CLK_MMINFRA_SMI>,
				 <&mminfra CLK_MMINFRA_GCE_26M>;
			clock-names = "apb", "smi", "gals0", "gals1";
			power-domains = <&scpsys MT6897_POWER_DOMAIN_MM_INFRA>;
			status = "disabled";
		};

		mdp_iommu: iommu@1e810000 {
			compatible = "mediatek,mt6897-iommu-mdp";
			reg = <0 0x1e810000 0 0x1000>;
			interrupts = <GIC_SPI 447 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&mminfra CLK_MMINFRA_SMI>;
			clock-names = "bclk";
			power-domains = <&scpsys MT6897_POWER_DOMAIN_MM_INFRA>;
			mediatek,larbs = <&larb4>;
			#iommu-cells = <1>;
			status = "disabled";
		};

		/*
		 * Video coprocessor (VCP): a RISC-V core that runs the video
		 * codec firmware. The bootloader loads the firmware and the
		 * secure monitor releases the reset. Its power domain and its
		 * clock are left on by the bootloader. Its memory accesses go
		 * through the MDP IOMMU without an SMI larb.
		 */
		vcp: vcp@1ea00000 {
			compatible = "mediatek,mt6897-vcp";
			reg = <0 0x1ea00000 0 0x40000>,
			      <0 0x1ec24000 0 0x1000>,
			      <0 0x1ec30000 0 0x1000>,
			      <0 0x1ecfb000 0 0x110>,
			      <0 0x1ecfc000 0 0x110>,
			      <0 0x1ecfd000 0 0x110>,
			      <0 0x1ecfe000 0 0x110>,
			      <0 0x1ecff000 0 0x110>;
			reg-names = "sram", "cfg", "core0",
				    "mbox0", "mbox1", "mbox2", "mbox3", "mbox4";
			interrupts = <GIC_SPI 857 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 859 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 860 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 861 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 862 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 863 IRQ_TYPE_LEVEL_HIGH 0>;
			interrupt-names = "wdt", "mbox0", "mbox1", "mbox2",
					  "mbox3", "mbox4";
			clocks = <&topckgen CLK_TOP_MMUP>,
				 <&topckgen CLK_TOP_MAINPLL_D3>,
				 <&clk26m>;
			clock-names = "mmup-sel", "mmup-clk", "mmup-26m";
			power-domains = <&scpsys MT6897_POWER_DOMAIN_MM_PROC_DORMANT>;
			iommus = <&mdp_iommu M4U_PORT_L31_VIDEO_UP>;
			status = "disabled";
		};

		mdpsys0: clock-controller@1f000000 {
			compatible = "mediatek,mt6897-mdpsys0", "syscon";
			reg = <0 0x1f000000 0 0x1000>;
			#clock-cells = <1>;
			status = "disabled";
		};

		mdpsys1: clock-controller@1f800000 {
			compatible = "mediatek,mt6897-mdpsys1", "syscon";
			reg = <0 0x1f800000 0 0x1000>;
			#clock-cells = <1>;
			status = "disabled";
		};
	};
};
