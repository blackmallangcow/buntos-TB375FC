// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
/*
 * MediaTek MT6897 (Dimensity 8300, sold as MT8792 in tablets) SoC
 *
 * Copyright (c) 2026 buntOS contributors
 *
 * Register and interrupt values come from the SoC device tree in the
 * Lenovo TB373FU/TB375FC stock firmware and were checked against the
 * MediaTek downstream mt6897.dts and the community port
 * https://github.com/u0n0u/tb375fc-linux. Blocks that need the missing
 * clock, pinctrl and power domain drivers are described but disabled.
 */

#include <dt-bindings/thermal/thermal.h>
#include <dt-bindings/clock/mediatek,mt6897-clock.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/memory/mediatek,mt6897-memory-port.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/power/mediatek,mt6897-power.h>
#include <dt-bindings/reset/mediatek,mt6897-resets.h>
#include <dt-bindings/thermal/mediatek,lvts-thermal.h>

/ {
	compatible = "mediatek,mt6897";
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	/*
	 * mediatek-drm finds the blocks of the display by these. The numbers of
	 * the display controllers are in mt6897_main_controllers of mtk_drm_drv.c.
	 */
	aliases {
		dsc0 = &dsc0;
		dsc1 = &dsc1;
		dsi0 = &dsi0;
		dsi1 = &dsi1;
		mmsys0 = &dispsys0;
		mmsys1 = &dispsys1;
		mmsys2 = &ovlsys0;
		mmsys3 = &ovlsys1;
		mutex0 = &disp_mutex0;
		mutex1 = &disp_mutex1;
		mutex2 = &ovl_mutex0;
		mutex3 = &ovl_mutex1;
		ovl-2l0 = &ovl_2l0;
		ovl-2l1 = &ovl_2l1;
	};

	clk26m: oscillator-26m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "clk26m";
	};

	clk13m: fixed-factor-clock-13m {
		compatible = "fixed-factor-clock";
		#clock-cells = <0>;
		clocks = <&clk26m>;
		clock-div = <2>;
		clock-mult = <1>;
		clock-output-names = "clk13m";
	};

	/* The stock firmware gives 32000 Hz, not 32768 */
	clk32k: oscillator-32k {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32000>;
		clock-output-names = "clk32k";
	};

	/* On-chip ultra low power oscillator, the osc_dN dividers' parent */
	ulposc: oscillator-ulposc {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <588000000>;
		clock-output-names = "ulposc";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a510";
			reg = <0x000>;
			enable-method = "psci";
			performance-domains = <&performance 0>;
			capacity-dmips-mhz = <338>;
			#cooling-cells = <2>;
			cpu-idle-states = <&cpu_off_l &cluster_off_l>;
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a510";
			reg = <0x100>;
			enable-method = "psci";
			performance-domains = <&performance 0>;
			capacity-dmips-mhz = <338>;
			#cooling-cells = <2>;
			cpu-idle-states = <&cpu_off_l &cluster_off_l>;
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a510";
			reg = <0x200>;
			enable-method = "psci";
			performance-domains = <&performance 0>;
			capacity-dmips-mhz = <338>;
			#cooling-cells = <2>;
			cpu-idle-states = <&cpu_off_l &cluster_off_l>;
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a510";
			reg = <0x300>;
			enable-method = "psci";
			performance-domains = <&performance 0>;
			capacity-dmips-mhz = <338>;
			#cooling-cells = <2>;
			cpu-idle-states = <&cpu_off_l &cluster_off_l>;
		};

		cpu4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a715";
			reg = <0x400>;
			enable-method = "psci";
			performance-domains = <&performance 1>;
			capacity-dmips-mhz = <1080>;
			#cooling-cells = <2>;
			cpu-idle-states = <&cpu_off_m &cluster_off_m>;
		};

		cpu5: cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a715";
			reg = <0x500>;
			enable-method = "psci";
			performance-domains = <&performance 1>;
			capacity-dmips-mhz = <1080>;
			#cooling-cells = <2>;
			cpu-idle-states = <&cpu_off_m &cluster_off_m>;
		};

		cpu6: cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a715";
			reg = <0x600>;
			enable-method = "psci";
			performance-domains = <&performance 1>;
			capacity-dmips-mhz = <1080>;
			#cooling-cells = <2>;
			cpu-idle-states = <&cpu_off_m &cluster_off_m>;
		};

		cpu7: cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-a715";
			reg = <0x700>;
			enable-method = "psci";
			performance-domains = <&performance 2>;
			capacity-dmips-mhz = <1024>;
			#cooling-cells = <2>;
			cpu-idle-states = <&cpu_off_b &cluster_off_b>;
		};

		/* One DynamIQ cluster; the three DVFS domains are performance-domains */
		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};

				core1 {
					cpu = <&cpu1>;
				};

				core2 {
					cpu = <&cpu2>;
				};

				core3 {
					cpu = <&cpu3>;
				};

				core4 {
					cpu = <&cpu4>;
				};

				core5 {
					cpu = <&cpu5>;
				};

				core6 {
					cpu = <&cpu6>;
				};

				core7 {
					cpu = <&cpu7>;
				};
			};
		};

		/*
		 * Only the CPU and cluster power-down states. The deeper MCUSYS
		 * and system states are coordinated by the SPM and need its
		 * driver first.
		 */
		idle-states {
			entry-method = "psci";

			cpu_off_l: cpu-off-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00010000>;
				local-timer-stop;
				entry-latency-us = <126>;
				exit-latency-us = <251>;
				min-residency-us = <5700>;
			};

			cpu_off_m: cpu-off-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00010000>;
				local-timer-stop;
				entry-latency-us = <77>;
				exit-latency-us = <179>;
				min-residency-us = <2520>;
			};

			cpu_off_b: cpu-off-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00010000>;
				local-timer-stop;
				entry-latency-us = <52>;
				exit-latency-us = <129>;
				min-residency-us = <1890>;
			};

			cluster_off_l: cluster-off-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010001>;
				local-timer-stop;
				entry-latency-us = <143>;
				exit-latency-us = <420>;
				min-residency-us = <5700>;
			};

			cluster_off_m: cluster-off-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010001>;
				local-timer-stop;
				entry-latency-us = <82>;
				exit-latency-us = <253>;
				min-residency-us = <3020>;
			};

			cluster_off_b: cluster-off-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010001>;
				local-timer-stop;
				entry-latency-us = <46>;
				exit-latency-us = <150>;
				min-residency-us = <2460>;
			};
		};
	};

	/*
	 * The fuses as the boot firmware passes them on. The cell offsets are in
	 * that copy (atag,devinfo), not in the efuse block at 0x11e80000.
	 */
	efuse: efuse {
		compatible = "mediatek,mt6897-devinfo";
		status = "disabled";

		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			/* Termination trims of CSI port 0, for the seninf */
			csi_trim0: csi-trim@1d4 {
				reg = <0x1d4 0x4>;
			};

			lvts_calib2: calib@2d4 {
				reg = <0x2d4 0x28>;
			};

			lvts_calib4: calib@2fc {
				reg = <0x2fc 0x10>;
			};

			lvts_calib1: calib@310 {
				reg = <0x310 0x38>;
			};

			lvts_calib3: calib@364 {
				reg = <0x364 0x4>;
			};
		};
	};

	pmu-a510 {
		compatible = "arm,cortex-a510-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
	};

	pmu-a715 {
		compatible = "arm,cortex-a715-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH &ppi_cluster1>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	/*
	 * The bootloader adds its fixed carve-outs (ATF, TEE, GenieZone,
	 * connsys, framebuffer, ...) here at boot.
	 */
	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
	};

	thermal-zones {
		cpu4-0-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_MEDIUM_CPU4_0>;

			trips {
				cpu4_0_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu4_0_alert>;
					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu4-1-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_MEDIUM_CPU4_1>;

			trips {
				cpu4_1_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu4_1_alert>;
					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu5-0-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_MEDIUM_CPU5_0>;

			trips {
				cpu5_0_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu5_0_alert>;
					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu5-1-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_MEDIUM_CPU5_1>;

			trips {
				cpu5_1_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu5_1_alert>;
					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu2-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_LITTLE_CPU2>;

			trips {
				cpu2_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu2_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu3-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_LITTLE_CPU3>;

			trips {
				cpu3_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu3_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu6-0-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_MEDIUM_CPU6_0>;

			trips {
				cpu6_0_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu6_0_alert>;
					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu6-1-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_MEDIUM_CPU6_1>;

			trips {
				cpu6_1_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu6_1_alert>;
					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		dsu0-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_DSU0>;

			trips {
				dsu0_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&dsu0_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu0-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_LITTLE_CPU0>;

			trips {
				cpu0_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu0_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu1-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_LITTLE_CPU1>;

			trips {
				cpu1_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu1_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		dsu1-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_DSU1>;

			trips {
				dsu1_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&dsu1_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu7-0-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_BIG_CPU7_0>;

			trips {
				cpu7_0_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu7_0_alert>;
					cooling-device = <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu7-1-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_BIG_CPU7_1>;

			trips {
				cpu7_1_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu7_1_alert>;
					cooling-device = <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		dsu2-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_DSU2>;

			trips {
				dsu2_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&dsu2_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		dsu3-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_DSU3>;

			trips {
				dsu3_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&dsu3_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		soc-top0-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_ap MT6897_AP_TOP0>;

			trips {
				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		soc-top1-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_ap MT6897_AP_TOP1>;

			trips {
				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		soc-top2-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_ap MT6897_AP_TOP2>;

			trips {
				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		soc-top3-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_ap MT6897_AP_TOP3>;

			trips {
				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		soc-bot0-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_ap MT6897_AP_BOT0>;

			trips {
				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		soc-bot1-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_ap MT6897_AP_BOT1>;

			trips {
				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		soc-bot2-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_ap MT6897_AP_BOT2>;

			trips {
				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		soc-bot3-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_ap MT6897_AP_BOT3>;

			trips {
				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		md0-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_ap MT6897_AP_MD0>;

			trips {
				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		md1-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_ap MT6897_AP_MD1>;

			trips {
				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		md2-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_ap MT6897_AP_MD2>;

			trips {
				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		md3-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_ap MT6897_AP_MD3>;

			trips {
				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		apu0-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_apu MT6897_APU0>;

			trips {
				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		apu1-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_apu MT6897_APU1>;

			trips {
				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		gpu0-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_gpu MT6897_GPU0>;

			trips {
				gpu0_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&gpu0_alert>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		gpu1-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <150>;
			thermal-sensors = <&lvts_gpu MT6897_GPU1>;

			trips {
				gpu1_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&gpu1_alert>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
	};

	timer: timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_HIGH 0>;
		clock-frequency = <13000000>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		dma-ranges = <0 0 0 0 0x10 0>;

		/* CPU DVFS in the MCUPM, one register bank per frequency domain */
		performance: performance-controller@11bc10 {
			compatible = "mediatek,cpufreq-hw";
			reg = <0 0x0011bc10 0 0x120>,
			      <0 0x0011bd30 0 0x120>,
			      <0 0x0011be50 0 0x120>;
			#performance-domain-cells = <1>;
		};

		/* Needed before the firmware accepts PSCI CPU_SUSPEND */
		mcupm@c0bf600 {
			compatible = "mediatek,mt6897-mcupm";
			reg = <0 0x0c0bf600 0 0xa00>;
		};

		/*
		 * Unlike MT8183..MT8195 the GIC is not at 0x0c000000: that
		 * range is MCUSYS (mcucfg, CPU PLLs, MCUPM at 0x0c070000).
		 * Both the shipped SoC tree and the tree the bootloader hands
		 * to the kernel use this base, as does the community port.
		 */
		gic: interrupt-controller@c400000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <4>;
			#redistributor-regions = <1>;
			interrupt-parent = <&gic>;
			interrupt-controller;
			reg = <0 0x0c400000 0 0x40000>,
			      <0 0x0c440000 0 0x200000>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH 0>;

			ppi-partitions {
				ppi_cluster0: interrupt-partition-0 {
					affinity = <&cpu0 &cpu1 &cpu2 &cpu3>;
				};

				ppi_cluster1: interrupt-partition-1 {
					affinity = <&cpu4 &cpu5 &cpu6 &cpu7>;
				};
			};
		};

		/*
		 * The clock controllers stay off in 2a, which runs on the clocks
		 * the bootloader left on. TODO(2b): enable all six together with
		 * pio and SPMI, keeping clk_ignore_unused on the command line.
		 */
		topckgen: clock-controller@10000000 {
			compatible = "mediatek,mt6897-topckgen", "syscon";
			reg = <0 0x10000000 0 0x1000>;
			mediatek,hardware-voter = <&hwv>;
			#clock-cells = <1>;
			status = "disabled";
		};

		/*
		 * 232 GPIOs and the five EINT blocks. EINTs 232-249 have no
		 * pin; the driver gives them virtual GPIOs (the SPMI rcs
		 * interrupt is EINT 248). TODO(2b): enable together with SPMI.
		 */
		pio: pinctrl@10005000 {
			compatible = "mediatek,mt6897-pinctrl";
			reg = <0 0x10005000 0 0x1000>,
			      <0 0x11b20000 0 0x1000>,
			      <0 0x11c00000 0 0x1000>,
			      <0 0x11d30000 0 0x1000>,
			      <0 0x11d40000 0 0x1000>,
			      <0 0x11d50000 0 0x1000>,
			      <0 0x11ea0000 0 0x1000>,
			      <0 0x11eb0000 0 0x1000>,
			      <0 0x11f20000 0 0x1000>,
			      <0 0x11f30000 0 0x1000>,
			      <0 0x11ce0000 0 0x1000>,
			      <0 0x11de0000 0 0x1000>,
			      <0 0x11e90000 0 0x1000>,
			      <0 0x11fe0000 0 0x1000>,
			      <0 0x1c01e000 0 0x1000>;
			reg-names = "base", "rt", "rm", "bl", "bm", "br",
				    "lb", "lt", "tm", "tl", "eint-e", "eint-s",
				    "eint-w", "eint-n", "eint-c";
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pio 0 0 232>;
			interrupt-controller;
			interrupts = <GIC_SPI 309 IRQ_TYPE_LEVEL_HIGH 0>;
			#interrupt-cells = <2>;
			status = "disabled";
		};

		apmixedsys: clock-controller@1000c000 {
			compatible = "mediatek,mt6897-apmixedsys", "syscon";
			reg = <0 0x1000c000 0 0x1000>;
			mediatek,hardware-voter = <&hwv>;
			#clock-cells = <1>;
			status = "disabled";
		};

		/*
		 * Bus protection registers of the power domains, which take them
		 * as a regmap. They stay disabled: nothing binds to a plain
		 * syscon, and fw_devlink would make the power controller wait
		 * for it through access-controllers until the deferred probe
		 * timeout.
		 */
		ifr_bus: syscon@1002c000 {
			compatible = "mediatek,mt6897-ifr-bus", "syscon";
			reg = <0 0x1002c000 0 0x1000>;
			status = "disabled";
		};

		/*
		 * Hardware voter: collects the clock votes of the AP and the
		 * remote processors, and switches some PLLs, muxes and gates,
		 * and some of the power domains.
		 */
		lvts_ap: thermal-sensor@10315000 {
			compatible = "mediatek,mt6897-lvts-ap";
			reg = <0 0x10315000 0 0x1000>;
			interrupts = <GIC_SPI 264 IRQ_TYPE_LEVEL_HIGH 0>;
			nvmem-cells = <&lvts_calib1>, <&lvts_calib2>,
				      <&lvts_calib3>, <&lvts_calib4>;
			nvmem-cell-names = "lvts-calib-data-1", "lvts-calib-data-2",
					   "lvts-calib-data-3", "lvts-calib-data-4";
			#thermal-sensor-cells = <1>;
			status = "disabled";
		};

		lvts_mcu: thermal-sensor@10316000 {
			compatible = "mediatek,mt6897-lvts-mcu";
			reg = <0 0x10316000 0 0x1000>;
			interrupts = <GIC_SPI 265 IRQ_TYPE_LEVEL_HIGH 0>;
			nvmem-cells = <&lvts_calib1>, <&lvts_calib2>,
				      <&lvts_calib3>, <&lvts_calib4>;
			nvmem-cell-names = "lvts-calib-data-1", "lvts-calib-data-2",
					   "lvts-calib-data-3", "lvts-calib-data-4";
			#thermal-sensor-cells = <1>;
			status = "disabled";
		};

		hwv: syscon@10320000 {
			compatible = "mediatek,mt6897-hwv", "syscon";
			reg = <0 0x10320000 0 0x2000>;
		};

		/*
		 * 8250_mtk needs a "bus" clock next to "baud". uart0 is the 2a
		 * console, so it keeps clk26m there and does not wait for the
		 * clock controllers. TODO(2b): <&pericfg_ao CLK_PERI_AO_UART0>.
		 */
		uart0: serial@11001000 {
			compatible = "mediatek,mt6897-uart", "mediatek,mt6577-uart";
			reg = <0 0x11001000 0 0x1000>;
			interrupts = <GIC_SPI 250 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk26m>, <&clk26m>;
			clock-names = "baud", "bus";
			status = "disabled";
		};

		uart1: serial@11002000 {
			compatible = "mediatek,mt6897-uart", "mediatek,mt6577-uart";
			reg = <0 0x11002000 0 0x1000>;
			interrupts = <GIC_SPI 251 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk26m>, <&pericfg_ao CLK_PERI_AO_UART1>;
			clock-names = "baud", "bus";
			status = "disabled";
		};

		uart2: serial@11003000 {
			compatible = "mediatek,mt6897-uart", "mediatek,mt6577-uart";
			reg = <0 0x11003000 0 0x1000>;
			interrupts = <GIC_SPI 252 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk26m>, <&pericfg_ao CLK_PERI_AO_UART2>;
			clock-names = "baud", "bus";
			status = "disabled";
		};

		/*
		 * UART3 reaches its pads or the UART hub, which this SoC has
		 * but MT6897 boards do not use (stock uarthub-disable).
		 */
		uart3: serial@11004000 {
			compatible = "mediatek,mt6897-uart", "mediatek,mt6577-uart";
			reg = <0 0x11004000 0 0x1000>;
			interrupts = <GIC_SPI 253 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk26m>, <&pericfg_ao CLK_PERI_AO_UART3>;
			clock-names = "baud", "bus";
			mediatek,syscon-pad-mode = <&pericfg_ao 0x50>;
			status = "disabled";
		};

		disp_pwm0: pwm@1100e000 {
			compatible = "mediatek,mt6897-disp-pwm", "mediatek,mt8183-disp-pwm";
			reg = <0 0x1100e000 0 0x1000>;
			interrupts = <GIC_SPI 254 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_DISP_PWM>,
				 <&pericfg_ao CLK_PERI_AO_DISP_PWM0>;
			clock-names = "main", "mm";
			#pwm-cells = <2>;
			status = "disabled";
		};

		/*
		 * The SPI masters take their clock from a topckgen mux behind a
		 * pericfg_ao gate. As in the stock tree, spi0-2 run from
		 * mainpll_d6_d2 and spi3-7 from univpll_d6_d2. The stock
		 * mediatek,tickdly sample delays have no mainline property.
		 * TODO(2c): enable with pio and the clock controllers.
		 */
		spi0: spi@11010000 {
			compatible = "mediatek,mt6897-spi", "mediatek,mt6991-spi";
			reg = <0 0x11010000 0 0x100>;
			interrupts = <GIC_SPI 242 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_MAINPLL_D6_D2>,
				 <&topckgen CLK_TOP_SPI0>,
				 <&pericfg_ao CLK_PERI_AO_SPI0_BCLK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			mediatek,pad-select = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		spi1: spi@11011000 {
			compatible = "mediatek,mt6897-spi", "mediatek,mt6991-spi";
			reg = <0 0x11011000 0 0x100>;
			interrupts = <GIC_SPI 243 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_MAINPLL_D6_D2>,
				 <&topckgen CLK_TOP_SPI1>,
				 <&pericfg_ao CLK_PERI_AO_SPI1_BCLK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			mediatek,pad-select = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		spi2: spi@11012000 {
			compatible = "mediatek,mt6897-spi", "mediatek,mt6991-spi";
			reg = <0 0x11012000 0 0x100>;
			interrupts = <GIC_SPI 244 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_MAINPLL_D6_D2>,
				 <&topckgen CLK_TOP_SPI2>,
				 <&pericfg_ao CLK_PERI_AO_SPI2_BCLK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			mediatek,pad-select = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		spi3: spi@11013000 {
			compatible = "mediatek,mt6897-spi", "mediatek,mt6991-spi";
			reg = <0 0x11013000 0 0x100>;
			interrupts = <GIC_SPI 245 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_UNIVPLL_D6_D2>,
				 <&topckgen CLK_TOP_SPI3>,
				 <&pericfg_ao CLK_PERI_AO_SPI3_BCLK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			mediatek,pad-select = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		spi4: spi@11014000 {
			compatible = "mediatek,mt6897-spi", "mediatek,mt6991-spi";
			reg = <0 0x11014000 0 0x100>;
			interrupts = <GIC_SPI 246 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_UNIVPLL_D6_D2>,
				 <&topckgen CLK_TOP_SPI4>,
				 <&pericfg_ao CLK_PERI_AO_SPI4_BCLK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			mediatek,pad-select = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		spi5: spi@11015000 {
			compatible = "mediatek,mt6897-spi", "mediatek,mt6991-spi";
			reg = <0 0x11015000 0 0x100>;
			interrupts = <GIC_SPI 247 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_UNIVPLL_D6_D2>,
				 <&topckgen CLK_TOP_SPI5>,
				 <&pericfg_ao CLK_PERI_AO_SPI5_BCLK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			mediatek,pad-select = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		spi6: spi@11016000 {
			compatible = "mediatek,mt6897-spi", "mediatek,mt6991-spi";
			reg = <0 0x11016000 0 0x100>;
			interrupts = <GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_UNIVPLL_D6_D2>,
				 <&topckgen CLK_TOP_SPI6>,
				 <&pericfg_ao CLK_PERI_AO_SPI6_BCLK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			mediatek,pad-select = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		spi7: spi@11017000 {
			compatible = "mediatek,mt6897-spi", "mediatek,mt6991-spi";
			reg = <0 0x11017000 0 0x100>;
			interrupts = <GIC_SPI 249 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&topckgen CLK_TOP_UNIVPLL_D6_D2>,
				 <&topckgen CLK_TOP_SPI7>,
				 <&pericfg_ao CLK_PERI_AO_SPI7_BCLK>;
			clock-names = "parent-clk", "sel-clk", "spi-clk";
			mediatek,pad-select = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		pericfg_ao: clock-controller@11036000 {
			compatible = "mediatek,mt6897-pericfg-ao", "syscon";
			reg = <0 0x11036000 0 0x1000>;
			mediatek,hardware-voter = <&hwv>;
			#clock-cells = <1>;
			status = "disabled";
		};

		afe: audio-controller@11050000 {
			compatible = "mediatek,mt6897-afe";
			reg = <0 0x11050000 0 0x9000>;
			interrupts = <GIC_SPI 257 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&scpsys MT6897_POWER_DOMAIN_AUDIO>;
			mediatek,topckgen = <&topckgen>;
			clocks = <&topckgen CLK_TOP_AUD_INTBUS>,
				 <&topckgen CLK_TOP_AUDIO_H>,
				 <&topckgen CLK_TOP_AUD_1>,
				 <&topckgen CLK_TOP_AUD_2>,
				 <&topckgen CLK_TOP_AUD_ENGEN1>,
				 <&topckgen CLK_TOP_AUD_ENGEN2>,
				 <&apmixedsys CLK_APMIXED_APLL1>,
				 <&apmixedsys CLK_APMIXED_APLL2>,
				 <&topckgen CLK_TOP_APLL1_D2>,
				 <&topckgen CLK_TOP_APLL2_D2>,
				 <&topckgen CLK_TOP_APLL1_D4>,
				 <&topckgen CLK_TOP_APLL2_D4>,
				 <&clk26m>;
			clock-names = "top_aud_intbus", "top_aud_h",
				      "top_aud_1", "top_aud_2",
				      "top_aud_eng1", "top_aud_eng2",
				      "apll1", "apll2",
				      "apll1_d2", "apll2_d2",
				      "apll1_d4", "apll2_d4",
				      "clk26m";
			status = "disabled";
		};

		/*
		 * The stock wakeup glue (pericfg_ao 0x200, vendor version 103)
		 * is a different layout from the mainline version 103 (MT8195
		 * IP0), so mediatek,syscon-wakeup and wakeup-source are left out.
		 */
		ssusb: usb@11201000 {
			compatible = "mediatek,mt6897-mtu3", "mediatek,mtu3";
			reg = <0 0x11201000 0 0x2e00>, <0 0x11203e00 0 0x100>;
			reg-names = "mac", "ippc";
			interrupts = <GIC_SPI 160 IRQ_TYPE_LEVEL_HIGH 0>;
			phys = <&u2port0 PHY_TYPE_USB2>, <&u3port0 PHY_TYPE_USB3>;
			/*
			 * MT6897 has no separate ref, mcu or dma clock (the
			 * stock tree gives none); clk26m keeps their places.
			 */
			clocks = <&topckgen CLK_TOP_USB_TOP>, <&clk26m>, <&clk26m>,
				 <&clk26m>, <&topckgen CLK_TOP_SSUSB_XHCI>,
				 <&pericfg_ao CLK_PERI_AO_SSUSB0_FRMCNT>;
			clock-names = "sys_ck", "ref_ck", "mcu_ck", "dma_ck",
				      "xhci_ck", "frmcnt_ck";
			maximum-speed = "super-speed";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			status = "disabled";

			xhci0: usb@11200000 {
				compatible = "mediatek,mt6897-xhci", "mediatek,mtk-xhci";
				reg = <0 0x11200000 0 0x1000>;
				reg-names = "mac";
				interrupts = <GIC_SPI 161 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&clk26m>;
				clock-names = "sys_ck";
				status = "disabled";
			};
		};

		/*
		 * The I2C controllers and their clock gates from here on, in address
		 * order with the other blocks. Like the other clock controllers, the
		 * gates stay off until something uses them. As in the stock tree,
		 * only i2c6 has its pins set by the kernel; the bootloader muxes the
		 * rest, so nothing here changes them.
		 */
		i2c6: i2c@11280000 {
			compatible = "mediatek,mt6897-i2c", "mediatek,mt8188-i2c";
			reg = <0 0x11280000 0 0x1000>, <0 0x11300600 0 0x80>;
			interrupts = <GIC_SPI 192 IRQ_TYPE_LEVEL_HIGH 0>;
			clock-div = <1>;
			clocks = <&imp_iic_wrap_c CLK_IMPC_I2C6>,
				 <&pericfg_ao CLK_PERI_AO_DMA_BCLK>;
			clock-names = "main", "dma";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		imp_iic_wrap_c: clock-controller@11281000 {
			compatible = "mediatek,mt6897-imp-iic-wrap-c", "syscon";
			reg = <0 0x11281000 0 0x1000>;
			#clock-cells = <1>;
			status = "disabled";
		};

		/*
		 * A newer M-PHY revision ("mphy-ver = <1>" in the stock tree)
		 * that takes no clocks and no power sequence from the kernel.
		 * Its reset (ufscfg_ao, MT6897_UFSAO_RST_UFS_MPHY) is left out:
		 * the vendor kernel does not use it either.
		 */
		ufsphy: ufs-phy@112a0000 {
			compatible = "mediatek,mt6897-ufsphy";
			reg = <0 0x112a0000 0 0x10000>;
			#phy-cells = <0>;
			status = "disabled";
		};

		/*
		 * No power domain: the compatible implies the RTFF MTCMOS
		 * power control through the SiP call. The two OPPs are the
		 * vendor's low and high parents of the ufs mux (mainpll_d4_d2,
		 * mmpll_d6) and the aes_ufsfde mux (univpll_d6, mainpll_d4)
		 * behind the main and aes gates; nothing scales them yet.
		 * MCQ also needs the queue interrupts SPI 177-184, which the
		 * UFS binding does not take yet, so start in single doorbell
		 * mode.
		 */
		ufshci: ufshci@112b0000 {
			compatible = "mediatek,mt6897-ufshci";
			reg = <0 0x112b0000 0 0x3000>;
			interrupts = <GIC_SPI 168 IRQ_TYPE_LEVEL_HIGH 0>;
			phys = <&ufsphy>;
			clocks = <&ufscfg_pdn CLK_UFSPDN_UFSHCI_UFS>,
				 <&ufscfg_pdn CLK_UFSPDN_UFSHCI_AES>,
				 <&ufscfg_ao CLK_UFSAO_UNIPRO_SYS>,
				 <&ufscfg_ao CLK_UFSAO_UNIPRO_TX_SYM>,
				 <&ufscfg_ao CLK_UFSAO_UNIPRO_RX_SYM0>,
				 <&ufscfg_ao CLK_UFSAO_UNIPRO_RX_SYM1>;
			clock-names = "main", "aes", "unipro_sysclk", "tx_symbol",
				      "rx_symbol0", "rx_symbol1";
			operating-points-v2 = <&ufs_opp_table>;
			resets = <&ufscfg_pdn MT6897_UFSPDN_RST_UFS_UNIPRO>,
				 <&ufscfg_pdn MT6897_UFSPDN_RST_UFS_CRYPTO>,
				 <&ufscfg_pdn MT6897_UFSPDN_RST_UFSHCI>;
			reset-names = "unipro", "crypto", "hci";
			mediatek,ufs-disable-mcq;
			status = "disabled";

			ufs_opp_table: opp-table {
				compatible = "operating-points-v2";

				opp-273000000 {
					opp-hz = /bits/ 64 <273000000>,
						 /bits/ 64 <416000000>,
						 /bits/ 64 <0>,
						 /bits/ 64 <0>,
						 /bits/ 64 <0>,
						 /bits/ 64 <0>;
				};

				opp-458333313 {
					opp-hz = /bits/ 64 <458333313>,
						 /bits/ 64 <546000000>,
						 /bits/ 64 <0>,
						 /bits/ 64 <0>,
						 /bits/ 64 <0>,
						 /bits/ 64 <0>;
				};
			};
		};

		ufscfg_ao: clock-controller@112b8000 {
			compatible = "mediatek,mt6897-ufscfg-ao", "syscon";
			reg = <0 0x112b8000 0 0x1000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			status = "disabled";
		};

		ufscfg_pdn: clock-controller@112bb000 {
			compatible = "mediatek,mt6897-ufscfg-pdn", "syscon";
			reg = <0 0x112bb000 0 0x1000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			status = "disabled";
		};

