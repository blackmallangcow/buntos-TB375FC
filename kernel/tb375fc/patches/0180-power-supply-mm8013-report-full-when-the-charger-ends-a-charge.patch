From: buntOS contributors
Subject: [PATCH] power: supply: mm8013: report full when the charger ends a charge

A charger that stops under the voltage that the gauge calls full ends
the charge without the gauge noticing. On a Lenovo TB375FC the charger
reported Full for the 15 minutes watched and UPower stayed at charging
with 0 W. UPower takes that state from the status of the battery, so
the gauge must have gone on saying Charging.

Report Full when a supplier does, as rt5033_battery and max17040_battery
take their status from their supplier. Tell user space when a supplier
changes, as UPower would otherwise wait for its next poll.

A supplier can say so too early. The MT6375 ends a charge on a low
current anywhere above where charging comes back, which is 73 % on this
battery, and its driver only puts that right at its next look, up to 10
seconds later. Do not believe it under 90 %, where UPower does not take
a battery that says nothing for full either.

On the device the gauge said Full as the charger ended a charge, and
UPower went to fully-charged within 30 seconds.

---
 drivers/power/supply/mm8013.c | 35 +++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/drivers/power/supply/mm8013.c b/drivers/power/supply/mm8013.c
index 7c50696..8eb8239 100644
--- a/drivers/power/supply/mm8013.c
+++ b/drivers/power/supply/mm8013.c
@@ -50,6 +50,12 @@
 #define MM8013_RETRY_DELAY_US		10000
 #define MM8013_READ_TRIES		3
 
+/*
+ * Under this, a charger that says a charge ended is not believed. UPower has
+ * the same threshold for a battery that does not say what it is doing.
+ */
+#define MM8013_ENDED_MIN_CAPACITY	90
+
 struct mm8013_chip {
 	struct i2c_client *client;
 	struct regmap *regmap;
@@ -108,6 +114,29 @@ static u32 mm8013_fillable_uah(struct mm8013_chip *chip, u32 mah)
 	return 10 * mah * chip->charged_soc;
 }
 
+/*
+ * A charge that ends under the voltage that the gauge calls full does not set
+ * its full flag, and it goes on saying that it charges. Only the charger knows.
+ * That one can say so too early, on the low current as a source comes up.
+ */
+static bool mm8013_charge_ended(struct mm8013_chip *chip,
+				struct power_supply *psy)
+{
+	union power_supply_propval status;
+	int capacity;
+
+	if (power_supply_get_property_from_supplier(psy,
+						    POWER_SUPPLY_PROP_STATUS,
+						    &status))
+		return false;
+
+	if (status.intval != POWER_SUPPLY_STATUS_FULL)
+		return false;
+
+	return !mm8013_read_capacity(chip, &capacity) &&
+	       capacity >= MM8013_ENDED_MIN_CAPACITY;
+}
+
 static enum power_supply_property mm8013_battery_props[] = {
 	POWER_SUPPLY_PROP_CAPACITY,
 	POWER_SUPPLY_PROP_CHARGE_FULL,
@@ -215,6 +244,11 @@ static int mm8013_get_property(struct power_supply *psy,
 		val->intval = ((s16)regval > 0);
 		break;
 	case POWER_SUPPLY_PROP_STATUS:
+		if (mm8013_charge_ended(chip, psy)) {
+			val->intval = POWER_SUPPLY_STATUS_FULL;
+			break;
+		}
+
 		ret = regmap_read(chip->regmap, REG_FLAGS, &regval);
 		if (ret < 0)
 			return ret;
@@ -279,6 +313,7 @@ static const struct power_supply_desc mm8013_desc = {
 	.properties		= mm8013_battery_props,
 	.num_properties		= ARRAY_SIZE(mm8013_battery_props),
 	.get_property		= mm8013_get_property,
+	.external_power_changed	= power_supply_changed,
 };
 
 static int mm8013_reg_read(void *context, unsigned int reg, unsigned int *val)
