+
+static inline struct sc820cs *to_sc820cs(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct sc820cs, sd);
+}
+
+/* The order and the delays are those of the vendor driver */
+static int sc820cs_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct sc820cs *sensor = to_sc820cs(sd);
+	int ret;
+
+	gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+
+	ret = clk_prepare_enable(sensor->mclk);
+	if (ret) {
+		dev_err(dev, "failed to enable MCLK: %d\n", ret);
+		return ret;
+	}
+
+	ret = regulator_enable(sensor->dovdd);
+	if (ret) {
+		dev_err(dev, "failed to enable DOVDD: %d\n", ret);
+		goto err_mclk;
+	}
+	fsleep(5 * USEC_PER_MSEC);
+
+	ret = regulator_enable(sensor->dvdd);
+	if (ret) {
+		dev_err(dev, "failed to enable DVDD: %d\n", ret);
+		goto err_dovdd;
+	}
+	fsleep(9 * USEC_PER_MSEC);
+
+	ret = regulator_enable(sensor->avdd);
+	if (ret) {
+		dev_err(dev, "failed to enable AVDD: %d\n", ret);
+		goto err_dvdd;
+	}
+	fsleep(5 * USEC_PER_MSEC);
+
+	gpiod_set_value_cansleep(sensor->reset_gpio, 0);
+	fsleep(5 * USEC_PER_MSEC);
+
+	return 0;
+
+err_dvdd:
+	regulator_disable(sensor->dvdd);
+err_dovdd:
+	regulator_disable(sensor->dovdd);
+err_mclk:
+	clk_disable_unprepare(sensor->mclk);
+	return ret;
+}
+
+static int sc820cs_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct sc820cs *sensor = to_sc820cs(sd);
+
+	gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+	regulator_disable(sensor->avdd);
+	regulator_disable(sensor->dvdd);
+	regulator_disable(sensor->dovdd);
+	clk_disable_unprepare(sensor->mclk);
+
+	return 0;
+}
+
+static int sc820cs_set_gain(struct sc820cs *sensor, u32 gain)
+{
+	unsigned int i;
+	u32 fine;
+	int ret = 0;
+
+	for (i = ARRAY_SIZE(sc820cs_gain_steps) - 1; i > 0; i--)
+		if (gain >= sc820cs_gain_steps[i].gain)
+			break;
+
+	fine = gain * SC820CS_GAIN_UNIT / sc820cs_gain_steps[i].gain;
+
+	cci_write(sensor->regmap, SC820CS_REG_GAIN_COARSE,
+		  sc820cs_gain_steps[i].code, &ret);
+	cci_write(sensor->regmap, SC820CS_REG_GAIN_FINE, (fine >> 3) & 0xff,
+		  &ret);
+
+	return ret;
+}
+
+static int sc820cs_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sc820cs *sensor = container_of(ctrl->handler, struct sc820cs,
+					      ctrls);
+	const struct v4l2_mbus_framefmt *format;
+	struct v4l2_subdev_state *state;
+	int ret = 0;
+
+	state = v4l2_subdev_get_locked_active_state(&sensor->sd);
+	format = v4l2_subdev_state_get_format(state, 0);
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 exposure_max = format->height + ctrl->val -
+				   SC820CS_EXPOSURE_MARGIN;
+
+		ret = __v4l2_ctrl_modify_range(sensor->exposure,
+					       sensor->exposure->minimum,
+					       exposure_max,
+					       sensor->exposure->step,
+					       min_t(s64, sensor->exposure->val,
+						     exposure_max));
+		if (ret)
+			return ret;
+	}
+
+	/* Only write the registers while the sensor is powered */
+	if (!pm_runtime_get_if_active(sensor->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(sensor->regmap, SC820CS_REG_EXPOSURE,
+			  (ctrl->val * 2) << 4, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = sc820cs_set_gain(sensor, ctrl->val);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(sensor->regmap, SC820CS_REG_VTS,
+			  format->height + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		if (ctrl->val)
+			cci_multi_reg_write(sensor->regmap,
+					    sc820cs_test_pattern_on,
+					    ARRAY_SIZE(sc820cs_test_pattern_on),
+					    &ret);
+		else
+			cci_multi_reg_write(sensor->regmap,
+					    sc820cs_test_pattern_off,
+					    ARRAY_SIZE(sc820cs_test_pattern_off),
+					    &ret);
+		break;
+	default:
+		break;
+	}
+
+	pm_runtime_put_autosuspend(sensor->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops sc820cs_ctrl_ops = {
+	.s_ctrl = sc820cs_set_ctrl,
+};
+
+static int sc820cs_update_mode_controls(struct sc820cs *sensor,
+					const struct sc820cs_mode *mode)
+{
+	s64 hblank = SC820CS_HTS - mode->width;
+	s64 exposure_max = mode->vts_def - SC820CS_EXPOSURE_MARGIN;
+	int ret;
+
+	ret = __v4l2_ctrl_modify_range(sensor->vblank,
+				       mode->vts_def - mode->height,
+				       SC820CS_VTS_MAX - mode->height, 1,
+				       mode->vts_def - mode->height);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(sensor->vblank, mode->vts_def - mode->height);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_modify_range(sensor->hblank, hblank, hblank, 1,
+				       hblank);
+	if (ret)
+		return ret;
+
+	return __v4l2_ctrl_modify_range(sensor->exposure, SC820CS_EXPOSURE_MIN,
+					exposure_max, SC820CS_EXPOSURE_STEP,
+					exposure_max);
+}
+
+static int sc820cs_enable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct sc820cs *sensor = to_sc820cs(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_multi_reg_write(sensor->regmap, sc820cs_init_regs,
+				  ARRAY_SIZE(sc820cs_init_regs), NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_multi_reg_write(sensor->regmap, sensor->mode->regs,
+				  sensor->mode->num_regs, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&sensor->ctrls);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(sensor->regmap, SC820CS_REG_STREAM, 1, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(sensor->dev);
+	return ret;
+}
+
+static int sc820cs_disable_streams(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state, u32 pad,
+				   u64 streams_mask)
+{
+	struct sc820cs *sensor = to_sc820cs(sd);
+	int ret;
+
+	ret = cci_write(sensor->regmap, SC820CS_REG_STREAM, 0, NULL);
+	if (ret)
+		dev_err(sensor->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(sensor->dev);
+
+	return ret;
+}
+
+static void sc820cs_update_format(const struct sc820cs_mode *mode,
+				  struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = SC820CS_MBUS_CODE;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int sc820cs_set_format(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state,
+			      struct v4l2_subdev_format *fmt)
+{
+	struct sc820cs *sensor = to_sc820cs(sd);
+	const struct sc820cs_mode *mode;
+	int ret;
+
+	mode = v4l2_find_nearest_size(sc820cs_modes, ARRAY_SIZE(sc820cs_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+
+	sc820cs_update_format(mode, &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	*v4l2_subdev_state_get_crop(state, 0) = mode->crop;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		return 0;
+
+	ret = sc820cs_update_mode_controls(sensor, mode);
+	if (ret)
+		return ret;
+
+	sensor->mode = mode;
+
+	return 0;
+}
+
+static int sc820cs_enum_mbus_code(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = SC820CS_MBUS_CODE;
+
+	return 0;
+}
+
+static int sc820cs_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->code != SC820CS_MBUS_CODE)
+		return -EINVAL;
+
+	if (fse->index >= ARRAY_SIZE(sc820cs_modes))
+		return -EINVAL;
+
+	fse->min_width = sc820cs_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = sc820cs_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int sc820cs_get_selection(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = SC820CS_NATIVE_WIDTH;
+		sel->r.height = SC820CS_NATIVE_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int sc820cs_init_state(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.code = SC820CS_MBUS_CODE,
+			.width = SC820CS_DEFAULT_MODE->width,
+			.height = SC820CS_DEFAULT_MODE->height,
+		},
+	};
+
+	return sc820cs_set_format(sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops sc820cs_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops sc820cs_pad_ops = {
+	.enum_mbus_code = sc820cs_enum_mbus_code,
+	.enum_frame_size = sc820cs_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = sc820cs_set_format,
+	.get_selection = sc820cs_get_selection,
+	.enable_streams = sc820cs_enable_streams,
+	.disable_streams = sc820cs_disable_streams,
+};
+
+static const struct v4l2_subdev_ops sc820cs_subdev_ops = {
+	.video = &sc820cs_video_ops,
+	.pad = &sc820cs_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops sc820cs_internal_ops = {
+	.init_state = sc820cs_init_state,
+};
+
+static int sc820cs_init_controls(struct sc820cs *sensor)
+{
+	const struct sc820cs_mode *mode = SC820CS_DEFAULT_MODE;
+	struct v4l2_ctrl_handler *hdl = &sensor->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	s64 pixel_rate, hblank, exposure_max;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+
+	sensor->link_freq = v4l2_ctrl_new_int_menu(hdl, &sc820cs_ctrl_ops,
+						   V4L2_CID_LINK_FREQ,
+						   ARRAY_SIZE(sc820cs_link_freqs) - 1,
+						   0, sc820cs_link_freqs);
+	if (sensor->link_freq)
+		sensor->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	pixel_rate = div_u64(sc820cs_link_freqs[0] * 2 * SC820CS_DATA_LANES,
+			     SC820CS_BPP);
+	sensor->pixel_rate = v4l2_ctrl_new_std(hdl, &sc820cs_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE, pixel_rate,
+					       pixel_rate, 1, pixel_rate);
+
+	hblank = SC820CS_HTS - mode->width;
+	sensor->hblank = v4l2_ctrl_new_std(hdl, &sc820cs_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank, hblank, 1,
+					   hblank);
+	if (sensor->hblank)
+		sensor->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sensor->vblank = v4l2_ctrl_new_std(hdl, &sc820cs_ctrl_ops,
+					   V4L2_CID_VBLANK,
+					   mode->vts_def - mode->height,
+					   SC820CS_VTS_MAX - mode->height, 1,
+					   mode->vts_def - mode->height);
+
+	exposure_max = mode->vts_def - SC820CS_EXPOSURE_MARGIN;
+	sensor->exposure = v4l2_ctrl_new_std(hdl, &sc820cs_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     SC820CS_EXPOSURE_MIN, exposure_max,
+					     SC820CS_EXPOSURE_STEP,
+					     exposure_max);
+
+	v4l2_ctrl_new_std(hdl, &sc820cs_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  SC820CS_GAIN_MIN, SC820CS_GAIN_MAX, SC820CS_GAIN_STEP,
+			  SC820CS_GAIN_MIN);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &sc820cs_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(sc820cs_test_pattern_menu) - 1,
+				     0, 0, sc820cs_test_pattern_menu);
+
+	ret = v4l2_fwnode_device_parse(sensor->dev, &props);
+	if (ret)
+		goto err_free;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &sc820cs_ctrl_ops, &props);
+	if (ret)
+		goto err_free;
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto err_free;
+	}
+
+	sensor->sd.ctrl_handler = hdl;
+
+	return 0;
+
+err_free:
+	v4l2_ctrl_handler_free(hdl);
+	return ret;
+}
+
+static int sc820cs_parse_fwnode(struct sc820cs *sensor)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	int ret;
+
+	/* The receiver may not be described yet, so take the endpoint as it is */
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(sensor->dev), NULL);
+	if (!endpoint)
+		return dev_err_probe(sensor->dev, -EINVAL,
+				     "endpoint node not found\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &bus_cfg);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(sensor->dev, ret,
+				     "failed to parse the endpoint\n");
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != SC820CS_DATA_LANES) {
+		ret = dev_err_probe(sensor->dev, -EINVAL,
+				    "only %u data lanes are supported\n",
+				    SC820CS_DATA_LANES);
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(sensor->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       sc820cs_link_freqs,
+				       ARRAY_SIZE(sc820cs_link_freqs),
+				       &sensor->link_freq_bitmap);
+
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	return ret;
+}
+
+static int sc820cs_identify(struct sc820cs *sensor)
+{
+	u64 id;
+	int ret;
+
+	ret = cci_read(sensor->regmap, SC820CS_REG_CHIP_ID, &id, NULL);
+	if (ret)
+		return dev_err_probe(sensor->dev, ret,
+				     "failed to read the chip ID\n");
+
+	if (id != SC820CS_CHIP_ID)
+		return dev_err_probe(sensor->dev, -ENXIO,
+				     "chip ID 0x%04llx is not 0x%04x\n", id,
+				     SC820CS_CHIP_ID);
+
+	dev_info(sensor->dev, "SC820CS, chip ID 0x%04llx\n", id);
+
+	return 0;
+}
+
+static int sc820cs_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct sc820cs *sensor;
+	unsigned long rate;
+	int ret;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+
+	sensor->dev = dev;
+	sensor->mode = SC820CS_DEFAULT_MODE;
+
+	ret = sc820cs_parse_fwnode(sensor);
+	if (ret)
+		return ret;
+
+	sensor->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sensor->regmap))
+		return dev_err_probe(dev, PTR_ERR(sensor->regmap),
+				     "failed to initialize CCI\n");
+
+	sensor->mclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sensor->mclk))
+		return dev_err_probe(dev, PTR_ERR(sensor->mclk),
+				     "failed to get MCLK\n");
+
+	rate = clk_get_rate(sensor->mclk);
+	if (rate != SC820CS_MCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "MCLK is %lu Hz, not %lu Hz\n", rate,
+				     (unsigned long)SC820CS_MCLK_FREQ);
+
+	sensor->dovdd = devm_regulator_get(dev, "dovdd");
+	if (IS_ERR(sensor->dovdd))
+		return dev_err_probe(dev, PTR_ERR(sensor->dovdd),
+				     "failed to get DOVDD\n");
+
+	sensor->dvdd = devm_regulator_get(dev, "dvdd");
+	if (IS_ERR(sensor->dvdd))
+		return dev_err_probe(dev, PTR_ERR(sensor->dvdd),
+				     "failed to get DVDD\n");
+
+	sensor->avdd = devm_regulator_get(dev, "avdd");
+	if (IS_ERR(sensor->avdd))
+		return dev_err_probe(dev, PTR_ERR(sensor->avdd),
+				     "failed to get AVDD\n");
+
+	sensor->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sensor->reset_gpio),
+				     "failed to get the reset GPIO\n");
+
+	v4l2_i2c_subdev_init(&sensor->sd, client, &sc820cs_subdev_ops);
+	sensor->sd.internal_ops = &sc820cs_internal_ops;
+
+	ret = sc820cs_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = sc820cs_identify(sensor);
+	if (ret)
+		goto err_power_off;
+
+	ret = sc820cs_init_controls(sensor);
+	if (ret)
+		goto err_power_off;
+
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret)
+		goto err_ctrls;
+
+	sensor->sd.state_lock = sensor->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret)
+		goto err_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_idle(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
+	if (ret)
+		goto err_rpm;
+
+	return 0;
+
+err_rpm:
+	pm_runtime_disable(dev);
+	v4l2_subdev_cleanup(&sensor->sd);
+	media_entity_cleanup(&sensor->sd.entity);
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+	if (!pm_runtime_status_suspended(dev))
+		sc820cs_power_off(dev);
+	pm_runtime_set_suspended(dev);
+	return ret;
+
+err_entity:
+	media_entity_cleanup(&sensor->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+err_power_off:
+	sc820cs_power_off(dev);
+	return ret;
+}
+
+static void sc820cs_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sc820cs *sensor = to_sc820cs(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		sc820cs_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(sc820cs_pm_ops, sc820cs_power_off,
+				 sc820cs_power_on, NULL);
+
+static const struct of_device_id sc820cs_of_match[] = {
+	{ .compatible = "smartsens,sc820cs" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sc820cs_of_match);
+
+static struct i2c_driver sc820cs_driver = {
+	.driver = {
+		.name = "sc820cs",
+		.of_match_table = sc820cs_of_match,
+		.pm = pm_ptr(&sc820cs_pm_ops),
+	},
+	.probe = sc820cs_probe,
+	.remove = sc820cs_remove,
+};
+module_i2c_driver(sc820cs_driver);
+
+MODULE_DESCRIPTION("SmartSens SC820CS image sensor driver");
+MODULE_LICENSE("GPL");
