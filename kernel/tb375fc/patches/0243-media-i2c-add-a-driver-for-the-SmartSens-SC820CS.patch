From: buntOS contributors
Subject: [PATCH] media: i2c: add a driver for the SmartSens SC820CS

Add a V4L2 sensor driver for the SmartSens SC820CS with three modes at
30 fps, 3264x2448, 3264x1836 and 1632x1224 (2x2 binning), all RAW10 over
four MIPI CSI-2 lanes from a 24 MHz MCLK. It has exposure, analogue gain,
vertical blanking and the vendor's test pattern as controls.

The register settings, the power on order and its delays and the way
gain and exposure are written come from the sc820cs_mipi_raw driver of
the MediaTek camera framework in the Lenovo TB375FC kernel source
(GPL-2.0). The SC820CS drivers in the OnePlus, OPPO and realme kernel
sources agree on the chip ID (0xd154 at 0x3107) and on the stream,
exposure, gain and frame length registers.

The 330 MHz link frequency is worked out from the vendor's pixel rate of
264 MHz over four lanes at 10 bits; a receiver driver will show whether
it is right. Until there is one, the driver identifies the sensor and
powers it on and off.
---
diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 5d173e0ec..000741946 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -803,6 +803,16 @@ config VIDEO_S5KJN1
 	  To compile this driver as a module, choose M here: the
 	  module will be called s5kjn1.
 
+config VIDEO_SC820CS
+	tristate "SmartSens SC820CS sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the SmartSens SC820CS
+	  8 MP raw camera sensor.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called sc820cs.
+
 config VIDEO_T4KA3
 	tristate "Toshiba T4KA3 sensor support"
 	depends on ACPI || COMPILE_TEST
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index e45359efe..57493613c 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -138,6 +138,7 @@ obj-$(CONFIG_VIDEO_SAA711X) += saa7115.o
 obj-$(CONFIG_VIDEO_SAA7127) += saa7127.o
 obj-$(CONFIG_VIDEO_SAA717X) += saa717x.o
 obj-$(CONFIG_VIDEO_SAA7185) += saa7185.o
+obj-$(CONFIG_VIDEO_SC820CS) += sc820cs.o
 obj-$(CONFIG_VIDEO_SONY_BTF_MPX) += sony-btf-mpx.o
 obj-$(CONFIG_VIDEO_ST_MIPID02) += st-mipid02.o
 obj-$(CONFIG_VIDEO_T4KA3) += t4ka3.o
