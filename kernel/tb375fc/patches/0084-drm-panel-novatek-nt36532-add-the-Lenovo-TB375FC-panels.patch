@@ -30,26 +36,56 @@
 	struct drm_dsc_config dsc;
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
+	struct regulator_bulk_data *bias_supplies;
+	struct drm_connector *connector;
+};
+
+struct panel_mode {
+	const struct drm_display_mode mode;
+	/* Refresh rate control registers 0xb2 and 0xb3 */
+	u8 rate_ctrl[2];
 };
 
 struct panel_info {
 	unsigned int lanes;
 	enum mipi_dsi_pixel_format format;
 	unsigned long mode_flags;
-
+	/* Maximum HS rate of each lane in Hz, where the panel has one */
+	unsigned long hs_rate;
+
+	/* The only mode, or the modes in order of preference */
 	const struct drm_display_mode display_mode;
+	const struct panel_mode *modes;
+	unsigned int num_modes;
 
 	const struct drm_dsc_config *dsc_cfg;
-
+	/* Fill in the rest of dsc_cfg, for a panel with fixed parameters */
+	int (*dsc_params)(struct drm_dsc_config *dsc);
+
+	void (*reset)(struct nt36532 *ctx);
 	int (*init_sequence)(struct nt36532 *ctx);
+	int (*off_sequence)(struct nt36532 *ctx);
 
 	bool is_dual_dsi;
+	/* Send the commands to the first DSI link */
+	bool cmds_on_first_link;
+	bool has_bias_supplies;
+	/* The panel dims over DCS instead of with an external backlight */
+	bool has_dcs_backlight;
+	/* The panel to use instead when the panel ID strap reads high */
+	const struct panel_info *panel_id_high;
 };
 
 static const struct regulator_bulk_data nt36532_supplies[] = {
 	{ .supply = "vddio" }, /* 1.8v */
 };
 
+/* In power up order */
+static const struct regulator_bulk_data nt36532_bias_supplies[] = {
+	{ .supply = "avdd" },
+	{ .supply = "avee" },
+};
+
 static inline struct nt36532 *to_nt36532(struct drm_panel *panel)
 {
 	return container_of(panel, struct nt36532, panel);
@@ -58,7 +94,8 @@
 static inline struct mipi_dsi_device *to_primary_dsi(struct nt36532 *ctx)
 {
 	/* Sync on DSI1 for dual dsi */
-	return ctx->panel_info->is_dual_dsi ? ctx->dsi[1] : ctx->dsi[0];
+	return ctx->panel_info->is_dual_dsi &&
+	       !ctx->panel_info->cmds_on_first_link ? ctx->dsi[1] : ctx->dsi[0];
 }
 
 static void nt36532_reset(struct nt36532 *ctx)
@@ -71,6 +108,41 @@
 	usleep_range(15000, 15100);
 }
 
+static int nt36532_bias_enable(struct nt36532 *ctx)
+{
+	int ret;
+
+	if (!ctx->bias_supplies)
+		return 0;
+
+	ret = regulator_enable(ctx->bias_supplies[0].consumer);
+	if (ret < 0)
+		return ret;
+
+	usleep_range(2000, 2100);
+
+	ret = regulator_enable(ctx->bias_supplies[1].consumer);
+	if (ret < 0) {
+		regulator_disable(ctx->bias_supplies[0].consumer);
+		return ret;
+	}
+
+	usleep_range(200, 300);
+
+	return 0;
+}
+
+static void nt36532_bias_disable(struct nt36532 *ctx)
+{
+	if (!ctx->bias_supplies)
+		return;
+
+	usleep_range(5000, 5100);
+	regulator_disable(ctx->bias_supplies[1].consumer);
+	usleep_range(2000, 2100);
+	regulator_disable(ctx->bias_supplies[0].consumer);
+}
+
 static int nt36532_prepare(struct drm_panel *panel)
 {
 	struct nt36532 *ctx = to_nt36532(panel);
@@ -81,11 +153,19 @@
 	if (ret < 0)
 		return ret;
 
-	nt36532_reset(ctx);
+	ret = nt36532_bias_enable(ctx);
+	if (ret < 0) {
+		regulator_bulk_disable(ARRAY_SIZE(nt36532_supplies),
+				       ctx->supplies);
+		return ret;
+	}
+
+	ctx->panel_info->reset(ctx);
 
 	ret = ctx->panel_info->init_sequence(ctx);
 	if (ret < 0) {
 		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		nt36532_bias_disable(ctx);
 		regulator_bulk_disable(ARRAY_SIZE(nt36532_supplies),
 				       ctx->supplies);
 		return ret;
@@ -113,11 +193,12 @@
 	struct device *dev = &ctx->dsi[0]->dev;
 	int ret;
 
-	ret = nt36532_off(ctx);
+	ret = ctx->panel_info->off_sequence(ctx);
 	if (ret < 0)
 		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
 
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	nt36532_bias_disable(ctx);
 	regulator_bulk_disable(ARRAY_SIZE(nt36532_supplies), ctx->supplies);
 
 	return 0;
@@ -128,9 +209,34 @@
 {
 	struct nt36532 *ctx = to_nt36532(panel);
 	const struct panel_info *panel_info = ctx->panel_info;
-
-	return drm_connector_helper_get_modes_fixed(connector,
-						    &panel_info->display_mode);
+	unsigned int i;
+
+	if (!panel_info->num_modes)
+		return drm_connector_helper_get_modes_fixed(connector,
+							    &panel_info->display_mode);
+
+	for (i = 0; i < panel_info->num_modes; i++) {
+		struct drm_display_mode *mode;
+
+		mode = drm_mode_duplicate(connector->dev,
+					  &panel_info->modes[i].mode);
+		if (!mode)
+			return -ENOMEM;
+
+		drm_mode_set_name(mode);
+
+		mode->type = DRM_MODE_TYPE_DRIVER;
+		if (i == 0)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+
+		drm_mode_probed_add(connector, mode);
+	}
+
+	connector->display_info.width_mm = panel_info->modes[0].mode.width_mm;
+	connector->display_info.height_mm = panel_info->modes[0].mode.height_mm;
+	ctx->connector = connector;
+
+	return panel_info->num_modes;
 }
 
 static const struct drm_panel_funcs nt36532_panel_funcs = {
@@ -313,6 +419,335 @@
 	.block_pred_enable = true,
 };
 
+static const struct panel_mode *nt36532_get_current_mode(struct nt36532 *ctx)
+{
+	const struct panel_info *panel_info = ctx->panel_info;
+	struct drm_connector *connector = ctx->connector;
+	struct drm_crtc_state *crtc_state;
+	unsigned int i;
+
+	/* The first mode until the panel knows better */
+	if (!connector || !connector->state || !connector->state->crtc)
+		return &panel_info->modes[0];
+
+	crtc_state = connector->state->crtc->state;
+
+	for (i = 0; i < panel_info->num_modes; i++) {
+		if (drm_mode_match(&crtc_state->mode,
+				   &panel_info->modes[i].mode,
+				   DRM_MODE_MATCH_TIMINGS | DRM_MODE_MATCH_CLOCK))
+			return &panel_info->modes[i];
+	}
+
+	return &panel_info->modes[0];
+}
+
+static void tb375fc_reset(struct nt36532 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 15000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 15000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 15000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 15000);
+}
+
+/*
+ * The refresh rate control registers select the table of the mode, the panel
+ * comes out of sleep with the rate that was asked for.
+ */
+static void tb375fc_display_on(struct nt36532 *ctx,
+			       struct mipi_dsi_multi_context *dsi_ctx)
+{
+	const struct panel_mode *mode = nt36532_get_current_mode(ctx);
+
+	mipi_dsi_generic_write_var_seq_multi(dsi_ctx, 0xb2, mode->rate_ctrl[0]);
+	mipi_dsi_generic_write_var_seq_multi(dsi_ctx, 0xb3, mode->rate_ctrl[1]);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 150);
+
+	mipi_dsi_dcs_set_display_on_multi(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 20);
+}
+
+/*
+ * The vendor sends the commands from 0xb0 up as generic writes and the others
+ * as DCS writes. Its bootloader and its kernel agree on that, so do we.
+ */
+static int tb375fc_boe_init_sequence(struct nt36532 *ctx)
+{
+	struct mipi_dsi_device *dsi = to_primary_dsi(ctx);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xff, 0x27);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x13, 0x06);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xd0, 0x71);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xd1, 0x84);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xd2, 0x38);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xde, 0x43);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xdf, 0x02);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xff, 0x20);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x0d, 0x43);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x69, 0xdd);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xff, 0x2a);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xb1, 0x00, 0x01);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xff, 0x10);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_TEAR_ON, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x3b,
+				     0x03, 0xb8, 0x1a, 0x0a, 0x0a, 0x00);
+
+	/* Enable DSC */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x90, 0x03);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x91,
+				     0x89, 0x28, 0x00, 0x14, 0xd2, 0x00, 0x00, 0x00,
+				     0x02, 0x19, 0x00, 0x0a, 0x05, 0x7a, 0x03, 0xac);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x92, 0x10, 0xd0);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9d, 0x01);
+
+	tb375fc_display_on(ctx, &dsi_ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+/* The Tianma panels keep their DSC parameters themselves */
+static int tb375fc_tianma_init_sequence(struct nt36532 *ctx)
+{
+	struct mipi_dsi_device *dsi = to_primary_dsi(ctx);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xff, 0x24);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x93, 0x1a, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x94, 0xb8, 0x00);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xda, 0x06);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x5b, 0x53);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xdb, 0x78);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xde, 0x09);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xff, 0x20);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x58, 0x43);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x01, 0x55);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x02, 0x55);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x08, 0x2d);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x65, 0xff);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6d, 0xff);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xff, 0x27);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x13, 0x06);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xd0, 0x71);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xd1, 0x84);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xd2, 0x38);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xde, 0x43);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xdf, 0x02);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xff, 0x20);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x0d, 0x43);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x69, 0xdd);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xff, 0x2a);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xb1, 0x00, 0x01);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xff, 0x2a);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x1a, 0x1d);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xff, 0x25);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x0f, 0x20);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x20, 0x53);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x27, 0x53);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x49, 0x53);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x62, 0x53);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xff, 0x26);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x52, 0x52);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x58, 0x52);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x5c, 0x52);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x65, 0x52);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x73, 0x52);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x84, 0x1c, 0x1c, 0x1c);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xff, 0x10);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_TEAR_ON, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x3b,
+				     0x03, 0xb8, 0x1a, 0x0a, 0x0a, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9d, 0x01);
+
+	tb375fc_display_on(ctx, &dsi_ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+static int tb375fc_off_sequence(struct nt36532 *ctx)
+{
+	struct mipi_dsi_device *dsi = to_primary_dsi(ctx);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	return dsi_ctx.accum_err;
+}
+
+/*
+ * Each link carries half of the active area and its own porches, and the DSI
+ * hosts of bonded links split the timings of the mode between them. Hence the
+ * doubled horizontal porches.
+ */
+static const struct panel_mode tb375fc_modes[] = {
+	{
+		.mode = {
+			.clock = (2944 + (36 + 6 + 31) * 2) *
+				 (1840 + 26 + 2 + 182) * 144 / 1000,
+			.hdisplay = 2944,
+			.hsync_start = 2944 + 36 * 2,
+			.hsync_end = 2944 + (36 + 6) * 2,
+			.htotal = 2944 + (36 + 6 + 31) * 2,
+			.vdisplay = 1840,
+			.vsync_start = 1840 + 26,
+			.vsync_end = 1840 + 26 + 2,
+			.vtotal = 1840 + 26 + 2 + 182,
+			.width_mm = 273,
+			.height_mm = 171,
+		},
+		.rate_ctrl = { 0x80, 0x00 },
+	},
+	{
+		.mode = {
+			.clock = (2944 + (90 + 10 + 88) * 2) *
+				 (1840 + 26 + 2 + 182) * 120 / 1000,
+			.hdisplay = 2944,
+			.hsync_start = 2944 + 90 * 2,
+			.hsync_end = 2944 + (90 + 10) * 2,
+			.htotal = 2944 + (90 + 10 + 88) * 2,
+			.vdisplay = 1840,
+			.vsync_start = 1840 + 26,
+			.vsync_end = 1840 + 26 + 2,
+			.vtotal = 1840 + 26 + 2 + 182,
+			.width_mm = 273,
+			.height_mm = 171,
+		},
+		.rate_ctrl = { 0x91, 0x40 },
+	},
+	{
+		.mode = {
+			.clock = (2944 + (90 + 10 + 88) * 2) *
+				 (1840 + 2076 + 2 + 182) * 60 / 1000,
+			.hdisplay = 2944,
+			.hsync_start = 2944 + 90 * 2,
+			.hsync_end = 2944 + (90 + 10) * 2,
+			.htotal = 2944 + (90 + 10 + 88) * 2,
+			.vdisplay = 1840,
