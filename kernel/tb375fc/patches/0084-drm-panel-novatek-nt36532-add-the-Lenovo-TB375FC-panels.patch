+/*
+ * The touch side of the controller reads this strap as well, to pick its
+ * firmware, so do not hold on to it.
+ */
+static int nt36532_read_panel_id(struct device *dev)
+{
+	struct gpio_desc *gpio;
+	int id;
+
+	gpio = gpiod_get(dev, "novatek,panel-id", GPIOD_IN);
+	if (PTR_ERR(gpio) == -EBUSY)
+		return dev_err_probe(dev, -EPROBE_DEFER,
+				     "Panel ID GPIO is busy\n");
+	if (IS_ERR(gpio))
+		return dev_err_probe(dev, PTR_ERR(gpio),
+				     "Failed to get panel ID GPIO\n");
+
+	id = gpiod_get_value_cansleep(gpio);
+	gpiod_put(gpio);
+	if (id < 0)
+		return dev_err_probe(dev, id, "Failed to read panel ID\n");
+
+	return id;
+}
