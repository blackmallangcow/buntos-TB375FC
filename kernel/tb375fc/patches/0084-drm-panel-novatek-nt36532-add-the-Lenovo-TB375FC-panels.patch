+/*
+ * The rate control of DSC 1.1 before the SCR, with a first line offset of 13
+ * instead of 12. The panel expects the values that follow from it, see register
+ * 0x91 of the BOE panel.
+ */
+static int tb375fc_dsc_params(struct drm_dsc_config *dsc)
+{
+	int ret;
+
+	drm_dsc_set_const_params(dsc);
+	drm_dsc_set_rc_buf_thresh(dsc);
+
+	ret = drm_dsc_setup_rc_params(dsc, DRM_DSC_1_1_PRE_SCR);
+	if (ret)
+		return ret;
+
+	dsc->first_line_bpg_offset = 13;
+	dsc->initial_scale_value = drm_dsc_initial_scale_value(dsc);
+	dsc->line_buf_depth = dsc->bits_per_component + 1;
+
+	return drm_dsc_compute_rc_parameters(dsc);
+}
