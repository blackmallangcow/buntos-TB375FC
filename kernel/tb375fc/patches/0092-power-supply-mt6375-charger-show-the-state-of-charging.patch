From: buntOS contributors
Subject: [PATCH] power: supply: mt6375-charger: show the state of charging

Add a power supply that only reads. The state and the limits of charging
are the first thing to know on a new board, and the driver also logs
what the bootloader left at probe. Nothing is written.

The boost now turns the charger watchdog off first, if it is on. Stock
keeps it off from probe on, and a chip of the same family stops the boost
when it ends.

---
 drivers/power/supply/Kconfig          |   7 +-
 drivers/power/supply/mt6375-charger.c | 265 +++++++++++++++++++++++++-
 2 files changed, 264 insertions(+), 8 deletions(-)

diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index c310511..c4934d8 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -735,10 +735,11 @@ config CHARGER_MT6375
 	tristate "MediaTek MT6375 Charger Driver"
 	depends on MFD_MT6375
 	depends on REGULATOR
+	select LINEAR_RANGES
 	help
-	  Say Y here to enable the MT6375 charger part. So far that is the
-	  boost that sources USB VBUS, as a regulator. Battery charging stays
-	  as the bootloader set it.
+	  Say Y here to enable the MT6375 charger part: the boost that sources
+	  USB VBUS as a regulator, and a power supply that shows the state of
+	  battery charging.
 
 	  This driver can also be built as a module. If so, the module
 	  will be called "mt6375-charger".
diff --git a/drivers/power/supply/mt6375-charger.c b/drivers/power/supply/mt6375-charger.c
index 8791906..d21c99c 100644
--- a/drivers/power/supply/mt6375-charger.c
+++ b/drivers/power/supply/mt6375-charger.c
@@ -1,11 +1,11 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * MediaTek MT6375 charger: the boost that sources USB VBUS
+ * MediaTek MT6375 charger: the boost that sources USB VBUS, and a read-only view
+ * of battery charging
  *
- * Only the OTG boost is here so far. Battery charging, the USB switch, BC1.2,
- * the watchdog and the interrupts stay as the bootloader left them, and neither
- * probing nor reading the state writes to the chip. The first write comes when
- * the regulator is enabled.
+ * Battery charging, the USB switch, BC1.2 and the interrupts stay as the
+ * bootloader left them, and neither probing nor reading the state writes to the
+ * chip. The first write comes when the regulator is enabled.
  *
  * The registers, the parameters and their order come from the MediaTek driver
  * in the OnePlus MT6897 kernel.
@@ -16,16 +16,26 @@
 #include <linux/bitfield.h>
 #include <linux/bits.h>
 #include <linux/kernel.h>
+#include <linux/linear_range.h>
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/property.h>
 #include <linux/regmap.h>
 #include <linux/regulator/driver.h>
 
 #define MT6375_REG_TM_PAS_CODE1		0x107
 #define MT6375_REG_CHG_TOP1		0x120
 #define MT6375_REG_CHG_TOP2		0x121
+#define MT6375_REG_CHG_AICR		0x122
+#define MT6375_REG_CHG_MIVR		0x123
+#define MT6375_REG_CHG_VCHG		0x125
+#define MT6375_REG_CHG_ICHG		0x126
+#define MT6375_REG_CHG_TMR		0x127
+#define MT6375_REG_CHG_EOC		0x128
 #define MT6375_REG_CHG_VSYS		0x129
+#define MT6375_REG_CHG_WDT		0x12a
 #define MT6375_REG_OTG_LBP		0x130
 #define MT6375_REG_OTG_V		0x131
 #define MT6375_REG_OTG_C		0x132
@@ -47,6 +57,7 @@
 #define MT6375_COMP_CLAMP_MASK		GENMASK(1, 0)
 #define MT6375_BUCK_RAMPOFT_MASK	GENMASK(7, 6)
 #define MT6375_ST_PWR_RDY		BIT(0)
+#define MT6375_WDT_EN			BIT(3)
 
 /*
  * OTG_LBP holds 2700 mV from 4 up in steps of 100 mV, OTG_V holds 4850 mV from
@@ -61,10 +72,54 @@
 #define MT6375_OTG_UV			5000000
 #define MT6375_OTG_CC_1800MA		4
 
+enum mt6375_chg_field {
+	F_CHG_EN, F_BUCK_EN, F_HZ, F_IAICR, F_ILIM_EN, F_VMIVR, F_CV, F_CC,
+	F_CHG_TMR_EN, F_TE, F_IEOC, F_WDT_EN, F_IC_STAT, F_ST_PWR_RDY, F_MAX,
+};
+
+static const struct reg_field mt6375_chg_reg_fields[F_MAX] = {
+	[F_CHG_EN] = REG_FIELD(MT6375_REG_CHG_TOP1, 0, 0),
+	[F_BUCK_EN] = REG_FIELD(MT6375_REG_CHG_TOP1, 1, 1),
+	[F_HZ] = REG_FIELD(MT6375_REG_CHG_TOP1, 3, 3),
+	[F_IAICR] = REG_FIELD(MT6375_REG_CHG_AICR, 0, 6),
+	[F_ILIM_EN] = REG_FIELD(MT6375_REG_CHG_AICR, 7, 7),
+	[F_VMIVR] = REG_FIELD(MT6375_REG_CHG_MIVR, 0, 6),
+	[F_CV] = REG_FIELD(MT6375_REG_CHG_VCHG, 0, 6),
+	[F_CC] = REG_FIELD(MT6375_REG_CHG_ICHG, 0, 5),
+	[F_CHG_TMR_EN] = REG_FIELD(MT6375_REG_CHG_TMR, 7, 7),
+	[F_TE] = REG_FIELD(MT6375_REG_CHG_EOC, 1, 1),
+	[F_IEOC] = REG_FIELD(MT6375_REG_CHG_EOC, 4, 7),
+	[F_WDT_EN] = REG_FIELD(MT6375_REG_CHG_WDT, 3, 3),
+	[F_IC_STAT] = REG_FIELD(MT6375_REG_CHG_STAT, 0, 3),
+	[F_ST_PWR_RDY] = REG_FIELD(MT6375_REG_CHG_STAT0, 0, 0),
+};
+
+static const struct linear_range mt6375_chg_ranges[F_MAX] = {
+	[F_IAICR] = LINEAR_RANGE(100000, 2, 127, 25000),
+	[F_VMIVR] = LINEAR_RANGE(3900000, 0, 95, 100000),
+	[F_CV] = LINEAR_RANGE(3900000, 0, 81, 10000),
+	[F_CC] = LINEAR_RANGE(300000, 6, 63, 50000),
+	[F_IEOC] = LINEAR_RANGE(100000, 1, 15, 50000),
+};
+
+enum {
+	MT6375_CHG_STAT_SLEEP,
+	MT6375_CHG_STAT_VBUS_RDY,
+	MT6375_CHG_STAT_TRICKLE,
+	MT6375_CHG_STAT_PRE,
+	MT6375_CHG_STAT_FAST,
+	MT6375_CHG_STAT_EOC,
+	MT6375_CHG_STAT_BKGND,
+	MT6375_CHG_STAT_DONE,
+	MT6375_CHG_STAT_FAULT,
+};
+
 struct mt6375_chg {
 	struct device *dev;
 	struct regmap *regmap;
+	struct regmap_field *fields[F_MAX];
 	struct regulator_dev *rdev;
+	struct power_supply *psy;
 };
 
 /* The chip wants these set differently for the boost than for charging */
@@ -143,6 +198,11 @@ static int mt6375_otg_enable(struct regulator_dev *rdev)
 		return -EBUSY;
 	}
 
+	/* Stock keeps this watchdog off. It may well stop the boost when it ends */
+	ret = regmap_update_bits(chg->regmap, MT6375_REG_CHG_WDT, MT6375_WDT_EN, 0);
+	if (ret)
+		return ret;
+
 	ret = regmap_update_bits(chg->regmap, MT6375_REG_OTG_LBP,
 				 MT6375_OTG_LBP_MASK, MT6375_OTG_LBP_2800MV);
 	if (ret)
@@ -237,11 +297,192 @@ static const struct regulator_desc mt6375_otg_desc = {
 	.enable_mask = MT6375_OTG_EN,
 };
 
+/*
+ * Reads a limit. A selector out of the range reads as the end of the range, as
+ * the chip treats it in the MediaTek driver.
+ */
+static int mt6375_chg_get_limit(struct mt6375_chg *chg, enum mt6375_chg_field fd,
+				int *val)
+{
+	const struct linear_range *r = &mt6375_chg_ranges[fd];
+	unsigned int sel, uval;
+	int ret;
+
+	ret = regmap_field_read(chg->fields[fd], &sel);
+	if (ret)
+		return ret;
+
+	ret = linear_range_get_value(r, clamp(sel, r->min_sel, r->max_sel), &uval);
+	if (ret)
+		return ret;
+
+	*val = uval;
+
+	return 0;
+}
+
+static bool mt6375_chg_online(struct mt6375_chg *chg, int *err)
+{
+	unsigned int pwr_rdy, stat;
+
+	*err = regmap_field_read(chg->fields[F_ST_PWR_RDY], &pwr_rdy);
+	if (*err)
+		return false;
+
+	*err = regmap_field_read(chg->fields[F_IC_STAT], &stat);
+	if (*err)
+		return false;
+
+	return pwr_rdy && stat != MT6375_IC_STAT_OTG;
+}
+
+static int mt6375_chg_get_status(struct mt6375_chg *chg, int *val)
+{
+	unsigned int stat, chg_en;
+	bool online;
+	int ret;
+
+	online = mt6375_chg_online(chg, &ret);
+	if (ret)
+		return ret;
+	if (!online) {
+		*val = POWER_SUPPLY_STATUS_DISCHARGING;
+		return 0;
+	}
+
+	ret = regmap_field_read(chg->fields[F_IC_STAT], &stat);
+	if (ret)
+		return ret;
+
+	ret = regmap_field_read(chg->fields[F_CHG_EN], &chg_en);
+	if (ret)
+		return ret;
+
+	switch (stat) {
+	case MT6375_CHG_STAT_VBUS_RDY:
+	case MT6375_CHG_STAT_TRICKLE:
+	case MT6375_CHG_STAT_PRE:
+	case MT6375_CHG_STAT_FAST:
+	case MT6375_CHG_STAT_EOC:
+	case MT6375_CHG_STAT_BKGND:
+		*val = chg_en ? POWER_SUPPLY_STATUS_CHARGING :
+				POWER_SUPPLY_STATUS_NOT_CHARGING;
+		break;
+	case MT6375_CHG_STAT_DONE:
+		*val = POWER_SUPPLY_STATUS_FULL;
+		break;
+	case MT6375_CHG_STAT_SLEEP:
+	case MT6375_CHG_STAT_FAULT:
+		*val = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		break;
+	default:
+		*val = POWER_SUPPLY_STATUS_UNKNOWN;
+		break;
+	}
+
+	return 0;
+}
+
+static int mt6375_chg_get_charge_type(struct mt6375_chg *chg, int *val)
+{
+	unsigned int stat;
+	int ret;
+
+	ret = regmap_field_read(chg->fields[F_IC_STAT], &stat);
+	if (ret)
+		return ret;
+
+	switch (stat) {
+	case MT6375_CHG_STAT_TRICKLE:
+	case MT6375_CHG_STAT_PRE:
+		*val = POWER_SUPPLY_CHARGE_TYPE_TRICKLE;
+		break;
+	case MT6375_CHG_STAT_FAST:
+		*val = POWER_SUPPLY_CHARGE_TYPE_FAST;
+		break;
+	default:
+		*val = POWER_SUPPLY_CHARGE_TYPE_NONE;
+		break;
+	}
+
+	return 0;
+}
+
+static int mt6375_chg_get_property(struct power_supply *psy,
+				   enum power_supply_property psp,
+				   union power_supply_propval *val)
+{
+	struct mt6375_chg *chg = power_supply_get_drvdata(psy);
+	int ret;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		val->intval = mt6375_chg_online(chg, &ret);
+		return ret;
+	case POWER_SUPPLY_PROP_STATUS:
+		return mt6375_chg_get_status(chg, &val->intval);
+	case POWER_SUPPLY_PROP_CHARGE_TYPE:
+		return mt6375_chg_get_charge_type(chg, &val->intval);
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		return mt6375_chg_get_limit(chg, F_CC, &val->intval);
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE:
+		return mt6375_chg_get_limit(chg, F_CV, &val->intval);
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		return mt6375_chg_get_limit(chg, F_IAICR, &val->intval);
+	case POWER_SUPPLY_PROP_INPUT_VOLTAGE_LIMIT:
+		return mt6375_chg_get_limit(chg, F_VMIVR, &val->intval);
+	case POWER_SUPPLY_PROP_CHARGE_TERM_CURRENT:
+		return mt6375_chg_get_limit(chg, F_IEOC, &val->intval);
+	default:
+		return -EINVAL;
+	}
+}
+
+static const enum power_supply_property mt6375_chg_properties[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_CHARGE_TYPE,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE,
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+	POWER_SUPPLY_PROP_INPUT_VOLTAGE_LIMIT,
+	POWER_SUPPLY_PROP_CHARGE_TERM_CURRENT,
+};
+
+static const struct power_supply_desc mt6375_chg_psy_desc = {
+	.name = "mt6375-charger",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.properties = mt6375_chg_properties,
+	.num_properties = ARRAY_SIZE(mt6375_chg_properties),
+	.get_property = mt6375_chg_get_property,
+};
+
+/* What the bootloader left. It is the first thing to know about a new board */
+static void mt6375_chg_log_state(struct mt6375_chg *chg)
+{
+	unsigned int en, buck, hz, wdt;
+	int cv, ichg, aicr;
+
+	if (mt6375_chg_get_limit(chg, F_CV, &cv) ||
+	    mt6375_chg_get_limit(chg, F_CC, &ichg) ||
+	    mt6375_chg_get_limit(chg, F_IAICR, &aicr) ||
+	    regmap_field_read(chg->fields[F_CHG_EN], &en) ||
+	    regmap_field_read(chg->fields[F_BUCK_EN], &buck) ||
+	    regmap_field_read(chg->fields[F_HZ], &hz) ||
+	    regmap_field_read(chg->fields[F_WDT_EN], &wdt))
+		return;
+
+	dev_info(chg->dev, "CV %d uV, ICHG %d uA, AICR %d uA, CHG_EN %u, BUCK_EN %u, HZ %u, WDT_EN %u\n",
+		 cv, ichg, aicr, en, buck, hz, wdt);
+}
+
 static int mt6375_chg_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
+	struct power_supply_config psy_cfg = { };
 	struct regulator_config cfg = { };
 	struct mt6375_chg *chg;
+	int ret;
 
 	chg = devm_kzalloc(dev, sizeof(*chg), GFP_KERNEL);
 	if (!chg)
@@ -252,6 +493,13 @@ static int mt6375_chg_probe(struct platform_device *pdev)
 	if (!chg->regmap)
 		return dev_err_probe(dev, -ENODEV, "Failed to get regmap\n");
 
+	ret = devm_regmap_field_bulk_alloc(dev, chg->regmap, chg->fields,
+					   mt6375_chg_reg_fields, F_MAX);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to allocate the fields\n");
+
+	mt6375_chg_log_state(chg);
+
 	cfg.dev = dev;
 	cfg.driver_data = chg;
 	cfg.regmap = chg->regmap;
@@ -260,6 +508,13 @@ static int mt6375_chg_probe(struct platform_device *pdev)
 		return dev_err_probe(dev, PTR_ERR(chg->rdev),
 				     "Failed to register the OTG regulator\n");
 
+	psy_cfg.drv_data = chg;
+	psy_cfg.fwnode = dev_fwnode(dev);
+	chg->psy = devm_power_supply_register(dev, &mt6375_chg_psy_desc, &psy_cfg);
+	if (IS_ERR(chg->psy))
+		return dev_err_probe(dev, PTR_ERR(chg->psy),
+				     "Failed to register the power supply\n");
+
 	platform_set_drvdata(pdev, chg);
 
 	return 0;
