+/*
+ * The work does not run in suspend, so nothing would follow the temperature, and
+ * charging stops until resume. Stock wakes every 10 seconds to look instead.
+ */
+static int mt6375_chg_suspend(struct device *dev)
+{
+	struct mt6375_chg *chg = dev_get_drvdata(dev);
+
+	if (!chg->can_control)
+		return 0;
+
+	mt6375_chg_stop_control(chg);
+
+	mutex_lock(&chg->lock);
+	if (chg->taken_over && regmap_field_write(chg->fields[F_CHG_EN], 0))
+		dev_err(dev, "Failed to stop charging\n");
+	mutex_unlock(&chg->lock);
+
+	return 0;
+}
+
+static int mt6375_chg_resume(struct device *dev)
+{
+	struct mt6375_chg *chg = dev_get_drvdata(dev);
+
+	if (chg->can_control) {
+		enable_delayed_work(&chg->work);
+		queue_delayed_work(system_freezable_wq, &chg->work, 0);
+	}
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(mt6375_chg_pm_ops, mt6375_chg_suspend,
+				mt6375_chg_resume);
