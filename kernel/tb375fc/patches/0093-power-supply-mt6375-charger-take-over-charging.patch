+static int mt6375_chg_read_battery(struct mt6375_chg *chg, int *temp, int *uv)
+{
+	union power_supply_propval val;
+	struct power_supply *gauge;
+	int ret;
+
+	gauge = power_supply_get_by_reference(dev_fwnode(chg->dev),
+					      "mediatek,fuel-gauge");
+	if (IS_ERR_OR_NULL(gauge))
+		return -ENODEV;
