+			 temp, next);
+	chg->temp = next;
+	chg->gauge_lost = false;
+	chg->read_fails = 0;
+
+	if (vbat >= chg->ovp_uv) {
+		if (!chg->overvoltage)
+			dev_err(chg->dev, "Battery at %d uV, stopping charging\n",
+				vbat);
+		chg->overvoltage = true;
+	}
