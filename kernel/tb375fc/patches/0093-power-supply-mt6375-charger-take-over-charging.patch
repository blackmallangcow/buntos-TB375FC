+static void mt6375_chg_stop_control(struct mt6375_chg *chg)
+{
+	disable_delayed_work_sync(&chg->work);
+
+	mutex_lock(&chg->lock);
+	if (chg->taken_over)
+		mt6375_chg_set_unsupervised(chg);
+	mutex_unlock(&chg->lock);
+}
+
+static void mt6375_chg_release_control(void *data)
+{
+	mt6375_chg_stop_control(data);
+}
+
+static int mt6375_chg_init_control(struct mt6375_chg *chg)
+{
+	struct device *dev = chg->dev;
+	int ret = -ENOENT;
+
+	if (chg->wants_control) {
+		ret = mt6375_chg_get_battery(chg);
+		if (ret)
+			dev_err(dev, "Unusable battery description: %d\n", ret);
+	}
+
+	if (ret) {
+		dev_info(dev, "Leaving charging as the bootloader set it\n");
+		return 0;
+	}
+
+	ret = devm_add_action_or_reset(dev, mt6375_chg_release_control, chg);
+	if (ret)
+		return ret;
+
+	mutex_lock(&chg->lock);
+	chg->can_control = true;
+	mutex_unlock(&chg->lock);
+
+	queue_delayed_work(system_freezable_wq, &chg->work, 0);
+
+	return 0;
+}
