+		cc = chg->cc_max_ua;
+	cc = min(cc, chg->user_cc_ua);
+
+	/*
+	 * Only turning charging off and on starts the safety timer anew for the
+	 * chip. A new source does that, as on stock. The limits below still
+	 * help if turning it off fails.
+	 */
+	if (!charge || (new_source && stat == MT6375_CHG_STAT_FAULT))
+		stop_ret = regmap_field_write(chg->fields[F_CHG_EN], 0);
+	chg->pwr_rdy = pwr_rdy;
+
+	ret = mt6375_chg_set_limit(chg, F_CV, cv);
+	if (ret)
+		goto stop;
+
+	ret = mt6375_chg_set_limit(chg, F_CC, cc);
+	if (ret)
+		goto stop;
+
+	ret = mt6375_chg_set_limit(chg, F_IAICR, aicr);
+	if (ret)
+		goto stop;
+
+	if (charge) {
+		ret = regmap_field_write(chg->fields[F_CHG_EN], 1);
+		if (ret)
