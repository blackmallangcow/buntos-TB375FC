+	cv = min(chg->cv_max_uv, chg->user_cv_uv);
+	if (chg->temp != MT6375_CHG_TEMP_NORMAL || chg->gauge_lost)
+		cv = min(cv, MT6375_CHG_CV_WARM_UV);
