+		return;
+	}
+
+	if (!ret) {
+		mt6375_chg_update_battery(chg, now->temp, now->vbat_uv);
+	} else {
+		/* The last temperature holds for now, and VBUS needs care */
+		if (chg->read_fails < MT6375_CHG_MAX_READ_FAILS)
+			chg->read_fails++;
+		if (chg->read_fails == MT6375_CHG_MAX_READ_FAILS) {
+			if (!chg->gauge_lost)
+				dev_err(chg->dev, "Lost the fuel gauge (%d), stopping charging\n",
+					ret);
+			chg->gauge_lost = true;
+		}
+	}
