+stop:
+	/*
+	 * A limit may be stale now. With taking over unfinished this is still
+	 * safe. The next round tries it all again.
+	 */
+	if (!chg->setup_failed)
+		dev_err(chg->dev, "Failed to set up charging: %d\n", ret);
+	chg->setup_failed = true;
+	mt6375_chg_stop_charging(chg);
+}
