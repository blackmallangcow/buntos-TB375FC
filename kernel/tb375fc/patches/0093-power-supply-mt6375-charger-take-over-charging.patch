+/*
+ * Before taking over, a gauge that cannot be read says nothing: it may just not
+ * be there yet, and the chip goes on as the bootloader set it. One that keeps
+ * making no sense is another matter. Taking that as no reading would stop
+ * charging at 99 C and not at 101 C. It stays stopped until a good reading.
+ */
+static void mt6375_chg_before_take_over(struct mt6375_chg *chg, int err,
+					int temp, int vbat)
+{
+	unsigned int pwr_rdy;
+	int ret;
+
+	if (err != -ERANGE) {
+		if (!chg->gauge_warned)
+			dev_warn(chg->dev, "Cannot read the fuel gauge: %d, not taking over charging\n",
+				 err);
+		chg->gauge_warned = true;
+	} else if (chg->read_fails < MT6375_CHG_MAX_READ_FAILS &&
+		   ++chg->read_fails == MT6375_CHG_MAX_READ_FAILS) {
+		dev_err(chg->dev, "Fuel gauge makes no sense (%d C, %d uV), stopping charging\n",
+			temp, vbat);
+	}
+
+	if (chg->fault &&
+	    !regmap_field_read(chg->fields[F_ST_PWR_RDY], &pwr_rdy) && !pwr_rdy)
+		chg->fault = false;
+
+	/* The work stays away during the boost, and this comes round again */
+	if (mt6375_chg_check_boost(chg) > 0)
+		return;
+
+	if (mt6375_chg_must_stop(chg))
+		ret = mt6375_chg_stop_charging(chg);
+	else
+		ret = mt6375_chg_release(chg);
+
+	if (ret && !chg->setup_failed)
+		dev_err(chg->dev, "Failed to set charging: %d\n", ret);
+	chg->setup_failed = ret != 0;
+}
