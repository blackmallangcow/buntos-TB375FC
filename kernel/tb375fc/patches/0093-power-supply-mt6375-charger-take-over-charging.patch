+static enum mt6375_chg_temp mt6375_chg_next_temp(struct mt6375_chg *chg,
+						 int temp)
+{
+	if (temp >= chg->temp_hot)
+		return MT6375_CHG_TEMP_HOT;
+	if (chg->temp == MT6375_CHG_TEMP_HOT &&
+	    temp >= chg->temp_hot - MT6375_CHG_TEMP_HYST)
+		return MT6375_CHG_TEMP_HOT;
+	if (temp < chg->temp_cold)
+		return MT6375_CHG_TEMP_COLD;
+	if (chg->temp == MT6375_CHG_TEMP_COLD &&
+	    temp <= chg->temp_cold + MT6375_CHG_TEMP_HYST)
+		return MT6375_CHG_TEMP_COLD;
+	if (temp > MT6375_CHG_TEMP_WARM)
+		return MT6375_CHG_TEMP_WARM_RANGE;
+	if (chg->temp == MT6375_CHG_TEMP_WARM_RANGE &&
+	    temp >= MT6375_CHG_TEMP_WARM - MT6375_CHG_TEMP_HYST)
+		return MT6375_CHG_TEMP_WARM_RANGE;
+
+	return MT6375_CHG_TEMP_NORMAL;
