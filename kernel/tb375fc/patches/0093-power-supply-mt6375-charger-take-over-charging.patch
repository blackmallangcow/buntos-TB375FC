+ * maximum, so getting over it means a bug, which must not reach the battery.
+ */
+static int mt6375_chg_set_limit(struct mt6375_chg *chg,
+				enum mt6375_chg_field fd, unsigned int val)
+{
+	const struct linear_range *r = &mt6375_chg_ranges[fd];
+	unsigned int max, sel;
+
+	switch (fd) {
+	case F_CV:
+		max = MT6375_CHG_CV_MAX_UV;
+		break;
+	case F_CC:
+		max = MT6375_CHG_CC_MAX_UA;
+		break;
+	case F_IAICR:
+		max = MT6375_CHG_AICR_MAX_UA;
+		break;
+	default:
+		max = linear_range_get_max_value(r);
+		break;
+	}
+	if (WARN_ON(val > max))
+		return -ERANGE;
+
+	/* Rounds down, which is the safe way for all of these */
+	linear_range_get_selector_within(r, val, &sel);
+
+	return regmap_field_write(chg->fields[fd], sel);
+}
