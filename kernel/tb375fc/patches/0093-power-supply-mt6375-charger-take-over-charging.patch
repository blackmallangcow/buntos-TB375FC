+	ret = -ERANGE;
+	if (*temp < MT6375_CHG_TEMP_SANE_MIN ||
+	    *temp > MT6375_CHG_TEMP_SANE_MAX)
+		goto out;
+
+	if (power_supply_get_property(gauge, POWER_SUPPLY_PROP_VOLTAGE_NOW,
+				      &val))
+		goto out;
