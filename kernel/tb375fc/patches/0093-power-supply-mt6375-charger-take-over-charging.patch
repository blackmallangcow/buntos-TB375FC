+
+	ret = regmap_field_read(chg->fields[F_ST_PWR_RDY], &pwr_rdy);
+	if (ret)
+		goto stop;
+
+	/*
+	 * A fault at a new source is from before it. Any other stays until the
+	 * source goes: nothing else may start the safety timer anew. That goes
