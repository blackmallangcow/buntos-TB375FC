From: buntOS contributors
Subject: [PATCH] drm/mediatek: mtk_disp_dsc: add MT6897

The DSC of MT6897 only differs in the place of its shadow control
register, and it wants a commit after the configuration. Its output goes
into the buffer of the DSI host, for which DISP_REG_DSC_MODE and the
output buffer get their values. All the registers come from
mtk_dsc_config() of the MediaTek driver, whose results for the three
panels of the Lenovo TB375FC this was compared with.

A pipe of two has one DSC for each link, so the width is the one of the
link. The DSI driver leaves alone what the panel filled in, so this uses
the values for DSC 1.1 that the panels want.
---
 drivers/gpu/drm/mediatek/mtk_disp_dsc.c | 110 ++++++++++++++++++++++++
 1 file changed, 110 insertions(+)

diff --git a/drivers/gpu/drm/mediatek/mtk_disp_dsc.c b/drivers/gpu/drm/mediatek/mtk_disp_dsc.c
index c9e2de26005442a0a2450b6c8fc4bc2f30a7c2bd..775dfcd2d76d16e0f36afdf075ef4e7c15057881 100644
--- a/drivers/gpu/drm/mediatek/mtk_disp_dsc.c
+++ b/drivers/gpu/drm/mediatek/mtk_disp_dsc.c
@@ -130,7 +130,27 @@
 #  define DSC_READ_WORKING		BIT(2)
 #  define DSC_SHADOW_DSC_VERSION_MINOR	GENMASK(8, 5)
 
+#define DISP_REG_DSC_SHADOW_CTRL_MT6897	0x228
+
+/* Below this width of the picture the output buffer gets a size of its own */
+#define DSC_OBUF_MIN_PIC_WIDTH_MT6897	1440
+#define DSC_OBUF_SW_MT6897		BIT(31)
+#define DSC_OBUF_SIZE_MT6897		200
+
+/**
+ * struct mtk_dsc_data - What differs in the DSC of newer SoCs
+ * @shadow_ctrl_reg: Register with the commit bits, apart from the one with the
+ *                   version. The DSC then stays off until mtk_dsc_setup().
+ * @dsi_buffer:      The DSI link has a buffer of its own, so the DSC needs no
+ *                   initial delay, and its registers count pixel groups.
+ */
+struct mtk_dsc_data {
+	u16 shadow_ctrl_reg;
+	bool dsi_buffer;
+};
+
 struct mtk_dsc {
+	const struct mtk_dsc_data *data;
 	struct clk		*clk;
 	void __iomem		*reg;
 	bool			dsc_config_done;
@@ -253,6 +273,78 @@ static void mtk_dsc_pps_setup(struct mtk_dsc *disp_dsc, struct drm_dsc_config *d
 	       disp_dsc->reg + DISP_REG_DSC_PPS(19));
 }
 
+/*
+ * The picture and the slices of the DSC of a link with a buffer, one DSC for
+ * each link. All of this comes from the vendor's driver, and the picture size in
+ * the configuration is the one of the link.
+ */
+static void mtk_dsc_setup_dsi_buffer(struct mtk_dsc *disp_dsc,
+				     struct drm_dsc_config *dsc_cfg)
+{
+	u32 slice_chunks = dsc_cfg->slice_chunk_size * dsc_cfg->slice_count;
+	u32 pic_group_width = (dsc_cfg->pic_width + 2) / 3;
+	u32 slice_group_width = (dsc_cfg->slice_width + 2) / 3;
+	u32 slices = DIV_ROUND_UP(dsc_cfg->pic_height, dsc_cfg->slice_height);
+	u32 chunk_groups = (slice_chunks + 2) / 3;
+	u32 val;
+
+	/* A bootloader can have left it on */
+	writel(0, disp_dsc->reg + DISP_REG_DSC_CON);
+
+	writel(0, disp_dsc->reg + DISP_REG_DSC_SPR);
+
+	if (dsc_cfg->pic_width < DSC_OBUF_MIN_PIC_WIDTH_MT6897)
+		writel(DSC_OBUF_SW_MT6897 | DSC_OBUF_SIZE_MT6897,
+		       disp_dsc->reg + DISP_REG_DSC_OUTBUF);
+
+	writel(FIELD_PREP(DSC_ENC_WIDTH_PIC, dsc_cfg->pic_width) |
+	       FIELD_PREP(DSC_ENC_WIDTH_SLICE, dsc_cfg->slice_width),
+	       disp_dsc->reg + DISP_REG_DSC_ENC_WIDTH);
+
+	/* The version goes along with the other bits of this register */
+	val = readl(disp_dsc->reg + DISP_REG_DSC_SHADOW);
+	val &= ~DSC_SHADOW_DSC_VERSION_MINOR;
+	val |= FIELD_PREP(DSC_SHADOW_DSC_VERSION_MINOR, dsc_cfg->dsc_version_minor);
+	writel(val, disp_dsc->reg + DISP_REG_DSC_SHADOW);
+
+	writel(FIELD_PREP(DSC_PIC_GROUP_WIDTH_M1, pic_group_width - 1) |
+	       FIELD_PREP(DSC_PIC_WIDTH, dsc_cfg->pic_width),
+	       disp_dsc->reg + DISP_REG_DSC_PIC_W);
+	writel(FIELD_PREP(DSC_PIC_HEIGHT_EXT_M1, slices * dsc_cfg->slice_height - 1) |
+	       FIELD_PREP(DSC_PIC_HEIGHT, dsc_cfg->pic_height - 1),
+	       disp_dsc->reg + DISP_REG_DSC_PIC_H);
+	writel(FIELD_PREP(DSC_SLICE_GROUP_WIDTH_M1, slice_group_width - 1) |
+	       FIELD_PREP(DSC_SLICE_WIDTH, dsc_cfg->slice_width),
+	       disp_dsc->reg + DISP_REG_DSC_SLICE_W);
+	writel(FIELD_PREP(DSC_SLICE_WIDTH_MOD3, dsc_cfg->slice_width % 3) |
+	       FIELD_PREP(DSC_SLICE_NUM_M1, slices - 1) |
+	       FIELD_PREP(DSC_SLICE_HEIGHT_M1, dsc_cfg->slice_height - 1),
+	       disp_dsc->reg + DISP_REG_DSC_SLICE_H);
+	writel(chunk_groups << 16 | dsc_cfg->slice_chunk_size,
+	       disp_dsc->reg + DISP_REG_DSC_CHUNK_SIZE);
+	writel(FIELD_PREP(DSC_PAD_NUMBER, chunk_groups * 3 - slice_chunks),
+	       disp_dsc->reg + DISP_REG_DSC_PAD);
+	writel(FIELD_PREP(DISP_DSC_BUF_SIZE_MASK,
+			  dsc_cfg->slice_chunk_size * dsc_cfg->slice_height),
+	       disp_dsc->reg + DISP_REG_DSC_BUF_SIZE);
+	writel(FIELD_PREP(DSC_TWO_SLICE_MODE, dsc_cfg->slice_count == 2),
+	       disp_dsc->reg + DISP_REG_DSC_MODE);
+	writel(DSC_CFG_ICH_EN |
+	       FIELD_PREP_CONST(DSC_CFG_FLATNESS_DET_THRES, DSC_CFG_FLATNESS_8BITS),
+	       disp_dsc->reg + DISP_REG_DSC_CFG);
+	writel(DSC_CKSM_CAL_EN, disp_dsc->reg + DISP_REG_DSC_DBG_CON);
+
+	mtk_dsc_pps_setup(disp_dsc, dsc_cfg);
+
+	writel(DSC_FORCE_COMMIT,
+	       disp_dsc->reg + disp_dsc->data->shadow_ctrl_reg);
+
+	writel(DSC_UFOE_SEL | DSC_PT_MEM_EN | DSC_EN,
+	       disp_dsc->reg + DISP_REG_DSC_CON);
+
+	disp_dsc->dsc_config_done = true;
+}
+
 void mtk_dsc_setup(struct device *dev, struct drm_dsc_config *dsc_cfg)
 {
 	struct mtk_dsc *disp_dsc = dev_get_drvdata(dev);
@@ -262,6 +354,11 @@ void mtk_dsc_setup(struct device *dev, struct drm_dsc_config *dsc_cfg)
 	u32 chunk_size, dsc_pad_num, dsc_pre_pad_sz;
 	bool dsc_en_bit;
 
+	if (disp_dsc->data && disp_dsc->data->dsi_buffer) {
+		mtk_dsc_setup_dsi_buffer(disp_dsc, dsc_cfg);
+		return;
+	}
+
 	pic_height_ext_num = dsc_cfg->pic_height + dsc_cfg->slice_height - 1;
 	pic_group_width = (dsc_cfg->slice_width * 4) / 3;
 	slice_group_width = (dsc_cfg->slice_width + 2) / 3;
@@ -359,6 +456,9 @@ void mtk_dsc_start(struct device *dev)
 	struct mtk_dsc *disp_dsc = dev_get_drvdata(dev);
 	u32 val;
 
+	if (disp_dsc->data && disp_dsc->data->dsi_buffer)
+		return;
+
 	val = readl(disp_dsc->reg + DISP_REG_DSC_CON);
 
 	/* If no DSC or config not done, stop the HW temporarily and set bypass mode */
@@ -378,6 +478,8 @@ void mtk_dsc_stop(struct device *dev)
 	struct mtk_dsc *disp_dsc = dev_get_drvdata(dev);
 
 	writel(0, disp_dsc->reg + DISP_REG_DSC_CON);
+	if (disp_dsc->data && disp_dsc->data->dsi_buffer)
+		disp_dsc->dsc_config_done = false;
 }
 
 static int mtk_dsc_bind(struct device *dev, struct device *master, void *data)
@@ -405,6 +507,8 @@ static int mtk_dsc_probe(struct platform_device *pdev)
 	if (!priv)
 		return -ENOMEM;
 
+	priv->data = of_device_get_match_data(dev);
+
 	priv->clk = devm_clk_get(dev, NULL);
 	if (IS_ERR(priv->clk))
 		return dev_err_probe(dev, PTR_ERR(priv->clk),
@@ -433,7 +537,13 @@ static void mtk_dsc_remove(struct platform_device *pdev)
 	component_del(&pdev->dev, &mtk_dsc_component_ops);
 }
 
+static const struct mtk_dsc_data mt6897_dsc_data = {
+	.shadow_ctrl_reg = DISP_REG_DSC_SHADOW_CTRL_MT6897,
+	.dsi_buffer = true,
+};
+
 static const struct of_device_id mtk_dsc_driver_dt_match[] = {
+	{ .compatible = "mediatek,mt6897-disp-dsc", .data = &mt6897_dsc_data },
 	{ .compatible = "mediatek,mt8195-disp-dsc" },
 	{ /* sentinel */ }
 };
