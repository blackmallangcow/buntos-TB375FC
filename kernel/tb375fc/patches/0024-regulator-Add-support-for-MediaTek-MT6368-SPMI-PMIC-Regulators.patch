+
+static void mt6368_irq_remove(void *data)
+{
+	int *virq = data;
+
+	irq_dispose_mapping(*virq);
+}
+
+static void mt6368_spmi_remove(void *data)
+{
+	struct spmi_device *sdev = data;
+
+	spmi_device_remove(sdev);
+}
+
+static struct regmap *mt6368_spmi_init_regmap(struct spmi_device *sdev, u32 base)
+{
+	/*
+	 * The registers are eight bits wide. Wider values would also write
+	 * the next register, such as the CLR register after a SET register
+	 * or the enable register after a CLR register.
+	 */
+	const struct regmap_config mt6368_regmap_config = {
+		.reg_bits = 16,
+		.val_bits = 8,
+		.reg_base = base,
+		.max_register = MT6368_RG_VRF13_AIF_VOSEL_ADDR,
+		.fast_io = true,
+	};
+
+	return devm_regmap_init_spmi_ext(sdev, &mt6368_regmap_config);
+}
+
+static struct regmap *mt6368_spmi_register_regmap(struct device *dev)
+{
+	struct spmi_device *sdev, *sparent;
+	u32 base;
+	int ret;
+
+	if (!dev->parent)
+		return ERR_PTR(-ENODEV);
+
+	ret = device_property_read_u32(dev, "reg", &base);
+	if (ret)
+		return ERR_PTR(ret);
+
+	sparent = to_spmi_device(dev->parent);
+	if (!sparent)
+		return ERR_PTR(-ENODEV);
+
+	sdev = spmi_device_alloc(sparent->ctrl);
+	if (!sdev)
+		return ERR_PTR(-ENODEV);
+
+	sdev->usid = sparent->usid;
+	dev_set_name(&sdev->dev, "%d-%02x-regulator", sdev->ctrl->nr, sdev->usid);
+	ret = device_add(&sdev->dev);
+	if (ret) {
+		put_device(&sdev->dev);
+		return ERR_PTR(ret);
+	}
+
+	ret = devm_add_action_or_reset(dev, mt6368_spmi_remove, sdev);
+	if (ret)
+		return ERR_PTR(ret);
+
+	return mt6368_spmi_init_regmap(sdev, base);
+}
+
+static int mt6368_regulator_probe(struct platform_device *pdev)
+{
+	struct device_node *interrupt_parent;
+	struct regulator_config config = {};
+	struct mt6368_regulator_info *info;
+	struct device *dev = &pdev->dev;
+	struct regulator_dev *rdev;
+	struct irq_fwspec fwspec = {};
+	struct irq_domain *domain;
+	struct spmi_device *sdev;
+	int i, ret;
+
+	config.regmap = mt6368_spmi_register_regmap(dev);
+	if (IS_ERR(config.regmap))
+		return dev_err_probe(dev, PTR_ERR(config.regmap),
+				     "Cannot get regmap\n");
+	config.dev = dev;
+	sdev = to_spmi_device(dev->parent);
+	platform_set_drvdata(pdev, config.regmap);
+
+	interrupt_parent = of_irq_find_parent(dev->of_node);
+	if (!interrupt_parent)
+		return dev_err_probe(dev, -EINVAL, "Cannot find IRQ parent\n");
+
+	domain = irq_find_host(interrupt_parent);
+	of_node_put(interrupt_parent);
+	if (!domain)
+		return dev_err_probe(dev, -ENODEV, "Cannot find IRQ domain\n");
+
+	fwspec.fwnode = domain->fwnode;
+	fwspec.param_count = 3;
+	fwspec.param[0] = sdev->usid;
+	fwspec.param[2] = IRQ_TYPE_LEVEL_HIGH;
+
+	for (i = 0; i < ARRAY_SIZE(mt6368_regulators); i++) {
+		info = &mt6368_regulators[i];
+
+		if (info->hwirq >= 0) {
+			fwspec.param[1] = info->hwirq;
+			info->virq = irq_create_fwspec_mapping(&fwspec);
+			if (!info->virq)
+				return dev_err_probe(dev, -EINVAL,
+						     "Failed to map IRQ%d\n", info->hwirq);
+
+			ret = devm_add_action_or_reset(dev, mt6368_irq_remove, &info->virq);
+			if (ret)
+				return ret;
+		}
+
+		config.driver_data = info;
+
+		rdev = devm_regulator_register(dev, &info->desc, &config);
+		if (IS_ERR(rdev))
+			return dev_err_probe(dev, PTR_ERR(rdev),
+					     "failed to register %s\n", info->desc.name);
+	}
+
+	return 0;
+}
+
+/* Let the power off sequence turn this PMIC off, as the MediaTek driver does */
+static void mt6368_regulator_shutdown(struct platform_device *pdev)
+{
+	struct regmap *regmap = platform_get_drvdata(pdev);
+
+	regmap_write(regmap, MT6368_TOP_CFG_ELR5, MT6368_TOP_CFG_ELR5_SHUTDOWN);
+}
+
+static const struct of_device_id mt6368_regulator_match[] = {
+	{ .compatible = "mediatek,mt6368-regulator" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, mt6368_regulator_match);
+
+static struct platform_driver mt6368_regulator_driver = {
+	.driver = {
+		.name = "mt6368-regulator",
+		.probe_type = PROBE_PREFER_ASYNCHRONOUS,
+		.of_match_table = mt6368_regulator_match,
+	},
+	.probe = mt6368_regulator_probe,
+	.shutdown = mt6368_regulator_shutdown,
+};
+module_platform_driver(mt6368_regulator_driver);
+
+MODULE_DESCRIPTION("Regulator Driver for MediaTek MT6368 PMIC");
+MODULE_LICENSE("GPL");
