+static int mtk_afe_i2s_apll_connect(struct snd_soc_dapm_widget *source,
+				    struct snd_soc_dapm_widget *sink)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(sink->dapm);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(cmpnt);
+	struct mtk_afe_i2s_priv *i2s_priv = get_i2s_priv(afe, MT6897_DAI_I2S_OUT4);
+
+	return mt6897_get_apll_by_rate(i2s_priv->rate) ==
+	       mt6897_get_apll_by_name(source->name);
+}
