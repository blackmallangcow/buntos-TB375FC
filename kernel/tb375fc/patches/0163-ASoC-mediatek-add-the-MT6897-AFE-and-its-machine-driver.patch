diff --git a/sound/soc/mediatek/mt6897/mt6897-mt6368.c b/sound/soc/mediatek/mt6897/mt6897-mt6368.c
new file mode 100644
index 0000000..bf746b4
--- /dev/null
+++ b/sound/soc/mediatek/mt6897/mt6897-mt6368.c
@@ -0,0 +1,298 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek ALSA SoC machine driver for MT6897 boards with the MT6368 PMIC codec
+ * and smart amplifiers on a TDM link
+ */
+
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "mt6897-afe-common.h"
+#include "../common/mtk-afe-platform-driver.h"
+#include "../common/mtk-soundcard-driver.h"
+#include "../../codecs/mt6368.h"
+
+#define CKSYS_AUD_TOP_CFG	0x032c
+#define CKSYS_AUD_TOP_MON	0x0330
+
+/* The phases of the link to the MT6368 that the codec can choose from */
+#define MT6897_MTKAIF_PHASES	42
+
+/*
+ * The amplifiers' register files fix their TDM link to 48 kHz, four slots of
+ * 32 bits, and the AFE has no rate converter between the memifs and the link.
+ */
+#define MT6897_TDM_RATE		48000
+#define MT6897_TDM_SLOTS	4
+
+/*
+ * Find, for each data pin of the link, the phase of the codec at which the delay
+ * of the returning test pulse changes, and use the one before it.
+ */
+static int mt6897_mt6368_mtkaif_calibration(struct snd_soc_pcm_runtime *rtd)
+{
+	struct snd_soc_component *cmpnt_afe = snd_soc_rtdcom_lookup(rtd, AFE_PCM_NAME);
+	struct snd_soc_component *cmpnt_codec = snd_soc_rtd_to_codec(rtd, 0)->component;
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(cmpnt_afe);
+	struct mt6897_afe_private *afe_priv = afe->platform_priv;
+	int prev_cycle[MT6897_MTKAIF_MISO_NUM] = { };
+	bool ok = true;
+	int phase, i, ret;
+
+	ret = pm_runtime_resume_and_get(afe->dev);
+	if (ret)
+		return ret;
+
+	ret = mt6368_mtkaif_calibration_enable(cmpnt_codec);
+	if (ret)
+		goto out_pm;
+
+	/* Protocol 2 with the second clock phase */
+	regmap_update_bits(afe->regmap, AFE_AUD_PAD_TOP_CFG0, 0xff, 0xb8);
+	regmap_update_bits(afe->regmap, AFE_AUD_PAD_TOP_CFG0, 0xff, 0xb9);
+
+	/* The test: a synchronizer pulse */
+	regmap_update_bits(afe_priv->topckgen, CKSYS_AUD_TOP_CFG, 0xffff, 0x4);
+
+	for (i = 0; i < MT6897_MTKAIF_MISO_NUM; i++)
+		afe_priv->mtkaif_chosen_phase[i] = -1;
+
+	for (phase = 0; phase <= MT6897_MTKAIF_PHASES && ok; phase++) {
+		int cycle[MT6897_MTKAIF_MISO_NUM] = { -1, -1, -1 };
+		bool done[MT6897_MTKAIF_MISO_NUM] = { };
+		unsigned int monitor;
+		int counter = 0;
+
+		mt6368_set_mtkaif_calibration_phase(cmpnt_codec, phase, phase, phase);
+
+		regmap_update_bits(afe_priv->topckgen, CKSYS_AUD_TOP_CFG, 0x1, 0x1);
+
+		while (!done[0] || !done[1] || !done[2]) {
+			regmap_read(afe_priv->topckgen, CKSYS_AUD_TOP_MON, &monitor);
+
+			for (i = 0; i < MT6897_MTKAIF_MISO_NUM; i++) {
+				if (!done[i] && (monitor >> (28 + i)) & 0x1) {
+					done[i] = true;
+					cycle[i] = (monitor >> (4 * i)) & 0xf;
+				}
+			}
+
+			if (++counter > 10000) {
+				dev_err(afe->dev, "MTKAIF test timed out at phase %d: %#x\n",
+					phase, monitor);
+				ok = false;
+				break;
+			}
+		}
+
+		if (phase == 0)
+			memcpy(prev_cycle, cycle, sizeof(prev_cycle));
+
+		for (i = 0; i < MT6897_MTKAIF_MISO_NUM; i++) {
+			if (cycle[i] != prev_cycle[i] &&
+			    afe_priv->mtkaif_chosen_phase[i] < 0) {
+				afe_priv->mtkaif_chosen_phase[i] = phase - 1;
+				afe_priv->mtkaif_phase_cycle[i] = prev_cycle[i];
+			}
+		}
+
+		regmap_update_bits(afe_priv->topckgen, CKSYS_AUD_TOP_CFG, 0x1, 0x0);
+
+		if (afe_priv->mtkaif_chosen_phase[0] >= 0 &&
+		    afe_priv->mtkaif_chosen_phase[1] >= 0 &&
+		    afe_priv->mtkaif_chosen_phase[2] >= 0)
+			break;
+	}
+
+	mt6368_set_mtkaif_calibration_phase(cmpnt_codec,
+					    max(afe_priv->mtkaif_chosen_phase[0], 0),
+					    max(afe_priv->mtkaif_chosen_phase[1], 0),
+					    max(afe_priv->mtkaif_chosen_phase[2], 0));
+
+	regmap_update_bits(afe->regmap, AFE_AUD_PAD_TOP_CFG0, 0xff, 0xb8);
+
+	mt6368_mtkaif_calibration_disable(cmpnt_codec);
+
+	dev_info(afe->dev, "MTKAIF phases %d/%d/%d, cycles %d/%d/%d\n",
+		 afe_priv->mtkaif_chosen_phase[0], afe_priv->mtkaif_chosen_phase[1],
+		 afe_priv->mtkaif_chosen_phase[2], afe_priv->mtkaif_phase_cycle[0],
+		 afe_priv->mtkaif_phase_cycle[1], afe_priv->mtkaif_phase_cycle[2]);
+
+out_pm:
+	pm_runtime_put(afe->dev);
+
+	return ret;
+}
+
+static int mt6897_adda_init(struct snd_soc_pcm_runtime *rtd)
+{
+	struct snd_soc_component *cmpnt_afe = snd_soc_rtdcom_lookup(rtd, AFE_PCM_NAME);
+	struct snd_soc_component *cmpnt_codec = snd_soc_rtd_to_codec(rtd, 0)->component;
+	struct mtk_base_afe *afe;
+	struct mt6897_afe_private *afe_priv;
+
+	if (!cmpnt_afe)
+		return -EINVAL;
+
+	/* The card without a codec on this link tries the AFE alone */
+	if (strcmp(cmpnt_codec->name, "snd-soc-dummy") == 0)
+		return 0;
+
+	afe = snd_soc_component_get_drvdata(cmpnt_afe);
+	afe_priv = afe->platform_priv;
+
+	mt6368_set_mtkaif_protocol(cmpnt_codec, afe_priv->mtkaif_protocol);
+
+	return mt6897_mt6368_mtkaif_calibration(rtd);
+}
+
+static int mt6897_fe_startup(struct snd_pcm_substream *substream)
+{
+	return snd_pcm_hw_constraint_single(substream->runtime,
+					    SNDRV_PCM_HW_PARAM_RATE,
+					    MT6897_TDM_RATE);
+}
+
+static const struct snd_soc_ops mt6897_fe_ops = {
+	.startup = mt6897_fe_startup,
+};
+
+static int mt6897_tdm_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
+				      struct snd_pcm_hw_params *params)
+{
+	hw_param_interval(params, SNDRV_PCM_HW_PARAM_RATE)->min = MT6897_TDM_RATE;
+	hw_param_interval(params, SNDRV_PCM_HW_PARAM_RATE)->max = MT6897_TDM_RATE;
+	hw_param_interval(params, SNDRV_PCM_HW_PARAM_CHANNELS)->min = MT6897_TDM_SLOTS;
+	hw_param_interval(params, SNDRV_PCM_HW_PARAM_CHANNELS)->max = MT6897_TDM_SLOTS;
+
+	snd_mask_reset_range(hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT),
+			     0, (__force unsigned int)SNDRV_PCM_FORMAT_LAST);
+	params_set_format(params, SNDRV_PCM_FORMAT_S32_LE);
+
+	return 0;
+}
+
+SND_SOC_DAILINK_DEFS(playback0,
+		     DAILINK_COMP_ARRAY(COMP_CPU("DL0")),
+		     DAILINK_COMP_ARRAY(COMP_DUMMY()),
+		     DAILINK_COMP_ARRAY(COMP_EMPTY()));
+SND_SOC_DAILINK_DEFS(playback1,
+		     DAILINK_COMP_ARRAY(COMP_CPU("DL1")),
+		     DAILINK_COMP_ARRAY(COMP_DUMMY()),
+		     DAILINK_COMP_ARRAY(COMP_EMPTY()));
+SND_SOC_DAILINK_DEFS(capture0,
+		     DAILINK_COMP_ARRAY(COMP_CPU("UL0")),
+		     DAILINK_COMP_ARRAY(COMP_DUMMY()),
+		     DAILINK_COMP_ARRAY(COMP_EMPTY()));
+SND_SOC_DAILINK_DEFS(capture1,
+		     DAILINK_COMP_ARRAY(COMP_CPU("UL1")),
+		     DAILINK_COMP_ARRAY(COMP_DUMMY()),
+		     DAILINK_COMP_ARRAY(COMP_EMPTY()));
+SND_SOC_DAILINK_DEFS(i2sout4,
+		     DAILINK_COMP_ARRAY(COMP_CPU("I2SOUT4")),
+		     DAILINK_COMP_ARRAY(COMP_DUMMY()),
+		     DAILINK_COMP_ARRAY(COMP_EMPTY()));
+SND_SOC_DAILINK_DEFS(i2sin4,
+		     DAILINK_COMP_ARRAY(COMP_CPU("I2SIN4")),
+		     DAILINK_COMP_ARRAY(COMP_DUMMY()),
+		     DAILINK_COMP_ARRAY(COMP_EMPTY()));
+SND_SOC_DAILINK_DEFS(adda,
+		     DAILINK_COMP_ARRAY(COMP_CPU("ADDA")),
+		     DAILINK_COMP_ARRAY(COMP_DUMMY()),
+		     DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+#define MT6897_FE(_name, _dailink, _dir) \
+	{ \
+		.name = _name "_FE", \
+		.stream_name = _name, \
+		.trigger = { SND_SOC_DPCM_TRIGGER_PRE, SND_SOC_DPCM_TRIGGER_PRE }, \
+		.dynamic = 1, \
+		._dir = 1, \
+		.ops = &mt6897_fe_ops, \
+		SND_SOC_DAILINK_REG(_dailink), \
+	}
+
+static struct snd_soc_dai_link mt6897_dai_links[] = {
+	/* Front ends, the PCM devices */
+	MT6897_FE("DL0", playback0, playback_only),
+	MT6897_FE("DL1", playback1, playback_only),
+	MT6897_FE("UL0", capture0, capture_only),
+	MT6897_FE("UL1", capture1, capture_only),
+
+	/* Back ends */
+	{
+		.name = "I2SOUT4_BE",
+		.no_pcm = 1,
+		.playback_only = 1,
+		.ignore_suspend = 1,
+		.ignore_pmdown_time = 1,
+		.be_hw_params_fixup = mt6897_tdm_hw_params_fixup,
+		SND_SOC_DAILINK_REG(i2sout4),
+	},
+	{
+		.name = "I2SIN4_BE",
+		.no_pcm = 1,
+		.capture_only = 1,
+		.ignore_suspend = 1,
+		.be_hw_params_fixup = mt6897_tdm_hw_params_fixup,
+		SND_SOC_DAILINK_REG(i2sin4),
+	},
+	{
+		.name = "ADDA_BE",
+		.no_pcm = 1,
+		.capture_only = 1,
+		.ignore_suspend = 1,
+		.init = mt6897_adda_init,
+		SND_SOC_DAILINK_REG(adda),
+	},
+};
+
+static const struct snd_soc_dapm_widget mt6897_widgets[] = {
+	SND_SOC_DAPM_SPK("Speakers", NULL),
+};
+
+static const struct snd_kcontrol_new mt6897_controls[] = {
+	SOC_DAPM_PIN_SWITCH("Speakers"),
+};
+
+static struct snd_soc_card mt6897_soc_card = {
+	.owner = THIS_MODULE,
+	.dai_link = mt6897_dai_links,
+	.num_links = ARRAY_SIZE(mt6897_dai_links),
+	.dapm_widgets = mt6897_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(mt6897_widgets),
+	.controls = mt6897_controls,
+	.num_controls = ARRAY_SIZE(mt6897_controls),
+};
+
+static const struct mtk_soundcard_pdata mt6897_mt6368_card = {
+	.card_name = "mt6897_mt6368",
+	.card_data = &(struct mtk_platform_card_data) {
+		.card = &mt6897_soc_card,
+	},
+};
+
+static const struct of_device_id mt6897_mt6368_dt_match[] = {
+	{ .compatible = "mediatek,mt6897-mt6368-sound", .data = &mt6897_mt6368_card },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, mt6897_mt6368_dt_match);
+
+static struct platform_driver mt6897_mt6368_driver = {
+	.driver = {
+		.name = "mt6897-mt6368",
+		.of_match_table = mt6897_mt6368_dt_match,
+		.pm = &snd_soc_pm_ops,
+	},
+	.probe = mtk_soundcard_common_probe,
+};
+module_platform_driver(mt6897_mt6368_driver);
+
+MODULE_DESCRIPTION("MediaTek ALSA SoC machine driver for MT6897 with MT6368");
+MODULE_LICENSE("GPL");
diff --git a/sound/soc/mediatek/mt6897/mt6897-reg.h b/sound/soc/mediatek/mt6897/mt6897-reg.h
new file mode 100644
index 0000000..ea73ce2
--- /dev/null
+++ b/sound/soc/mediatek/mt6897/mt6897-reg.h
@@ -0,0 +1,387 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MediaTek MT6897 audio driver register definitions
+ *
+ * Copyright (c) 2021 MediaTek Inc.
+ * Author: Tina Tsai <tina.tsai@mediatek.com>
+ */
+
+#ifndef _MT6897_REG_H_
+#define _MT6897_REG_H_
+
+enum {
+	MT6897_MEMIF_PBUF_SIZE_32_BYTES,
+	MT6897_MEMIF_PBUF_SIZE_64_BYTES,
+	MT6897_MEMIF_PBUF_SIZE_128_BYTES,
+	MT6897_MEMIF_PBUF_SIZE_256_BYTES,
+	MT6897_MEMIF_PBUF_SIZE_NUM,
+};
+
+/* registers */
+#define AUDIO_TOP_CON0                           0x0
+#define AUDIO_TOP_CON1                           0x4
+#define AUDIO_TOP_CON2                           0x8
+#define AUDIO_TOP_CON3                           0xc
+#define AUDIO_TOP_CON4                           0x10
+#define AUDIO_ENGEN_CON0                         0x14
+#define AFE_APLL1_TUNER_CFG                      0x30
+#define AFE_APLL1_TUNER_MON0                     0x34
+#define AFE_APLL2_TUNER_CFG                      0x38
+#define AFE_APLL2_TUNER_MON0                     0x3c
+#define AFE_SPM_CONTROL_ACK                      0x64
+#define AUDIO_ENGEN_CON0_MON                     0x7c
+#define AFE_IRQ_MCU_EN                           0x100
+#define AFE_CUSTOM_IRQ_MCU_EN                    0x110
+#define AFE_IRQ_MCU_STATUS                       0x120
+#define AFE_CUSTOM_IRQ_MCU_STATUS                0x124
+#define AFE_IRQ_MCU_CLR                          0x128
+#define AFE_CUSTOM_IRQ_MCU_CLR                   0x130
+#define AFE_IRQ0_MCU_CFG0                        0x140
+#define AFE_IRQ0_MCU_CFG1                        0x144
+#define AFE_IRQ1_MCU_CFG0                        0x148
+#define AFE_IRQ1_MCU_CFG1                        0x14c
+#define AFE_IRQ2_MCU_CFG0                        0x150
+#define AFE_IRQ2_MCU_CFG1                        0x154
+#define AFE_IRQ13_MCU_CFG0                       0x1a8
