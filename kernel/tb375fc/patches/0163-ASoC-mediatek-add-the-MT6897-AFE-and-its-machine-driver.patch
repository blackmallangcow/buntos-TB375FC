+static int mt6897_fe_startup(struct snd_pcm_substream *substream,
+			     struct snd_soc_dai *dai)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct mtk_base_afe_memif *memif = &afe->memif[snd_soc_rtd_to_cpu(rtd, 0)->id];
+	int ret;
+
+	memif->substream = substream;
+
+	ret = snd_pcm_hw_constraint_step(runtime, 0,
+					 SNDRV_PCM_HW_PARAM_BUFFER_BYTES, 16);
+	if (ret < 0)
+		return ret;
+
+	snd_soc_set_runtime_hwparams(substream, afe->mtk_afe_hardware);
+
+	ret = snd_pcm_hw_constraint_integer(runtime, SNDRV_PCM_HW_PARAM_PERIODS);
+	if (ret < 0)
+		return ret;
+
+	mt6897_afe_dram_request(afe);
+
+	return 0;
+}
+
+static void mt6897_fe_shutdown(struct snd_pcm_substream *substream,
+			       struct snd_soc_dai *dai)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mtk_base_afe_memif *memif = &afe->memif[snd_soc_rtd_to_cpu(rtd, 0)->id];
+
+	mt6897_afe_dram_release(afe);
+	memif->substream = NULL;
+}
+
+static int mt6897_fe_trigger(struct snd_pcm_substream *substream, int cmd,
+			     struct snd_soc_dai *dai)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_pcm_runtime *const runtime = substream->runtime;
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	int id = snd_soc_rtd_to_cpu(rtd, 0)->id;
+	struct mtk_base_afe_memif *memif = &afe->memif[id];
+	const struct mtk_base_irq_data *irq_data = afe->irqs[memif->irq_usage].irq_data;
+	int fs, ret;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+		ret = mtk_memif_set_enable(afe, id);
+		if (ret) {
+			dev_err(afe->dev, "memif %d enable failed: %d\n", id, ret);
+			return ret;
+		}
+
+		/* An uplink memif needs some data before its first interrupt */
+		if (substream->stream == SNDRV_PCM_STREAM_CAPTURE &&
+		    (runtime->period_size * 1000) / runtime->rate <= 10)
+			udelay(300);
+
+		regmap_update_bits(afe->regmap, irq_data->irq_cnt_reg,
+				   irq_data->irq_cnt_maskbit << irq_data->irq_cnt_shift,
+				   runtime->period_size << irq_data->irq_cnt_shift);
+
+		fs = afe->irq_fs(substream, runtime->rate);
+		if (fs < 0)
+			return fs;
+
+		regmap_update_bits(afe->regmap, irq_data->irq_fs_reg,
+				   irq_data->irq_fs_maskbit << irq_data->irq_fs_shift,
+				   fs << irq_data->irq_fs_shift);
+
+		regmap_update_bits(afe->regmap, irq_data->irq_en_reg,
+				   BIT(irq_data->irq_en_shift),
+				   BIT(irq_data->irq_en_shift));
+		return 0;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+		ret = mtk_memif_set_disable(afe, id);
+		if (ret)
+			dev_warn(afe->dev, "memif %d disable failed: %d\n", id, ret);
+
+		regmap_update_bits(afe->regmap, irq_data->irq_en_reg,
+				   BIT(irq_data->irq_en_shift), 0);
+
+		/* A pending interrupt must not fire on the next start */
+		regmap_write(afe->regmap, irq_data->irq_clr_reg,
+			     BIT(irq_data->irq_clr_shift));
+		return ret;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int mt6897_memif_fs(struct snd_pcm_substream *substream, unsigned int rate)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_component *component = snd_soc_rtdcom_lookup(rtd, AFE_PCM_NAME);
+
+	if (!component)
+		return -EINVAL;
+
+	return mt6897_rate_transform(component->dev, rate);
+}
+
+static int mt6897_get_dai_fs(struct mtk_base_afe *afe, int dai_id,
+			     unsigned int rate)
+{
+	return mt6897_rate_transform(afe->dev, rate);
+}
+
+static int mt6897_get_memif_pbuf_size(struct snd_pcm_substream *substream)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+
+	if ((runtime->period_size * 1000) / runtime->rate > 10)
+		return MT6897_MEMIF_PBUF_SIZE_256_BYTES;
+
+	return MT6897_MEMIF_PBUF_SIZE_32_BYTES;
+}
