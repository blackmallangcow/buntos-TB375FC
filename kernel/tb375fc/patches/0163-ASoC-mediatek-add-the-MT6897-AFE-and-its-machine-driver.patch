+static irqreturn_t mt6897_afe_irq_handler(int irq_id, void *dev)
+{
+	struct mtk_base_afe *afe = dev;
+	unsigned int status, status_mcu, mcu_en;
+	int i;
+
+	regmap_read(afe->regmap, AFE_IRQ_MCU_EN, &mcu_en);
+	regmap_read(afe->regmap, AFE_IRQ_MCU_STATUS, &status);
+
+	status_mcu = status & mcu_en & AFE_IRQ_STATUS_BITS;
+	if (!status_mcu)
+		return IRQ_NONE;
+
+	for (i = 0; i < MT6897_MEMIF_NUM; i++) {
+		struct mtk_base_afe_memif *memif = &afe->memif[i];
+
+		if (memif->substream &&
+		    (status_mcu & BIT(afe->irqs[memif->irq_usage].irq_data->id)))
+			snd_pcm_period_elapsed(memif->substream);
+	}
+
+	regmap_write(afe->regmap, AFE_IRQ_MCU_CLR, status_mcu);
+
+	return IRQ_HANDLED;
+}
