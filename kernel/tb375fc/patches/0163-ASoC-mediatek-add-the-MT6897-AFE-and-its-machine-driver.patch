diff --git a/sound/soc/mediatek/mt6897/mt6897-afe-clk.c b/sound/soc/mediatek/mt6897/mt6897-afe-clk.c
new file mode 100644
index 0000000..861b94e
--- /dev/null
+++ b/sound/soc/mediatek/mt6897/mt6897-afe-clk.c
@@ -0,0 +1,242 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek MT6897 AFE clock control
+ *
+ * Copyright (c) 2021 MediaTek Inc.
+ * Author: Tina Tsai <tina.tsai@mediatek.com>
+ *
+ * The audio gates live in the AFE's own AUDIO_TOP_CON registers and are
+ * handled with the rest of the AFE, so this file only deals with the clocks
+ * that come from outside.
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/clk.h>
+#include <linux/regmap.h>
+#include <linux/soc/mediatek/mtk_sip_svc.h>
+
+#include "mt6897-afe-clk.h"
+#include "mt6897-afe-common.h"
+
+static const char *const aud_clks[MT6897_CLK_NUM] = {
+	[MT6897_CLK_AUD_INTBUS] = "top_aud_intbus",
+	[MT6897_CLK_AUD_H] = "top_aud_h",
+	[MT6897_CLK_AUD_1] = "top_aud_1",
+	[MT6897_CLK_AUD_2] = "top_aud_2",
+	[MT6897_CLK_AUD_ENG1] = "top_aud_eng1",
+	[MT6897_CLK_AUD_ENG2] = "top_aud_eng2",
+	[MT6897_CLK_APLL1] = "apll1",
+	[MT6897_CLK_APLL2] = "apll2",
+	[MT6897_CLK_APLL1_D2] = "apll1_d2",
+	[MT6897_CLK_APLL2_D2] = "apll2_d2",
+	[MT6897_CLK_APLL1_D4] = "apll1_d4",
+	[MT6897_CLK_APLL2_D4] = "apll2_d4",
+	[MT6897_CLK_26M] = "clk26m",
+};
+
+static int mt6897_afe_enable_mux(struct mtk_base_afe *afe, int mux, int parent)
+{
+	struct mt6897_afe_private *afe_priv = afe->platform_priv;
+	int ret;
+
+	ret = clk_prepare_enable(afe_priv->clk[mux]);
+	if (ret) {
+		dev_err(afe->dev, "failed to enable %s: %d\n", aud_clks[mux], ret);
+		return ret;
+	}
+
+	ret = clk_set_parent(afe_priv->clk[mux], afe_priv->clk[parent]);
+	if (ret) {
+		dev_err(afe->dev, "failed to set %s to %s: %d\n",
+			aud_clks[mux], aud_clks[parent], ret);
+		clk_disable_unprepare(afe_priv->clk[mux]);
+	}
+
+	return ret;
+}
+
+/* Back on 26 MHz before the gate closes, so that the APLL can stop */
+static void mt6897_afe_disable_mux(struct mtk_base_afe *afe, int mux)
+{
+	struct mt6897_afe_private *afe_priv = afe->platform_priv;
+	int ret;
+
+	ret = clk_set_parent(afe_priv->clk[mux], afe_priv->clk[MT6897_CLK_26M]);
+	if (ret)
+		dev_warn(afe->dev, "failed to set %s to 26 MHz: %d\n",
+			 aud_clks[mux], ret);
+
+	clk_disable_unprepare(afe_priv->clk[mux]);
+}
+
+int mt6897_afe_enable_clock(struct mtk_base_afe *afe)
+{
+	struct arm_smccc_res res;
+	int ret;
+
+	ret = mt6897_afe_enable_mux(afe, MT6897_CLK_AUD_INTBUS, MT6897_CLK_26M);
+	if (ret)
+		return ret;
+
+	ret = mt6897_afe_enable_mux(afe, MT6897_CLK_AUD_H, MT6897_CLK_26M);
+	if (ret) {
+		mt6897_afe_disable_mux(afe, MT6897_CLK_AUD_INTBUS);
+		return ret;
+	}
+
+	/* The firmware tells the SPM about the domain's sidebands */
+	arm_smccc_smc(MTK_SIP_AUDIO_CONTROL, MTK_AUDIO_SMC_OP_DOMAIN_SIDEBANDS,
+		      0, 0, 0, 0, 0, 0, &res);
+	arm_smccc_smc(MTK_SIP_AUDIO_CONTROL, MTK_AUDIO_SMC_OP_SRAM_REQUEST,
+		      0, 0, 0, 0, 0, 0, &res);
+
+	return 0;
+}
+
+void mt6897_afe_disable_clock(struct mtk_base_afe *afe)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(MTK_SIP_AUDIO_CONTROL, MTK_AUDIO_SMC_OP_SRAM_RELEASE,
+		      0, 0, 0, 0, 0, 0, &res);
+
+	mt6897_afe_disable_mux(afe, MT6897_CLK_AUD_H);
+	mt6897_afe_disable_mux(afe, MT6897_CLK_AUD_INTBUS);
+}
+
+void mt6897_afe_dram_request(struct mtk_base_afe *afe)
+{
+	struct mt6897_afe_private *afe_priv = afe->platform_priv;
+	struct arm_smccc_res res;
+
+	guard(mutex)(&afe_priv->dram_lock);
+
+	if (!afe_priv->dram_users++)
+		arm_smccc_smc(MTK_SIP_AUDIO_CONTROL, MTK_AUDIO_SMC_OP_DRAM_REQUEST,
+			      0, 0, 0, 0, 0, 0, &res);
+}
+
+void mt6897_afe_dram_release(struct mtk_base_afe *afe)
+{
+	struct mt6897_afe_private *afe_priv = afe->platform_priv;
+	struct arm_smccc_res res;
+
+	guard(mutex)(&afe_priv->dram_lock);
+
+	if (!--afe_priv->dram_users)
+		arm_smccc_smc(MTK_SIP_AUDIO_CONTROL, MTK_AUDIO_SMC_OP_DRAM_RELEASE,
+			      0, 0, 0, 0, 0, 0, &res);
+}
+
+int mt6897_apll_enable(struct mtk_base_afe *afe, int apll)
+{
+	struct mt6897_afe_private *afe_priv = afe->platform_priv;
+	bool first = apll == MT6897_APLL1;
+	int aud = first ? MT6897_CLK_AUD_1 : MT6897_CLK_AUD_2;
+	int eng = first ? MT6897_CLK_AUD_ENG1 : MT6897_CLK_AUD_ENG2;
+	int pll = first ? MT6897_CLK_APLL1 : MT6897_CLK_APLL2;
+	int ret;
+
+	ret = mt6897_afe_enable_mux(afe, aud, pll);
+	if (ret)
+		return ret;
+
+	/* The 22.5792 or 24.576 MHz family, APLL / 4 */
+	ret = mt6897_afe_enable_mux(afe, eng,
+				    first ? MT6897_CLK_APLL1_D4 : MT6897_CLK_APLL2_D4);
+	if (ret)
+		goto err_aud;
+
+	ret = clk_set_parent(afe_priv->clk[MT6897_CLK_AUD_H],
+			     afe_priv->clk[first ? MT6897_CLK_APLL1_D2 : MT6897_CLK_APLL2_D2]);
+	if (ret) {
+		dev_err(afe->dev, "failed to set the audio_h parent: %d\n", ret);
+		goto err_eng;
+	}
+
+	ret = clk_prepare_enable(afe_priv->clk[pll]);
+	if (ret) {
+		dev_err(afe->dev, "failed to enable %s: %d\n", aud_clks[pll], ret);
+		goto err_h;
+	}
+
+	if (first) {
+		regmap_update_bits(afe->regmap, AFE_APLL1_TUNER_CFG, 0xfff7, 0x372);
+		regmap_update_bits(afe->regmap, AFE_APLL1_TUNER_CFG, 0x1, 0x1);
+		regmap_update_bits(afe->regmap, AUDIO_ENGEN_CON0,
+				   AUDIO_APLL1_EN_ON_MASK_SFT,
+				   BIT(AUDIO_APLL1_EN_ON_SFT));
+	} else {
+		regmap_update_bits(afe->regmap, AFE_APLL2_TUNER_CFG, 0xfff7, 0x374);
+		regmap_update_bits(afe->regmap, AFE_APLL2_TUNER_CFG, 0x1, 0x1);
+		regmap_update_bits(afe->regmap, AUDIO_ENGEN_CON0,
+				   AUDIO_APLL2_EN_ON_MASK_SFT,
+				   BIT(AUDIO_APLL2_EN_ON_SFT));
+	}
+
+	return 0;
+
+err_h:
+	clk_set_parent(afe_priv->clk[MT6897_CLK_AUD_H],
+		       afe_priv->clk[MT6897_CLK_26M]);
+err_eng:
+	mt6897_afe_disable_mux(afe, eng);
+err_aud:
+	mt6897_afe_disable_mux(afe, aud);
+
+	return ret;
+}
+
+void mt6897_apll_disable(struct mtk_base_afe *afe, int apll)
+{
+	struct mt6897_afe_private *afe_priv = afe->platform_priv;
+	bool first = apll == MT6897_APLL1;
+
+	if (first) {
+		regmap_update_bits(afe->regmap, AUDIO_ENGEN_CON0,
+				   AUDIO_APLL1_EN_ON_MASK_SFT, 0);
+		regmap_update_bits(afe->regmap, AFE_APLL1_TUNER_CFG, 0x1, 0);
+	} else {
+		regmap_update_bits(afe->regmap, AUDIO_ENGEN_CON0,
+				   AUDIO_APLL2_EN_ON_MASK_SFT, 0);
+		regmap_update_bits(afe->regmap, AFE_APLL2_TUNER_CFG, 0x1, 0);
+	}
+
+	clk_disable_unprepare(afe_priv->clk[first ? MT6897_CLK_APLL1 : MT6897_CLK_APLL2]);
+
+	clk_set_parent(afe_priv->clk[MT6897_CLK_AUD_H],
+		       afe_priv->clk[MT6897_CLK_26M]);
+
+	mt6897_afe_disable_mux(afe, first ? MT6897_CLK_AUD_ENG1 : MT6897_CLK_AUD_ENG2);
+	mt6897_afe_disable_mux(afe, first ? MT6897_CLK_AUD_1 : MT6897_CLK_AUD_2);
+}
+
+int mt6897_get_apll_by_rate(unsigned int rate)
+{
+	return rate % 8000 ? MT6897_APLL1 : MT6897_APLL2;
+}
+
+int mt6897_get_apll_by_name(const char *name)
+{
+	return strcmp(name, APLL1_W_NAME) ? MT6897_APLL2 : MT6897_APLL1;
+}
+
+int mt6897_init_clock(struct mtk_base_afe *afe)
+{
+	struct mt6897_afe_private *afe_priv = afe->platform_priv;
+	int i;
+
+	afe_priv->clk = devm_kcalloc(afe->dev, MT6897_CLK_NUM,
+				     sizeof(*afe_priv->clk), GFP_KERNEL);
+	if (!afe_priv->clk)
+		return -ENOMEM;
+
+	for (i = 0; i < MT6897_CLK_NUM; i++) {
+		afe_priv->clk[i] = devm_clk_get(afe->dev, aud_clks[i]);
+		if (IS_ERR(afe_priv->clk[i]))
+			return dev_err_probe(afe->dev, PTR_ERR(afe_priv->clk[i]),
+					     "failed to get %s\n", aud_clks[i]);
+	}
+
+	return 0;
+}
diff --git a/sound/soc/mediatek/mt6897/mt6897-afe-clk.h b/sound/soc/mediatek/mt6897/mt6897-afe-clk.h
new file mode 100644
index 0000000..ee9c867
--- /dev/null
+++ b/sound/soc/mediatek/mt6897/mt6897-afe-clk.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MediaTek MT6897 AFE clock control definitions
+ *
+ * Copyright (c) 2021 MediaTek Inc.
+ * Author: Tina Tsai <tina.tsai@mediatek.com>
+ */
+
+#ifndef _MT6897_AFE_CLK_H_
+#define _MT6897_AFE_CLK_H_
+
+/* APLL */
+#define APLL1_W_NAME "APLL1"
+#define APLL2_W_NAME "APLL2"
+
+enum {
+	MT6897_APLL1,
+	MT6897_APLL2,
+};
+
+enum {
+	MT6897_CLK_AUD_INTBUS,
+	MT6897_CLK_AUD_H,
+	MT6897_CLK_AUD_1,
+	MT6897_CLK_AUD_2,
+	MT6897_CLK_AUD_ENG1,
+	MT6897_CLK_AUD_ENG2,
+	MT6897_CLK_APLL1,
+	MT6897_CLK_APLL2,
+	MT6897_CLK_APLL1_D2,
+	MT6897_CLK_APLL2_D2,
+	MT6897_CLK_APLL1_D4,
+	MT6897_CLK_APLL2_D4,
+	MT6897_CLK_26M,
+	MT6897_CLK_NUM,
+};
+
+struct mtk_base_afe;
+
+int mt6897_init_clock(struct mtk_base_afe *afe);
+int mt6897_afe_enable_clock(struct mtk_base_afe *afe);
+void mt6897_afe_disable_clock(struct mtk_base_afe *afe);
+void mt6897_afe_dram_request(struct mtk_base_afe *afe);
+void mt6897_afe_dram_release(struct mtk_base_afe *afe);
+int mt6897_apll_enable(struct mtk_base_afe *afe, int apll);
+void mt6897_apll_disable(struct mtk_base_afe *afe, int apll);
+int mt6897_get_apll_by_rate(unsigned int rate);
+int mt6897_get_apll_by_name(const char *name);
+
+#endif
diff --git a/sound/soc/mediatek/mt6897/mt6897-afe-common.h b/sound/soc/mediatek/mt6897/mt6897-afe-common.h
new file mode 100644
index 0000000..5b937a4
--- /dev/null
+++ b/sound/soc/mediatek/mt6897/mt6897-afe-common.h
@@ -0,0 +1,92 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MediaTek MT6897 audio driver definitions
+ *
+ * Copyright (c) 2021 MediaTek Inc.
+ * Author: Tina Tsai <tina.tsai@mediatek.com>
+ */
+
+#ifndef _MT6897_AFE_COMMON_H_
+#define _MT6897_AFE_COMMON_H_
+
+#include <sound/pcm.h>
+#include <sound/soc.h>
+
+#include "mt6897-reg.h"
+#include "../common/mtk-base-afe.h"
+
+/* HW IPM 2.0 */
+enum {
+	MTK_AFE_IPM2P0_RATE_8K = 0x0,
+	MTK_AFE_IPM2P0_RATE_11K = 0x1,
+	MTK_AFE_IPM2P0_RATE_12K = 0x2,
+	MTK_AFE_IPM2P0_RATE_16K = 0x4,
+	MTK_AFE_IPM2P0_RATE_22K = 0x5,
+	MTK_AFE_IPM2P0_RATE_24K = 0x6,
+	MTK_AFE_IPM2P0_RATE_32K = 0x8,
+	MTK_AFE_IPM2P0_RATE_44K = 0x9,
+	MTK_AFE_IPM2P0_RATE_48K = 0xa,
+	MTK_AFE_IPM2P0_RATE_88K = 0xd,
+	MTK_AFE_IPM2P0_RATE_96K = 0xe,
+	MTK_AFE_IPM2P0_RATE_176K = 0x11,
+	MTK_AFE_IPM2P0_RATE_192K = 0x12,
+};
+
+enum {
+	MT6897_MEMIF_DL0,
+	MT6897_MEMIF_DL1,
+	MT6897_MEMIF_DL2,
+	MT6897_MEMIF_VUL0,
+	MT6897_MEMIF_VUL1,
+	MT6897_MEMIF_VUL2,
+	MT6897_MEMIF_VUL3,
+	MT6897_MEMIF_NUM,
+	MT6897_DAI_I2S_IN4 = MT6897_MEMIF_NUM,
+	MT6897_DAI_I2S_OUT4,
+	MT6897_DAI_ADDA,
+	MT6897_DAI_NUM,
+};
+
+/* irq ID (= enum) from AFE_IRQ_MCU_STATUS */
+enum {
+	MT6897_IRQ_0,
+	MT6897_IRQ_1,
+	MT6897_IRQ_2,
+	MT6897_IRQ_13 = 13,
+	MT6897_IRQ_14,
+	MT6897_IRQ_15,
+	MT6897_IRQ_16,
+	MT6897_IRQ_NUM,
+};
+
+enum {
+	MTKAIF_PROTOCOL_1 = 0,
+	MTKAIF_PROTOCOL_2,
+	MTKAIF_PROTOCOL_2_CLK_P2,
+};
+
+/* The data pins of the link to the MT6368, the third is for channels 3 and 4 */
+#define MT6897_MTKAIF_MISO_NUM 3
+
+struct clk;
+struct mtk_base_afe;
+struct regmap;
+
+struct mt6897_afe_private {
+	struct clk **clk;
+	struct regmap *topckgen;
+	/* serializes the DRAM request, which several memifs can hold */
+	struct mutex dram_lock;
+	int dram_users;
+	/* MTKAIF, the calibration runs in the machine driver */
+	int mtkaif_protocol;
+	int mtkaif_chosen_phase[MT6897_MTKAIF_MISO_NUM];
+	int mtkaif_phase_cycle[MT6897_MTKAIF_MISO_NUM];
+	/* dai */
+	void *dai_priv[MT6897_DAI_NUM];
+};
+
+int mt6897_dai_adda_register(struct mtk_base_afe *afe);
+int mt6897_dai_i2s_register(struct mtk_base_afe *afe);
+
+#endif
diff --git a/sound/soc/mediatek/mt6897/mt6897-afe-pcm.c b/sound/soc/mediatek/mt6897/mt6897-afe-pcm.c
new file mode 100644
index 0000000..7fb6042
--- /dev/null
+++ b/sound/soc/mediatek/mt6897/mt6897-afe-pcm.c
@@ -0,0 +1,789 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek ALSA SoC AFE platform driver for MT6897
+ *
+ * Copyright (c) 2021 MediaTek Inc.
+ * Author: Tina Tsai <tina.tsai@mediatek.com>
+ */
+
