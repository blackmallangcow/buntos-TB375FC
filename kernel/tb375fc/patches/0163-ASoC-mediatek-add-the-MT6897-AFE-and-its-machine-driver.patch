+static void mt6897_afe_init_hw(struct mtk_base_afe *afe)
+{
+	/* The module gates stay open while the domain is on */
+	regmap_write(afe->regmap, AUDIO_TOP_CON0, 0);
+	regmap_write(afe->regmap, AUDIO_TOP_CON1, 0);
+	regmap_write(afe->regmap, AUDIO_TOP_CON2, 0);
+	regmap_write(afe->regmap, AUDIO_TOP_CON3, 0);
+
+	regmap_write(afe->regmap, AFE_IRQ_MCU_EN, 0xffffffff);
+
+	regmap_update_bits(afe->regmap, AFE_CBIP_CFG0, 0x1, 0x1);
+
+	/* The CPU writes 32-bit data in the 8.24 format */
+	regmap_update_bits(afe->regmap, AFE_MEMIF_CON0, CPU_HD_ALIGN_MASK_SFT, 0);
+
+	regmap_update_bits(afe->regmap, AUDIO_ENGEN_CON0,
+			   AUDIO_26M_EN_ON_MASK_SFT, AUDIO_26M_EN_ON_MASK_SFT);
+}
+
+static int mt6897_afe_runtime_suspend(struct device *dev)
+{
+	struct mtk_base_afe *afe = dev_get_drvdata(dev);
+	unsigned int value;
+	int ret;
+
+	if (!afe->regmap)
+		goto skip_regmap;
+
+	regmap_update_bits(afe->regmap, AUDIO_ENGEN_CON0,
+			   AUDIO_26M_EN_ON_MASK_SFT, 0);
+
+	ret = regmap_read_poll_timeout(afe->regmap, AUDIO_ENGEN_CON0_MON, value,
+				       (value & AUDIO_ENGEN_MON_SFT) == 0,
+				       20, 1000 * 1000);
+	if (ret)
+		dev_warn(afe->dev, "the engine did not stop: %d\n", ret);
+
+	regmap_write(afe->regmap, AFE_IRQ_MCU_CLR, 0xffffffff);
+	regmap_write(afe->regmap, AFE_CUSTOM_IRQ_MCU_CLR, 0xffffffff);
+
+	regcache_cache_only(afe->regmap, true);
+	regcache_mark_dirty(afe->regmap);
+
+skip_regmap:
+	mt6897_afe_disable_clock(afe);
+
+	return 0;
+}
+
+static int mt6897_afe_runtime_resume(struct device *dev)
+{
+	struct mtk_base_afe *afe = dev_get_drvdata(dev);
+	int ret;
+
+	ret = mt6897_afe_enable_clock(afe);
+	if (ret)
+		return ret;
+
+	/*
+	 * The hopping and 26 MHz gates feed the registers themselves, so they
+	 * open before anything else touches the block, the regmap included.
+	 */
+	writel(0, afe->base_addr + AUDIO_TOP_CON4);
+
+	if (!afe->regmap)
+		return 0;
+
+	regcache_cache_only(afe->regmap, false);
+	ret = regcache_sync(afe->regmap);
+	if (ret)
+		dev_warn(afe->dev, "regcache sync failed: %d\n", ret);
+
+	mt6897_afe_init_hw(afe);
+
+	return 0;
+}
+
+static int mt6897_afe_component_probe(struct snd_soc_component *component)
+{
+	return mtk_afe_add_sub_dai_control(component);
+}
+
+static int mt6897_afe_pcm_open(struct snd_soc_component *component,
+			       struct snd_pcm_substream *substream)
+{
+	substream->wait_time = msecs_to_jiffies(2 * 1000);
+
+	return 0;
+}
+
+static void mt6897_afe_pcm_free(struct snd_soc_component *component,
+				struct snd_pcm *pcm)
+{
+	snd_pcm_lib_preallocate_free_for_all(pcm);
+}
+
+static const struct snd_soc_component_driver mt6897_afe_component = {
+	.name = AFE_PCM_NAME,
+	.probe = mt6897_afe_component_probe,
+	.pcm_new = mtk_afe_pcm_new,
+	.pcm_free = mt6897_afe_pcm_free,
+	.open = mt6897_afe_pcm_open,
+	.pointer = mtk_afe_pcm_pointer,
+};
+
+static int mt6897_dai_memif_register(struct mtk_base_afe *afe)
+{
+	struct mtk_base_afe_dai *dai;
+
+	dai = devm_kzalloc(afe->dev, sizeof(*dai), GFP_KERNEL);
+	if (!dai)
+		return -ENOMEM;
+
+	dai->dai_drivers = mt6897_memif_dai_driver;
+	dai->num_dai_drivers = ARRAY_SIZE(mt6897_memif_dai_driver);
+	dai->dapm_widgets = mt6897_memif_widgets;
+	dai->num_dapm_widgets = ARRAY_SIZE(mt6897_memif_widgets);
+	dai->dapm_routes = mt6897_memif_routes;
+	dai->num_dapm_routes = ARRAY_SIZE(mt6897_memif_routes);
+
+	list_add(&dai->list, &afe->sub_dais);
+
+	return 0;
+}
+
+typedef int (*dai_register_cb)(struct mtk_base_afe *);
+static const dai_register_cb dai_register_cbs[] = {
+	mt6897_dai_adda_register,
+	mt6897_dai_i2s_register,
+	mt6897_dai_memif_register,
+};
+
+static int mt6897_afe_pcm_dev_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mt6897_afe_private *afe_priv;
+	struct mtk_base_afe *afe;
+	int i, irq_id, ret;
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(34));
+	if (ret)
+		return ret;
+
+	afe = devm_kzalloc(dev, sizeof(*afe), GFP_KERNEL);
+	if (!afe)
+		return -ENOMEM;
+
+	platform_set_drvdata(pdev, afe);
+	afe->dev = dev;
+
+	afe->platform_priv = devm_kzalloc(dev, sizeof(*afe_priv), GFP_KERNEL);
+	if (!afe->platform_priv)
+		return -ENOMEM;
+
+	afe_priv = afe->platform_priv;
+	ret = devm_mutex_init(dev, &afe_priv->dram_lock);
+	if (ret)
+		return ret;
+
+	afe_priv->topckgen = syscon_regmap_lookup_by_phandle(dev->of_node,
+							     "mediatek,topckgen");
+	if (IS_ERR(afe_priv->topckgen))
+		return dev_err_probe(dev, PTR_ERR(afe_priv->topckgen),
+				     "failed to get topckgen\n");
+
+	afe_priv->mtkaif_protocol = MTKAIF_PROTOCOL_2_CLK_P2;
+	for (i = 0; i < MT6897_MTKAIF_MISO_NUM; i++)
+		afe_priv->mtkaif_chosen_phase[i] = -1;
+
+	afe->base_addr = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(afe->base_addr))
+		return dev_err_probe(dev, PTR_ERR(afe->base_addr),
+				     "AFE base_addr not found\n");
+
+	ret = mt6897_init_clock(afe);
+	if (ret)
+		return ret;
+
+	afe->memif_32bit_supported = 1;
+	afe->memif_size = MT6897_MEMIF_NUM;
+	afe->memif = devm_kcalloc(dev, afe->memif_size, sizeof(*afe->memif),
+				  GFP_KERNEL);
+	if (!afe->memif)
+		return -ENOMEM;
+
+	for (i = 0; i < afe->memif_size; i++) {
+		afe->memif[i].data = &memif_data[i];
+		afe->memif[i].irq_usage = memif_irq_usage[i];
+		afe->memif[i].const_irq = 1;
+	}
+
+	mutex_init(&afe->irq_alloc_lock);
+
+	afe->irqs_size = MT6897_IRQ_NUM;
+	afe->irqs = devm_kcalloc(dev, afe->irqs_size, sizeof(*afe->irqs),
+				 GFP_KERNEL);
+	if (!afe->irqs)
+		return -ENOMEM;
+
+	for (i = 0; i < afe->irqs_size; i++)
+		afe->irqs[i].irq_data = &irq_data[i];
+
+	INIT_LIST_HEAD(&afe->sub_dais);
+
+	for (i = 0; i < ARRAY_SIZE(dai_register_cbs); i++) {
+		ret = dai_register_cbs[i](afe);
+		if (ret)
+			return dev_err_probe(dev, ret, "dai register %d failed\n", i);
+	}
+
+	ret = mtk_afe_combine_sub_dai(afe);
+	if (ret)
+		return dev_err_probe(dev, ret, "mtk_afe_combine_sub_dai failed\n");
+
+	afe->mtk_afe_hardware = &mt6897_afe_hardware;
+	afe->memif_fs = mt6897_memif_fs;
+	afe->irq_fs = mt6897_memif_fs;
+	afe->get_dai_fs = mt6897_get_dai_fs;
+	afe->get_memif_pbuf_size = mt6897_get_memif_pbuf_size;
+	afe->runtime_resume = mt6897_afe_runtime_resume;
+	afe->runtime_suspend = mt6897_afe_runtime_suspend;
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+
+	/*
+	 * The audio device is part of a genpd domain. As a syscore device the
+	 * domain is not turned off behind it across suspend.
+	 */
+	dev_pm_syscore_device(dev, true);
+
+	/* The regmap reads its defaults from the hardware */
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to resume the AFE\n");
+
+	afe->regmap = devm_regmap_init_mmio(dev, afe->base_addr,
+					    &mt6897_afe_regmap_config);
+	if (IS_ERR(afe->regmap)) {
+		ret = PTR_ERR(afe->regmap);
+		goto err_pm_put;
+	}
+
+	/* The first resume above had no regmap yet */
+	mt6897_afe_init_hw(afe);
+
+	irq_id = platform_get_irq(pdev, 0);
+	if (irq_id < 0) {
+		ret = irq_id;
+		goto err_pm_put;
+	}
+
+	ret = devm_request_irq(dev, irq_id, mt6897_afe_irq_handler,
+			       IRQF_TRIGGER_NONE, "mt6897-afe", afe);
+	if (ret) {
+		dev_err(dev, "failed to request the interrupt: %d\n", ret);
+		goto err_pm_put;
+	}
+
+	pm_runtime_put_sync(dev);
+
+	ret = devm_snd_soc_register_component(dev, &mt6897_afe_component,
+					      afe->dai_drivers,
+					      afe->num_dai_drivers);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to register the component\n");
+
+	return 0;
+
+err_pm_put:
+	pm_runtime_put_sync(dev);
+	return ret;
+}
+
+static const struct of_device_id mt6897_afe_pcm_dt_match[] = {
+	{ .compatible = "mediatek,mt6897-afe" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, mt6897_afe_pcm_dt_match);
+
+static const struct dev_pm_ops mt6897_afe_pm_ops = {
+	RUNTIME_PM_OPS(mt6897_afe_runtime_suspend, mt6897_afe_runtime_resume, NULL)
+};
+
+static struct platform_driver mt6897_afe_pcm_driver = {
+	.driver = {
+		.name = "mt6897-afe",
+		.of_match_table = mt6897_afe_pcm_dt_match,
+		.pm = pm_ptr(&mt6897_afe_pm_ops),
+	},
+	.probe = mt6897_afe_pcm_dev_probe,
+};
+module_platform_driver(mt6897_afe_pcm_driver);
+
+MODULE_DESCRIPTION("MediaTek ALSA SoC AFE platform driver for MT6897");
+MODULE_LICENSE("GPL");
diff --git a/sound/soc/mediatek/mt6897/mt6897-dai-adda.c b/sound/soc/mediatek/mt6897/mt6897-dai-adda.c
new file mode 100644
index 0000000..6c53505
--- /dev/null
+++ b/sound/soc/mediatek/mt6897/mt6897-dai-adda.c
@@ -0,0 +1,246 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek ALSA SoC Audio DAI ADDA control, the capture path for now
+ *
+ * Copyright (c) 2021 MediaTek Inc.
+ * Author: Tina Tsai <tina.tsai@mediatek.com>
+ */
+
+#include <linux/delay.h>
+#include <linux/regmap.h>
+#include <sound/pcm_params.h>
+
+#include "mt6897-afe-common.h"
+#include "mt6897-interconnection.h"
+
+enum {
+	MTK_AFE_ADDA_UL_RATE_8K,
+	MTK_AFE_ADDA_UL_RATE_16K,
+	MTK_AFE_ADDA_UL_RATE_32K,
+	MTK_AFE_ADDA_UL_RATE_48K,
+	MTK_AFE_ADDA_UL_RATE_96K,
+	MTK_AFE_ADDA_UL_RATE_192K,
+};
+
+enum {
+	SUPPLY_SEQ_ADDA_AFE_ON,
+	SUPPLY_SEQ_ADDA_AUD_PAD_TOP,
+	SUPPLY_SEQ_ADDA_MTKAIF_CFG,
+	SUPPLY_SEQ_ADDA_UL_ON,
+};
+
+/* The data of the two pins are delayed against each other by one of these */
+enum {
+	DELAY_DATA_MISO1,
+	DELAY_DATA_MISO2,
+};
+
+#define MT6897_UL_IIR_SW	0
+
+static int adda_ul_rate_transform(unsigned int rate)
+{
+	switch (rate) {
+	case 8000:
+		return MTK_AFE_ADDA_UL_RATE_8K;
+	case 16000:
+		return MTK_AFE_ADDA_UL_RATE_16K;
+	case 32000:
+		return MTK_AFE_ADDA_UL_RATE_32K;
+	case 48000:
+		return MTK_AFE_ADDA_UL_RATE_48K;
+	case 96000:
+		return MTK_AFE_ADDA_UL_RATE_96K;
+	case 192000:
+		return MTK_AFE_ADDA_UL_RATE_192K;
+	default:
+		return -EINVAL;
+	}
+}
+
+/* 1/fs at the lowest rate, before the AFE may go down */
+static int mtk_adda_ul_event(struct snd_soc_dapm_widget *w,
+			     struct snd_kcontrol *kcontrol, int event)
+{
+	if (event == SND_SOC_DAPM_POST_PMD)
+		usleep_range(125, 150);
+
+	return 0;
+}
+
+static int mtk_adda_pad_top_event(struct snd_soc_dapm_widget *w,
+				  struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(w->dapm);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(cmpnt);
+	struct mt6897_afe_private *afe_priv = afe->platform_priv;
+
+	regmap_write(afe->regmap, AFE_AUD_PAD_TOP_CFG0,
+		     afe_priv->mtkaif_protocol == MTKAIF_PROTOCOL_2_CLK_P2 ?
+		     0xb8 : 0xb0);
+
+	return 0;
+}
+
+static int mtk_adda_mtkaif_cfg_event(struct snd_soc_dapm_widget *w,
+				     struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(w->dapm);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(cmpnt);
+	struct mt6897_afe_private *afe_priv = afe->platform_priv;
+	int delay_data, delay_cycle;
+
+	switch (afe_priv->mtkaif_protocol) {
+	case MTKAIF_PROTOCOL_2_CLK_P2:
+		regmap_write(afe->regmap, AFE_MTKAIF0_CFG0, 0x00010000);
+		regmap_write(afe->regmap, AFE_MTKAIF1_CFG0, 0x00010000);
+
+		/* The clock is inverted for the calibrated phase */
+		regmap_update_bits(afe->regmap, AFE_MTKAIF0_CFG0,
+				   RG_MTKAIF0_RXIF_CLKINV_MASK_SFT,
+				   0x1 << RG_MTKAIF0_RXIF_CLKINV_SFT);
+		regmap_update_bits(afe->regmap, AFE_MTKAIF1_CFG0,
+				   RG_MTKAIF1_RXIF_CLKINV_ADC_MASK_SFT,
+				   0x1 << RG_MTKAIF1_RXIF_CLKINV_ADC_SFT);
+
+		if (afe_priv->mtkaif_chosen_phase[0] < 0 ||
+		    afe_priv->mtkaif_chosen_phase[1] < 0) {
+			dev_warn(afe->dev, "no calibrated MTKAIF phase\n");
+			break;
+		}
+
+		/* Align the data of the two pins */
+		if (afe_priv->mtkaif_phase_cycle[0] >=
+		    afe_priv->mtkaif_phase_cycle[1]) {
+			delay_data = DELAY_DATA_MISO1;
+			delay_cycle = afe_priv->mtkaif_phase_cycle[0] -
+				      afe_priv->mtkaif_phase_cycle[1];
+		} else {
+			delay_data = DELAY_DATA_MISO2;
+			delay_cycle = afe_priv->mtkaif_phase_cycle[1] -
+				      afe_priv->mtkaif_phase_cycle[0];
+		}
+
+		regmap_update_bits(afe->regmap, AFE_MTKAIF0_RX_CFG2,
+				   RG_MTKAIF0_RXIF_DELAY_DATA_MASK_SFT,
+				   delay_data << RG_MTKAIF0_RXIF_DELAY_DATA_SFT);
+		regmap_update_bits(afe->regmap, AFE_MTKAIF0_RX_CFG2,
+				   RG_MTKAIF0_RXIF_DELAY_CYCLE_MASK_SFT,
+				   delay_cycle << RG_MTKAIF0_RXIF_DELAY_CYCLE_SFT);
+		break;
+	case MTKAIF_PROTOCOL_2:
+		regmap_write(afe->regmap, AFE_MTKAIF0_CFG0, 0x00010000);
+		regmap_write(afe->regmap, AFE_MTKAIF1_CFG0, 0x00010000);
+		break;
+	default:
+		regmap_write(afe->regmap, AFE_MTKAIF0_CFG0, 0x0);
+		regmap_write(afe->regmap, AFE_MTKAIF1_CFG0, 0x0);
+		break;
+	}
+
+	return 0;
+}
+
+static const struct snd_soc_dapm_widget mtk_dai_adda_widgets[] = {
+	SND_SOC_DAPM_SUPPLY_S("ADDA Enable", SUPPLY_SEQ_ADDA_AFE_ON,
+			      AUDIO_ENGEN_CON0, AUDIO_F3P25M_EN_ON_SFT, 0,
+			      NULL, 0),
+	SND_SOC_DAPM_SUPPLY_S("ADDA Capture Enable", SUPPLY_SEQ_ADDA_UL_ON,
+			      AFE_ADDA_UL0_SRC_CON0, UL_SRC_ON_TMP_CTL_SFT, 0,
+			      mtk_adda_ul_event, SND_SOC_DAPM_POST_PMD),
+	SND_SOC_DAPM_SUPPLY_S("AUD_PAD_TOP", SUPPLY_SEQ_ADDA_AUD_PAD_TOP,
+			      AFE_AUD_PAD_TOP_CFG0, RG_RX_FIFO_ON_SFT, 0,
+			      mtk_adda_pad_top_event, SND_SOC_DAPM_PRE_PMU),
+	SND_SOC_DAPM_SUPPLY_S("ADDA_MTKAIF_CFG", SUPPLY_SEQ_ADDA_MTKAIF_CFG,
+			      SND_SOC_NOPM, 0, 0,
+			      mtk_adda_mtkaif_cfg_event, SND_SOC_DAPM_PRE_PMU),
+};
+
+static const struct snd_soc_dapm_route mtk_dai_adda_routes[] = {
+	{"ADDA Capture", NULL, "ADDA Enable"},
+	{"ADDA Capture", NULL, "ADDA Capture Enable"},
+	{"ADDA Capture", NULL, "AUD_PAD_TOP"},
+	{"ADDA Capture", NULL, "ADDA_MTKAIF_CFG"},
+};
+
+static int mtk_dai_adda_hw_params(struct snd_pcm_substream *substream,
+				  struct snd_pcm_hw_params *params,
+				  struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	int voice_mode = adda_ul_rate_transform(params_rate(params));
+	unsigned int ul_src_con0;
+
+	if (voice_mode < 0) {
+		dev_err(afe->dev, "unsupported rate %u\n", params_rate(params));
+		return voice_mode;
+	}
+
+	ul_src_con0 = (voice_mode & 0x7) << 17;
+	ul_src_con0 |= 1 << UL_IIR_ON_TMP_CTL_SFT;
+	ul_src_con0 |= (MT6897_UL_IIR_SW << UL_IIRMODE_CTL_SFT) & UL_IIRMODE_CTL_MASK_SFT;
+
+	/* A high pass at 35 Hz, for 48 kHz */
+	regmap_write(afe->regmap, AFE_ADDA_UL0_IIR_COEF_02_01, 0x00000000);
+	regmap_write(afe->regmap, AFE_ADDA_UL0_IIR_COEF_04_03, 0x00003fb8);
+	regmap_write(afe->regmap, AFE_ADDA_UL0_IIR_COEF_06_05, 0x3fb80000);
+	regmap_write(afe->regmap, AFE_ADDA_UL0_IIR_COEF_08_07, 0x3fb80000);
+	regmap_write(afe->regmap, AFE_ADDA_UL0_IIR_COEF_10_09, 0x0000c048);
+
+	regmap_update_bits(afe->regmap, AFE_ADDA_UL0_SRC_CON0,
+			   ~(u32)(1 << UL_SRC_ON_TMP_CTL_SFT), ul_src_con0);
+
+	/* The data on the link comes from analog microphones */
+	regmap_update_bits(afe->regmap, AFE_MTKAIF0_RX_CFG0, 0x1, 0x0);
+
+	return 0;
+}
+
+static const struct snd_soc_dai_ops mtk_dai_adda_ops = {
+	.hw_params = mtk_dai_adda_hw_params,
+};
+
+#define MTK_ADDA_CAPTURE_RATES (SNDRV_PCM_RATE_8000 |\
+				SNDRV_PCM_RATE_16000 |\
+				SNDRV_PCM_RATE_32000 |\
+				SNDRV_PCM_RATE_48000 |\
+				SNDRV_PCM_RATE_96000 |\
+				SNDRV_PCM_RATE_192000)
+
+#define MTK_ADDA_FORMATS (SNDRV_PCM_FMTBIT_S16_LE |\
+			  SNDRV_PCM_FMTBIT_S24_LE |\
+			  SNDRV_PCM_FMTBIT_S32_LE)
+
+static struct snd_soc_dai_driver mtk_dai_adda_driver[] = {
+	{
+		.name = "ADDA",
+		.id = MT6897_DAI_ADDA,
+		.capture = {
+			.stream_name = "ADDA Capture",
+			.channels_min = 1,
+			.channels_max = 2,
+			.rates = MTK_ADDA_CAPTURE_RATES,
+			.formats = MTK_ADDA_FORMATS,
+		},
+		.ops = &mtk_dai_adda_ops,
+	},
+};
+
+int mt6897_dai_adda_register(struct mtk_base_afe *afe)
+{
+	struct mtk_base_afe_dai *dai;
+
+	dai = devm_kzalloc(afe->dev, sizeof(*dai), GFP_KERNEL);
+	if (!dai)
+		return -ENOMEM;
+
+	dai->dai_drivers = mtk_dai_adda_driver;
+	dai->num_dai_drivers = ARRAY_SIZE(mtk_dai_adda_driver);
+	dai->dapm_widgets = mtk_dai_adda_widgets;
+	dai->num_dapm_widgets = ARRAY_SIZE(mtk_dai_adda_widgets);
+	dai->dapm_routes = mtk_dai_adda_routes;
+	dai->num_dapm_routes = ARRAY_SIZE(mtk_dai_adda_routes);
+
+	list_add(&dai->list, &afe->sub_dais);
+
+	return 0;
+}
diff --git a/sound/soc/mediatek/mt6897/mt6897-dai-i2s.c b/sound/soc/mediatek/mt6897/mt6897-dai-i2s.c
new file mode 100644
index 0000000..54d6e1d
--- /dev/null
+++ b/sound/soc/mediatek/mt6897/mt6897-dai-i2s.c
