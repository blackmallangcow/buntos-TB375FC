From: buntOS contributors
Subject: [PATCH] usb: mtu3: override the VBUS input when the board asks for it

The driver leaves VBUS detection to the hardware. On a Lenovo TB375FC
(MediaTek MT6897) that input doesn't follow the cable. With a gadget
running at high speed, clearing the override bits makes the host lose the
device at once, and setting them again brings it back.

Set the override bits while the device function runs if the board has
mediatek,force-vbus. The vendor driver for this SoC does the same when it
starts and stops the device function, including the OTG select bit.
---
 drivers/usb/mtu3/mtu3.h      | 2 ++
 drivers/usb/mtu3/mtu3_plat.c | 1 +
 drivers/usb/mtu3/mtu3_core.c | 22 ++++++++++++++++++++++
 3 files changed, 25 insertions(+)

diff --git a/drivers/usb/mtu3/mtu3.h b/drivers/usb/mtu3/mtu3.h
--- a/drivers/usb/mtu3/mtu3.h
+++ b/drivers/usb/mtu3/mtu3.h
@@ -242,6 +242,7 @@
  * @u3p_dis_msk: mask of disabling usb3 ports, for example, bit0==1 to
  *		disable u3port0, bit1==1 to disable u3port1,... etc
  * @dbgfs_root: only used when supports manual dual-role switch via debugfs
+ * @force_vbus: the controller can't sense VBUS, override its VBUS input
  * @uwk_en: it's true when supports remote wakeup in host mode
  * @uwk: syscon including usb wakeup glue layer between SSUSB IP and SPM
  * @uwk_reg_base: the base address of the wakeup glue layer in @uwk
@@ -266,6 +267,7 @@
 	int u3_ports;
 	int u2p_dis_msk;
 	int u3p_dis_msk;
+	bool force_vbus;
 	struct dentry *dbgfs_root;
 	/* usb wakeup for host mode */
 	bool uwk_en;
diff --git a/drivers/usb/mtu3/mtu3_plat.c b/drivers/usb/mtu3/mtu3_plat.c
--- a/drivers/usb/mtu3/mtu3_plat.c
+++ b/drivers/usb/mtu3/mtu3_plat.c
@@ -272,6 +272,7 @@
 		ssusb->dr_mode = USB_DR_MODE_OTG;
 
 	of_property_read_u32(node, "mediatek,u3p-dis-msk", &ssusb->u3p_dis_msk);
+	ssusb->force_vbus = of_property_read_bool(node, "mediatek,force-vbus");
 
 	if (ssusb->dr_mode == USB_DR_MODE_PERIPHERAL)
 		goto out;
diff --git a/drivers/usb/mtu3/mtu3_core.c b/drivers/usb/mtu3/mtu3_core.c
--- a/drivers/usb/mtu3/mtu3_core.c
+++ b/drivers/usb/mtu3/mtu3_core.c
@@ -350,6 +350,26 @@
 		usb_speed_string(mtu->speed), is_on ? "+" : "-");
 }
 
+/* override the VBUS input while the device function runs */
+static void mtu3_force_vbus(struct mtu3 *mtu, bool on)
+{
+	if (!mtu->ssusb->force_vbus)
+		return;
+
+	if (on) {
+		mtu3_clrbits(mtu->ippc_base, SSUSB_U2_CTRL(0),
+			     SSUSB_U2_PORT_OTG_SEL);
+		mtu3_setbits(mtu->mac_base, U3D_MISC_CTRL,
+			     VBUS_FRC_EN | VBUS_ON);
+	} else {
+		mtu3_clrbits(mtu->mac_base, U3D_MISC_CTRL,
+			     VBUS_FRC_EN | VBUS_ON);
+		if (mtu->ssusb->dr_mode == USB_DR_MODE_OTG)
+			mtu3_setbits(mtu->ippc_base, SSUSB_U2_CTRL(0),
+				     SSUSB_U2_PORT_OTG_SEL);
+	}
+}
+
 void mtu3_start(struct mtu3 *mtu)
 {
 	void __iomem *mbase = mtu->mac_base;
@@ -358,6 +378,7 @@
 		mtu3_readl(mbase, U3D_DEVICE_CONTROL));
 
 	mtu3_dev_power_on(mtu);
+	mtu3_force_vbus(mtu, true);
 	mtu3_csr_init(mtu);
 	mtu3_set_speed(mtu, mtu->speed);
 
@@ -378,6 +399,7 @@
 	if (mtu->softconnect)
 		mtu3_dev_on_off(mtu, 0);
 
+	mtu3_force_vbus(mtu, false);
 	mtu->is_active = 0;
 	mtu3_dev_power_down(mtu);
 }
