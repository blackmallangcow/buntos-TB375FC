+#define MT_SOC_DEBUG_CTRL_AO_CTRL3	0x1850000c
+#define MT_SOC_DEBUG_THRES		GENMASK(31, 16)
+#define MT_SOC_DEBUG_THRES_VAL		0x04f5
+#define MT_SOC_DEBUG_TIMEOUT_CLR	BIT(9)
+#define MT_SOC_DEBUG_EN_DEBUGTOP	BIT(4)
