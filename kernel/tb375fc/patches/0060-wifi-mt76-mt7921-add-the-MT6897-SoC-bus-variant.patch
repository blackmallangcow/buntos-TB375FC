+#define MT_SOC_DEBUG_EN			BIT(2)
+#define MT_SOC_DEBUG_MASK_BUSY		BIT(8)
+
+/* Where the firmware says where its release string is in its region */
+#define MT_SOC_EMI_FW_VER_OFS		0xb00024
+#define MT_SOC_EMI_ADDR_MASK		GENMASK(23, 0)
+
+/* WFDMA rings: data 0 is band 0, 2 takes events and 3 the TX free events */
+#define MT_SOC_TXQ_DATA			0
+#define MT_SOC_TXQ_MCU_WM		15
+#define MT_SOC_TXQ_FWDL			16
+#define MT_SOC_RXQ_DATA			0
+#define MT_SOC_RXQ_EVENT		2
+#define MT_SOC_RXQ_TX_FREE		3
+
+#define MT_SOC_TX_RING_SIZE		1024
+#define MT_SOC_TX_MCU_RING_SIZE		256
+#define MT_SOC_TX_FWDL_RING_SIZE	128
+#define MT_SOC_RX_RING_SIZE		1024
+#define MT_SOC_RX_EVENT_RING_SIZE	512
+#define MT_SOC_RX_TX_FREE_RING_SIZE	128
+
+/* Every frame on its way holds window memory, and RX has to find room there */
+#define MT_SOC_TOKEN_SIZE		2048
+
+/*
+ * A firmware that comes up to stop answering again gets this many chances. The
+ * reset work takes up to 10 of them in one go, and that leaves one more go.
+ * This long without a restart gives them all back.
+ */
+#define MT_SOC_RESTART_MAX		20
+#define MT_SOC_RESTART_CALM		(10 * 60 * HZ)
+
+#define MT_SOC_RX_RETRY_DELAY		(HZ / 10)
+
+static bool mt7921_soc_cnm;
+module_param_named(cnm, mt7921_soc_cnm, bool, 0444);
+MODULE_PARM_DESC(cnm, "let the firmware manage channels (CNM)");
+
+static const struct mt76_connac_reg_map mt7921_soc_map[] = {
