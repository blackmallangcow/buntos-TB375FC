+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * The MT7921 on the SoC bus: the Wi-Fi of the MT6897 connsys ("soc7_0").
+ *
+ * The chip has the ID and the WFDMA of a PCIe MT7921, but its registers are on
+ * the AXI bus of the SoC with another address map, the rings sit elsewhere, the
+ * connsys driver powers it and the bootloader has already loaded its firmware.
+ *
+ * Nothing here runs without a device tree node that says "okay", and every step
+ * of the way up is logged, as a mistake here hangs the bus without a word.
+ */
+
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/soc/mediatek/mtk-connsys.h>
+
+#include "mt7921.h"
+#include "soc.h"
+#include "mcu.h"
+#include "../dma.h"
+#include "../mt76_connac2_mac.h"
+
+/* The window of the AXI bus: 0x18000000 up to here */
+#define MT_SOC_BUS_BASE			0x18000000
+#define MT_SOC_BUS_SIZE			0x700000
+/* The second register range of the node */
+#define MT_SOC_INFRA_PCCIF_RST		0xbf0
+#define MT_SOC_INFRA_PCCIF_RST_WF	GENMASK(18, 16)
+/* The common code's WFDMA offsets are the ones of the PCIe BAR */
+#define MT_SOC_PCIE_WFDMA		0xd0000
+#define MT_SOC_PCIE_HOST_CSR		0xe0000
+#define MT_SOC_PCIE_CONN_INFRA		0xf0000
+#define MT_SOC_WFDMA			0x20000
+#define MT_SOC_HOST_CSR			0x60000
+#define MT_SOC_WF_OFS			0x400000
+
+#define MT_SOC_WFDMA0_BASE		0x24000
+#define MT_SOC_WFDMA0(ofs)		(MT_SOC_WFDMA0_BASE + (ofs))
+#define MT_SOC_WFDMA0_END		MT_SOC_WFDMA0(0x1000)
+#define MT_SOC_WFDMA0_HOST_INT_ENA	MT_SOC_WFDMA0(0x204)
+#define MT_SOC_TX_RING_BASE		MT_SOC_WFDMA0(0x300)
+#define MT_SOC_RX_RING_BASE		MT_SOC_WFDMA0(0x500)
+
