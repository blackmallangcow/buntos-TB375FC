+/* Only a path through more controllers has its components in other power domains */
+static unsigned int mtk_crtc_num_power_comps(struct mtk_crtc *mtk_crtc)
+{
+	return mtk_crtc->num_controllers ? mtk_crtc->ddp_comp_nr : 1;
+}
+
+static void mtk_crtc_power_off(struct mtk_crtc *mtk_crtc, int num)
+{
+	while (--num >= 0)
+		mtk_ddp_comp_power_off(mtk_crtc->ddp_comp[num]);
+}
+
+static int mtk_crtc_power_on(struct mtk_crtc *mtk_crtc)
+{
+	int i, ret;
+
+	for (i = 0; i < mtk_crtc_num_power_comps(mtk_crtc); i++) {
+		struct mtk_ddp_comp *comp = mtk_crtc->ddp_comp[i];
+
+		ret = mtk_ddp_comp_power_on(comp);
+		if (ret < 0) {
+			DRM_DEV_ERROR(comp->dev, "Failed to enable power domain: %d\n", ret);
+			mtk_crtc_power_off(mtk_crtc, i);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
 static void mtk_crtc_destroy(struct drm_crtc *crtc)
 {
 	struct mtk_crtc *mtk_crtc = to_mtk_crtc(crtc);
 	int i;
 
+	if (mtk_crtc->boot_power)
+		mtk_crtc_power_off(mtk_crtc, mtk_crtc_num_power_comps(mtk_crtc));
+
 	mtk_mutex_put(mtk_crtc->mutex);
+	for (i = 1; i < mtk_crtc->num_controllers; i++)
+		mtk_mutex_put(mtk_crtc->controller_mutex[i]);
 #if IS_REACHABLE(CONFIG_MTK_CMDQ)
 	if (mtk_crtc->cmdq_client.chan) {
 		cmdq_pkt_destroy(&mtk_crtc->cmdq_client, &mtk_crtc->cmdq_handle);
@@ -339,14 +391,222 @@ ddp_cmdq_cb_out:
 }
 #endif
 
+/* Width of the part of the screen each pipe makes */
+static unsigned int mtk_crtc_pipe_width(struct mtk_crtc *mtk_crtc, unsigned int width)
+{
+	return mtk_crtc->second_pipe ? width / 2 : width;
+}
+
+/*
+ * With two pipes a layer goes to the same layer of both overlays, each one with
+ * its part of the screen. The address is the one of the top left pixel the layer
+ * shows, so it only has to move for the pipe that starts somewhere inside.
+ */
+static void mtk_crtc_layer_config(struct mtk_crtc *mtk_crtc, struct mtk_ddp_comp *comp,
+				  unsigned int local_layer,
+				  struct mtk_plane_state *state,
+				  struct cmdq_pkt *cmdq_handle)
+{
+	struct mtk_plane_pending_state *pending = &state->pending;
+	struct mtk_plane_state part = *state;
+	const struct drm_format_info *info;
+	unsigned int mid, right_x, cpp;
+	int left_w, right_w;
+	bool enable;
+
+	if (!mtk_crtc->second_pipe) {
+		mtk_ddp_comp_layer_config(comp, local_layer, state, cmdq_handle);
+		return;
+	}
+
+	mid = mtk_crtc->pipe_width;
+	right_x = max_t(unsigned int, pending->x, mid);
+	left_w = min_t(int, pending->width, (int)mid - (int)pending->x);
+	right_w = (int)(pending->x + pending->width) - (int)right_x;
+	/* An async update can leave a plane outside of the screen */
+	enable = pending->enable && (int)pending->width > 0 && (int)pending->height > 0;
+	info = enable ? drm_format_info(pending->format) : NULL;
+	cpp = info ? info->cpp[0] : 0;
+
+	part.pending.enable = enable && left_w > 0;
+	part.pending.width = max(left_w, 0);
+	mtk_ddp_comp_layer_config(comp, local_layer, &part, cmdq_handle);
+
+	part.pending.enable = enable && right_w > 0;
+	part.pending.width = max(right_w, 0);
+	part.pending.x = right_x - mid;
+	part.pending.addr = pending->addr + (right_x - pending->x) * cpp;
+	mtk_ddp_comp_layer_config(mtk_crtc->ddp_comp[mtk_crtc->second_pipe],
+				  local_layer, &part, cmdq_handle);
+}
+
+static int mtk_crtc_mutex_prepare(struct mtk_crtc *mtk_crtc)
+{
+	int i, ret;
+
+	if (!mtk_crtc->num_controllers)
+		return mtk_mutex_prepare(mtk_crtc->mutex);
+
+	for (i = 0; i < mtk_crtc->num_controllers; i++) {
+		ret = mtk_mutex_prepare(mtk_crtc->controller_mutex[i]);
+		if (ret < 0)
+			goto err_unprepare;
+	}
+
+	return 0;
+
+err_unprepare:
+	while (--i >= 0)
+		mtk_mutex_unprepare(mtk_crtc->controller_mutex[i]);
+
+	return ret;
+}
+
+static void mtk_crtc_mutex_unprepare(struct mtk_crtc *mtk_crtc)
+{
+	int i;
+
+	if (!mtk_crtc->num_controllers) {
+		mtk_mutex_unprepare(mtk_crtc->mutex);
+		return;
+	}
+
+	for (i = mtk_crtc->num_controllers - 1; i >= 0; i--)
+		mtk_mutex_unprepare(mtk_crtc->controller_mutex[i]);
+}
+
+/* The index of the last component of the pipe that holds a component */
+static unsigned int mtk_crtc_pipe_end(struct mtk_crtc *mtk_crtc, unsigned int i)
+{
+	if (mtk_crtc->second_pipe && i < mtk_crtc->second_pipe)
+		return mtk_crtc->second_pipe - 1;
+
+	return mtk_crtc->ddp_comp_nr - 1;
+}
+
+/*
+ * A connection between two controllers has a part in the routes of each. All the
+ * mutexes of a pipe wait for the start of frame of its output, even if the output
+ * is in a controller of its own.
+ */
+static void mtk_crtc_controllers_connect(struct mtk_crtc *mtk_crtc)
+{
+	const u8 *controllers = mtk_crtc->controllers;
+	unsigned int i;
+
+	for (i = 0; i < mtk_crtc->num_controllers; i++)
+		mtk_mutex_clear(mtk_crtc->controller_mutex[i]);
+
+	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++) {
+		unsigned int id = mtk_crtc->ddp_comp[i]->id;
+		unsigned int end = mtk_crtc_pipe_end(mtk_crtc, i);
+		unsigned int ctrl = controllers[i];
+
+		mtk_mutex_add_comp(mtk_crtc->controller_mutex[ctrl], id);
+
+		if (i == end) {
+			unsigned int j;
+
+			for (j = 0; j < i; j++) {
+				unsigned int other = controllers[j];
+				struct mtk_mutex *mutex = mtk_crtc->controller_mutex[other];
+
+				if (mtk_crtc_pipe_end(mtk_crtc, j) == end && other != ctrl)
+					mtk_mutex_add_comp(mutex, id);
+			}
+			continue;
+		}
+
+		mtk_mmsys_ddp_connect(mtk_crtc->controller_mmsys[ctrl], id,
+				      mtk_crtc->ddp_comp[i + 1]->id);
+		if (controllers[i + 1] != ctrl)
+			mtk_mmsys_ddp_connect(mtk_crtc->controller_mmsys[controllers[i + 1]],
+					      id, mtk_crtc->ddp_comp[i + 1]->id);
+	}
+
+	for (i = 0; i < mtk_crtc->num_controllers; i++)
+		mtk_mutex_enable(mtk_crtc->controller_mutex[i]);
+}
+
+static void mtk_crtc_controllers_disconnect(struct mtk_crtc *mtk_crtc)
+{
+	const u8 *controllers = mtk_crtc->controllers;
+	unsigned int i;
+
+	for (i = 0; i < mtk_crtc->num_controllers; i++)
+		mtk_mutex_disable(mtk_crtc->controller_mutex[i]);
+
+	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++) {
+		unsigned int id = mtk_crtc->ddp_comp[i]->id;
+		unsigned int end = mtk_crtc_pipe_end(mtk_crtc, i);
+		unsigned int ctrl = controllers[i];
+
+		mtk_mutex_remove_comp(mtk_crtc->controller_mutex[ctrl], id);
+
+		if (i == end) {
+			unsigned int j;
+
+			for (j = 0; j < i; j++) {
+				unsigned int other = controllers[j];
+				struct mtk_mutex *mutex = mtk_crtc->controller_mutex[other];
+
+				if (mtk_crtc_pipe_end(mtk_crtc, j) == end && other != ctrl)
+					mtk_mutex_remove_comp(mutex, id);
+			}
+			continue;
+		}
+
+		mtk_mmsys_ddp_disconnect(mtk_crtc->controller_mmsys[ctrl], id,
+					 mtk_crtc->ddp_comp[i + 1]->id);
+		if (controllers[i + 1] != ctrl)
+			mtk_mmsys_ddp_disconnect(mtk_crtc->controller_mmsys[controllers[i + 1]],
+						 id, mtk_crtc->ddp_comp[i + 1]->id);
+	}
+}
+
+static bool mtk_crtc_comp_is_dsi(struct mtk_ddp_comp *comp)
+{
+	return comp->id >= DDP_COMPONENT_DSI0 && comp->id <= DDP_COMPONENT_DSI3;
+}
+
+/* Set up the DSC of each pipe, with the config coming from the DSI of that pipe */
+static void mtk_crtc_dsc_setup(struct mtk_crtc *mtk_crtc)
+{
+	struct mtk_ddp_comp *comp_dsi = NULL, *comp_dsc = NULL;
+	struct drm_dsc_config *dsc_cfg;
+	int i;
+
+	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++) {
+		struct mtk_ddp_comp *comp = mtk_crtc->ddp_comp[i];
+
+		if (i && i == mtk_crtc->second_pipe) {
+			comp_dsi = NULL;
+			comp_dsc = NULL;
+		}
+
+		if (mtk_crtc_comp_is_dsi(comp))
+			if (!comp_dsi)
+				comp_dsi = comp;
+
+		if (comp->id == DDP_COMPONENT_DSC0 ||
+		    comp->id == DDP_COMPONENT_DSC1)
+			if (!comp_dsc)
+				comp_dsc = comp;
+
+		if (i == mtk_crtc_pipe_end(mtk_crtc, i) && comp_dsc && comp_dsi) {
+			dsc_cfg = mtk_dsi_get_dsc_config(comp_dsi->dev);
+			if (dsc_cfg)
+				mtk_ddp_comp_dsc_setup(comp_dsc, dsc_cfg);
+		}
+	}
+}
