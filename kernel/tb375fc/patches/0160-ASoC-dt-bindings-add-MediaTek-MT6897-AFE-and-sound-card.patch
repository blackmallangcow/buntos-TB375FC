@@ -0,0 +1,99 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/mediatek,mt6897-mt6368.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6897 ASoC sound card with the MT6368 PMIC codec
+
+maintainers:
+  - Liam Girdwood <lgirdwood@gmail.com>
+  - Mark Brown <broonie@kernel.org>
+
+allOf:
+  - $ref: sound-card-common.yaml#
+
+properties:
+  compatible:
+    const: mediatek,mt6897-mt6368-sound
+
+  mediatek,platform:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The phandle of the MT6897 AFE platform.
+
+patternProperties:
+  "^dai-link-[0-9]+$":
+    type: object
+    description:
+      Container for dai-link level properties and the CODEC sub-nodes.
+
+    properties:
+      link-name:
+        description: The name of a back end link of the machine driver.
+        items:
+          enum:
+            - ADDA_BE
+            - I2SOUT4_BE
+            - I2SIN4_BE
+
+      dai-format:
+        description: The format of the link.
+        enum:
+          - i2s
+          - left_j
+          - right_j
+          - dsp_a
+          - dsp_b
+
+      mediatek,clk-provider:
+        $ref: /schemas/types.yaml#/definitions/string
+        description: Which end provides the clocks of the link.
+        enum:
+          - cpu
+          - codec
+
+      codec:
+        description: The CODECs of the link.
+        type: object
+
+        properties:
+          sound-dai:
+            minItems: 1
+            maxItems: 8
+            description: The phandles of the CODECs.
+
+        required:
+          - sound-dai
+
+        additionalProperties: false
+
+    required:
+      - link-name
+
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - mediatek,platform
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    sound {
+        compatible = "mediatek,mt6897-mt6368-sound";
+        model = "TB375FC";
+        mediatek,platform = <&afe>;
+        audio-routing = "Speakers", "Amp0 DAC Output";
+
+        dai-link-0 {
+            link-name = "I2SOUT4_BE";
+            dai-format = "dsp_b";
+            mediatek,clk-provider = "cpu";
+
+            codec {
+                sound-dai = <&amp0>, <&amp1>;
+            };
+        };
+    };
+...
