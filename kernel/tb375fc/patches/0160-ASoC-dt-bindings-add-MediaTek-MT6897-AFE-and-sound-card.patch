+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/mediatek,mt6897-afe.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek Audio Front End PCM controller for MT6897
+
+maintainers:
+  - Liam Girdwood <lgirdwood@gmail.com>
+  - Mark Brown <broonie@kernel.org>
+
+properties:
+  compatible:
+    const: mediatek,mt6897-afe
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: mux for the audio internal bus
+      - description: mux for audio h
+      - description: mux that takes APLL1
+      - description: mux that takes APLL2
+      - description: mux for audio engine 1
+      - description: mux for audio engine 2
+      - description: audio PLL 1
+      - description: audio PLL 2
+      - description: audio PLL 1 divided by 2
+      - description: audio PLL 2 divided by 2
+      - description: audio PLL 1 divided by 4
+      - description: audio PLL 2 divided by 4
+      - description: 26 MHz clock
+
+  clock-names:
+    items:
+      - const: top_aud_intbus
+      - const: top_aud_h
+      - const: top_aud_1
+      - const: top_aud_2
+      - const: top_aud_eng1
+      - const: top_aud_eng2
+      - const: apll1
+      - const: apll2
+      - const: apll1_d2
+      - const: apll2_d2
+      - const: apll1_d4
+      - const: apll2_d4
+      - const: clk26m
+
+  mediatek,topckgen:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      The clock controller with the test of the link to the PMIC codec.
+
+  pinctrl-0: true
+
+  pinctrl-names: true
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - power-domains
+  - clocks
+  - clock-names
+  - mediatek,topckgen
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/mediatek,mt6897-clock.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/power/mediatek,mt6897-power.h>
+
+    audio-controller@11050000 {
+        compatible = "mediatek,mt6897-afe";
+        reg = <0x11050000 0x9000>;
+        interrupts = <GIC_SPI 257 IRQ_TYPE_LEVEL_HIGH 0>;
+        power-domains = <&scpsys MT6897_POWER_DOMAIN_AUDIO>;
+        clocks = <&topckgen CLK_TOP_AUD_INTBUS>,
+                 <&topckgen CLK_TOP_AUDIO_H>,
+                 <&topckgen CLK_TOP_AUD_1>,
+                 <&topckgen CLK_TOP_AUD_2>,
+                 <&topckgen CLK_TOP_AUD_ENGEN1>,
+                 <&topckgen CLK_TOP_AUD_ENGEN2>,
+                 <&apmixedsys CLK_APMIXED_APLL1>,
+                 <&apmixedsys CLK_APMIXED_APLL2>,
+                 <&topckgen CLK_TOP_APLL1_D2>,
+                 <&topckgen CLK_TOP_APLL2_D2>,
+                 <&topckgen CLK_TOP_APLL1_D4>,
+                 <&topckgen CLK_TOP_APLL2_D4>,
+                 <&clk26m>;
+        clock-names = "top_aud_intbus", "top_aud_h",
+                      "top_aud_1", "top_aud_2",
+                      "top_aud_eng1", "top_aud_eng2",
+                      "apll1", "apll2",
+                      "apll1_d2", "apll2_d2",
+                      "apll1_d4", "apll2_d4",
+                      "clk26m";
+        mediatek,topckgen = <&topckgen>;
+    };
+...
