From: buntOS contributors
Subject: [PATCH] mfd: add MediaTek MT6375 core driver

Add a core driver for MT6375, modelled on the MT6370 one: 16-bit
register addresses with the bank in the upper byte, as in the MediaTek
driver, and a regmap for the sub-devices. It does not extend mt6370.c:
the chips differ in the vendor ID, the register map and the banks, and
mt6370_probe() masks all interrupts and registers the backlight, LED,
flash and ADC cells that this chip does not have in that form.

The USB gadget is the way into a tablet being brought up, and a mistake
in this chip can cut it. So probing reads the device information and
writes nothing, the interrupt line is not used, and the regmap only lets
the registers of the OTG boost be written.

---
 drivers/mfd/Kconfig  |  15 +++++
 drivers/mfd/Makefile |   1 +
 drivers/mfd/mt6375.c | 152 +++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 168 insertions(+)

diff --git a/drivers/mfd/Kconfig b/drivers/mfd/Kconfig
index f031d58..251e412 100644
--- a/drivers/mfd/Kconfig
+++ b/drivers/mfd/Kconfig
@@ -1138,6 +1138,21 @@ config MFD_MT6370
 	  This driver can also be built as a module. If so, the module
 	  will be called "mt6370".
 
+config MFD_MT6375
+	tristate "MediaTek MT6375 SubPMIC"
+	select MFD_CORE
+	select REGMAP
+	depends on I2C
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	help
+	  Say Y here to enable MT6375 SubPMIC functional support. The chip has
+	  a battery charger with a boost for USB VBUS, a USB Type-C and PD
+	  controller, a fuel gauge and ADCs. This core driver checks the chip
+	  and gives its sub-devices register access. So far the only one is
+	  the boost.
+
+	  This driver can also be built as a module. If so, the module
+	  will be called "mt6375".
 config MFD_MT6397
 	tristate "MediaTek MT6397 PMIC Support"
 	select MFD_CORE
diff --git a/drivers/mfd/Makefile b/drivers/mfd/Makefile
index cf618fe..c01c3d9 100644
--- a/drivers/mfd/Makefile
+++ b/drivers/mfd/Makefile
@@ -187,6 +187,7 @@ obj-$(CONFIG_MFD_MP2629)	+= mp2629.o
 
 obj-$(CONFIG_MFD_MT6360)	+= mt6360-core.o
 obj-$(CONFIG_MFD_MT6370)	+= mt6370.o
+obj-$(CONFIG_MFD_MT6375)	+= mt6375.o
 mt6397-objs			:= mt6397-core.o mt6397-irq.o mt6358-irq.o
 obj-$(CONFIG_MFD_MT6397)	+= mt6397.o
 obj-$(CONFIG_MFD_MTK_SPMI_PMIC)	+= mtk-spmi-pmic.o
diff --git a/drivers/mfd/mt6375.c b/drivers/mfd/mt6375.c
new file mode 100644
index 0000000..3b850bb
--- /dev/null
+++ b/drivers/mfd/mt6375.c
@@ -0,0 +1,152 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6375 SubPMIC core driver
+ *
+ * The chip answers on one I2C address per block. As on MT6370, a register
+ * address carries the bank in its upper byte and the offset in its lower byte,
+ * so the register numbers read like the ones in the MediaTek driver. Only the
+ * PMU bank, which sits on the address of the device node, is in use so far.
+ *
+ * Probing only reads the device information. Nothing here writes to the chip,
+ * and the interrupt line stays unused, so a failed probe leaves the chip as the
+ * bootloader left it.
+ *
+ * Copyright (c) 2026 buntOS contributors
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/i2c.h>
+#include <linux/mfd/core.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+
+#define MT6375_REG_DEV_INFO	0x100
+#define MT6375_VENID_MASK	GENMASK(7, 4)
+#define MT6375_REV_MASK		GENMASK(3, 0)
+#define MT6375_VENID		0x7
+
+#define MT6375_REG_PMU_FIRST	0x100
+#define MT6375_REG_PMU_LAST	0x1ff
+#define MT6375_REG_OFFSET_SIZE	2
+
+static int mt6375_regmap_read(void *context, const void *reg_buf,
+			      size_t reg_size, void *val_buf, size_t val_size)
+{
+	struct i2c_client *i2c = context;
+	const u8 *reg = reg_buf;
+	int ret;
+
+	ret = i2c_smbus_read_i2c_block_data(i2c, reg[1], val_size, val_buf);
+	if (ret < 0)
+		return ret;
+
+	return ret == val_size ? 0 : -EIO;
+}
+
+static int mt6375_regmap_write(void *context, const void *data, size_t count)
+{
+	struct i2c_client *i2c = context;
+	const u8 *buf = data;
+
+	return i2c_smbus_write_i2c_block_data(i2c, buf[1],
+					      count - MT6375_REG_OFFSET_SIZE,
+					      buf + MT6375_REG_OFFSET_SIZE);
+}
+
+static const struct regmap_bus mt6375_regmap_bus = {
+	.read		= mt6375_regmap_read,
+	.write		= mt6375_regmap_write,
+	.max_raw_read	= I2C_SMBUS_BLOCK_MAX,
+	.max_raw_write	= I2C_SMBUS_BLOCK_MAX,
+};
+
+static const struct regmap_range mt6375_rd_ranges[] = {
+	regmap_reg_range(MT6375_REG_PMU_FIRST, MT6375_REG_PMU_LAST),
+};
+
+static const struct regmap_access_table mt6375_rd_table = {
+	.yes_ranges	= mt6375_rd_ranges,
+	.n_yes_ranges	= ARRAY_SIZE(mt6375_rd_ranges),
+};
+
+/*
+ * The registers of the OTG boost and nothing else. The same bank holds battery
+ * charging, the USB switch and BC1.2, which this driver must leave alone. The
+ * cell that takes those over extends this list.
+ */
+static const struct regmap_range mt6375_wr_ranges[] = {
+	regmap_reg_range(0x107, 0x107),		/* TM_PAS_CODE1 */
+	regmap_reg_range(0x120, 0x121),		/* CHG_TOP1, CHG_TOP2 */
+	regmap_reg_range(0x129, 0x129),		/* CHG_VSYS */
+	regmap_reg_range(0x130, 0x132),		/* OTG_LBP, OTG_V, OTG_C */
+	regmap_reg_range(0x135, 0x135),		/* CHG_DUMY0 */
+	regmap_reg_range(0x140, 0x140),		/* CHG_HD_BUCK5 */
+};
+
+static const struct regmap_access_table mt6375_wr_table = {
+	.yes_ranges	= mt6375_wr_ranges,
+	.n_yes_ranges	= ARRAY_SIZE(mt6375_wr_ranges),
+};
+
+static const struct regmap_config mt6375_regmap_config = {
+	.reg_bits		= 16,
+	.val_bits		= 8,
+	.reg_format_endian	= REGMAP_ENDIAN_BIG,
+	.max_register		= MT6375_REG_PMU_LAST,
+	.rd_table		= &mt6375_rd_table,
+	.wr_table		= &mt6375_wr_table,
+};
+
+static const struct mfd_cell mt6375_devices[] = {
+	MFD_CELL_OF("mt6375-charger", NULL, NULL, 0, 0, "mediatek,mt6375-charger"),
+};
+
+static int mt6375_probe(struct i2c_client *i2c)
+{
+	struct device *dev = &i2c->dev;
+	struct regmap *regmap;
+	unsigned int devinfo;
+	int ret;
+
+	regmap = devm_regmap_init(dev, &mt6375_regmap_bus, i2c,
+				  &mt6375_regmap_config);
+	if (IS_ERR(regmap))
+		return dev_err_probe(dev, PTR_ERR(regmap),
+				     "Failed to init regmap\n");
+
+	ret = regmap_read(regmap, MT6375_REG_DEV_INFO, &devinfo);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "Failed to read the device information\n");
+
+	if (FIELD_GET(MT6375_VENID_MASK, devinfo) != MT6375_VENID)
+		return dev_err_probe(dev, -ENODEV,
+				     "Unknown device information 0x%02x\n",
+				     devinfo);
+
+	dev_info(dev, "MT6375 revision %lu\n",
+		 FIELD_GET(MT6375_REV_MASK, devinfo));
+
+	return devm_mfd_add_devices(dev, PLATFORM_DEVID_AUTO, mt6375_devices,
+				    ARRAY_SIZE(mt6375_devices), NULL, 0, NULL);
+}
+
+static const struct of_device_id mt6375_of_match[] = {
+	{ .compatible = "mediatek,mt6375" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, mt6375_of_match);
+
+static struct i2c_driver mt6375_driver = {
+	.driver = {
+		.name = "mt6375",
+		.of_match_table = mt6375_of_match,
+	},
+	.probe = mt6375_probe,
+};
+module_i2c_driver(mt6375_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6375 SubPMIC core driver");
+MODULE_LICENSE("GPL");
