+#define CLK_CAM_MAIN_CAMSV_E		28
+#define CLK_CAM_MAIN_CAMSV		29
+
+/* CAM_VCORE */
+#define CLK_CAM_VCORE_MM0_SUBCOMMON_DCM_DIS	0
+
 #endif /* _DT_BINDINGS_CLK_MEDIATEK_MT6897_H */
