+#define CLK_CAM_MAIN_CAM_SUBC		7
+#define CLK_CAM_MAIN_CAM_MRAW		8
+#define CLK_CAM_MAIN_CAMTG		9
+#define CLK_CAM_MAIN_SENINF		10
+#define CLK_CAM_MAIN_CAMSV_TOP		11
+#define CLK_CAM_MAIN_ADLRD		12
+#define CLK_CAM_MAIN_ADLWR		13
+#define CLK_CAM_MAIN_UISP		14
+#define CLK_CAM_MAIN_FAKE_ENG		15
+#define CLK_CAM_MAIN_CAM2MM0_GALS	16
+#define CLK_CAM_MAIN_CAM2MM1_GALS	17
+#define CLK_CAM_MAIN_CAM2SYS_GALS	18
+#define CLK_CAM_MAIN_CAM2MM2_GALS	19
