+/* The horizontal timing of the vendor's N4 and N5 hosts, in whole words */
+static void mtk_dsi_config_vdo_timing_aligned(struct mtk_dsi *dsi)
+{
+	struct mtk_phy_timing *timing = &dsi->phy_timing;
+	struct videomode *vm = &dsi->vm;
+	u32 hsa_byte, hbp_byte, hfp_byte;
+	u32 ps_wc, hs_vb_ps_wc;
+	u32 bpp;
+
+	bpp = dsi->format == MIPI_DSI_FMT_RGB565 ? 2 : 3;
+
+	if (dsi->mode_flags & MIPI_DSI_MODE_VIDEO_SYNC_PULSE) {
+		hsa_byte = ALIGN(vm->hsync_len * bpp - 10, 4);
+		hbp_byte = ALIGN(vm->hback_porch * bpp - 10, 4);
+	} else {
+		hsa_byte = ALIGN(vm->hsync_len * bpp - 4, 4);
+		hbp_byte = ALIGN((vm->hback_porch + vm->hsync_len) * bpp - 10, 4);
+	}
+	hfp_byte = ALIGN(vm->hfront_porch * bpp - 12, 4);
+
+	if (dsi->dsc)
+		ps_wc = dsi->dsc->slice_count * dsi->dsc->slice_chunk_size;
+	else
+		ps_wc = vm->hactive * bpp;
+
+	hs_vb_ps_wc = ps_wc - (timing->lpx + timing->da_hs_exit +
+			       timing->da_hs_prepare + timing->da_hs_zero + 2) *
+			      dsi->lanes;
+
+	writel(hsa_byte, dsi->regs + DSI_HSA_WC);
+	writel(hbp_byte, dsi->regs + DSI_HBP_WC);
+	writel(hfp_byte | FIELD_PREP(HFP_HS_EN, 1) |
+	       FIELD_PREP(HFP_HS_VB_PS_WC, hs_vb_ps_wc),
+	       dsi->regs + DSI_HFP_WC);
+}
