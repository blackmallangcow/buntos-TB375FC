+/*
+ * The way the vendor gets the timing of the N4 and N5 hosts. It takes the rate
+ * its panel asks for, 1004 Mbps, not the one the PLL gets, so this has the cycle
+ * of that rate instead of the real one. The upper limit of hs_prep is then off
+ * by 5 ns, and the panel is known to work with these values.
+ */
+static void mtk_dsi_phy_timconfig_nominal(struct mtk_dsi *dsi)
+{
+	struct mtk_phy_timing *timing = &dsi->phy_timing;
+	u32 rate_mhz = dsi->driver_data->nominal_rate_mhz;
+	u32 ui = max_t(u32, 1000 / rate_mhz, 1);
+	u32 cycle = 8000 / rate_mhz;
+	u32 clk_prep = NS_TO_CYCLE(64, cycle);
+	u32 clk_zero = NS_TO_CYCLE(350, cycle);
+	u32 hs_prep = NS_TO_CYCLE(64 + 5 * ui, cycle) + 1;
+	u32 hs_zero = NS_TO_CYCLE(200 + 10 * ui, cycle);
+	u32 lpx = NS_TO_CYCLE(75, cycle) + 1;
+
+	timing->lpx = lpx + lpx % 2;
+	timing->da_hs_prepare = max(hs_prep + hs_prep % 2, 6U);
+	/* Before the rounding up of hs_prep */
+	timing->da_hs_zero = hs_zero > hs_prep ? hs_zero - hs_prep : hs_zero;
+	timing->da_hs_trail = max(NS_TO_CYCLE(9 * ui, cycle),
+				  NS_TO_CYCLE(80 + 5 * ui, cycle));
+
+	/* Before the rounding up of lpx */
+	timing->ta_go = 4 * lpx;
+	timing->ta_sure = 3 * lpx / 2;
+	timing->ta_get = 5 * lpx;
+	timing->da_hs_exit = (NS_TO_CYCLE(125, cycle) + 1) | 1;
+
+	timing->clk_hs_prepare = clk_prep;
+	timing->clk_hs_zero = clk_zero > clk_prep ? clk_zero - clk_prep : clk_zero;
+	timing->clk_hs_trail = NS_TO_CYCLE(80, cycle);
+	timing->clk_hs_exit = NS_TO_CYCLE(125, cycle) + 1;
+	timing->clk_hs_post = NS_TO_CYCLE(90 + 52 * ui, cycle);
+
+	/* The pattern of the clock lane: the vendor always writes it for these hosts */
+	writel(LC_PAT_DPHY, dsi->regs + DSI_PHY_LCPAT);
+}
