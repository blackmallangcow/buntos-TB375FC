+/*
+ * The buffer between the display path and the lanes, with the marks for the bus
+ * priority. In video mode the host starts from the frame timing, so it needs no
+ * mark of its own to send data.
+ */
+static void mtk_dsi_config_tx_buf(struct mtk_dsi *dsi)
+{
+	const struct mtk_dsi_tx_buf_data *buf = dsi->driver_data->tx_buf;
+	u32 data_rate_mhz = dsi->driver_data->nominal_rate_mhz;
+	u32 clk_mhz = clk_get_rate(dsi->engine_clk) / HZ_PER_MHZ;
+	u32 ps_wc, bpp, size, fill_rate, drain_rate, rw_lines;
+
+	bpp = dsi->format == MIPI_DSI_FMT_RGB565 ? 2 : 3;
+
+	if (dsi->dsc)
+		ps_wc = dsi->dsc->slice_count * dsi->dsc->slice_chunk_size;
+	else
+		ps_wc = dsi->vm.hactive * bpp;
+	rw_lines = ps_wc * dsi->vm.vactive;
+
+#define DSI_TX_BUF_MARK(us)	((us) * data_rate_mhz * dsi->lanes / 8 / buf->buffer_unit)
+	size = buf->sram_lines * buf->sram_unit / buf->buffer_unit;
+	fill_rate = clk_mhz * bpp / buf->buffer_unit;
+	drain_rate = data_rate_mhz * dsi->lanes / 8 / buf->buffer_unit;
+	fill_rate = max(fill_rate, drain_rate);
+
+	mtk_dsi_mask(dsi, DSI_BUF_CON1, BUF_OUT_VALID_THRESH, 0);
+	mtk_dsi_mask(dsi, DSI_DEBUG_SEL, MM_RST_SEL, 0);
+	mtk_dsi_mask(dsi, DSI_RESERVED, VDE_BLOCK_ULTRA, 0);
+
+	writel(FIELD_PREP(BUF_THRESHOLD, size - 12 * (fill_rate - drain_rate) / 10),
+	       dsi->regs + DSI_BUF_SODI_HIGH);
+	writel(FIELD_PREP(BUF_THRESHOLD, DSI_TX_BUF_MARK(23 + 5)),
+	       dsi->regs + DSI_BUF_SODI_LOW);
+	writel(FIELD_PREP(BUF_THRESHOLD, DSI_TX_BUF_MARK(26)),
+	       dsi->regs + DSI_BUF_PREULTRA_HIGH);
+	writel(FIELD_PREP(BUF_THRESHOLD, DSI_TX_BUF_MARK(25)),
+	       dsi->regs + DSI_BUF_PREULTRA_LOW);
+	writel(FIELD_PREP(BUF_THRESHOLD, DSI_TX_BUF_MARK(25)),
+	       dsi->regs + DSI_BUF_ULTRA_HIGH);
+	writel(FIELD_PREP(BUF_THRESHOLD, DSI_TX_BUF_MARK(23)),
+	       dsi->regs + DSI_BUF_ULTRA_LOW);
+	writel(FIELD_PREP(BUF_THRESHOLD, DSI_TX_BUF_MARK(buf->urgent_hi_us)),
+	       dsi->regs + DSI_BUF_URGENT_HIGH);
+	writel(FIELD_PREP(BUF_THRESHOLD, DSI_TX_BUF_MARK(buf->urgent_lo_us)),
+	       dsi->regs + DSI_BUF_URGENT_LOW);
+#undef DSI_TX_BUF_MARK
+
+	writel(DIV_ROUND_UP(rw_lines, buf->read_width),
+	       dsi->regs + DSI_TX_BUF_RW_TIMES);
+	mtk_dsi_mask(dsi, DSI_BUF_CON0, BUF_BUF_EN, BUF_BUF_EN);
+}
