From: buntOS contributors
Subject: [PATCH] ASoC: dt-bindings: add the MediaTek MT6368 codec

The audio codec of the MT6368 PMIC, a sub-device of the SPMI PMIC. Like the
MT6359 it describes what is connected to its analog inputs. Its 26 MHz comes
from a clock buffer of the MT6685, reached through "mediatek,dcxo" as the
MT6897 connectivity subsystem does for the same chip.
---
 .../bindings/mfd/mediatek,mt6363.yaml         |  7 ++
 .../bindings/sound/mediatek,mt6368-sound.yaml | 77 +++++++++++++++++++
 2 files changed, 84 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/mediatek,mt6368-sound.yaml

diff --git a/Documentation/devicetree/bindings/mfd/mediatek,mt6363.yaml b/Documentation/devicetree/bindings/mfd/mediatek,mt6363.yaml
index 015e313..341b9ad 100644
--- a/Documentation/devicetree/bindings/mfd/mediatek,mt6363.yaml
+++ b/Documentation/devicetree/bindings/mfd/mediatek,mt6363.yaml
@@ -50,6 +50,13 @@ properties:
   "#interrupt-cells":
     const: 3
 
+  audio-codec:
+    type: object
+    $ref: /schemas/sound/mediatek,mt6368-sound.yaml#
+    unevaluatedProperties: false
+    description:
+      The audio codec of the MT6368.
+
   keys:
     type: object
     $ref: /schemas/input/mediatek,pmic-keys.yaml#
diff --git a/Documentation/devicetree/bindings/sound/mediatek,mt6368-sound.yaml b/Documentation/devicetree/bindings/sound/mediatek,mt6368-sound.yaml
new file mode 100644
index 0000000..a2140aa
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/mediatek,mt6368-sound.yaml
@@ -0,0 +1,77 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/mediatek,mt6368-sound.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6368 Codec
+
+maintainers:
+  - Liam Girdwood <lgirdwood@gmail.com>
+  - Mark Brown <broonie@kernel.org>
+
+description:
+  The audio codec of the MT6368 PMIC, reached over SPMI. It must be a child
+  node of the PMIC.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: mediatek,mt6368-sound
+
+  '#sound-dai-cells':
+    const: 0
+
+  mediatek,dcxo:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      The PMIC with the clock buffer for the codec's 26 MHz, an MT6685.
+
+  vaud18-supply:
+    description: The 1.8 V supply of the analog part.
+
+  mediatek,mic-type-0:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: The type of microphone on AIN0.
+    enum:
+      - 0 # IDLE - mic in turn-off status
+      - 1 # ACC - analog mic with alternating coupling
+      - 2 # DMIC - digital mic
+      - 3 # DCC - analog mic with direct coupling
+      - 4 # DCC_ECM_DIFF - analog electret condenser mic, differential
+      - 5 # DCC_ECM_SINGLE - analog electret condenser mic, single ended
+    default: 3
+
+  mediatek,mic-type-1:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: The type of microphone on AIN1.
+    enum: [0, 1, 2, 3, 4, 5]
+    default: 3
+
+  mediatek,mic-type-2:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: The type of microphone on AIN2 and AIN3.
+    enum: [0, 1, 2, 3, 4, 5]
+    default: 3
+
+required:
+  - compatible
+  - '#sound-dai-cells'
+  - mediatek,dcxo
+  - vaud18-supply
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    audio-codec {
+        compatible = "mediatek,mt6368-sound";
+        #sound-dai-cells = <0>;
+        mediatek,dcxo = <&mt6685>;
+        vaud18-supply = <&mt6368_vaud18>;
+        mediatek,mic-type-0 = <3>;
+    };
+
+...
