From: buntOS contributors
Subject: [PATCH] clk: mediatek: mux: add hardware voter mux gate without FENC

On MT6897 the hardware voter (HWV) opens and closes the gates of some
topckgen muxes, as on MT8196, but these muxes have no FENC status bit.
Once the voter has served the vote, the clock runs when the gate bit in
the mux register itself reads clear, so poll that bit instead.

Move the vote and its done poll into a helper shared with the FENC
variant, and add mtk_mux_gate_hwv_clr_set_upd_ops with the
MUX_GATE_HWV_CLR_SET_UPD() macros.

---
diff --git a/drivers/clk/mediatek/clk-mux.c b/drivers/clk/mediatek/clk-mux.c
index 5f4b07e7c..64cfcd2c0 100644
--- a/drivers/clk/mediatek/clk-mux.c
+++ b/drivers/clk/mediatek/clk-mux.c
@@ -122,18 +122,26 @@ static int mtk_clk_mux_is_enabled(struct clk_hw *hw)
 	return (val & BIT(mux->data->gate_shift)) == 0;
 }
 
-static int mtk_clk_mux_hwv_fenc_enable(struct clk_hw *hw)
+static int mtk_clk_mux_hwv_vote(struct clk_hw *hw)
 {
 	struct mtk_clk_mux *mux = to_mtk_clk_mux(hw);
 	u32 val;
-	int ret;
 
 	regmap_write(mux->regmap_hwv, mux->data->hwv_set_ofs,
 		     BIT(mux->data->gate_shift));
 
-	ret = regmap_read_poll_timeout_atomic(mux->regmap_hwv, mux->data->hwv_sta_ofs,
-					      val, val & BIT(mux->data->gate_shift), 0,
-					      MTK_WAIT_HWV_DONE_US);
+	return regmap_read_poll_timeout_atomic(mux->regmap_hwv, mux->data->hwv_sta_ofs,
+					       val, val & BIT(mux->data->gate_shift), 0,
+					       MTK_WAIT_HWV_DONE_US);
+}
+
+static int mtk_clk_mux_hwv_fenc_enable(struct clk_hw *hw)
+{
+	struct mtk_clk_mux *mux = to_mtk_clk_mux(hw);
+	u32 val;
+	int ret;
+
+	ret = mtk_clk_mux_hwv_vote(hw);
 	if (ret)
 		return ret;
 
@@ -144,6 +152,25 @@ static int mtk_clk_mux_hwv_fenc_enable(struct clk_hw *hw)
 	return ret;
 }
 
+/*
+ * Without a FENC, the clock is running once the voter has opened the gate
+ * in the mux register itself.
+ */
+static int mtk_clk_mux_hwv_enable(struct clk_hw *hw)
+{
+	struct mtk_clk_mux *mux = to_mtk_clk_mux(hw);
+	u32 val;
+	int ret;
+
+	ret = mtk_clk_mux_hwv_vote(hw);
+	if (ret)
+		return ret;
+
+	return regmap_read_poll_timeout_atomic(mux->regmap, mux->data->mux_ofs,
+					       val, !(val & BIT(mux->data->gate_shift)), 1,
+					       MTK_WAIT_HWV_DONE_US);
+}
+
 static void mtk_clk_mux_hwv_disable(struct clk_hw *hw)
 {
 	struct mtk_clk_mux *mux = to_mtk_clk_mux(hw);
@@ -228,7 +255,8 @@ static int mtk_clk_mux_determine_rate(struct clk_hw *hw,
 
 static bool mtk_clk_mux_uses_hwv(const struct clk_ops *ops)
 {
-	if (ops == &mtk_mux_gate_hwv_fenc_clr_set_upd_ops)
+	if (ops == &mtk_mux_gate_hwv_fenc_clr_set_upd_ops ||
+	    ops == &mtk_mux_gate_hwv_clr_set_upd_ops)
 		return true;
 
 	return false;
@@ -271,6 +299,16 @@ const struct clk_ops mtk_mux_gate_hwv_fenc_clr_set_upd_ops = {
 };
 EXPORT_SYMBOL_GPL(mtk_mux_gate_hwv_fenc_clr_set_upd_ops);
 
+const struct clk_ops mtk_mux_gate_hwv_clr_set_upd_ops = {
+	.enable = mtk_clk_mux_hwv_enable,
+	.disable = mtk_clk_mux_hwv_disable,
+	.is_enabled = mtk_clk_mux_is_enabled,
+	.get_parent = mtk_clk_mux_get_parent,
+	.set_parent = mtk_clk_mux_set_parent_setclr_lock,
+	.determine_rate = mtk_clk_mux_determine_rate,
+};
+EXPORT_SYMBOL_GPL(mtk_mux_gate_hwv_clr_set_upd_ops);
+
 static struct clk_hw *mtk_clk_register_mux(struct device *dev,
 					   const struct mtk_mux *mux,
 					   struct regmap *regmap,
diff --git a/drivers/clk/mediatek/clk-mux.h b/drivers/clk/mediatek/clk-mux.h
index 1a9baf306..c2be1e591 100644
--- a/drivers/clk/mediatek/clk-mux.h
+++ b/drivers/clk/mediatek/clk-mux.h
@@ -85,6 +85,7 @@ extern const struct clk_ops mtk_mux_clr_set_upd_ops;
 extern const struct clk_ops mtk_mux_gate_clr_set_upd_ops;
 extern const struct clk_ops mtk_mux_gate_fenc_clr_set_upd_ops;
 extern const struct clk_ops mtk_mux_gate_hwv_fenc_clr_set_upd_ops;
+extern const struct clk_ops mtk_mux_gate_hwv_clr_set_upd_ops;
 
 #define MUX_GATE_CLR_SET_UPD_FLAGS(_id, _name, _parents, _mux_ofs,	\
 			_mux_set_ofs, _mux_clr_ofs, _shift, _width,	\
@@ -168,6 +169,42 @@ extern const struct clk_ops mtk_mux_gate_hwv_fenc_clr_set_upd_ops;
 				_shift, _width, _gate, _upd_ofs, _upd,			\
 				_fenc_sta_mon_ofs, _fenc, 0)
 
+/*
+ * Hardware voter mux gate without a FENC: the gate bit in the mux register
+ * shows whether the clock runs.
+ */
+#define MUX_GATE_HWV_CLR_SET_UPD_FLAGS(_id, _name, _parents,				\
+				_mux_ofs, _mux_set_ofs, _mux_clr_ofs,			\
+				_hwv_sta_ofs, _hwv_set_ofs, _hwv_clr_ofs,		\
+				_shift, _width, _gate, _upd_ofs, _upd, _flags) {	\
+			.id = _id,							\
+			.name = _name,							\
+			.mux_ofs = _mux_ofs,						\
+			.set_ofs = _mux_set_ofs,					\
+			.clr_ofs = _mux_clr_ofs,					\
+			.hwv_sta_ofs = _hwv_sta_ofs,					\
+			.hwv_set_ofs = _hwv_set_ofs,					\
+			.hwv_clr_ofs = _hwv_clr_ofs,					\
+			.upd_ofs = _upd_ofs,						\
+			.mux_shift = _shift,						\
+			.mux_width = _width,						\
+			.gate_shift = _gate,						\
+			.upd_shift = _upd,						\
+			.parent_names = _parents,					\
+			.num_parents = ARRAY_SIZE(_parents),				\
+			.flags = _flags,						\
+			.ops = &mtk_mux_gate_hwv_clr_set_upd_ops,			\
+		}
+
+#define MUX_GATE_HWV_CLR_SET_UPD(_id, _name, _parents,					\
+				_mux_ofs, _mux_set_ofs, _mux_clr_ofs,			\
+				_hwv_sta_ofs, _hwv_set_ofs, _hwv_clr_ofs,		\
+				_shift, _width, _gate, _upd_ofs, _upd)			\
+			MUX_GATE_HWV_CLR_SET_UPD_FLAGS(_id, _name, _parents,		\
+				_mux_ofs, _mux_set_ofs, _mux_clr_ofs,			\
+				_hwv_sta_ofs, _hwv_set_ofs, _hwv_clr_ofs,		\
+				_shift, _width, _gate, _upd_ofs, _upd, 0)
+
 #define MUX_GATE_FENC_CLR_SET_UPD_FLAGS(_id, _name, _parents, _paridx,		\
 			_num_parents, _mux_ofs, _mux_set_ofs, _mux_clr_ofs,	\
 			_shift, _width, _gate, _upd_ofs, _upd,			\
