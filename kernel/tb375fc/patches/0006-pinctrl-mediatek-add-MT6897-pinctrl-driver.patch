From: buntOS contributors
Subject: [PATCH] pinctrl: mediatek: add MT6897 pinctrl driver

Add the pin controller and GPIO driver for the MediaTek MT6897 (Dimensity
8300) SoC, modelled on the MT6878 driver.

- The register field tables and pull types come from the MediaTek vendor
  driver (pinctrl-mt6897.c in the OnePlus Pad GPL release).
- The vendor enhanced drive (DRV_EH) fields map to DRV_ADV. The vendor-only
  I2C enhanced drive list and capability flags are left out.
- The EINT table has 250 entries in five instances, 141 of them used, as
  in the mediatek,pins list of the vendor device tree. Unused numbers are
  marked EINT_INVALID_BASE, as on MT8196.
- EINTs 232 to 249 have no pin. As on MT6878 and MT8196 they get virtual
  pins (veint232 to veint249), so that users such as the SPMI rcs
  interrupt (EINT 248) can request them.
- The debounce times are the same as on MT6878.

---
diff --git a/drivers/pinctrl/mediatek/Kconfig b/drivers/pinctrl/mediatek/Kconfig
index 97980cc28..618f340d6 100644
--- a/drivers/pinctrl/mediatek/Kconfig
+++ b/drivers/pinctrl/mediatek/Kconfig
@@ -186,6 +186,16 @@ config PINCTRL_MT6893
 	  Say yes here to support pin controller and gpio driver
 	  on the MediaTek Dimensity 1200 MT6893 Smartphone SoC.
 
+config PINCTRL_MT6897
+	bool "MediaTek Dimensity MT6897 pin control"
+	depends on OF
+	depends on ARM64 || COMPILE_TEST
+	default ARM64 && ARCH_MEDIATEK
+	select PINCTRL_MTK_PARIS
+	help
+	  Say yes here to support pin controller and gpio driver
+	  on the MediaTek Dimensity 8300 MT6897 SoC.
+
 config PINCTRL_MT7622
 	bool "MediaTek MT7622 pin control"
 	depends on OF
diff --git a/drivers/pinctrl/mediatek/Makefile b/drivers/pinctrl/mediatek/Makefile
index 6dc17b0c2..773dff11d 100644
--- a/drivers/pinctrl/mediatek/Makefile
+++ b/drivers/pinctrl/mediatek/Makefile
@@ -24,6 +24,7 @@ obj-$(CONFIG_PINCTRL_MT6795)		+= pinctrl-mt6795.o
 obj-$(CONFIG_PINCTRL_MT6797)		+= pinctrl-mt6797.o
 obj-$(CONFIG_PINCTRL_MT6878)		+= pinctrl-mt6878.o
 obj-$(CONFIG_PINCTRL_MT6893)		+= pinctrl-mt6893.o
+obj-$(CONFIG_PINCTRL_MT6897)		+= pinctrl-mt6897.o
 obj-$(CONFIG_PINCTRL_MT7622)		+= pinctrl-mt7622.o
 obj-$(CONFIG_PINCTRL_MT7623)		+= pinctrl-mt7623.o
 obj-$(CONFIG_PINCTRL_MT7629)		+= pinctrl-mt7629.o
