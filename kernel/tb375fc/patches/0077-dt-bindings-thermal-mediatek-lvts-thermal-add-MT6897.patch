From: buntOS contributors
Subject: [PATCH] dt-bindings: thermal: mediatek,lvts-thermal: add MT6897

The MT6897 has four LVTS domains: AP, MCU, APU and GPU, with 32 sensors
in nine controllers. The sensors and their names are from the stock
device tree and the LVTS driver in the OnePlus MT6897 kernel.

The boot firmware sets the hardware up, so it has no clock or reset for
the kernel to use. The calibration data is spread out over four NVMEM
cells.
---
 .../thermal/mediatek,lvts-thermal.yaml        | 44 ++++++++++++++++++-
 .../thermal/mediatek,lvts-thermal.h           | 36 +++++++++++++++
 2 files changed, 78 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/thermal/mediatek,lvts-thermal.yaml b/Documentation/devicetree/bindings/thermal/mediatek,lvts-thermal.yaml
index 9752351..99e9762 100644
--- a/Documentation/devicetree/bindings/thermal/mediatek,lvts-thermal.yaml
+++ b/Documentation/devicetree/bindings/thermal/mediatek,lvts-thermal.yaml
@@ -18,6 +18,10 @@ description: |
 properties:
   compatible:
     enum:
+      - mediatek,mt6897-lvts-ap
+      - mediatek,mt6897-lvts-apu
+      - mediatek,mt6897-lvts-gpu
+      - mediatek,mt6897-lvts-mcu
       - mediatek,mt7987-lvts-ap
       - mediatek,mt7988-lvts-ap
       - mediatek,mt8186-lvts
@@ -48,12 +52,16 @@ properties:
     items:
       - description: Calibration eFuse data 1 for LVTS
       - description: Calibration eFuse data 2 for LVTS
+      - description: Calibration eFuse data 3 for LVTS
+      - description: Calibration eFuse data 4 for LVTS
 
   nvmem-cell-names:
     minItems: 1
     items:
       - const: lvts-calib-data-1
       - const: lvts-calib-data-2
+      - const: lvts-calib-data-3
+      - const: lvts-calib-data-4
 
   "#thermal-sensor-cells":
     const: 1
@@ -61,6 +69,40 @@ properties:
 allOf:
   - $ref: thermal-sensor.yaml#
 
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - mediatek,mt6897-lvts-ap
+              - mediatek,mt6897-lvts-apu
+              - mediatek,mt6897-lvts-gpu
+              - mediatek,mt6897-lvts-mcu
+    then:
+      description:
+        Firmware sets the LVTS up before the kernel starts and the kernel only
+        reads it, so there is no clock or reset for the kernel to use.
+      properties:
+        clocks: false
+
+        resets: false
+
+        nvmem-cells:
+          minItems: 4
+
+        nvmem-cell-names:
+          minItems: 4
+    else:
+      properties:
+        nvmem-cells:
+          maxItems: 2
+
+        nvmem-cell-names:
+          maxItems: 2
+      required:
+        - clocks
+        - resets
+
   - if:
       properties:
         compatible:
@@ -98,8 +140,6 @@ required:
   - compatible
   - reg
   - interrupts
-  - clocks
-  - resets
   - nvmem-cells
   - nvmem-cell-names
 
diff --git a/include/dt-bindings/thermal/mediatek,lvts-thermal.h b/include/dt-bindings/thermal/mediatek,lvts-thermal.h
index 350f981..9909d1d 100644
--- a/include/dt-bindings/thermal/mediatek,lvts-thermal.h
+++ b/include/dt-bindings/thermal/mediatek,lvts-thermal.h
@@ -7,6 +7,42 @@
 #ifndef __MEDIATEK_LVTS_DT_H
 #define __MEDIATEK_LVTS_DT_H
 
+#define MT6897_MCU_MEDIUM_CPU4_0	0
+#define MT6897_MCU_MEDIUM_CPU4_1	1
+#define MT6897_MCU_MEDIUM_CPU5_0	2
+#define MT6897_MCU_MEDIUM_CPU5_1	3
+#define MT6897_MCU_LITTLE_CPU2		4
+#define MT6897_MCU_LITTLE_CPU3		5
+#define MT6897_MCU_MEDIUM_CPU6_0	6
+#define MT6897_MCU_MEDIUM_CPU6_1	7
+#define MT6897_MCU_DSU0			8
+#define MT6897_MCU_LITTLE_CPU0		9
+#define MT6897_MCU_LITTLE_CPU1		10
+#define MT6897_MCU_DSU1			11
+#define MT6897_MCU_BIG_CPU7_0		12
+#define MT6897_MCU_BIG_CPU7_1		13
+#define MT6897_MCU_DSU2			14
+#define MT6897_MCU_DSU3			15
+
+#define MT6897_AP_TOP0			0
+#define MT6897_AP_TOP1			1
+#define MT6897_AP_TOP2			2
+#define MT6897_AP_TOP3			3
+#define MT6897_AP_BOT0			4
+#define MT6897_AP_BOT1			5
+#define MT6897_AP_BOT2			6
+#define MT6897_AP_BOT3			7
+#define MT6897_AP_MD0			8
+#define MT6897_AP_MD1			9
+#define MT6897_AP_MD2			10
+#define MT6897_AP_MD3			11
+
+#define MT6897_APU0			0
+#define MT6897_APU1			1
+
+#define MT6897_GPU0			0
+#define MT6897_GPU1			1
+
 #define MT7987_CPU		0
 #define MT7987_ETH2P5G		1
 
