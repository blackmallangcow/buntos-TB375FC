+
+/* modifiers and six usages, without the reserved byte of a boot report */
+static void owb_tc_report_keys(struct pogo_kbd *kb, const u8 *data, unsigned int len)
+{
+	u8 rep[POGO_KEY_REPORT_LEN] = { };
+
+	if (len < OWB_TC_KEY_REPORT_LEN)
+		return;
+	rep[0] = data[0];
