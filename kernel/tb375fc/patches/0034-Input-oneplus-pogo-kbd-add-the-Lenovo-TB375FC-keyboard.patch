+	{ 0xde, 0xac, 0xe9, 0xae, 0xf1, 0xba, 0xc4, 0xe7,
+	  0xcf, 0xec, 0xea, 0xb4, 0xf4, 0xfe, 0x14, 0xb2 },
+	{ 0x3d, 0x3b, 0xdd, 0xb7, 0xef, 0xb8, 0xc5, 0xcd,
+	  0xaa, 0xdf, 0xbe, 0x37, 0xf5, 0xf8, 0xaf, 0x3c },
+	{ 0x34, 0x3e, 0xa7, 0xad, 0xb5, 0x16, 0x1a, 0xfc,
+	  0xe4, 0xb6, 0xff, 0xc2, 0x36, 0xd7, 0xc9, 0x1b },
+	{ 0x17, 0xf0, 0xfa, 0xa8, 0xa3, 0xb9, 0xc7, 0xf2,
+	  0x31, 0xd9, 0xe1, 0x15, 0xf7, 0xdb, 0xa6, 0xc1 },
+};
+
+static u8 owb_tc_sum(const u8 *buf, unsigned int len)
+{
+	u8 sum = 0;
+
+	while (len--)
+		sum += *buf++;
+	return sum;
+}
+
+static unsigned int owb_tc_encode(u8 *out, const u8 *row, u8 value)
+{
+	out[0] = row[15 - (value >> 4)];
+	out[1] = row[15 - (value & 0xf)];
+	return 2;
+}
+
+static unsigned int owb_tc_build_frame(u8 *out, u8 cmd, const u8 *payload, u8 len)
+{
+	const u8 *row = owb_tc_rows[get_random_u8() % ARRAY_SIZE(owb_tc_rows)];
+	unsigned int n = OWB_HEAD_SYNC_LEN, i;
+
+	memset(out, OWB_HEAD_SYNC, OWB_HEAD_SYNC_LEN);
+	out[n++] = OWB_TC_START;
+	out[n++] = cmd;
+	n += owb_tc_encode(&out[n], row, len);
+	for (i = 0; i < len; i++)
+		n += owb_tc_encode(&out[n], row, payload[i]);
+	n += owb_tc_encode(&out[n], row, owb_tc_sum(&out[OWB_HEAD_SYNC_LEN],
+						    n - OWB_HEAD_SYNC_LEN));
+	out[n++] = OWB_TC_END;
+	memset(&out[n], OWB_HEAD_SYNC, OWB_TAIL_SYNC_LEN);
+	n += OWB_TAIL_SYNC_LEN;
+
+	return n;
+}
