-static void pogo_report_touchpad(struct pogo_kbd *kb, const u8 *data,
-				 unsigned int len)
+static void owb_report_touchpad(struct pogo_kbd *kb, const u8 *data,
+				unsigned int len)
 {
 	struct input_dev *input = kb->tp;
 	unsigned int fingers, i;
@@ -574,6 +751,53 @@ static void pogo_report_touchpad(struct pogo_kbd *kb, const u8 *data,
 	input_sync(input);
 }
 
+/*
+ * Touchpad payload: a button byte followed by fingers x {flags, x_lo, x_hi,
+ * y_lo, y_hi}.  flags: [7:4] slot id, [0] down.  A finger left out of a report
+ * has been lifted.
+ */
+static void owb_tc_report_touchpad(struct pogo_kbd *kb, const u8 *data,
+				   unsigned int len)
+{
+	struct input_dev *input = kb->tp;
+	unsigned int fingers, i;
+
+	if (len < 1)
+		return;
+	fingers = (len - 1) / POGO_TOUCH_REC_LEN;
+	if (fingers > kb->hw->tp_fingers)
+		return;
+
+	for (i = 0; i < fingers; i++) {
+		const u8 *rec = data + 1 + i * POGO_TOUCH_REC_LEN;
+		unsigned int slot = rec[0] >> 4;
+		bool down = rec[0] & BIT(0);
+
+		if (slot >= kb->hw->tp_fingers)
+			continue;
+		input_mt_slot(input, slot);
+		input_mt_report_slot_state(input, MT_TOOL_FINGER, down);
+		if (down) {
+			input_report_abs(input, ABS_MT_POSITION_X,
+					 get_unaligned_le16(rec + 1));
+			input_report_abs(input, ABS_MT_POSITION_Y,
+					 get_unaligned_le16(rec + 3));
+		}
+	}
+	input_mt_sync_frame(input);
+	input_report_key(input, BTN_LEFT, data[0] & 0x03);
+	input_sync(input);
+}
+
+/* state_lock held, as a frame can still come when the keyboard has lost power */
+static void pogo_report_tablet_mode(struct pogo_kbd *kb, bool tablet)
+{
+	if (!kb->sw)
+		return;
+	input_report_switch(kb->sw, SW_TABLET_MODE, tablet);
+	input_sync(kb->sw);
+}
