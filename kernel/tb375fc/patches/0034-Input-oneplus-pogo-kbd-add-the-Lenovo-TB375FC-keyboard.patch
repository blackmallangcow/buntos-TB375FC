+	unsigned int n = (kb->rx_len - OWB_TC_HDR_LEN) / 2, i;
+	u8 msg[OWB_MAX_PAYLOAD + 2];	/* len, payload, sum */
+	const u8 *row;
+	u8 cmd = kb->rx_buf[1];
