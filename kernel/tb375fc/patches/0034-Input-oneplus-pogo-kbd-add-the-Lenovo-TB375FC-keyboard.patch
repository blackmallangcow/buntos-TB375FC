+	if (kb->rx_len < OWB_TC_HDR_LEN + OWB_TC_SYMBOLS(0) ||
+	    (kb->rx_len - OWB_TC_HDR_LEN) % 2 || n > sizeof(msg)) {
+		dev_dbg(kb->dev, "bad frame length %u\n", kb->rx_len);
+		return;
