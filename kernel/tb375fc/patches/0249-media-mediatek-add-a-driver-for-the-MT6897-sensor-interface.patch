+	{ MEDIA_BUS_FMT_SRGGB12_1X12, MIPI_CSI2_DT_RAW12, 12 },
+};
+
+struct mt6897_seninf {
+	struct device *dev;
+	void __iomem *base;
+	void __iomem *ana;
+	struct clk_bulk_data clks[ARRAY_SIZE(seninf_clk_names)];
+	struct dev_pm_domain_list *pds;
+	struct mt6897_vcp *vcp;
+	unsigned long csi_rate;
+	unsigned int num_lanes;
+	u32 trims;		/* CSI0 termination trims from the fuses */
+	bool have_trims;
+
+	struct media_device mdev;
+	struct v4l2_device v4l2_dev;
+	struct v4l2_subdev sd;
+	struct media_pad pads[SENINF_NUM_PADS];
+	struct v4l2_async_notifier notifier;
+
+	struct mutex debugfs_lock;	/* serializes the debugfs stream file */
+	struct dentry *debugfs;
+};
+
+static inline struct mt6897_seninf *sd_to_seninf(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct mt6897_seninf, sd);
+}
+
+static const struct seninf_format *seninf_find_format(u32 code)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(seninf_formats); i++)
+		if (seninf_formats[i].code == code)
+			return &seninf_formats[i];
+	return NULL;
+}
+
+/* ---- registers --------------------------------------------------------- */
+
+static void seninf_update(void __iomem *reg, u32 mask, u32 val)
+{
+	writel((readl(reg) & ~mask) | (val & mask), reg);
+}
+
+#define seninf_field(reg, mask, val)	seninf_update(reg, mask, FIELD_PREP(mask, val))
+
+#define R_TOP(s, off)		((s)->base + (off))
+#define R_S1(s, off)		((s)->base + SENINF1 + (off))
+#define R_CSI2(s, off)		((s)->base + SENINF1_CSI2 + (off))
+#define R_MUX(s, n, off)		((s)->base + SENINF_MUX(n) + (off))
+#define R_CAM_MUX(s, n, off)	((s)->base + SENINF_CAM_MUX(n) + (off))
+#define R_GCSR(s, off)		((s)->base + SENINF_CAM_MUX_GCSR + (off))
+#define R_ANA(s, half, off)	((s)->ana + (half) + (off))
+#define R_DPHY(s, off)		((s)->ana + DPHY_RX + (off))
+#define R_MACT(s, off)		((s)->ana + CSIRX_MAC_TOP + (off))
+#define R_MACC(s, off)		((s)->ana + CSIRX_MAC_CSI2 + (off))
+
+static u32 seninf_ns_to_cycles(struct mt6897_seninf *seninf, u32 ns)
+{
+	return DIV_ROUND_UP_ULL((u64)ns * seninf->csi_rate, NSEC_PER_SEC);
+}
+
+/* What the vendor does when the first user powers seninf up */
+static void seninf_hw_idle(struct mt6897_seninf *seninf)
+{
+	unsigned int i, page;
+
+	for (i = 0; i < SENINF_NUM_MUX; i++)
+		seninf_update(R_MUX(seninf, i, SENINF_MUX_CTRL_0), MUX_EN, 0);
+
+	for (i = 0; i < SENINF_NUM_CAM_MUX; i++) {
+		seninf_field(R_CAM_MUX(seninf, i, CAM_MUX_CTRL), CAM_MUX_NEXT_SRC_SEL,
+			     CAM_MUX_SRC_IDLE);
+		seninf_field(R_CAM_MUX(seninf, i, CAM_MUX_CTRL), CAM_MUX_SRC_SEL,
+			     CAM_MUX_SRC_IDLE);
+		seninf_update(R_CAM_MUX(seninf, i, CAM_MUX_CTRL), CAM_MUX_EN, 0);
+		for (page = 0; page < 4; page++) {
+			seninf_field(R_CAM_MUX(seninf, i, CAM_MUX_OPT),
+				     CAM_MUX_TAG_PAGE_SEL, page);
+			writel(0, R_CAM_MUX(seninf, i, CAM_MUX_TAG_VC_SEL));
+			writel(0, R_CAM_MUX(seninf, i, CAM_MUX_TAG_DT_SEL));
+		}
+		writel(CAM_MUX_IRQ_CLEAR, R_CAM_MUX(seninf, i, CAM_MUX_IRQ_STATUS));
+	}
+}
+
+static void seninf_ana_power(struct mt6897_seninf *seninf, u32 half, bool on)
+{
+	seninf_update(R_ANA(seninf, half, CDPHY_RX_ANA_8), ANA_EQ_OS_CAL_EN, 0);
+	seninf_update(R_ANA(seninf, half, CDPHY_RX_ANA_0), ANA_BG_LPF_EN, 0);
+	seninf_update(R_ANA(seninf, half, CDPHY_RX_ANA_0), ANA_BG_CORE_EN, 0);
+	fsleep(200);
+	if (!on)
+		return;
+
+	seninf_update(R_ANA(seninf, half, CDPHY_RX_ANA_0), ANA_BG_CORE_EN,
+		      ANA_BG_CORE_EN);
+	fsleep(30);
+	seninf_update(R_ANA(seninf, half, CDPHY_RX_ANA_0), ANA_BG_LPF_EN,
+		      ANA_BG_LPF_EN);
+	udelay(1);
+	seninf_update(R_ANA(seninf, half, CDPHY_RX_ANA_8), ANA_EQ_OS_CAL_EN,
+		      ANA_EQ_OS_CAL_EN);
+	udelay(1);
+}
+
+static void seninf_ana_hsrt(struct mt6897_seninf *seninf, u32 half,
+			    const u32 code[3])
+{
+	unsigned int i;
+
+	for (i = 0; i < 3; i++) {
+		seninf_field(R_ANA(seninf, half, CDPHY_RX_ANA_HSRT(i)),
+			     ANA_HSRT_CODE_P, code[i]);
+		seninf_field(R_ANA(seninf, half, CDPHY_RX_ANA_HSRT(i)),
+			     ANA_HSRT_CODE_N, code[i]);
+	}
+}
+
+static void seninf_ana_init(struct mt6897_seninf *seninf, u32 half)
+{
+	static const u32 hsrt_default[3] = {
+		ANA_HSRT_CODE_DEFAULT, ANA_HSRT_CODE_DEFAULT, ANA_HSRT_CODE_DEFAULT,
+	};
+	unsigned int i;
+
+	seninf_field(R_ANA(seninf, half, CDPHY_RX_ANA_1), ANA_BG_LPRX_VTL_SEL, 4);
+	seninf_field(R_ANA(seninf, half, CDPHY_RX_ANA_1), ANA_BG_LPRX_VTH_SEL, 4);
+	seninf_field(R_ANA(seninf, half, CDPHY_RX_ANA_2), ANA_BG_ALP_RX_VTL_SEL, 4);
+	seninf_field(R_ANA(seninf, half, CDPHY_RX_ANA_2), ANA_BG_ALP_RX_VTH_SEL, 4);
+	seninf_field(R_ANA(seninf, half, CDPHY_RX_ANA_1), ANA_BG_VREF_SEL, 8);
+	seninf_field(R_ANA(seninf, half, CDPHY_RX_ANA_1), ANA_EQ_DES_VREF_SEL, 2);
+
+	seninf_field(R_ANA(seninf, half, CDPHY_RX_ANA_5), ANA_EQ_BW, 1);
+	seninf_field(R_ANA(seninf, half, CDPHY_RX_ANA_5), ANA_EQ_IS, 1);
+	seninf_update(R_ANA(seninf, half, CDPHY_RX_ANA_5), ANA_EQ_LATCH_EN,
+		      ANA_EQ_LATCH_EN);
+	seninf_update(R_ANA(seninf, half, CDPHY_RX_ANA_5),
+		      ANA_EQ_DG0_EN | ANA_EQ_DG1_EN | ANA_EQ_SR0 | ANA_EQ_SR1, 0);
+
+	/* 50 ohm termination, replaced by the fuse trims if there are any */
+	seninf_ana_hsrt(seninf, half, hsrt_default);
+
+	seninf_update(R_ANA(seninf, half, CDPHY_RX_ANA_0),
+		      ANA_CPHY_CDR_FIRST_EDGE_EN, 0);
+	seninf_update(R_ANA(seninf, half, CDPHY_RX_ANA_2),
+		      ANA_CPHY_CDR_SELF_CAL_EN, 0);
+	for (i = 0; i < 2; i++) {
+		void __iomem *reg = R_ANA(seninf, half, CDPHY_RX_ANA_CDR(i));
+
+		seninf_field(reg, ANA_CDR_CK_DELAY, 4);
+		seninf_field(reg, ANA_CDR_AB_WIDTH, 9);
+		seninf_field(reg, ANA_CDR_BC_WIDTH, 9);
+		seninf_field(reg, ANA_CDR_CA_WIDTH, 9);
+	}
+	seninf_field(R_ANA(seninf, half, CDPHY_RX_ANA_8), ANA_RESERVE, 0x400);
+}
+
+static void seninf_dphy_timing(struct mt6897_seninf *seninf)
+{
+	u32 settle = min(seninf_ns_to_cycles(seninf, SENINF_DPHY_DATA_SETTLE_NS),
+			 0xffU);
+	u32 settle_ck = min(seninf_ns_to_cycles(seninf, SENINF_DPHY_CLK_SETTLE_NS),
+			    0xffU);
+	u32 trail = min(seninf_ns_to_cycles(seninf, SENINF_DPHY_TRAIL_NS), 0x3ffU);
+	unsigned int i;
+
+	dev_dbg(seninf->dev, "D-PHY settle %u, clock settle %u, trail %u cycles\n",
+		settle, settle_ck, trail);
+
+	for (i = 0; i < 4; i++) {
+		void __iomem *reg = R_DPHY(seninf, DPHY_RX_DATA_LANE(i));
+
+		seninf_field(reg, DPHY_LD_HS_SETTLE, settle);
+		seninf_field(reg, DPHY_LD_HS_PREPARE, 0);
+		seninf_field(reg, DPHY_LD_HS_TRAIL, trail);
+		seninf_update(reg, DPHY_LD_HS_TRAIL_EN, DPHY_LD_HS_TRAIL_EN);
+	}
+	for (i = 0; i < 2; i++)
+		seninf_field(R_DPHY(seninf, DPHY_RX_CLOCK_LANE(i)), DPHY_LC_HS_SETTLE,
+			     settle_ck);
+
+	seninf_update(R_DPHY(seninf, DPHY_RX_DESKEW_CTRL), DPHY_DESKEW_EN,
+		      DPHY_DESKEW_EN);
+	for (i = 0; i < 4; i++)
+		seninf_update(R_DPHY(seninf, DPHY_RX_DESKEW_LANE(i)),
+			      DPHY_DESKEW_DELAY_EN, 0);
+
+	for (i = 0; i < 4; i++)
+		seninf_update(R_DPHY(seninf, DPHY_RX_DATA_LANE(i)),
+			      DPHY_LD_HS_PREPARE_EN, DPHY_LD_HS_PREPARE_EN);
+	for (i = 0; i < 2; i++) {
+		void __iomem *reg = R_DPHY(seninf, DPHY_RX_CLOCK_LANE(i));
+
+		seninf_field(reg, DPHY_LC_HS_PREPARE, 0);
+		seninf_update(reg, DPHY_LC_HS_PREPARE_EN, DPHY_LC_HS_PREPARE_EN);
+	}
+
+	/* The vendor sets this for D-PHY too */
+	seninf_update(seninf->ana + CPHY_RX + CPHY_RX_DETECT_CTRL_POST,
+		      CPHY_DATA_VALID_POST_EN, CPHY_DATA_VALID_POST_EN);
+}
+
+static void seninf_mac_setup(struct mt6897_seninf *seninf)
+{
+	seninf_update(R_MACT(seninf, MAC_TOP_CTRL), MAC_TOP_8PIX_SHARE_16PIX, 0);
+	seninf_update(R_MACT(seninf, MAC_TOP_PHY_CTRL_CSI0), MAC_TOP_CPHY_EN, 0);
+	seninf_update(R_MACT(seninf, MAC_TOP_PHY_CTRL_CSI0), MAC_TOP_DPHY_EN,
+		      MAC_TOP_DPHY_EN);
+	seninf_field(R_MACT(seninf, MAC_TOP_PHY_CTRL_CSI0), MAC_TOP_CPHY_MODE, 0);
+
+	seninf_update(R_MACC(seninf, MAC_CSI2_OPT), MAC_CSI2_CPHY_SEL, 0);
+	seninf_field(R_MACC(seninf, MAC_CSI2_EN), MAC_CSI2_LANE_EN,
+		     GENMASK(seninf->num_lanes - 1, 0));
+	seninf_update(R_MACC(seninf, MAC_CSI2_OPT),
+		      MAC_CSI2_8_16_PIXEL_SEL | MAC_CSI2_ECC_EN | MAC_CSI2_B2P_EN |
+		      MAC_CSI2_IMG_PACKET_EN | MAC_CSI2_SPEC_V2P0_SEL |
+		      MAC_CSI2_MULTI_FRAME_VLD_EN | MAC_CSI2_VS_OUTPUT_MODE |
+		      MAC_CSI2_VS_OUTPUT_LEN_SEL,
+		      MAC_CSI2_ECC_EN | MAC_CSI2_B2P_EN | MAC_CSI2_IMG_PACKET_EN |
+		      MAC_CSI2_SPEC_V2P0_SEL | MAC_CSI2_MULTI_FRAME_VLD_EN);
+	seninf_field(R_MACC(seninf, MAC_CSI2_RESYNC_MERGE_CTRL),
+		     MAC_CSI2_RESYNC_CYCLE_CNT, 0x1f);
+	seninf_update(R_MACC(seninf, MAC_CSI2_RESYNC_MERGE_CTRL),
+		      MAC_CSI2_RESYNC_CYCLE_CNT_OPT, MAC_CSI2_RESYNC_CYCLE_CNT_OPT);
+	/* Only the clear mode: the status bits latch, no interrupt is raised */
+	writel(MAC_CSI2_IRQ_CLR_MODE, R_MACC(seninf, MAC_CSI2_IRQ_EN));
+	seninf_update(R_MACC(seninf, MAC_CSI2_DBG_CTRL), MAC_CSI2_DBG_PACKET_CNT_EN,
+		      MAC_CSI2_DBG_PACKET_CNT_EN);
+	seninf_update(R_MACC(seninf, MAC_CSI2_HDR_MODE_0),
+		      MAC_CSI2_HEADER_MODE | MAC_CSI2_HEADER_LEN, 0);
+	seninf_update(R_MACC(seninf, MAC_CSI2_RESYNC_MERGE_CTRL),
+		      MAC_CSI2_RESYNC_DMY_CYCLE | MAC_CSI2_RESYNC_DMY_CNT |
+		      MAC_CSI2_RESYNC_DMY_EN | MAC_CSI2_RESYNC_LRTE_EN, 0);
+}
+
+static void seninf_ana_dphy_mode(struct mt6897_seninf *seninf)
+{
+	static const u32 halves[] = { CSI0A, CSI0B };
+	unsigned int i;
+
+	seninf_field(R_ANA(seninf, CSI0A, CDPHY_RX_ANA_SETTING_1), ANA_ASYNC_OPTION, 4);
+	seninf_field(R_ANA(seninf, CSI0A, CDPHY_RX_ANA_SETTING_1),
+		     ANA_AFIFO_DUMMY_VALID_NUM, 3);
+	seninf_update(R_ANA(seninf, CSI0A, CDPHY_RX_ANA_SETTING_1),
+		      ANA_AFIFO_DUMMY_VALID_EN, ANA_AFIFO_DUMMY_VALID_EN);
+	seninf_field(R_ANA(seninf, CSI0A, CDPHY_RX_ANA_SETTING_1),
+		     ANA_AFIFO_DUMMY_PREPARE_NUM, 4);
+	seninf_field(R_ANA(seninf, CSI0A, CDPHY_RX_ANA_SETTING_1),
+		     ANA_AFIFO_DUMMY_GAP_NUM, 4);
+	seninf_field(R_ANA(seninf, CSI0A, CDPHY_RX_ANA_SETTING_0),
+		     ANA_ASYNC_FIFO_GATING_SEL, 2);
+
+	for (i = 0; i < ARRAY_SIZE(halves); i++) {
+		void __iomem *reg = R_ANA(seninf, halves[i], CDPHY_RX_ANA_0);
+
+		seninf_update(reg, ANA_CPHY_EN, 0);
+		seninf_update(reg, ANA_DPHY_CKMODE_EN, 0);
+		seninf_update(reg, ANA_DPHY_CKSEL, ANA_DPHY_CKSEL);
+	}
+	/* The clock lane is pair 2 of the A half */
+	seninf_update(R_ANA(seninf, CSI0A, CDPHY_RX_ANA_0), ANA_DPHY_L2_CKMODE_EN,
+		      ANA_DPHY_L2_CKMODE_EN);
+	for (i = 0; i < ARRAY_SIZE(halves); i++)
+		seninf_update(R_ANA(seninf, halves[i], CDPHY_RX_ANA_0),
+			      ANA_CPHY_HSMODE_EN, ANA_CPHY_HSMODE_EN);
+
+	/* Equalizer for less than 2.5 Gbit/s per lane */
+	for (i = 0; i < ARRAY_SIZE(halves); i++) {
+		void __iomem *reg = R_ANA(seninf, halves[i], CDPHY_RX_ANA_5);
+
+		seninf_update(reg, ANA_EQ_SR1 | ANA_EQ_SR0 | ANA_EQ_DG1_EN |
+			      ANA_EQ_DG0_EN | ANA_EQ_BW, 0);
+		seninf_update(reg, ANA_EQ_LATCH_EN, ANA_EQ_LATCH_EN);
+		seninf_field(reg, ANA_EQ_IS, 1);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(halves); i++)
+		seninf_ana_power(seninf, halves[i], true);
+}
+
+static void seninf_dphy_lanes(struct mt6897_seninf *seninf)
+{
+	unsigned int i;
+
+	seninf_update(R_DPHY(seninf, DPHY_RX_LANE_EN), DPHY_LC0_EN | DPHY_LC1_EN |
+		      DPHY_LD_EN, DPHY_LC0_EN | DPHY_LD_EN);
+	/* The vendor's fixed wiring of a four-lane port 0 */
+	seninf_field(R_DPHY(seninf, DPHY_RX_LANE_SELECT), DPHY_LC0_SEL, 2);
+	seninf_field(R_DPHY(seninf, DPHY_RX_LANE_SELECT), DPHY_LC1_SEL, 0);
+	seninf_field(R_DPHY(seninf, DPHY_RX_LANE_SELECT), DPHY_LD0_SEL, 1);
+	seninf_field(R_DPHY(seninf, DPHY_RX_LANE_SELECT), DPHY_LD1_SEL, 3);
+	seninf_field(R_DPHY(seninf, DPHY_RX_LANE_SELECT), DPHY_LD2_SEL, 0);
+	seninf_field(R_DPHY(seninf, DPHY_RX_LANE_SELECT), DPHY_LD3_SEL, 4);
+	for (i = 0; i < 2; i++) {
+		u32 half = i ? CSI0B : CSI0A;
+
+		seninf_update(R_ANA(seninf, half, CDPHY_RX_ASYM_AFIFO_CTRL_0),
+			      ANA_L0_AFIFO_FLUSH_EN | ANA_L1_AFIFO_FLUSH_EN,
+			      ANA_L0_AFIFO_FLUSH_EN | ANA_L1_AFIFO_FLUSH_EN);
+	}
+	seninf_update(R_DPHY(seninf, DPHY_RX_LANE_SELECT), DPHY_CK_DATA_MUX_EN,
+		      DPHY_CK_DATA_MUX_EN);
+	seninf_update(R_DPHY(seninf, DPHY_RX_HS_RX_EN_SW), DPHY_PN_SWAP_EN, 0);
+	seninf_update(R_DPHY(seninf, DPHY_DPHYV21_CTRL), DPHY_SYNC_METH_SEL,
+		      DPHY_SYNC_METH_SEL);
+	writel(0xf1, R_DPHY(seninf, DPHY_RX_SPARE0));
+	for (i = 0; i < 4; i++)
+		seninf_update(R_DPHY(seninf, DPHY_RX_DESKEW_LANE(i)),
+			      DPHY_DESKEW_DELAY_EN, 0);
+	writel(DPHY_IRQ_SOT_SYNC_ERR, R_DPHY(seninf, DPHY_RX_IRQ_EN));
+}
+
+static void seninf_mux_setup(struct mt6897_seninf *seninf)
+{
+	u32 val;
+
+	seninf_update(R_MUX(seninf, 0, SENINF_MUX_CTRL_0), MUX_EN, MUX_EN);
+	seninf_field(R_MUX(seninf, 0, SENINF_MUX_CTRL_1), MUX_SRC_SEL, MUX_SRC_CSI);
+	seninf_field(R_MUX(seninf, 0, SENINF_MUX_CTRL_1), MUX_PIX_MODE_SEL,
+		     SENINF_PIX_MODE);
+	seninf_update(R_MUX(seninf, 0, SENINF_MUX_OPT),
+		      MUX_VS_SPLIT_EN | MUX_HSYNC_POL | MUX_VSYNC_POL,
+		      MUX_VS_SPLIT_EN);
+	val = readl(R_MUX(seninf, 0, SENINF_MUX_CTRL_0));
+	writel(val | MUX_IRQ_SW_RST | MUX_SW_RST, R_MUX(seninf, 0, SENINF_MUX_CTRL_0));
+	writel(val & ~(MUX_IRQ_SW_RST | MUX_SW_RST),
+	       R_MUX(seninf, 0, SENINF_MUX_CTRL_0));
+	/* mux1 takes seninf1 */
+	seninf_field(R_TOP(seninf, SENINF_TOP_MUX_CTRL_0), SENINF_TOP_MUX1_SRC_SEL, 0);
+	seninf_field(R_MUX(seninf, 0, SENINF_MUX_VC_SEL0), MUX_B0_VC_SEL, 0);
+	seninf_update(R_MUX(seninf, 0, SENINF_MUX_VC_SEL0), MUX_B0_VC_REF_EN,
+		      MUX_B0_VC_REF_EN);
+	/* The frame size monitor, for the status file */
+	seninf_update(R_MUX(seninf, 0, SENINF_MUX_SIZE_MON_CTRL), MUX_SIZE_MON_EN,
+		      MUX_SIZE_MON_EN);
+}
+
+/* cam-mux 0, on the register page that is selected now */
+static void seninf_cam_mux_page(struct mt6897_seninf *seninf,
+				const struct v4l2_mbus_framefmt *fmt, u8 dt)
+{
+	seninf_field(R_CAM_MUX(seninf, 0, CAM_MUX_OPT), CAM_MUX_VC_SEL, 0);
+	seninf_field(R_CAM_MUX(seninf, 0, CAM_MUX_OPT), CAM_MUX_DT_SEL, dt);
+	seninf_update(R_CAM_MUX(seninf, 0, CAM_MUX_OPT),
+		      CAM_MUX_VC_SEL_EN | CAM_MUX_DT_SEL_EN,
+		      CAM_MUX_VC_SEL_EN | CAM_MUX_DT_SEL_EN);
+	seninf_field(R_CAM_MUX(seninf, 0, CAM_MUX_OPT), CAM_MUX_TAG_PAGE_SEL, 0);
+	seninf_field(R_CAM_MUX(seninf, 0, CAM_MUX_TAG_VC_SEL), CAM_MUX_TAG_VC, 0);
+	seninf_update(R_CAM_MUX(seninf, 0, CAM_MUX_TAG_VC_SEL), CAM_MUX_TAG_VC_EN,
+		      CAM_MUX_TAG_VC_EN);
+	seninf_field(R_CAM_MUX(seninf, 0, CAM_MUX_TAG_DT_SEL), CAM_MUX_TAG_DT, dt);
+	seninf_update(R_CAM_MUX(seninf, 0, CAM_MUX_TAG_DT_SEL), CAM_MUX_TAG_DT_EN,
+		      CAM_MUX_TAG_DT_EN);
+	/* virtual mux 0 is mux1 */
+	seninf_field(R_CAM_MUX(seninf, 0, CAM_MUX_CTRL), CAM_MUX_SRC_SEL, 0);
+	seninf_field(R_CAM_MUX(seninf, 0, CAM_MUX_CHK_CTL), CAM_MUX_EXP_HSIZE,
+		     fmt->width);
+	seninf_field(R_CAM_MUX(seninf, 0, CAM_MUX_CHK_CTL), CAM_MUX_EXP_VSIZE,
+		     fmt->height);
+	seninf_field(R_CAM_MUX(seninf, 0, CAM_MUX_CTRL), CAM_MUX_CHK_PIX_MODE,
+		     SENINF_PIX_MODE);
+	seninf_update(R_CAM_MUX(seninf, 0, CAM_MUX_CTRL), CAM_MUX_EN, CAM_MUX_EN);
+	writel(CAM_MUX_IRQ_CLEAR, R_CAM_MUX(seninf, 0, CAM_MUX_IRQ_STATUS));
+	seninf_field(R_CAM_MUX(seninf, 0, CAM_MUX_CTRL), CAM_MUX_NEXT_SRC_SEL, 0);
+}
+
+static void seninf_rx_start(struct mt6897_seninf *seninf,
+			    const struct v4l2_mbus_framefmt *fmt, u8 dt)
+{
+	unsigned int i;
+
+	/* Reset seninf1's CSI-2 unit and the CSI-RX MAC */
+	seninf_update(R_S1(seninf, SENINF_CSI2_CTRL), SENINF_CSI2_SW_RST,
+		      SENINF_CSI2_SW_RST);
+	udelay(1);
+	seninf_update(R_S1(seninf, SENINF_CSI2_CTRL), SENINF_CSI2_SW_RST, 0);
+	seninf_update(R_MACT(seninf, MAC_TOP_CTRL), MAC_TOP_SW_RST, MAC_TOP_SW_RST);
+	udelay(1);
+	seninf_update(R_MACT(seninf, MAC_TOP_CTRL), MAC_TOP_SW_RST, 0);
+
+	/* Virtual channel 0 and the data type of the format */
+	for (i = 0; i < 8; i++)
+		writel(0, R_CSI2(seninf, SENINF_CSI2_S_DI_CTRL(i)));
+	for (i = 0; i < 4; i++)
+		writel(0, R_CSI2(seninf, SENINF_CSI2_CH_CTRL(i)));
+	writel(0, R_MACC(seninf, MAC_CSI2_FORCEDT0));
+	seninf_field(R_MACC(seninf, MAC_CSI2_DT0), MAC_CSI2_RAW10_DT, MIPI_CSI2_DT_RAW10);
+	seninf_field(R_MACC(seninf, MAC_CSI2_DT0), MAC_CSI2_RAW12_DT, MIPI_CSI2_DT_RAW12);
+	seninf_field(R_MACC(seninf, MAC_CSI2_DT0), MAC_CSI2_RAW14_DT, MIPI_CSI2_DT_RAW14);
+	seninf_field(R_MACC(seninf, MAC_CSI2_DT0), MAC_CSI2_RAW16_DT, MIPI_CSI2_DT_RAW16);
+	seninf_field(R_CSI2(seninf, SENINF_CSI2_S_DI_CTRL(0)), CSI2_S_DT_SEL, dt);
+	seninf_field(R_CSI2(seninf, SENINF_CSI2_S_DI_CTRL(0)), CSI2_S_VC_SEL, 0);
+	seninf_field(R_CSI2(seninf, SENINF_CSI2_S_DI_CTRL(0)),
+		     CSI2_S_DT_INTERLEAVE_MODE, 1);
+	seninf_update(R_CSI2(seninf, SENINF_CSI2_S_DI_CTRL(0)),
+		      CSI2_S_VC_INTERLEAVE_EN, CSI2_S_VC_INTERLEAVE_EN);
+	seninf_update(R_CSI2(seninf, SENINF_CSI2_CH_CTRL(0)), CSI2_CH_S0_GRP_EN,
+		      CSI2_CH_S0_GRP_EN);
+
+	seninf_ana_init(seninf, CSI0A);
+	seninf_ana_init(seninf, CSI0B);
+	if (seninf->have_trims) {
+		const u32 a[3] = {
+			(seninf->trims >> 27) & 0x1f,
+			(seninf->trims >> 22) & 0x1f,
+			(seninf->trims >> 17) & 0x1f,
+		};
+		const u32 b[3] = {
+			(seninf->trims >> 12) & 0x1f,
+			(seninf->trims >> 7) & 0x1f,
+			(seninf->trims >> 2) & 0x1f,
+		};
+
+		seninf_ana_hsrt(seninf, CSI0A, a);
+		seninf_ana_hsrt(seninf, CSI0B, b);
+	}
+
+	seninf_dphy_timing(seninf);
+	seninf_mac_setup(seninf);
+
+	seninf_update(R_TOP(seninf, SENINF_TOP_CTRL2), SENINF_TOP_AFIFOA_POP_HALF_EN,
+		      SENINF_TOP_AFIFOA_POP_HALF_EN);
+	seninf_update(R_S1(seninf, SENINF_CSI2_CTRL), SENINF_CSI2_EN, SENINF_CSI2_EN);
+	seninf_update(R_S1(seninf, SENINF_CTRL), SENINF_EN, SENINF_EN);
+
+	seninf_ana_dphy_mode(seninf);
+	seninf_dphy_lanes(seninf);
+
+	seninf_mux_setup(seninf);
+	/* The cam-mux registers come in two pages; set both */
+	seninf_update(R_GCSR(seninf, CAM_MUX_GCSR_DYN_CTRL), CAM_MUX_GCSR_PAGE_OUTER,
+		      CAM_MUX_GCSR_PAGE_OUTER);
+	seninf_cam_mux_page(seninf, fmt, dt);
+	seninf_update(R_GCSR(seninf, CAM_MUX_GCSR_DYN_CTRL), CAM_MUX_GCSR_PAGE_OUTER, 0);
+	seninf_cam_mux_page(seninf, fmt, dt);
+}
+
+static void seninf_rx_stop(struct mt6897_seninf *seninf)
+{
+	seninf_update(R_MUX(seninf, 0, SENINF_MUX_CTRL_0), MUX_EN, 0);
+	seninf_field(R_CAM_MUX(seninf, 0, CAM_MUX_CTRL), CAM_MUX_NEXT_SRC_SEL,
+		     CAM_MUX_SRC_IDLE);
+	seninf_field(R_CAM_MUX(seninf, 0, CAM_MUX_CTRL), CAM_MUX_SRC_SEL,
+		     CAM_MUX_SRC_IDLE);
+	seninf_update(R_CAM_MUX(seninf, 0, CAM_MUX_CTRL), CAM_MUX_EN, 0);
+	writel(CAM_MUX_IRQ_CLEAR, R_CAM_MUX(seninf, 0, CAM_MUX_IRQ_STATUS));
+
+	writel(0, R_CSI2(seninf, SENINF_CSI2_PRBS));
+	seninf_ana_power(seninf, CSI0A, false);
+	seninf_ana_power(seninf, CSI0B, false);
+	seninf_update(R_ANA(seninf, CSI0A, CDPHY_RX_ANA_SETTING_0), ANA_REF_CK_SEL, 0);
+
+	seninf_update(R_S1(seninf, SENINF_CTRL), SENINF_EN, 0);
+	seninf_update(R_S1(seninf, SENINF_CSI2_CTRL), SENINF_CSI2_EN, 0);
+	seninf_update(R_TOP(seninf, SENINF_TOP_CTRL2), SENINF_TOP_AFIFOA_POP_HALF_EN, 0);
+	seninf_update(R_DPHY(seninf, DPHY_RX_LANE_EN), DPHY_LC0_EN | DPHY_LD_EN, 0);
+}
+
+/* ---- the subdev --------------------------------------------------------- */
+
+static const struct v4l2_mbus_framefmt seninf_default_fmt = {
+	.code = MEDIA_BUS_FMT_SBGGR10_1X10,
+	.width = 1632,
+	.height = 1224,
+	.field = V4L2_FIELD_NONE,
+	.colorspace = V4L2_COLORSPACE_RAW,
+	.xfer_func = V4L2_XFER_FUNC_NONE,
+	.ycbcr_enc = V4L2_YCBCR_ENC_601,
+	.quantization = V4L2_QUANTIZATION_FULL_RANGE,
+};
+
+static int seninf_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	*v4l2_subdev_state_get_format(state, SENINF_PAD_SINK) = seninf_default_fmt;
+	*v4l2_subdev_state_get_format(state, SENINF_PAD_SOURCE) = seninf_default_fmt;
+	return 0;
+}
+
+static int seninf_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->pad == SENINF_PAD_SOURCE) {
+		if (code->index)
+			return -EINVAL;
+		code->code = v4l2_subdev_state_get_format(state,
+							  SENINF_PAD_SINK)->code;
+		return 0;
+	}
+
+	if (code->index >= ARRAY_SIZE(seninf_formats))
+		return -EINVAL;
+	code->code = seninf_formats[code->index].code;
+	return 0;
+}
+
+static int seninf_set_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *format)
+{
+	struct v4l2_mbus_framefmt *fmt = &format->format;
+
+	/* The source pad passes on what comes in */
+	if (format->pad == SENINF_PAD_SOURCE)
+		return v4l2_subdev_get_fmt(sd, state, format);
+
+	if (format->which == V4L2_SUBDEV_FORMAT_ACTIVE &&
+	    v4l2_subdev_is_streaming(sd))
+		return -EBUSY;
+
+	if (!seninf_find_format(fmt->code))
+		fmt->code = seninf_default_fmt.code;
+	fmt->width = clamp(fmt->width, 1U, 0xffffU);
+	fmt->height = clamp(fmt->height, 1U, 0xffffU);
+	fmt->field = V4L2_FIELD_NONE;
+
+	*v4l2_subdev_state_get_format(state, SENINF_PAD_SINK) = *fmt;
+	*v4l2_subdev_state_get_format(state, SENINF_PAD_SOURCE) = *fmt;
+	return 0;
+}
+
+static int seninf_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct mt6897_seninf *seninf = sd_to_seninf(sd);
+	const struct v4l2_mbus_framefmt *fmt;
+	const struct seninf_format *sfmt;
+	struct v4l2_subdev *source;
+	struct media_pad *remote;
+	s64 link_freq;
+	int ret;
+
+	remote = media_pad_remote_pad_first(&seninf->pads[SENINF_PAD_SINK]);
+	if (!remote)
+		return -ENOLINK;
+	source = media_entity_to_v4l2_subdev(remote->entity);
+
+	fmt = v4l2_subdev_state_get_format(state, SENINF_PAD_SINK);
+	sfmt = seninf_find_format(fmt->code);
+	if (!sfmt)
+		return -EINVAL;
+
+	link_freq = v4l2_get_link_freq(remote, sfmt->bpp, 2 * seninf->num_lanes);
+	if (link_freq < 0) {
+		dev_err(seninf->dev, "no link frequency from %s: %lld\n",
+			source->name, link_freq);
+		return link_freq;
+	}
+	if (2 * link_freq >= SENINF_MAX_LANE_RATE) {
+		dev_err(seninf->dev, "%lld bit/s per lane is not supported yet\n",
+			2 * link_freq);
+		return -EINVAL;
+	}
+	dev_dbg(seninf->dev, "%ux%u data type 0x%02x, %lld bit/s per lane\n",
+		fmt->width, fmt->height, sfmt->dt, 2 * link_freq);
+
+	ret = pm_runtime_resume_and_get(seninf->dev);
+	if (ret)
+		return ret;
+
+	seninf_rx_start(seninf, fmt, sfmt->dt);
+
+	ret = v4l2_subdev_enable_streams(source, remote->index, BIT_ULL(0));
+	if (ret) {
+		dev_err(seninf->dev, "starting %s failed: %d\n", source->name, ret);
+		seninf_rx_stop(seninf);
+		pm_runtime_put_sync(seninf->dev);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int seninf_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct mt6897_seninf *seninf = sd_to_seninf(sd);
+	struct media_pad *remote;
+	int ret;
+
+	remote = media_pad_remote_pad_first(&seninf->pads[SENINF_PAD_SINK]);
+	if (remote) {
+		ret = v4l2_subdev_disable_streams(media_entity_to_v4l2_subdev(remote->entity),
+						  remote->index, BIT_ULL(0));
+		if (ret)
+			dev_err(seninf->dev, "stopping the source failed: %d\n", ret);
+	}
+
+	seninf_rx_stop(seninf);
+	pm_runtime_put_sync(seninf->dev);
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops seninf_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops seninf_pad_ops = {
+	.enum_mbus_code = seninf_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = seninf_set_fmt,
+	.link_validate = v4l2_subdev_link_validate_default,
+	.enable_streams = seninf_enable_streams,
+	.disable_streams = seninf_disable_streams,
+};
+
+static const struct v4l2_subdev_ops seninf_subdev_ops = {
+	.video = &seninf_video_ops,
+	.pad = &seninf_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops seninf_internal_ops = {
+	.init_state = seninf_init_state,
+};
+
+static const struct media_entity_operations seninf_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+	.get_fwnode_pad = v4l2_subdev_get_fwnode_pad_1_to_1,
+};
