+/* ---- debugfs ------------------------------------------------------------ */
+
+static int seninf_status_show(struct seq_file *m, void *data)
+{
+	struct mt6897_seninf *seninf = m->private;
+	u32 frame;
+
+	/* Reading a block that is powered off would hang the bus */
+	if (pm_runtime_get_if_in_use(seninf->dev) <= 0) {
+		seq_puts(m, "powered off\n");
+		return 0;
+	}
+
+	frame = readl(R_MACC(seninf, MAC_CSI2_LINE_FRAME_NUM));
+	seq_printf(m, "mac: packets %u, frame %u, line %u, irq 0x%08x, last packet 0x%08x\n",
+		   readl(R_MACC(seninf, MAC_CSI2_PACKET_CNT_STATUS)) & 0xffff,
+		   frame >> 16, frame & 0xffff,
+		   readl(R_MACC(seninf, MAC_CSI2_IRQ_STATUS)),
+		   readl(R_MACC(seninf, MAC_CSI2_PACKET_STATUS)));
+	seq_printf(m, "dphy: sot sync irq 0x%lx, sot errors 0x%08x, lp A 0x%03x B 0x%03x\n",
+		   FIELD_GET(DPHY_IRQ_SOT_SYNC_ERR,
+			     readl(R_DPHY(seninf, DPHY_RX_IRQ_STATUS))),
+		   readl(R_DPHY(seninf, DPHY_RX_STATUS_2)),
+		   readl(R_ANA(seninf, CSI0A, CDPHY_RX_ANA_AD_0)) & 0x333,
+		   readl(R_ANA(seninf, CSI0B, CDPHY_RX_ANA_AD_0)) & 0x333);
+	seq_printf(m, "seninf1: irq 0x%08x\n",
+		   readl(R_CSI2(seninf, SENINF_CSI2_IRQ_STATUS)));
+	seq_printf(m, "mux1: size 0x%08x, irq 0x%08x, monitor 0x%08x 0x%08x 0x%08x 0x%08x\n",
+		   readl(R_MUX(seninf, 0, SENINF_MUX_SIZE)),
+		   readl(R_MUX(seninf, 0, SENINF_MUX_IRQ_STATUS)),
+		   readl(R_MUX(seninf, 0, SENINF_MUX_SIZE_MON(0))),
+		   readl(R_MUX(seninf, 0, SENINF_MUX_SIZE_MON(1))),
+		   readl(R_MUX(seninf, 0, SENINF_MUX_SIZE_MON(2))),
+		   readl(R_MUX(seninf, 0, SENINF_MUX_SIZE_MON(3))));
+	seq_printf(m, "cam-mux 0: received 0x%08x, irq 0x%08x, enabled 0x%08x, vsync 0x%08x\n",
+		   readl(R_CAM_MUX(seninf, 0, CAM_MUX_CHK_RES)),
+		   readl(R_CAM_MUX(seninf, 0, CAM_MUX_IRQ_STATUS)),
+		   readl(R_GCSR(seninf, CAM_MUX_GCSR_MUX_EN)),
+		   readl(R_GCSR(seninf, CAM_MUX_GCSR_VSYNC_IRQ_STS)));
+	seq_printf(m, "offset calibration done: A 0x%02lx B 0x%02lx\n",
+		   FIELD_GET(ANA_OS_CAL_CPLT, readl(R_ANA(seninf, CSI0A, CDPHY_RX_ANA_9))),
+		   FIELD_GET(ANA_OS_CAL_CPLT, readl(R_ANA(seninf, CSI0B, CDPHY_RX_ANA_9))));
+
+	/* Clear the latched bits so that the next read shows new events */
+	writel(0xffffffff, R_MACC(seninf, MAC_CSI2_IRQ_STATUS));
+	writel(0xffffffff, R_DPHY(seninf, DPHY_RX_IRQ_CLR));
+	writel(0xffffffff, R_CSI2(seninf, SENINF_CSI2_IRQ_STATUS));
+	writel(CAM_MUX_IRQ_CLEAR, R_MUX(seninf, 0, SENINF_MUX_IRQ_STATUS));
+	writel(CAM_MUX_IRQ_CLEAR, R_CAM_MUX(seninf, 0, CAM_MUX_IRQ_STATUS));
+
+	pm_runtime_put(seninf->dev);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(seninf_status);
+
+static int seninf_stream_start(struct mt6897_seninf *seninf)
+{
+	struct v4l2_subdev_format format = {
+		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
+	};
+	struct v4l2_subdev *source;
+	struct media_pad *remote;
+	int ret;
+
+	remote = media_pad_remote_pad_first(&seninf->pads[SENINF_PAD_SINK]);
+	if (!remote)
+		return -ENOLINK;
+	source = media_entity_to_v4l2_subdev(remote->entity);
+
+	/* Take over the sensor's format, as link validation would demand */
+	format.pad = remote->index;
+	ret = v4l2_subdev_call_state_active(source, pad, get_fmt, &format);
+	if (ret)
+		return ret;
+	format.pad = SENINF_PAD_SINK;
+	ret = v4l2_subdev_call_state_active(&seninf->sd, pad, set_fmt, &format);
+	if (ret)
+		return ret;
+
+	return v4l2_subdev_enable_streams(&seninf->sd, SENINF_PAD_SOURCE, BIT_ULL(0));
+}
+
+static ssize_t seninf_stream_write(struct file *file, const char __user *buf,
+				   size_t count, loff_t *ppos)
+{
+	struct mt6897_seninf *seninf = file->private_data;
+	bool on;
+	int ret;
+
+	ret = kstrtobool_from_user(buf, count, &on);
+	if (ret)
+		return ret;
+
+	mutex_lock(&seninf->debugfs_lock);
+	if (on)
+		ret = seninf_stream_start(seninf);
+	else
+		ret = v4l2_subdev_disable_streams(&seninf->sd, SENINF_PAD_SOURCE,
+						  BIT_ULL(0));
+	mutex_unlock(&seninf->debugfs_lock);
+
+	return ret ? ret : count;
+}
+
+static const struct file_operations seninf_stream_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = seninf_stream_write,
+	.llseek = noop_llseek,
+};
+
+/* ---- power and probe ----------------------------------------------------- */
+
+/*
+ * The coprocessor first, then the power domains, then the clocks, some of
+ * which are gates inside CAM_MAIN, and the reverse on the way down. All of it
+ * lives here because the driver core resumes this device on its own as well,
+ * whenever a child such as the media or a subdevice node is added. It is all
+ * synchronous, so that the domains are off before the coprocessor may stop.
+ */
+static int seninf_runtime_suspend(struct device *dev)
+{
+	struct mt6897_seninf *seninf = dev_get_drvdata(dev);
+	unsigned int i = seninf->pds->num_pds;
+
+	clk_bulk_disable_unprepare(ARRAY_SIZE(seninf->clks), seninf->clks);
+	while (i--)
+		pm_runtime_put_sync(seninf->pds->pd_devs[i]);
+	mt6897_vcp_stop(seninf->vcp);
+	return 0;
+}
+
+static int seninf_runtime_resume(struct device *dev)
+{
+	struct mt6897_seninf *seninf = dev_get_drvdata(dev);
+	unsigned int i;
+	int ret;
+
+	ret = mt6897_vcp_start(seninf->vcp);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < seninf->pds->num_pds; i++) {
+		ret = pm_runtime_resume_and_get(seninf->pds->pd_devs[i]);
+		if (ret)
+			goto err_pds;
+	}
+
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(seninf->clks), seninf->clks);
+	if (ret)
+		goto err_pds;
+
+	seninf_hw_idle(seninf);
+	return 0;
+
+err_pds:
+	while (i--)
+		pm_runtime_put_sync(seninf->pds->pd_devs[i]);
+	mt6897_vcp_stop(seninf->vcp);
+	return ret;
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(seninf_pm_ops, seninf_runtime_suspend,
+				 seninf_runtime_resume, NULL);
+
+static int seninf_probe(struct platform_device *pdev)
+{
+	static const struct dev_pm_domain_attach_data pd_data = {
+		.pd_names = seninf_pd_names,
+		.num_pd_names = ARRAY_SIZE(seninf_pd_names),
+		.pd_flags = PD_FLAG_NO_DEV_LINK,
+	};
+	struct device *dev = &pdev->dev;
+	struct mt6897_seninf *seninf;
+	unsigned int i;
+	int ret;
+
+	seninf = devm_kzalloc(dev, sizeof(*seninf), GFP_KERNEL);
+	if (!seninf)
+		return -ENOMEM;
+	seninf->dev = dev;
+	platform_set_drvdata(pdev, seninf);
+
+	seninf->base = devm_platform_ioremap_resource_byname(pdev, "base");
+	if (IS_ERR(seninf->base))
+		return PTR_ERR(seninf->base);
+	seninf->ana = devm_platform_ioremap_resource_byname(pdev, "ana-rx");
+	if (IS_ERR(seninf->ana))
+		return PTR_ERR(seninf->ana);
+
+	for (i = 0; i < ARRAY_SIZE(seninf_clk_names); i++)
+		seninf->clks[i].id = seninf_clk_names[i];
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(seninf->clks), seninf->clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "getting the clocks failed\n");
+	seninf->csi_rate = clk_get_rate(seninf->clks[SENINF_CLK_CSI].clk);
+	if (!seninf->csi_rate)
+		return dev_err_probe(dev, -EINVAL, "the CSI clock has no rate\n");
+
+	seninf->vcp = mt6897_vcp_get(dev);
+	if (IS_ERR(seninf->vcp))
+		return dev_err_probe(dev, PTR_ERR(seninf->vcp),
+				     "getting the video coprocessor failed\n");
+
+	ret = devm_pm_domain_attach_list(dev, &pd_data, &seninf->pds);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "attaching the power domains failed\n");
+	if (ret != ARRAY_SIZE(seninf_pd_names))
+		return dev_err_probe(dev, -ENODEV, "found %d of %zu power domains\n",
+				     ret, ARRAY_SIZE(seninf_pd_names));
+	/* System sleep leaves the domains to the runtime PM callbacks */
+	for (i = 0; i < seninf->pds->num_pds; i++)
+		dev_pm_syscore_device(seninf->pds->pd_devs[i], true);
+
+	ret = seninf_read_trims(seninf);
+	if (ret)
+		return dev_err_probe(dev, ret, "reading the CSI trims failed\n");
+
+	ret = devm_mutex_init(dev, &seninf->debugfs_lock);
+	if (ret)
+		return ret;
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+
+	seninf->mdev.dev = dev;
+	strscpy(seninf->mdev.model, "MediaTek MT6897 seninf",
+		sizeof(seninf->mdev.model));
+	media_device_init(&seninf->mdev);
+	seninf->v4l2_dev.mdev = &seninf->mdev;
+	ret = v4l2_device_register(dev, &seninf->v4l2_dev);
+	if (ret)
+		goto err_mdev;
+
+	v4l2_subdev_init(&seninf->sd, &seninf_subdev_ops);
+	seninf->sd.internal_ops = &seninf_internal_ops;
+	seninf->sd.owner = THIS_MODULE;
+	seninf->sd.dev = dev;
+	seninf->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	strscpy(seninf->sd.name, dev_name(dev), sizeof(seninf->sd.name));
+	seninf->sd.entity.function = MEDIA_ENT_F_VID_IF_BRIDGE;
+	seninf->sd.entity.ops = &seninf_entity_ops;
+	seninf->pads[SENINF_PAD_SINK].flags = MEDIA_PAD_FL_SINK |
+					      MEDIA_PAD_FL_MUST_CONNECT;
+	seninf->pads[SENINF_PAD_SOURCE].flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&seninf->sd.entity, SENINF_NUM_PADS,
+				     seninf->pads);
+	if (ret)
+		goto err_v4l2;
+	ret = v4l2_subdev_init_finalize(&seninf->sd);
+	if (ret)
+		goto err_entity;
+	ret = v4l2_device_register_subdev(&seninf->v4l2_dev, &seninf->sd);
+	if (ret)
+		goto err_subdev;
+
+	ret = media_device_register(&seninf->mdev);
+	if (ret)
+		goto err_unreg_subdev;
+
+	v4l2_async_nf_init(&seninf->notifier, &seninf->v4l2_dev);
+	seninf->notifier.ops = &seninf_notify_ops;
+	ret = seninf_parse_endpoint(seninf);
+	if (ret)
+		goto err_nf;
+	ret = v4l2_async_nf_register(&seninf->notifier);
+	if (ret)
+		goto err_nf;
+
+	seninf->debugfs = debugfs_create_dir(dev_name(dev), NULL);
+	debugfs_create_file("status", 0400, seninf->debugfs, seninf,
+			    &seninf_status_fops);
+	debugfs_create_file("stream", 0200, seninf->debugfs, seninf,
+			    &seninf_stream_fops);
+
+	dev_info(dev, "CSI port 0, %u lanes, CSI clock %lu Hz\n",
+		 seninf->num_lanes, seninf->csi_rate);
+	return 0;
+
+err_nf:
+	v4l2_async_nf_cleanup(&seninf->notifier);
+	media_device_unregister(&seninf->mdev);
+err_unreg_subdev:
+	v4l2_device_unregister_subdev(&seninf->sd);
+err_subdev:
+	v4l2_subdev_cleanup(&seninf->sd);
+err_entity:
+	media_entity_cleanup(&seninf->sd.entity);
+err_v4l2:
+	v4l2_device_unregister(&seninf->v4l2_dev);
+err_mdev:
+	media_device_cleanup(&seninf->mdev);
+	return ret;
+}
+
+static void seninf_remove(struct platform_device *pdev)
+{
+	struct mt6897_seninf *seninf = platform_get_drvdata(pdev);
+
+	debugfs_remove_recursive(seninf->debugfs);
+	v4l2_async_nf_unregister(&seninf->notifier);
+	v4l2_async_nf_cleanup(&seninf->notifier);
+	media_device_unregister(&seninf->mdev);
+	v4l2_device_unregister_subdev(&seninf->sd);
+	v4l2_subdev_cleanup(&seninf->sd);
+	media_entity_cleanup(&seninf->sd.entity);
+	v4l2_device_unregister(&seninf->v4l2_dev);
+	media_device_cleanup(&seninf->mdev);
+}
+
+static const struct of_device_id seninf_of_match[] = {
+	{ .compatible = "mediatek,mt6897-seninf" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, seninf_of_match);
+
+static struct platform_driver seninf_driver = {
+	.probe = seninf_probe,
+	.remove = seninf_remove,
+	.driver = {
+		.name = "mt6897-seninf",
+		.of_match_table = seninf_of_match,
+		.pm = pm_ptr(&seninf_pm_ops),
+	},
+};
+module_platform_driver(seninf_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6897 sensor interface");
+MODULE_LICENSE("GPL");
