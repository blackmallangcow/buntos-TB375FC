+/* ---- the sensor --------------------------------------------------------- */
+
+static int seninf_notify_bound(struct v4l2_async_notifier *notifier,
+			       struct v4l2_subdev *source,
+			       struct v4l2_async_connection *asc)
+{
+	struct mt6897_seninf *seninf =
+		container_of(notifier, struct mt6897_seninf, notifier);
+
+	dev_dbg(seninf->dev, "bound %s\n", source->name);
+	return v4l2_create_fwnode_links_to_pad(source,
+					       &seninf->pads[SENINF_PAD_SINK],
+					       MEDIA_LNK_FL_ENABLED |
+					       MEDIA_LNK_FL_IMMUTABLE);
+}
+
+static int seninf_notify_complete(struct v4l2_async_notifier *notifier)
+{
+	struct mt6897_seninf *seninf =
+		container_of(notifier, struct mt6897_seninf, notifier);
+
+	return v4l2_device_register_subdev_nodes(&seninf->v4l2_dev);
+}
+
+static const struct v4l2_async_notifier_operations seninf_notify_ops = {
+	.bound = seninf_notify_bound,
+	.complete = seninf_notify_complete,
+};
+
+static int seninf_parse_endpoint(struct mt6897_seninf *seninf)
+{
+	struct v4l2_fwnode_endpoint vep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct v4l2_async_connection *asc;
+	struct fwnode_handle *ep;
+	int ret;
+
+	ep = fwnode_graph_get_endpoint_by_id(dev_fwnode(seninf->dev), 0, 0,
+					     FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!ep)
+		return dev_err_probe(seninf->dev, -ENODEV,
+				     "no endpoint on port 0\n");
+
+	ret = v4l2_fwnode_endpoint_parse(ep, &vep);
+	if (ret) {
+		dev_err_probe(seninf->dev, ret, "parsing the endpoint failed\n");
+		goto out;
+	}
+	if (vep.bus.mipi_csi2.num_data_lanes != 4) {
+		ret = dev_err_probe(seninf->dev, -EINVAL,
+				    "only four data lanes are supported\n");
+		goto out;
+	}
+	seninf->num_lanes = vep.bus.mipi_csi2.num_data_lanes;
+
+	asc = v4l2_async_nf_add_fwnode_remote(&seninf->notifier, ep,
+					      struct v4l2_async_connection);
+	if (IS_ERR(asc))
+		ret = dev_err_probe(seninf->dev, PTR_ERR(asc),
+				    "adding the sensor failed\n");
+out:
+	fwnode_handle_put(ep);
+	return ret;
+}
+
+/*
+ * The fuses hold termination trims for the six pins of each half of CSI port
+ * 0, with a checksum in the low five bits. Use them only when the checksum
+ * holds, as the vendor driver checks them. The value itself stays private.
+ */
+static int seninf_read_trims(struct mt6897_seninf *seninf)
+{
+	u32 val, sum, check;
+	int ret;
+
+	ret = nvmem_cell_read_u32(seninf->dev, "csi0", &val);
+	if (ret == -EPROBE_DEFER)
+		return ret;
+	if (ret) {
+		dev_info(seninf->dev, "no CSI trim fuses, using the defaults\n");
+		return 0;
+	}
+
+	sum = ((val >> 27) & 0x1f) + ((val >> 22) & 0x1f) + ((val >> 17) & 0x1f) +
+	      ((val >> 12) & 0x1f) + ((val >> 7) & 0x1f);
+	if (!sum) {
+		dev_info(seninf->dev, "the CSI trim fuses are blank, using the defaults\n");
+		return 0;
+	}
+	check = (((sum >> 4) & 0xf) + (sum & 0xf)) & 0x1f;
+	if (check != (val & 0x1f)) {
+		dev_warn(seninf->dev,
+			 "the CSI trim fuses fail their checksum, using the defaults\n");
+		return 0;
+	}
+
+	seninf->trims = val;
+	seninf->have_trims = true;
+	dev_info(seninf->dev, "using the CSI trims from the fuses\n");
+	return 0;
+}
