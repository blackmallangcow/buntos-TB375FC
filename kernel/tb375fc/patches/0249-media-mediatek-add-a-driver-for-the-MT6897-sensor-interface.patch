+# SPDX-License-Identifier: GPL-2.0-only
+config VIDEO_MEDIATEK_MT6897_SENINF
+	tristate "MediaTek MT6897 sensor interface (seninf)"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on VIDEO_DEV
+	depends on MTK_MT6897_VCP
+	depends on PM
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select V4L2_FWNODE
+	help
+	  Say y or m here for the MIPI CSI-2 receiver of the MT6897, the
+	  sensor interface (seninf) with its CSI RX analog front ends. It
+	  supports CSI port 0 as a four-lane D-PHY port for now.
+
+	  To compile this driver as a module, choose M here: the module will
+	  be called mt6897-seninf.
