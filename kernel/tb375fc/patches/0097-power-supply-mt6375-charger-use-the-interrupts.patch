From: buntOS contributors
Subject: [PATCH] power: supply: mt6375-charger: use the interrupts

React to VBUS at once instead of at the next poll, which matters when a
weaker source follows a stronger one. Also log the overvoltage of VBUS,
and stop charging at the end of the safety timer until the source goes.
The core driver only gives these when it has an interrupt itself.

They come after the rest of the probe and before the work starts, so a
failure here leaves the chip alone.

---
 drivers/power/supply/mt6375-charger.c | 83 ++++++++++++++++++++++++++-
 1 file changed, 80 insertions(+), 3 deletions(-)

diff --git a/drivers/power/supply/mt6375-charger.c b/drivers/power/supply/mt6375-charger.c
index 2fed29f..aac3025 100644
--- a/drivers/power/supply/mt6375-charger.c
+++ b/drivers/power/supply/mt6375-charger.c
@@ -3,9 +3,10 @@
  * MediaTek MT6375 charger: battery charging and the boost that sources USB VBUS
  *
  * The USB switch, BC1.2 and the charge pumps stay as the bootloader left them,
- * and neither probing nor reading the state writes to the chip. The first
- * write comes when the regulator is enabled, when charging is taken over or
- * when it has to stop.
+ * and neither probing nor reading the state writes to the chip, apart from
+ * unmasking the interrupts when the core driver has them. The first write to
+ * the charger comes when the regulator is enabled, when charging is taken over
+ * or when it has to stop.
  *
  * Charging is only taken over with a description of the battery and a fuel
  * gauge in the device tree, and once the gauge has given a good temperature and
@@ -24,6 +25,7 @@
 
 #include <linux/bitfield.h>
 #include <linux/bits.h>
+#include <linux/interrupt.h>
 #include <linux/kernel.h>
 #include <linux/linear_range.h>
 #include <linux/mod_devicetable.h>
@@ -1328,6 +1330,77 @@ static void mt6375_chg_log_state(struct mt6375_chg *chg)
 		 cv, ichg, aicr, en, buck, hz, wdt, bat_comp);
 }
 
+static irqreturn_t mt6375_chg_vbus_irq(int irq, void *data)
+{
+	struct mt6375_chg *chg = data;
+
+	/* Does nothing when the work never started */
+	mod_delayed_work(system_freezable_wq, &chg->work, 0);
+	power_supply_changed(chg->psy);
+
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t mt6375_chg_vbus_ov_irq(int irq, void *data)
+{
+	struct mt6375_chg *chg = data;
+
+	dev_err(chg->dev, "VBUS over voltage\n");
+	power_supply_changed(chg->psy);
+
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t mt6375_chg_tout_irq(int irq, void *data)
+{
+	struct mt6375_chg *chg = data;
+
+	dev_err(chg->dev, "Charging safety timer expired\n");
+	if (chg->can_control) {
+		mutex_lock(&chg->lock);
+		chg->fault = true;
+		mutex_unlock(&chg->lock);
+	}
+	mod_delayed_work(system_freezable_wq, &chg->work, 0);
+	power_supply_changed(chg->psy);
+
+	return IRQ_HANDLED;
+}
+
+/* The core driver gives these only when it has an interrupt itself */
+static int mt6375_chg_init_irqs(struct platform_device *pdev)
+{
+	static const struct {
+		const char *name;
+		irq_handler_t handler;
+	} irqs[] = {
+		{ "pwr_rdy", mt6375_chg_vbus_irq },
+		{ "detach", mt6375_chg_vbus_irq },
+		{ "vbus_ov", mt6375_chg_vbus_ov_irq },
+		{ "chg_tout", mt6375_chg_tout_irq },
+	};
+	struct mt6375_chg *chg = platform_get_drvdata(pdev);
+	int i, irq, ret;
+
+	for (i = 0; i < ARRAY_SIZE(irqs); i++) {
+		irq = platform_get_irq_byname_optional(pdev, irqs[i].name);
+		if (irq == -ENXIO)
+			continue;
+		if (irq < 0)
+			return irq;
+
+		ret = devm_request_threaded_irq(chg->dev, irq, NULL,
+						irqs[i].handler, IRQF_ONESHOT,
+						irqs[i].name, chg);
+		if (ret)
+			return dev_err_probe(chg->dev, ret,
+					     "Failed to request %s\n",
+					     irqs[i].name);
+	}
+
+	return 0;
+}
+
 static void mt6375_chg_stop_control(struct mt6375_chg *chg)
 {
 	disable_delayed_work_sync(&chg->work);
@@ -1435,6 +1508,10 @@ static int mt6375_chg_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
+	ret = mt6375_chg_init_irqs(pdev);
+	if (ret)
+		return ret;
+
 	if (chg->can_control)
 		mt6375_chg_start_work(chg);
 
