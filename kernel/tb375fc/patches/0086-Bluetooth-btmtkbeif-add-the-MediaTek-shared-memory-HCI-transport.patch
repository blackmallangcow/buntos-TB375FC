From: buntOS contributors
Subject: [PATCH] Bluetooth: btmtkbeif: add the MediaTek shared memory HCI transport

The Bluetooth radio of the MT6897 is not behind a UART as on the MT7622.
The host writes H:4 into a ring in memory and rings a doorbell, and the
firmware writes into another ring and raises a software interrupt. The
vendor calls this BEIF. HCI and the WMT commands above it are those of
btmtk, of which this uses the structures and btmtk_set_bdaddr(); like the
other btmtk drivers it has a WMT function of its own.

The ring is set up by the host at every power on. All the firmware ever
gives it is its two positions, and those are checked before they are used:
a wrong one, a frame that does not parse, a ring that stays full or an
interrupt that makes no sense stops the transport and reports a hardware
error, on which the stack closes and opens the device again. The firmware
does not tell when it has made room, so a full ring is polled.

The MCU starts from its ROM at every open and has no storage of its own, so
the address comes from the device tree or from the system, as for other
radios like that, and the stack sets it again every time.

The bootloader loads the firmware, so power on is the sequence of the stock
driver without a download, which has been compared with it in a model by
the registers it writes. Bringing the common part up and keeping it up for
the other radios is for the connsys driver.

This does not do everything the stock driver does:

 - The MCU stays awake (driver own) while the device is open, and only goes
   to the firmware for a system sleep. It costs idle power, and it leaves
   the sleep handshake for after the first real use.
 - The calibration result is not saved over a close. The firmware
   calibrates again at every function on, where the stock driver powers
   Wi-Fi along the first time and restores the result after that. Its
   comment says this mostly fails with Wi-Fi off, so the result is logged.
 - The firmware log, the core dump and the power and temperature limits are
   not there. The antenna command is what the stock driver sends when its
   configuration file has nothing for the chip, and no RF front end
   configuration is sent, as for a device without one.
 - It does not tell the modem about Bluetooth. This device has none.
 - It does not wake the system.
 - None of the cases where the stock driver resets all of connsys are done,
   as that takes the other radios along: a request of the firmware, a bus
   hang, a bus that is not quiet at power off and conninfra not answering.
   They are reported and the MCU alone is restarted, three times at most
   for one that fails right after it has started.

The UTC command has the right length here, where the stock driver sends one
byte more than it says.

Each step of a power on is logged, as a wrong step can hang the bus without
a word and the last line says where. It stays that way until the driver has
seen real use.
---
 drivers/bluetooth/Kconfig     |   14 
 drivers/bluetooth/Makefile    |    1 
 drivers/bluetooth/btmtkbeif.c | 1547 +++++++++++++++++++++++++++++++++++++++++
 3 files changed, 1562 insertions(+)

diff --git a/drivers/bluetooth/Kconfig b/drivers/bluetooth/Kconfig
index 4e8c24d..062643d 100644
--- a/drivers/bluetooth/Kconfig
+++ b/drivers/bluetooth/Kconfig
@@ -413,6 +413,20 @@ config BT_MTKUART
 	  Say Y here to compile support for MediaTek Bluetooth UART devices
 	  into the kernel or say M to compile it as module (btmtkuart).
 
+config BT_MTKBEIF
+	tristate "MediaTek HCI shared memory driver"
+	depends on BT_HCIUART
+	depends on MTK_CONNSYS
+	depends on USB || !BT_HCIBTUSB_MTK
+	select BT_HCIUART_H4
+	select BT_MTK
+	help
+	  MediaTek Bluetooth HCI driver for the radio inside a SoC whose host
+	  interface is a pair of rings in shared memory, such as the MT6897.
+
+	  Say Y here to compile support for it into the kernel or say M to
+	  compile it as module (btmtkbeif).
+
 config BT_QCOMSMD
 	tristate "Qualcomm SMD based HCI support"
 	depends on RPMSG || (COMPILE_TEST && RPMSG=n)
diff --git a/drivers/bluetooth/Makefile b/drivers/bluetooth/Makefile
index bafc262..f7c3e12 100644
--- a/drivers/bluetooth/Makefile
+++ b/drivers/bluetooth/Makefile
@@ -20,6 +20,7 @@ obj-$(CONFIG_BT_MRVL)		+= btmrvl.o
 obj-$(CONFIG_BT_MRVL_SDIO)	+= btmrvl_sdio.o
 obj-$(CONFIG_BT_MTKSDIO)	+= btmtksdio.o
 obj-$(CONFIG_BT_MTKUART)	+= btmtkuart.o
+obj-$(CONFIG_BT_MTKBEIF)	+= btmtkbeif.o
 obj-$(CONFIG_BT_QCOMSMD)	+= btqcomsmd.o
 obj-$(CONFIG_BT_BCM)		+= btbcm.o
 obj-$(CONFIG_BT_RTL)		+= btrtl.o
diff --git a/drivers/bluetooth/btmtkbeif.c b/drivers/bluetooth/btmtkbeif.c
new file mode 100644
index 0000000..ed4d9cb
--- /dev/null
+++ b/drivers/bluetooth/btmtkbeif.c
@@ -0,0 +1,1547 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Bluetooth support for the MediaTek SoCs with a shared memory HCI transport
+ *
+ * The Bluetooth radio of the MT6897 has an MCU of its own (BGF) in the
+ * connectivity subsystem. The host talks H:4 to it over two byte rings in
+ * memory, which the vendor calls BEIF, with a doorbell one way and a software
+ * interrupt the other. The bootloader loads the firmware, so nothing is
+ * downloaded, and the connsys driver powers the part the radios have in common.
+ *
+ * The firmware only ever gives us its two ring positions. Those are checked
+ * before they are used, and everything else about the rings stays on this side.
+ *
+ * A wrong step on the way up can hang the bus without a word, so power on says
+ * what it is about to do, and the last line says where it stopped. It stays that
+ * way until the driver has seen real use.
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/ktime.h>
+#include <linux/limits.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm.h>
+#include <linux/sizes.h>
+#include <linux/skbuff.h>
+#include <linux/soc/mediatek/mtk-connsys.h>
+#include <linux/spinlock.h>
+#include <linux/stddef.h>
+#include <linux/usb.h>
+#include <linux/wait_bit.h>
+
+#include <net/bluetooth/bluetooth.h>
+#include <net/bluetooth/hci_core.h>
+
+#include "hci_uart.h"
+#include "btmtk.h"
+
+/* The "bgf" window, at the top of the BGF subsystem */
+#define BGF_MCCR			0x00100
+#define BGF_MCCR_AHB_AUTO_DIS		BIT(31)
+#define BGF_MCCR_SET			0x00104
+#define BGF_MCCR_AHB_STOP		BIT(2)
+#define BGF_MCU_SW_DBG_CTL		0x0016c
+#define BGF_MCU_ROM_DONE		0x1d1e
+#define BGF_IP_VERSION			0x12000
+#define BGF_IP_VER_ID			0x02080000
+#define BGF_CKGEN0_HCLK_FRZ_WIN		0x12100
+#define BGF_HCLK_SWITCH_FRZ_WIN		BIT(2)
+#define BGF_MCUSYS_DLY_CHAIN		0x20284
+#define BGF_MCUSYS_DLY_CHAIN_MASK	GENMASK(19, 16)
+#define BGF_MCUSYS_DLY_CHAIN_VAL	0x80000
+
+/* The "conn" window, at the top of the common part */
+#define CONN_RGU_BGF_PWR_CTL		0x00020
+#define CONN_RGU_BGF_PWR_KEY		0x42540000
+#define CONN_RGU_BGF_PWR_KEY_MASK	GENMASK(31, 16)
+#define CONN_RGU_BGF_PWR_EN		BIT(7)
+#define CONN_RGU_BGF_CPU_SW_RST		0x00124
+#define CONN_RGU_BGF_CPU_SW_RST_B	BIT(0)
+#define CONN_RGU_SEMA_M1_SW_RST		0x0015c
+#define CONN_RGU_SEMA_M1_SW_RST_B	BIT(0)
+#define CONN_RGU_BGF_OFF_PWR_ACK	0x00424
+#define CONN_RGU_BGF_OFF_PWR_ACK_B	BIT(24)
+#define CONN_RGU_BGF_OFF_PWR_ACK_S	BIT(0)
+
+#define CONN_CFG_BT_PWRCTLCR0		0x01208
+#define CONN_CFG_BT_FUNC_EN		BIT(0)
+#define CONN_CFG_PWRCTRL1		0x01210
+#define CONN_CFG_RDY			BIT(16)
+#define CONN_CFG_CONN2BT_SLP_CTL	0x01450
+#define CONN_CFG_BT2CONN_SLP_CTL	0x01460
+#define CONN_CFG_SLP_STATUS		4
+#define CONN_CFG_SLP_TX_EN		BIT(0)
+#define CONN_CFG_SLP_RX_EN		BIT(4)
+#define CONN_CFG_SLP_TX_ACK		BIT(23)
+#define CONN_CFG_SLP_RX_ACK		BIT(22)
+
+#define CONN_WT_SLP_TOP_CK_2		0x03128
+#define CONN_WT_SLP_TOP_CK_2_EN		BIT(0)
+#define CONN_WT_SLP_TOP_CK_2_BUSY	BIT(1)
+
+#define CONN_CFG_VERSION		0x11000
+#define CONN_CFG_ID			0x02050400
+#define CONN_CFG_EMI_CTL_BT		0x11118
+#define CONN_CFG_EMI_CTL_BT_EMI_REQ	BIT(0)
+#define CONN_CFG_EMI_CTL_BT_SRCCLKENA	BIT(1)
+#define CONN_CFG_EMI_CTL_BT_AP_BUS_REQ	BIT(2)
+#define CONN_CFG_EMI_CTL_BT_APSRC_REQ	BIT(3)
+#define CONN_CFG_EMI_CTL_BT_INFRA_REQ	BIT(5)
+
+#define CONN_BGF_DBG_DATA		0x23a00
+#define CONN_BGF_DBG_SEL		0x23a04
+#define CONN_BGF_DBG_SEL_MCU_PC		0xc0010d2a
+
+#define CONN_CCIF4_BGF2AP_ACK		0x3e014
+#define CONN_BGF_MCUCIRQ		0x3f00c
+#define CONN_BGF_MCUCIRQ_WAKE		(BIT(0) | BIT(1))
+#define CONN_BGF_SW_IRQ_STATUS		0x3f010
+#define CONN_BGF_SW_IRQ_RESET		0x3f014
+#define CONN_BGF_SW_IRQ_FW_LOG		BIT(0)
+#define CONN_BGF_SW_IRQ_SUBSYS_RESET	BIT(1)
+#define CONN_BGF_SW_IRQ_CHIP_RESET	BIT(2)
+#define CONN_BGF_SW_IRQ_FW2AP		BIT(3)
+#define CONN_BGF_SW_IRQ_ALL		GENMASK(3, 0)
+#define CONN_BGF_SW_IRQ_BUS_DEAD	0xdeadfeed
+
+#define CONN_CSR_BGF_LPCTL		0x60030
+#define CONN_CSR_BGF_SET_FW_OWN		BIT(0)
+#define CONN_CSR_BGF_CLR_FW_OWN		BIT(1)
+#define CONN_CSR_BGF_OWNER_SYNC		BIT(2)
+#define CONN_CSR_BGF_IRQ_STAT		0x60034
+#define CONN_CSR_BGF_IRQ_STAT2		0x6003c
+#define CONN_CSR_BGF_IRQ_FW_OWN		BIT(0)
+#define CONN_CSR_WAKEUP_BT		0x601a8
+#define CONN_CSR_WAKEUP_BT_EN		BIT(0)
+#define CONN_CSR_MCU_PC			0x6022c
+#define CONN_CSR_BUS_TIMEOUT		0x60268
+#define CONN_CSR_BUS_TIMEOUT_OK		0x87000000
+#define CONN_CSR_BUS_TIMEOUT_OK_MASK	GENMASK(31, 24)
+#define CONN_CSR_PWR_STATES		0x60a10
+#define CONN_CSR_BGF_ON_ISO_MASK	GENMASK(19, 18)
+#define CONN_CSR_BGF_ON_ISO_VAL		BIT(18)
+#define CONN_CSR_MONFLG_ON_OUT		0x60c00
+#define CONN_CSR_MONFLG_CONN_RDY	BIT(15)
+#define CONN_CSR_MONFLG_DBG_SEL		0x60c04
+#define CONN_CSR_MONFLG_DBG_SEL_KEEP	GENMASK(31, 22)
+#define CONN_CSR_MONFLG_DBG_SEL_BGF_ON	0x300001
+
+#define CONN_SEMA_M1_RELEASE_FIRST	0x71200
+#define CONN_SEMA_M1_RELEASE_LAST	0x71260
+
+/*
+ * The connsys memory. The bootloader loads the firmware at its bottom, which we
+ * have no business reading. The rings and the log headers are in the last MiB,
+ * which is the part the stock kernel reads and writes as well.
+ */
+#define BT_EMI_WINDOW_OFS		0xb00000
+#define BT_EMI_WINDOW_SIZE		0x100000
+#define BT_EMI_FW_VER_OFS		0xb48024
+#define BT_EMI_FW_VER_LEN		128
+#define BT_EMI_RING_OFS			0xba0000
+#define BT_EMI_RING_SIZE		SZ_32K
+
+/* The layout of the ring memory. All of it is for the host to set up. */
+#define BEIF_KEY			0x55665566
+#define BEIF_VERSION			0
+#define BEIF_HDR_KEY			0
+#define BEIF_HDR_VERSION		4
+#define BEIF_HDR_HOST_CTRL_OFS		8
+#define BEIF_HDR_FW_CTRL_OFS		12
+#define BEIF_HDR_H2C_OFS		16
+#define BEIF_HDR_H2C_SIZE		20
+#define BEIF_HDR_C2H_OFS		24
+#define BEIF_HDR_C2H_SIZE		28
+#define BEIF_HDR_LEN			32
+
+#define BEIF_CTRL_TX_PUSH		0
+#define BEIF_CTRL_RX_POP		4
+#define BEIF_CTRL_GUARD			28
+#define BEIF_CTRL_LEN			32
+
+#define BEIF_GUARD			0xdeadbeef
+#define BEIF_GUARD_LEN			32
+
+#define BEIF_HOST_CTRL			BEIF_HDR_LEN
+#define BEIF_FW_CTRL			(BEIF_HOST_CTRL + BEIF_CTRL_LEN)
+#define BEIF_H2C			(BEIF_FW_CTRL + BEIF_CTRL_LEN)
+#define BEIF_BUF_SIZE			((BT_EMI_RING_SIZE - BEIF_H2C - 2 * BEIF_GUARD_LEN) / 2)
+#define BEIF_H2C_GUARD			(BEIF_H2C + BEIF_BUF_SIZE)
+#define BEIF_C2H			(BEIF_H2C_GUARD + BEIF_GUARD_LEN)
+#define BEIF_C2H_GUARD			(BEIF_C2H + BEIF_BUF_SIZE)
+
+/* How much is copied out of the ring at a time, and at most on one interrupt */
+#define BEIF_RX_CHUNK			2048
+#define BEIF_RX_BUDGET			(2 * BEIF_BUF_SIZE)
+
+/*
+ * The firmware does not tell when it has made room, so this polls for that. The
+ * stack counts on every frame it sends, so one that does not fit is the end.
+ */
+#define BEIF_TX_TIMEOUT_MS		1000
+
+#define BTMTKBEIF_POLL_US		500
+#define BTMTKBEIF_POLL_TIMEOUT_US	(100 * BTMTKBEIF_POLL_US)
+#define BTMTKBEIF_OWN_TIMEOUT_MS	2000
+#define BTMTKBEIF_ROM_RETRIES		100
+#define BTMTKBEIF_WMT_TIMEOUT		msecs_to_jiffies(2000)
+#define BTMTKBEIF_MAX_RESETS		3
+#define BTMTKBEIF_STABLE_AFTER		(60 * HZ)
+
+#define BTMTKBEIF_WMT_DIR_HOST		1
+#define BTMTKBEIF_WMT_DIR_CHIP		2
+#define BTMTKBEIF_WMT_MISC		0xf0
+#define BTMTKBEIF_WMT_MISC_UTC		2
+#define BTMTKBEIF_WMT_MISC_BLANK	3
+#define BTMTKBEIF_WMT_RF_CAL		0x14
+#define BTMTKBEIF_WMT_RF_CAL_RESULT	3
+#define BTMTKBEIF_WMT_ANT		0x55
+#define BTMTKBEIF_WMT_ANT_SWAP		0
+
+/* After the status byte of a WMT_RF_CAL event */
+struct btmtkbeif_wmt_cal_evt {
+	u8 subop;
+	__le32 start;
+	__le16 len;
+	__le32 ready;
+} __packed;
+
+enum btmtkbeif_irq {
+	BTMTKBEIF_IRQ_SW,
+	BTMTKBEIF_IRQ_BUS_HANG,
+	BTMTKBEIF_NR_IRQS,
+};
+
+enum {
+	BTMTKBEIF_RUNNING,
+	BTMTKBEIF_DEAD,
+	BTMTKBEIF_WMT_WAIT,
+};
+
+struct btmtkbeif_dev {
+	struct device *dev;
+	struct hci_dev *hdev;
+	struct mtk_connsys *connsys;
+
+	void __iomem *bgf;
+	void __iomem *conn;
+	void __iomem *emi;
+	void __iomem *ring;
+	int irq[BTMTKBEIF_NR_IRQS];
+
+	/* A thread takes them off when it has seen enough, close does as well */
+	spinlock_t irq_lock;
+	bool irq_off[BTMTKBEIF_NR_IRQS];
+
+	unsigned long flags;
+	u8 wmt_op;
+	struct sk_buff *evt_skb;
+	unsigned long opened;
+	unsigned int resets;
+
+	/* Serialises the writers of the host to chip ring and who owns the MCU */
+	struct mutex tx_lock;
+	u32 tx_push;
+	bool fw_owned;
+
+	/* These belong to the thread of the software interrupt */
+	u32 rx_pop;
+	bool rx_more;
+	u8 *rx_buf;
+	struct sk_buff *rx_skb;
+	struct hci_uart hu;
+};
+
+static void btmtkbeif_conn_set(struct btmtkbeif_dev *bdev, u32 reg, u32 bits)
+{
+	writel(readl(bdev->conn + reg) | bits, bdev->conn + reg);
+}
+
+static void btmtkbeif_conn_clear(struct btmtkbeif_dev *bdev, u32 reg, u32 bits)
+{
+	writel(readl(bdev->conn + reg) & ~bits, bdev->conn + reg);
+}
+
+static int btmtkbeif_conn_poll(struct btmtkbeif_dev *bdev, const char *what,
+			       u32 reg, u32 mask, u32 want)
+{
+	u32 val;
+	int ret;
+
+	ret = readl_poll_timeout(bdev->conn + reg, val, (val & mask) == want,
+				 BTMTKBEIF_POLL_US, BTMTKBEIF_POLL_TIMEOUT_US);
+	if (ret) {
+		bt_dev_err(bdev->hdev, "BGF: %s: %05x = %08x", what, reg, val);
+		return ret;
+	}
+
+	/* The stock driver sleeps after every read, also the last. Nobody says why. */
+	usleep_range(BTMTKBEIF_POLL_US, BTMTKBEIF_POLL_US + 50);
+
+	return 0;
+}
+
+/* The always-on part of the common part says if a bus timeout has hit BGF */
+static bool btmtkbeif_bus_timed_out(struct btmtkbeif_dev *bdev)
+{
+	u32 val = readl(bdev->conn + CONN_CSR_BUS_TIMEOUT);
+
+	if (!val || (val & CONN_CSR_BUS_TIMEOUT_OK_MASK) == CONN_CSR_BUS_TIMEOUT_OK)
+		return false;
+
+	bt_dev_err(bdev->hdev, "BGF bus timeout: %08x", val);
+
+	return true;
+}
+
+static void btmtkbeif_conn_sleep(struct btmtkbeif_dev *bdev)
+{
+	btmtkbeif_conn_clear(bdev, CONN_CSR_WAKEUP_BT, CONN_CSR_WAKEUP_BT_EN);
+}
+
+/* Keep the sleeping part of the common part awake for register accesses */
+static int btmtkbeif_conn_wake(struct btmtkbeif_dev *bdev)
+{
+	u32 val;
+	int ret;
+
+	btmtkbeif_conn_set(bdev, CONN_CSR_WAKEUP_BT, CONN_CSR_WAKEUP_BT_EN);
+	/* Before this it can look ready when it is not */
+	usleep_range(200, 250);
+
+	ret = readl_poll_timeout(bdev->conn + CONN_CFG_VERSION, val,
+				 val == CONN_CFG_ID, 1000, 10000);
+	if (ret) {
+		bt_dev_err(bdev->hdev, "conninfra version: %08x", val);
+		goto err_sleep;
+	}
+
+	ret = readl_poll_timeout(bdev->conn + CONN_CFG_PWRCTRL1, val,
+				 val & CONN_CFG_RDY, BTMTKBEIF_POLL_US, 5000);
+	if (ret) {
+		bt_dev_err(bdev->hdev, "conninfra not ready: %08x", val);
+		goto err_sleep;
+	}
+
+	return 0;
+
+err_sleep:
+	btmtkbeif_conn_sleep(bdev);
+	return ret;
+}
+
+/* Take down a bus sleep protection, the receive side first */
+static int btmtkbeif_slp_prot_release(struct btmtkbeif_dev *bdev,
+				      const char *name, u32 ctl)
+{
+	int ret;
+
+	bt_dev_info(bdev->hdev, "BGF: %s sleep protection off", name);
+
+	btmtkbeif_conn_clear(bdev, ctl, CONN_CFG_SLP_RX_EN);
+	ret = btmtkbeif_conn_poll(bdev, "receive sleep protection",
+				  ctl + CONN_CFG_SLP_STATUS,
+				  CONN_CFG_SLP_RX_ACK, 0);
+	if (ret)
+		return ret;
+
+	btmtkbeif_conn_clear(bdev, ctl, CONN_CFG_SLP_TX_EN);
+
+	return btmtkbeif_conn_poll(bdev, "transmit sleep protection",
+				   ctl + CONN_CFG_SLP_STATUS,
+				   CONN_CFG_SLP_TX_ACK, 0);
+}
+
+static int btmtkbeif_mcu_power_on(struct btmtkbeif_dev *bdev)
+{
+	struct hci_dev *hdev = bdev->hdev;
+	u32 val;
+	int i, ret;
+
+	bt_dev_info(hdev, "BGF: wake conninfra");
+	ret = btmtkbeif_conn_wake(bdev);
+	if (ret)
+		return ret;
+
+	bt_dev_info(hdev, "BGF: top on, CPU in reset");
+	btmtkbeif_conn_clear(bdev, CONN_RGU_BGF_CPU_SW_RST,
+			     CONN_RGU_BGF_CPU_SW_RST_B);
+
+	val = readl(bdev->conn + CONN_RGU_BGF_PWR_CTL);
+	val &= ~(CONN_RGU_BGF_PWR_KEY_MASK | CONN_RGU_BGF_PWR_EN);
+	writel(val | CONN_RGU_BGF_PWR_KEY | CONN_RGU_BGF_PWR_EN,
+	       bdev->conn + CONN_RGU_BGF_PWR_CTL);
+
+	ret = btmtkbeif_conn_poll(bdev, "top isolation", CONN_CSR_PWR_STATES,
+				  CONN_CSR_BGF_ON_ISO_MASK,
+				  CONN_CSR_BGF_ON_ISO_VAL);
+	if (ret)
+		return ret;
+
+	bt_dev_info(hdev, "BGF: function on");
+	btmtkbeif_conn_set(bdev, CONN_CFG_BT_PWRCTLCR0, CONN_CFG_BT_FUNC_EN);
+
+	ret = btmtkbeif_conn_poll(bdev, "power ack", CONN_RGU_BGF_OFF_PWR_ACK,
+				  CONN_RGU_BGF_OFF_PWR_ACK_B,
+				  CONN_RGU_BGF_OFF_PWR_ACK_B);
+	if (ret)
+		return ret;
+
+	ret = btmtkbeif_conn_poll(bdev, "second power ack",
+				  CONN_RGU_BGF_OFF_PWR_ACK,
+				  CONN_RGU_BGF_OFF_PWR_ACK_S,
+				  CONN_RGU_BGF_OFF_PWR_ACK_S);
+	if (ret)
+		return ret;
+
+	ret = btmtkbeif_slp_prot_release(bdev, "conn2bt",
+					 CONN_CFG_CONN2BT_SLP_CTL);
+	if (ret)
+		return ret;
+
+	ret = btmtkbeif_slp_prot_release(bdev, "bt2conn",
+					 CONN_CFG_BT2CONN_SLP_CTL);
+	if (ret)
+		return ret;
+
+	usleep_range(400, 440);
+
+	/* If this hangs, the power or the protections above are not what they said */
+	bt_dev_info(hdev, "BGF: first read of the BGF side");
+	val = readl(bdev->bgf + BGF_IP_VERSION);
+	bt_dev_info(hdev, "BGF: version %08x", val);
+	if (val != BGF_IP_VER_ID) {
+		bt_dev_err(hdev, "BGF: not the version it should be");
+		return -ENODEV;
+	}
+
+	val = readl(bdev->bgf + BGF_MCCR);
+	writel(val & ~BGF_MCCR_AHB_AUTO_DIS, bdev->bgf + BGF_MCCR);
+	writel(BGF_MCCR_AHB_STOP, bdev->bgf + BGF_MCCR_SET);
+
+	val = readl(bdev->bgf + BGF_MCUSYS_DLY_CHAIN);
+	val &= ~BGF_MCUSYS_DLY_CHAIN_MASK;
+	writel(val | BGF_MCUSYS_DLY_CHAIN_VAL,
+	       bdev->bgf + BGF_MCUSYS_DLY_CHAIN);
+
+	val = readl(bdev->bgf + BGF_CKGEN0_HCLK_FRZ_WIN);
+	writel(val | BGF_HCLK_SWITCH_FRZ_WIN,
+	       bdev->bgf + BGF_CKGEN0_HCLK_FRZ_WIN);
+
+	val = readl(bdev->conn + CONN_CSR_MONFLG_DBG_SEL);
+	val &= CONN_CSR_MONFLG_DBG_SEL_KEEP;
+	writel(val | CONN_CSR_MONFLG_DBG_SEL_BGF_ON,
+	       bdev->conn + CONN_CSR_MONFLG_DBG_SEL);
+
+	ret = btmtkbeif_conn_poll(bdev, "conninfra restore",
+				  CONN_CSR_MONFLG_ON_OUT,
+				  CONN_CSR_MONFLG_CONN_RDY,
+				  CONN_CSR_MONFLG_CONN_RDY);
+	if (ret)
+		return ret;
+
+	writel(CONN_CSR_BGF_IRQ_FW_OWN, bdev->conn + CONN_CSR_BGF_IRQ_STAT);
+	writel(CONN_CSR_BGF_IRQ_FW_OWN, bdev->conn + CONN_CSR_BGF_IRQ_STAT2);
+	writel(0xff, bdev->conn + CONN_CCIF4_BGF2AP_ACK);
+
+	bt_dev_info(hdev, "BGF: CPU out of reset");
+	btmtkbeif_conn_set(bdev, CONN_RGU_BGF_CPU_SW_RST,
+			   CONN_RGU_BGF_CPU_SW_RST_B);
+
+	val = readl(bdev->conn + CONN_CSR_MONFLG_DBG_SEL);
+	writel(val & CONN_CSR_MONFLG_DBG_SEL_KEEP,
+	       bdev->conn + CONN_CSR_MONFLG_DBG_SEL);
+
+	/* The MCU comes to a stop when the power-on part of its ROM has run */
+	writel(CONN_BGF_DBG_SEL_MCU_PC, bdev->conn + CONN_BGF_DBG_SEL);
+
+	for (i = 0; i < BTMTKBEIF_ROM_RETRIES; i++) {
+		if (readl(bdev->conn + CONN_CFG_VERSION) != CONN_CFG_ID) {
+			bt_dev_err(hdev, "BGF: conninfra stopped answering");
+			return -EIO;
+		}
+
+		val = readl(bdev->bgf + BGF_MCU_SW_DBG_CTL);
+		if (val == BGF_MCU_ROM_DONE)
+			break;
+
+		bt_dev_dbg(hdev, "BGF: MCU pc %08x",
+			   readl(bdev->conn + CONN_BGF_DBG_DATA));
+		usleep_range(5000, 5500);
+	}
+	if (i == BTMTKBEIF_ROM_RETRIES) {
+		bt_dev_err(hdev, "BGF: MCU ROM: %08x, pc %08x", val,
+			   readl(bdev->conn + CONN_BGF_DBG_DATA));
+		return -ETIMEDOUT;
+	}
+	bt_dev_info(hdev, "BGF: MCU ROM done after %d polls", i);
+
+	btmtkbeif_conn_set(bdev, CONN_BGF_SW_IRQ_RESET, CONN_BGF_SW_IRQ_FW_LOG);
+	btmtkbeif_conn_set(bdev, CONN_BGF_SW_IRQ_RESET,
+			   CONN_BGF_SW_IRQ_SUBSYS_RESET);
+
+	btmtkbeif_conn_sleep(bdev);
+
+	return 0;
+}
+
+/* Put up a bus sleep protection, the transmit side first */
+static int btmtkbeif_slp_prot_set(struct btmtkbeif_dev *bdev, u32 ctl)
+{
+	int ret, err = 0;
+
+	btmtkbeif_conn_set(bdev, ctl, CONN_CFG_SLP_TX_EN);
+	ret = btmtkbeif_conn_poll(bdev, "transmit sleep protection on",
+				  ctl + CONN_CFG_SLP_STATUS,
+				  CONN_CFG_SLP_TX_ACK, CONN_CFG_SLP_TX_ACK);
+	if (ret)
+		err = ret;
+
+	btmtkbeif_conn_set(bdev, ctl, CONN_CFG_SLP_RX_EN);
+	ret = btmtkbeif_conn_poll(bdev, "receive sleep protection on",
+				  ctl + CONN_CFG_SLP_STATUS,
+				  CONN_CFG_SLP_RX_ACK, CONN_CFG_SLP_RX_ACK);
+
+	return ret ?: err;
+}
+
+static void btmtkbeif_mcu_power_off(struct btmtkbeif_dev *bdev)
+{
+	struct hci_dev *hdev = bdev->hdev;
+	u32 val;
+	int ret, err;
+	u32 reg;
+
+	bt_dev_info(hdev, "BGF: power off");
+
+	if (btmtkbeif_conn_wake(bdev))
+		return;
+
+	err = btmtkbeif_slp_prot_set(bdev, CONN_CFG_BT2CONN_SLP_CTL);
+	ret = btmtkbeif_slp_prot_set(bdev, CONN_CFG_CONN2BT_SLP_CTL);
+	if (ret || err)
+		/* The stock driver resets all of connsys here, which takes every radio */
+		bt_dev_err(hdev, "BGF: the bus to it is not quiet, going on without a reset");
+
+	btmtkbeif_conn_clear(bdev, CONN_CFG_BT_PWRCTLCR0, CONN_CFG_BT_FUNC_EN);
+
+	val = readl(bdev->conn + CONN_RGU_BGF_PWR_CTL);
+	val &= ~(CONN_RGU_BGF_PWR_KEY_MASK | CONN_RGU_BGF_PWR_EN);
+	writel(val | CONN_RGU_BGF_PWR_KEY, bdev->conn + CONN_RGU_BGF_PWR_CTL);
+
+	btmtkbeif_conn_clear(bdev, CONN_RGU_BGF_CPU_SW_RST,
+			     CONN_RGU_BGF_CPU_SW_RST_B);
+
+	usleep_range(1000, 1100);
+
+	if (!btmtkbeif_bus_timed_out(bdev)) {
+		val = readl(bdev->conn + CONN_BGF_SW_IRQ_STATUS);
+		if (val & CONN_BGF_SW_IRQ_ALL)
+			btmtkbeif_conn_set(bdev, CONN_BGF_SW_IRQ_RESET,
+					   val & CONN_BGF_SW_IRQ_ALL);
+		bt_dev_dbg(hdev, "BGF: software interrupts at off: %08x", val);
+	}
+
+	btmtkbeif_conn_clear(bdev, CONN_WT_SLP_TOP_CK_2, CONN_WT_SLP_TOP_CK_2_EN);
+	btmtkbeif_conn_poll(bdev, "A-die clock off", CONN_WT_SLP_TOP_CK_2,
+			    CONN_WT_SLP_TOP_CK_2_BUSY, 0);
+
+	/* Give back the semaphores it may hold, and their block */
+	for (reg = CONN_SEMA_M1_RELEASE_FIRST; reg <= CONN_SEMA_M1_RELEASE_LAST;
+	     reg += 4)
+		btmtkbeif_conn_set(bdev, reg, BIT(0));
+
+	btmtkbeif_conn_clear(bdev, CONN_RGU_SEMA_M1_SW_RST,
+			     CONN_RGU_SEMA_M1_SW_RST_B);
+	btmtkbeif_conn_set(bdev, CONN_RGU_SEMA_M1_SW_RST,
+			   CONN_RGU_SEMA_M1_SW_RST_B);
+
+	/* Pulse away what it has requested of the memory and the bus */
+	btmtkbeif_conn_set(bdev, CONN_CFG_EMI_CTL_BT, CONN_CFG_EMI_CTL_BT_EMI_REQ);
+	btmtkbeif_conn_clear(bdev, CONN_CFG_EMI_CTL_BT, CONN_CFG_EMI_CTL_BT_EMI_REQ);
+	btmtkbeif_conn_set(bdev, CONN_CFG_EMI_CTL_BT,
+			   CONN_CFG_EMI_CTL_BT_SRCCLKENA);
+	btmtkbeif_conn_clear(bdev, CONN_CFG_EMI_CTL_BT,
+			     CONN_CFG_EMI_CTL_BT_SRCCLKENA);
+	btmtkbeif_conn_clear(bdev, CONN_CFG_EMI_CTL_BT,
+			     CONN_CFG_EMI_CTL_BT_AP_BUS_REQ);
+	btmtkbeif_conn_clear(bdev, CONN_CFG_EMI_CTL_BT,
+			     CONN_CFG_EMI_CTL_BT_APSRC_REQ);
+	btmtkbeif_conn_set(bdev, CONN_CFG_EMI_CTL_BT,
+			   CONN_CFG_EMI_CTL_BT_INFRA_REQ);
+	btmtkbeif_conn_clear(bdev, CONN_CFG_EMI_CTL_BT,
+			     CONN_CFG_EMI_CTL_BT_INFRA_REQ);
+
+	btmtkbeif_conn_sleep(bdev);
+}
+
+static void btmtkbeif_ring_guard(struct btmtkbeif_dev *bdev, u32 ofs)
+{
+	int i;
+
+	for (i = 0; i < BEIF_GUARD_LEN; i += 4)
+		writel(BEIF_GUARD, bdev->ring + ofs + i);
+}
+
+/* All of this is ours to set up, and the MCU only takes the positions from it */
+static void btmtkbeif_ring_reset(struct btmtkbeif_dev *bdev)
+{
+	void __iomem *ring = bdev->ring;
+
+	writel(BEIF_KEY, ring + BEIF_HDR_KEY);
+	writel(BEIF_VERSION, ring + BEIF_HDR_VERSION);
+	writel(BEIF_HOST_CTRL, ring + BEIF_HDR_HOST_CTRL_OFS);
+	writel(BEIF_FW_CTRL, ring + BEIF_HDR_FW_CTRL_OFS);
+	writel(BEIF_H2C, ring + BEIF_HDR_H2C_OFS);
+	writel(BEIF_BUF_SIZE, ring + BEIF_HDR_H2C_SIZE);
+	writel(BEIF_C2H, ring + BEIF_HDR_C2H_OFS);
+	writel(BEIF_BUF_SIZE, ring + BEIF_HDR_C2H_SIZE);
+
+	writel(0, ring + BEIF_HOST_CTRL + BEIF_CTRL_TX_PUSH);
+	writel(0, ring + BEIF_HOST_CTRL + BEIF_CTRL_RX_POP);
+	writel(BEIF_GUARD, ring + BEIF_HOST_CTRL + BEIF_CTRL_GUARD);
+	memset_io(ring + BEIF_H2C, 0, BEIF_BUF_SIZE);
+	btmtkbeif_ring_guard(bdev, BEIF_H2C_GUARD);
+
+	writel(0, ring + BEIF_FW_CTRL + BEIF_CTRL_TX_PUSH);
+	writel(0, ring + BEIF_FW_CTRL + BEIF_CTRL_RX_POP);
+	writel(BEIF_GUARD, ring + BEIF_FW_CTRL + BEIF_CTRL_GUARD);
+	memset_io(ring + BEIF_C2H, 0, BEIF_BUF_SIZE);
+	btmtkbeif_ring_guard(bdev, BEIF_C2H_GUARD);
+
+	bdev->tx_push = 0;
+	bdev->rx_pop = 0;
+}
+
+static void btmtkbeif_dump(struct btmtkbeif_dev *bdev)
+{
+	void __iomem *ring = bdev->ring;
+	u32 key = readl(ring + BEIF_HDR_KEY);
+	u32 guard[2];
+
+	guard[0] = readl(ring + BEIF_H2C_GUARD);
+	guard[1] = readl(ring + BEIF_C2H_GUARD);
+
+	bt_dev_info(bdev->hdev,
+		    "BEIF: key %08x guards %08x %08x, to chip %u/%u, from chip %u/%u, MCU pc %08x",
+		    key, guard[0], guard[1], bdev->tx_push,
+		    readl(ring + BEIF_FW_CTRL + BEIF_CTRL_RX_POP),
+		    readl(ring + BEIF_FW_CTRL + BEIF_CTRL_TX_PUSH), bdev->rx_pop,
+		    readl(bdev->conn + CONN_CSR_MCU_PC));
+}
+
+static void btmtkbeif_irqs_off_nosync(struct btmtkbeif_dev *bdev)
+{
+	unsigned long flags;
+	int i;
+
+	spin_lock_irqsave(&bdev->irq_lock, flags);
+	for (i = 0; i < BTMTKBEIF_NR_IRQS; i++) {
+		if (!bdev->irq_off[i]) {
+			bdev->irq_off[i] = true;
+			disable_irq_nosync(bdev->irq[i]);
+		}
+	}
+	spin_unlock_irqrestore(&bdev->irq_lock, flags);
+}
+
+static void btmtkbeif_irqs_off(struct btmtkbeif_dev *bdev)
+{
+	int i;
+
+	btmtkbeif_irqs_off_nosync(bdev);
+	for (i = 0; i < BTMTKBEIF_NR_IRQS; i++)
+		synchronize_irq(bdev->irq[i]);
+}
+
+static void btmtkbeif_irqs_on(struct btmtkbeif_dev *bdev)
+{
+	unsigned long flags;
+	int i;
+
+	for (i = 0; i < BTMTKBEIF_NR_IRQS; i++) {
+		spin_lock_irqsave(&bdev->irq_lock, flags);
+		bdev->irq_off[i] = false;
+		enable_irq(bdev->irq[i]);
+		spin_unlock_irqrestore(&bdev->irq_lock, flags);
+	}
+}
+
+/*
+ * The firmware or the bus has gone wrong. Nothing more is sent or received until
+ * the stack, on the hardware error, has closed the device and opened it again.
+ * That is not done forever for firmware that fails right after it has started.
+ */
+static void btmtkbeif_fatal(struct btmtkbeif_dev *bdev, const char *why)
+{
+	if (test_and_set_bit(BTMTKBEIF_DEAD, &bdev->flags))
+		return;
+
+	bt_dev_err(bdev->hdev, "%s", why);
+
+	btmtkbeif_irqs_off_nosync(bdev);
+
+	if (test_and_clear_bit(BTMTKBEIF_WMT_WAIT, &bdev->flags)) {
+		/* Barrier to sync with other CPUs */
+		smp_mb__after_atomic();
+		wake_up_bit(&bdev->flags, BTMTKBEIF_WMT_WAIT);
+	}
+
+	if (time_after(jiffies, bdev->opened + BTMTKBEIF_STABLE_AFTER))
+		bdev->resets = 0;
+
+	if (++bdev->resets > BTMTKBEIF_MAX_RESETS) {
+		bt_dev_err(bdev->hdev, "BGF: it keeps failing, not starting it again");
+		return;
+	}
+
+	hci_reset_dev(bdev->hdev);
+}
+
+static int btmtkbeif_recv_event(struct hci_dev *hdev, struct sk_buff *skb)
+{
+	struct btmtkbeif_dev *bdev = hci_get_drvdata(hdev);
+	struct btmtk_hci_wmt_evt *wmt_evt = (void *)skb->data;
+	struct sk_buff *clone = NULL;
+	bool wmt;
+	int err;
+
+	/* An answer that comes late is not the answer to the next command */
+	wmt = wmt_evt->hhdr.evt == HCI_EV_WMT &&
+	      skb->len >= offsetofend(struct btmtk_hci_wmt_evt, whdr.op) &&
+	      wmt_evt->whdr.op == bdev->wmt_op &&
+	      test_bit(BTMTKBEIF_WMT_WAIT, &bdev->flags);
+
+	/* The one waiting for a WMT event reads it from a copy */
+	if (wmt)
+		clone = skb_clone(skb, GFP_KERNEL);
+
+	err = hci_recv_frame(hdev, skb);
+
+	if (wmt) {
+		kfree_skb(xchg(&bdev->evt_skb, clone));
+		if (test_and_clear_bit(BTMTKBEIF_WMT_WAIT, &bdev->flags)) {
+			/* Barrier to sync with other CPUs */
+			smp_mb__after_atomic();
+			wake_up_bit(&bdev->flags, BTMTKBEIF_WMT_WAIT);
+		}
+	}
+
+	return err;
+}
+
+static const struct h4_recv_pkt btmtkbeif_recv_pkts[] = {
+	{ H4_RECV_ACL,      .recv = hci_recv_frame },
+	{ H4_RECV_SCO,      .recv = hci_recv_frame },
+	{ H4_RECV_EVENT,    .recv = btmtkbeif_recv_event },
+	{ H4_RECV_ISO,      .recv = hci_recv_frame },
+};
+
+/* Empty the chip to host ring. The position in it is the firmware's to get wrong. */
+static void btmtkbeif_rx(struct btmtkbeif_dev *bdev)
+{
+	void __iomem *ring = bdev->ring;
+	struct hci_dev *hdev = bdev->hdev;
+	u32 budget = BEIF_RX_BUDGET;
+	u32 pop = bdev->rx_pop;
+	u32 push, len;
+
+	while (budget) {
+		/* This read is ordered before the reads of the data */
+		push = readl(ring + BEIF_FW_CTRL + BEIF_CTRL_TX_PUSH);
+		if (push >= BEIF_BUF_SIZE) {
+			bt_dev_err(hdev, "BEIF: from chip position %u", push);
+			btmtkbeif_fatal(bdev, "BEIF: the firmware has lost its place");
+			return;
+		}
+
+		if (push == pop)
+			return;
+
+		len = push > pop ? push - pop : BEIF_BUF_SIZE - pop;
+		len = min3(len, (u32)BEIF_RX_CHUNK, budget);
+		memcpy_fromio(bdev->rx_buf, ring + BEIF_C2H + pop, len);
+
+		bdev->rx_skb = h4_recv_buf(&bdev->hu, bdev->rx_skb, bdev->rx_buf,
+					   len, btmtkbeif_recv_pkts,
+					   ARRAY_SIZE(btmtkbeif_recv_pkts));
+		if (IS_ERR(bdev->rx_skb)) {
+			bt_dev_err(hdev, "BEIF: frame reassembly failed (%ld)",
+				   PTR_ERR(bdev->rx_skb));
+			bdev->rx_skb = NULL;
+			hdev->stat.err_rx++;
+			btmtkbeif_fatal(bdev, "BEIF: the stream from the chip is broken");
+			return;
+		}
+
+		hdev->stat.byte_rx += len;
+		budget -= len;
+
+		pop += len;
+		if (pop == BEIF_BUF_SIZE)
+			pop = 0;
+		bdev->rx_pop = pop;
+		writel(pop, ring + BEIF_HOST_CTRL + BEIF_CTRL_RX_POP);
+	}
+
+	/* It keeps writing; let the others run before going on */
+	bdev->rx_more = true;
+	irq_wake_thread(bdev->irq[BTMTKBEIF_IRQ_SW], bdev);
+}
+
+static irqreturn_t btmtkbeif_sw_irq(int irq, void *data)
+{
+	struct btmtkbeif_dev *bdev = data;
+	bool more = bdev->rx_more;
+	u32 status;
+
+	bdev->rx_more = false;
+
+	if (btmtkbeif_conn_wake(bdev)) {
+		btmtkbeif_fatal(bdev, "BGF: can't wake conninfra for an interrupt");
+		return IRQ_HANDLED;
+	}
+
+	if (btmtkbeif_bus_timed_out(bdev)) {
+		btmtkbeif_conn_sleep(bdev);
+		btmtkbeif_fatal(bdev, "BGF: bus timeout");
+		return IRQ_HANDLED;
+	}
+
+	status = readl(bdev->conn + CONN_BGF_SW_IRQ_STATUS);
+	if (status == CONN_BGF_SW_IRQ_BUS_DEAD ||
+	    (status & ~CONN_BGF_SW_IRQ_ALL)) {
+		btmtkbeif_conn_sleep(bdev);
+		bt_dev_err(bdev->hdev, "BGF: software interrupts: %08x", status);
+		btmtkbeif_fatal(bdev, "BGF: the bus has gone away");
+		return IRQ_HANDLED;
+	}
+
+	/*
+	 * Before the ring is read, so that anything later interrupts again. The
+	 * read sees it through; the ring is on another path than this write.
+	 */
+	if (status) {
+		btmtkbeif_conn_set(bdev, CONN_BGF_SW_IRQ_RESET, status);
+		readl(bdev->conn + CONN_BGF_SW_IRQ_STATUS);
+	}
+	btmtkbeif_conn_sleep(bdev);
+
+	if (!status && !more)
+		return IRQ_NONE;
+
+	if (more || (status & CONN_BGF_SW_IRQ_FW2AP))
+		btmtkbeif_rx(bdev);
+
+	if (status & CONN_BGF_SW_IRQ_FW_LOG)
+		bt_dev_dbg(bdev->hdev, "BGF: firmware log, not read");
+
+	if (status & CONN_BGF_SW_IRQ_SUBSYS_RESET) {
+		btmtkbeif_dump(bdev);
+		btmtkbeif_fatal(bdev, "BGF: firmware assert");
+	} else if (status & CONN_BGF_SW_IRQ_CHIP_RESET) {
+		btmtkbeif_dump(bdev);
+		/* That would take the other radios along. The MCU alone starts again. */
+		btmtkbeif_fatal(bdev, "BGF: the firmware asks for a whole connsys reset");
+	}
+
+	return IRQ_HANDLED;
+}
+
+/* No register clears this one, so it stays off until the next open */
+static irqreturn_t btmtkbeif_bus_hang_irq(int irq, void *data)
+{
+	btmtkbeif_fatal(data, "BGF: bus hang");
+
+	return IRQ_HANDLED;
+}
+
+/* The MCU sleeps unless it belongs to the driver. It stays ours while awake. */
+static int btmtkbeif_driver_own(struct btmtkbeif_dev *bdev)
+{
+	unsigned long timeout = jiffies + msecs_to_jiffies(BTMTKBEIF_OWN_TIMEOUT_MS);
+	int i;
+
+	bt_dev_info(bdev->hdev, "BGF: driver own");
+
+	for (i = 0; ; i++) {
+		if (!(i % 16))
+			writel(CONN_CSR_BGF_CLR_FW_OWN,
+			       bdev->conn + CONN_CSR_BGF_LPCTL);
+
+		if (!(readl(bdev->conn + CONN_CSR_BGF_LPCTL) &
+		      CONN_CSR_BGF_OWNER_SYNC))
+			break;
+
+		if (time_after(jiffies, timeout)) {
+			bt_dev_err(bdev->hdev, "BGF: no driver own: %08x, MCU pc %08x",
+				   readl(bdev->conn + CONN_CSR_BGF_LPCTL),
+				   readl(bdev->conn + CONN_CSR_MCU_PC));
+			return -ETIMEDOUT;
+		}
+
+		usleep_range(BTMTKBEIF_POLL_US, BTMTKBEIF_POLL_US + 50);
+	}
+
+	writel(CONN_CSR_BGF_IRQ_FW_OWN, bdev->conn + CONN_CSR_BGF_IRQ_STAT);
+	bdev->fw_owned = false;
+
+	return 0;
+}
+
+/*
+ * Give the MCU back to its firmware. The owner bit follows the write, not the
+ * firmware, so what counts is the interrupt status, masked or not.
+ */
+static int btmtkbeif_fw_own(struct btmtkbeif_dev *bdev)
+{
+	unsigned long timeout = jiffies + msecs_to_jiffies(BTMTKBEIF_OWN_TIMEOUT_MS);
+	int i;
+
+	bt_dev_info(bdev->hdev, "BGF: firmware own");
+
+	for (i = 0; ; i++) {
+		if (!(i % 16))
+			writel(CONN_CSR_BGF_SET_FW_OWN,
+			       bdev->conn + CONN_CSR_BGF_LPCTL);
+
+		if (readl(bdev->conn + CONN_CSR_BGF_IRQ_STAT2) &
+		    CONN_CSR_BGF_IRQ_FW_OWN)
+			break;
+
+		if (time_after(jiffies, timeout))
+			return -ETIMEDOUT;
+
+		usleep_range(BTMTKBEIF_POLL_US, BTMTKBEIF_POLL_US + 50);
+	}
+
+	writel(CONN_CSR_BGF_IRQ_FW_OWN, bdev->conn + CONN_CSR_BGF_IRQ_STAT2);
+	bdev->fw_owned = true;
+
+	return 0;
+}
+
+/* The firmware writes where its release string is. It is not read outside the window. */
+static void btmtkbeif_log_fw_version(struct btmtkbeif_dev *bdev)
+{
+	char ver[BT_EMI_FW_VER_LEN];
+	u32 ofs;
+
+	ofs = readl(bdev->emi + BT_EMI_FW_VER_OFS - BT_EMI_WINDOW_OFS);
+	if (ofs < BT_EMI_WINDOW_OFS ||
+	    ofs > BT_EMI_WINDOW_OFS + BT_EMI_WINDOW_SIZE - sizeof(ver)) {
+		bt_dev_info(bdev->hdev, "firmware release string at %#x, not read", ofs);
+		return;
+	}
+
+	memcpy_fromio(ver, bdev->emi + ofs - BT_EMI_WINDOW_OFS, sizeof(ver) - 1);
+	ver[sizeof(ver) - 1] = '\0';
+	bt_dev_info(bdev->hdev, "firmware: %*pE", (int)strlen(ver), ver);
+}
+
+static int btmtkbeif_open(struct hci_dev *hdev)
+{
+	struct btmtkbeif_dev *bdev = hci_get_drvdata(hdev);
+	int ret;
+
+	ret = mtk_connsys_power_on(bdev->connsys, MTK_CONNSYS_RADIO_BT);
+	if (ret) {
+		bt_dev_err(hdev, "can't power connsys: %d", ret);
+		return ret;
+	}
+
+	clear_bit(BTMTKBEIF_DEAD, &bdev->flags);
+	bdev->opened = jiffies;
+	bdev->fw_owned = true;
+
+	/*
+	 * The stock driver has the ring in place from when it loads, so the MCU
+	 * has never run without it, and sets it up again once the MCU is up.
+	 */
+	btmtkbeif_ring_reset(bdev);
+
+	ret = btmtkbeif_mcu_power_on(bdev);
+	if (ret) {
+		btmtkbeif_dump(bdev);
+		goto err_power_off;
+	}
+
+	btmtkbeif_ring_reset(bdev);
+	btmtkbeif_log_fw_version(bdev);
+
+	btmtkbeif_irqs_on(bdev);
+
+	ret = btmtkbeif_driver_own(bdev);
+	if (ret)
+		goto err_irqs_off;
+
+	set_bit(BTMTKBEIF_RUNNING, &bdev->flags);
+
+	bt_dev_info(hdev, "BGF: up, ring of %u bytes each way", BEIF_BUF_SIZE);
+
+	return 0;
+
+err_irqs_off:
+	btmtkbeif_irqs_off(bdev);
+	kfree_skb(bdev->rx_skb);
+	bdev->rx_skb = NULL;
+	bdev->rx_more = false;
+err_power_off:
+	btmtkbeif_mcu_power_off(bdev);
+	mtk_connsys_power_off(bdev->connsys, MTK_CONNSYS_RADIO_BT);
+
+	return ret;
+}
+
+static int btmtkbeif_close(struct hci_dev *hdev)
+{
+	struct btmtkbeif_dev *bdev = hci_get_drvdata(hdev);
+
+	mutex_lock(&bdev->tx_lock);
+	clear_bit(BTMTKBEIF_RUNNING, &bdev->flags);
+	mutex_unlock(&bdev->tx_lock);
+
+	btmtkbeif_irqs_off(bdev);
+
+	kfree_skb(bdev->rx_skb);
+	bdev->rx_skb = NULL;
+	bdev->rx_more = false;
+	kfree_skb(xchg(&bdev->evt_skb, NULL));
+
+	btmtkbeif_mcu_power_off(bdev);
+	mtk_connsys_power_off(bdev->connsys, MTK_CONNSYS_RADIO_BT);
+
+	return 0;
+}
+
+/*
+ * Send a WMT command and wait for its event. The status is the first byte after
+ * the header, which is called flag there; what follows it goes into rsp.
+ */
+static int btmtkbeif_wmt_sync(struct hci_dev *hdev,
+			      struct btmtk_hci_wmt_params *params,
+			      unsigned long timeout, void *rsp, size_t rsp_len)
+{
+	struct btmtkbeif_dev *bdev = hci_get_drvdata(hdev);
+	struct btmtk_hci_wmt_evt *wmt_evt;
+	struct btmtk_hci_wmt_cmd *wc;
+	struct sk_buff *evt;
+	u32 hlen;
+	int err;
+
+	hlen = sizeof(wc->hdr) + params->dlen;
+	if (hlen > U8_MAX)
+		return -EINVAL;
+
+	wc = kzalloc(hlen, GFP_KERNEL);
+	if (!wc)
+		return -ENOMEM;
+
+	wc->hdr.dir = BTMTKBEIF_WMT_DIR_HOST;
+	wc->hdr.op = params->op;
+	wc->hdr.dlen = cpu_to_le16(params->dlen + 1);
+	wc->hdr.flag = params->flag;
+	if (params->dlen)
+		memcpy(wc->data, params->data, params->dlen);
+
+	/* From a wait that timed out */
+	kfree_skb(xchg(&bdev->evt_skb, NULL));
+
+	bdev->wmt_op = params->op;
+	set_bit(BTMTKBEIF_WMT_WAIT, &bdev->flags);
+	/* Barrier to sync with btmtkbeif_fatal() */
+	smp_mb__after_atomic();
+	if (test_bit(BTMTKBEIF_DEAD, &bdev->flags)) {
+		clear_bit(BTMTKBEIF_WMT_WAIT, &bdev->flags);
+		err = -EIO;
+		goto out_free_wc;
+	}
+
+	err = __hci_cmd_send(hdev, 0xfc6f, hlen, wc);
+	if (err < 0) {
+		clear_bit(BTMTKBEIF_WMT_WAIT, &bdev->flags);
+		goto out_free_wc;
+	}
+
+	/*
+	 * WMT commands are answered by a vendor event alone, without the usual
+	 * command status or complete, which the event handler above looks for.
+	 */
+	err = wait_on_bit_timeout(&bdev->flags, BTMTKBEIF_WMT_WAIT,
+				  TASK_INTERRUPTIBLE, timeout);
+	if (err == -EINTR) {
+		bt_dev_err(hdev, "WMT command %#x interrupted", params->op);
+		clear_bit(BTMTKBEIF_WMT_WAIT, &bdev->flags);
+		goto out_free_wc;
+	}
+	if (err) {
+		bt_dev_err(hdev, "WMT command %#x timed out", params->op);
+		clear_bit(BTMTKBEIF_WMT_WAIT, &bdev->flags);
+		btmtkbeif_dump(bdev);
+		err = -ETIMEDOUT;
+		goto out_free_wc;
+	}
+
+	evt = xchg(&bdev->evt_skb, NULL);
+	if (!evt) {
+		err = test_bit(BTMTKBEIF_DEAD, &bdev->flags) ? -EIO : -ENOMEM;
+		goto out_free_wc;
+	}
+
+	wmt_evt = skb_pull_data(evt, sizeof(*wmt_evt));
+	if (!wmt_evt || wmt_evt->whdr.dir != BTMTKBEIF_WMT_DIR_CHIP ||
+	    wmt_evt->whdr.op != params->op || !wmt_evt->whdr.dlen ||
+	    le16_to_cpu(wmt_evt->whdr.dlen) - 1 > evt->len ||
+	    evt->len < rsp_len) {
+		bt_dev_err(hdev, "WMT command %#x: wrong event", params->op);
+		err = -EIO;
+		goto out_free_evt;
+	}
+
+	if (params->status)
+		*params->status = wmt_evt->whdr.flag;
+	if (rsp_len)
+		memcpy(rsp, evt->data, rsp_len);
+
+out_free_evt:
+	kfree_skb(evt);
+out_free_wc:
+	kfree(wc);
+
+	return err;
+}
+
+static int btmtkbeif_func_ctrl(struct hci_dev *hdev, u8 on)
+{
+	u32 status = U32_MAX;
+	struct btmtk_hci_wmt_params params = {
+		.op = BTMTK_WMT_FUNC_CTRL,
+		.flag = 0,
+		.dlen = sizeof(on),
+		.data = &on,
+		.status = &status,
+	};
+	int err;
+
+	/* This calibrates the radio on the way up, so it gets the long timeout */
+	err = btmtkbeif_wmt_sync(hdev, &params, HCI_INIT_TIMEOUT, NULL, 0);
+	if (err)
+		return err;
+
+	bt_dev_info(hdev, "WMT function %s: status %u", on ? "on" : "off", status);
+
+	return status ? -EIO : 0;
+}
+
+/*
+ * The result is not kept for the next time, but it is the only word on whether
+ * calibrating worked: the stock driver says it mostly does not with Wi-Fi off.
+ */
+static void btmtkbeif_log_calibration(struct hci_dev *hdev)
+{
+	struct btmtkbeif_wmt_cal_evt cal;
+	u32 status = U32_MAX;
+	struct btmtk_hci_wmt_params params = {
+		.op = BTMTKBEIF_WMT_RF_CAL,
+		.flag = BTMTKBEIF_WMT_RF_CAL_RESULT,
+		.status = &status,
+	};
+	int err;
+
+	err = btmtkbeif_wmt_sync(hdev, &params, BTMTKBEIF_WMT_TIMEOUT, &cal,
+				 sizeof(cal));
+	if (err) {
+		bt_dev_warn(hdev, "no word on the calibration: %d", err);
+		return;
+	}
+
+	bt_dev_info(hdev, "WMT calibration: status %u, sub %u, %u bytes", status,
+		    cal.subop, le16_to_cpu(cal.len));
+}
+
+static int btmtkbeif_setup(struct hci_dev *hdev)
+{
+	static const u8 ant_none[] = { 0, 0 };
+	struct timespec64 now;
+	__le32 utc[2];
+	u8 screen_on = 1;
+	struct btmtk_hci_wmt_params params = {
+		.op = BTMTKBEIF_WMT_ANT,
+		.flag = BTMTKBEIF_WMT_ANT_SWAP,
+		.dlen = sizeof(ant_none),
+		.data = ant_none,
+	};
+	int err;
+
+	/*
+	 * What the stock driver sends when its configuration file has no antenna
+	 * settings for this chip. It goes on if this fails.
+	 */
+	err = btmtkbeif_wmt_sync(hdev, &params, BTMTKBEIF_WMT_TIMEOUT, NULL, 0);
+	if (err)
+		bt_dev_warn(hdev, "can't set the antennas: %d", err);
+
+	err = btmtkbeif_func_ctrl(hdev, 1);
+	if (err) {
+		bt_dev_err(hdev, "can't turn the function on: %d", err);
+		return err;
+	}
+
+	/* Only for what it logs and how it scans, so these don't have to work */
+	ktime_get_real_ts64(&now);
+	utc[0] = cpu_to_le32(now.tv_sec);
+	utc[1] = cpu_to_le32(now.tv_nsec / NSEC_PER_USEC);
+	params = (struct btmtk_hci_wmt_params){
+		.op = BTMTKBEIF_WMT_MISC,
+		.flag = BTMTKBEIF_WMT_MISC_UTC,
+		.dlen = sizeof(utc),
+		.data = utc,
+	};
+	err = btmtkbeif_wmt_sync(hdev, &params, BTMTKBEIF_WMT_TIMEOUT, NULL, 0);
+	if (err)
+		bt_dev_warn(hdev, "can't set the time: %d", err);
+
+	params = (struct btmtk_hci_wmt_params){
+		.op = BTMTKBEIF_WMT_MISC,
+		.flag = BTMTKBEIF_WMT_MISC_BLANK,
+		.dlen = sizeof(screen_on),
+		.data = &screen_on,
+	};
+	err = btmtkbeif_wmt_sync(hdev, &params, BTMTKBEIF_WMT_TIMEOUT, NULL, 0);
+	if (err)
+		bt_dev_warn(hdev, "can't set the screen state: %d", err);
+
+	btmtkbeif_log_calibration(hdev);
+
+	return 0;
+}
+
+static int btmtkbeif_shutdown(struct hci_dev *hdev)
+{
+	struct btmtkbeif_dev *bdev = hci_get_drvdata(hdev);
+
+	if (test_bit(BTMTKBEIF_DEAD, &bdev->flags))
+		return 0;
+
+	return btmtkbeif_func_ctrl(hdev, 0);
+}
+
+/* Write a whole frame or nothing. The position in the ring is the firmware's to get wrong. */
+static int btmtkbeif_ring_write(struct btmtkbeif_dev *bdev, const void *data,
+				u32 len)
+{
+	unsigned long timeout = jiffies + msecs_to_jiffies(BEIF_TX_TIMEOUT_MS);
+	void __iomem *ring = bdev->ring;
+	u32 push = bdev->tx_push;
+	u32 pop, space, first;
+
+	if (len >= BEIF_BUF_SIZE)
+		return -EMSGSIZE;
+
+	for (;;) {
+		pop = readl(ring + BEIF_FW_CTRL + BEIF_CTRL_RX_POP);
+		if (pop >= BEIF_BUF_SIZE) {
+			bt_dev_err(bdev->hdev, "BEIF: to chip position %u", pop);
+			btmtkbeif_fatal(bdev, "BEIF: the firmware has lost its place");
+			return -EIO;
+		}
+
+		space = (pop + BEIF_BUF_SIZE - push - 1) % BEIF_BUF_SIZE;
+		if (space >= len)
+			break;
+
+		if (test_bit(BTMTKBEIF_DEAD, &bdev->flags))
+			return -EIO;
+
+		if (time_after(jiffies, timeout))
+			return -ETIMEDOUT;
+
+		usleep_range(100, 200);
+	}
+
+	first = min_t(u32, len, BEIF_BUF_SIZE - push);
+	memcpy_toio(ring + BEIF_H2C + push, data, first);
+	if (first < len)
+		memcpy_toio(ring + BEIF_H2C, data + first, len - first);
+
+	push = (push + len) % BEIF_BUF_SIZE;
+	bdev->tx_push = push;
+
+	/* This write is ordered after the data, and the read sees it through */
+	writel(push, ring + BEIF_HOST_CTRL + BEIF_CTRL_TX_PUSH);
+	readl(ring + BEIF_HOST_CTRL + BEIF_CTRL_TX_PUSH);
+
+	writel(CONN_BGF_MCUCIRQ_WAKE, bdev->conn + CONN_BGF_MCUCIRQ);
+
+	return 0;
+}
+
+static int btmtkbeif_tx(struct btmtkbeif_dev *bdev, const void *data, u32 len)
+{
+	int err;
+
+	if (!test_bit(BTMTKBEIF_RUNNING, &bdev->flags) ||
+	    test_bit(BTMTKBEIF_DEAD, &bdev->flags))
+		return -EIO;
+
+	/* After a system sleep it is the firmware's until there is something to do */
+	if (bdev->fw_owned) {
+		err = btmtkbeif_driver_own(bdev);
+		if (err) {
+			btmtkbeif_fatal(bdev, "BGF: it does not wake up");
+			return err;
+		}
+	}
+
+	err = btmtkbeif_ring_write(bdev, data, len);
+	if (err == -ETIMEDOUT) {
+		btmtkbeif_dump(bdev);
+		btmtkbeif_fatal(bdev, "BEIF: the firmware does not read");
+	}
+
+	return err;
+}
+
+static int btmtkbeif_send_frame(struct hci_dev *hdev, struct sk_buff *skb)
+{
+	struct btmtkbeif_dev *bdev = hci_get_drvdata(hdev);
+	u8 type = hci_skb_pkt_type(skb);
+	int err;
+
+	/* Prepend skb with frame type */
+	memcpy(skb_push(skb, 1), &type, 1);
+
+	mutex_lock(&bdev->tx_lock);
+	err = btmtkbeif_tx(bdev, skb->data, skb->len);
+	mutex_unlock(&bdev->tx_lock);
+
+	if (err) {
+		hdev->stat.err_tx++;
+		return err;
+	}
+
+	hdev->stat.byte_tx += skb->len;
+
+	switch (type) {
+	case HCI_COMMAND_PKT:
+		hdev->stat.cmd_tx++;
+		break;
+	case HCI_ACLDATA_PKT:
+		hdev->stat.acl_tx++;
+		break;
+	case HCI_SCODATA_PKT:
+		hdev->stat.sco_tx++;
+		break;
+	}
+
+	kfree_skb(skb);
+
+	return 0;
+}
+
+static void btmtkbeif_cmd_timeout(struct hci_dev *hdev)
+{
+	struct btmtkbeif_dev *bdev = hci_get_drvdata(hdev);
+
+	if (!test_bit(BTMTKBEIF_RUNNING, &bdev->flags))
+		return;
+
+	btmtkbeif_dump(bdev);
+	btmtkbeif_fatal(bdev, "BGF: a command timed out");
+}
+
+/*
+ * The stock driver never lets the system sleep while the MCU is the driver's. It
+ * gets the firmware's here if nothing is going on, and comes back when needed.
+ */
+static int btmtkbeif_suspend(struct device *dev)
+{
+	struct btmtkbeif_dev *bdev = dev_get_drvdata(dev);
+	void __iomem *fw = bdev->ring + BEIF_FW_CTRL;
+	int i;
+
+	mutex_lock(&bdev->tx_lock);
+
+	if (!test_bit(BTMTKBEIF_RUNNING, &bdev->flags) ||
+	    test_bit(BTMTKBEIF_DEAD, &bdev->flags) || bdev->fw_owned)
+		goto out;
+
+	/* A command being answered is not in the rings. It may take a while. */
+	for (i = 0; i < 5; i++) {
+		if (!test_bit(BTMTKBEIF_WMT_WAIT, &bdev->flags) &&
+		    readl(fw + BEIF_CTRL_RX_POP) == bdev->tx_push &&
+		    readl(fw + BEIF_CTRL_TX_PUSH) == bdev->rx_pop)
+			break;
+		usleep_range(1000, 1100);
+	}
+	if (i == 5) {
+		bt_dev_warn(bdev->hdev, "BGF: it is busy, not sleeping");
+		goto out;
+	}
+
+	if (btmtkbeif_fw_own(bdev))
+		btmtkbeif_fatal(bdev, "BGF: it does not go to sleep");
+out:
+	mutex_unlock(&bdev->tx_lock);
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(btmtkbeif_pm_ops, btmtkbeif_suspend, NULL);
+
+static int btmtkbeif_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct btmtkbeif_dev *bdev;
+	struct hci_dev *hdev;
+	phys_addr_t emi_addr;
+	struct resource *res;
+	u32 emi_size;
+	int i, ret;
+
+	bdev = devm_kzalloc(dev, sizeof(*bdev), GFP_KERNEL);
+	if (!bdev)
+		return -ENOMEM;
+
+	bdev->dev = dev;
+	spin_lock_init(&bdev->irq_lock);
+	bdev->irq_off[BTMTKBEIF_IRQ_SW] = true;
+	bdev->irq_off[BTMTKBEIF_IRQ_BUS_HANG] = true;
+
+	ret = devm_mutex_init(dev, &bdev->tx_lock);
+	if (ret)
+		return ret;
+
+	bdev->connsys = devm_mtk_connsys_get(dev);
+	if (IS_ERR(bdev->connsys))
+		return dev_err_probe(dev, PTR_ERR(bdev->connsys), "no connsys\n");
+
+	mtk_connsys_get_emi(bdev->connsys, &emi_addr, &emi_size);
+	if (emi_size < BT_EMI_WINDOW_OFS + BT_EMI_WINDOW_SIZE)
+		return dev_err_probe(dev, -EINVAL, "connsys memory of only %#x\n",
+				     emi_size);
+
+	/* Other radios map these too; nothing here claims them */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "bgf");
+	if (!res)
+		return dev_err_probe(dev, -EINVAL, "no bgf\n");
+	bdev->bgf = devm_ioremap(dev, res->start, resource_size(res));
+	if (!bdev->bgf)
+		return -ENOMEM;
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "conn");
+	if (!res)
+		return dev_err_probe(dev, -EINVAL, "no conn\n");
+	bdev->conn = devm_ioremap(dev, res->start, resource_size(res));
+	if (!bdev->conn)
+		return -ENOMEM;
+
+	/*
+	 * This memory is shared with a bus master that sees no cache. It fails
+	 * here if the bootloader left it to the kernel, in its linear map.
+	 */
+	bdev->emi = devm_ioremap(dev, emi_addr + BT_EMI_WINDOW_OFS,
+				 BT_EMI_WINDOW_SIZE);
+	if (!bdev->emi)
+		return dev_err_probe(dev, -ENOMEM, "can't map the rings\n");
+	bdev->ring = bdev->emi + BT_EMI_RING_OFS - BT_EMI_WINDOW_OFS;
+
+	bdev->rx_buf = devm_kmalloc(dev, BEIF_RX_CHUNK, GFP_KERNEL);
+	if (!bdev->rx_buf)
+		return -ENOMEM;
+
+	bdev->irq[BTMTKBEIF_IRQ_SW] = platform_get_irq_byname(pdev, "sw");
+	bdev->irq[BTMTKBEIF_IRQ_BUS_HANG] = platform_get_irq_byname(pdev, "bus-hang");
+	for (i = 0; i < BTMTKBEIF_NR_IRQS; i++)
+		if (bdev->irq[i] < 0)
+			return bdev->irq[i];
+
+	/* Level interrupts, which stay masked until their thread has run */
+	ret = devm_request_threaded_irq(dev, bdev->irq[BTMTKBEIF_IRQ_SW], NULL,
+					btmtkbeif_sw_irq,
+					IRQF_ONESHOT | IRQF_NO_AUTOEN,
+					"btmtkbeif-sw", bdev);
+	if (ret)
+		return ret;
+
+	ret = devm_request_threaded_irq(dev, bdev->irq[BTMTKBEIF_IRQ_BUS_HANG],
+					NULL, btmtkbeif_bus_hang_irq,
+					IRQF_ONESHOT | IRQF_NO_AUTOEN,
+					"btmtkbeif-bus-hang", bdev);
+	if (ret)
+		return ret;
+
+	hdev = hci_alloc_dev();
+	if (!hdev)
+		return -ENOMEM;
+
+	bdev->hdev = hdev;
+	bdev->hu.hdev = hdev;
+	hci_set_drvdata(hdev, bdev);
+
+	hdev->bus = HCI_UART;
+	hdev->manufacturer = 70;
+	hdev->open = btmtkbeif_open;
+	hdev->close = btmtkbeif_close;
+	hdev->setup = btmtkbeif_setup;
+	hdev->shutdown = btmtkbeif_shutdown;
+	hdev->send = btmtkbeif_send_frame;
+	hdev->reset = btmtkbeif_cmd_timeout;
+	hdev->set_bdaddr = btmtk_set_bdaddr;
+
+	/* Every open starts the MCU again from its ROM */
+	hci_set_quirk(hdev, HCI_QUIRK_NON_PERSISTENT_SETUP);
+
+	/*
+	 * Which forgets the address too. The device has it on storage for the
+	 * system to give to the stack, which sets it again at every open.
+	 */
+	hci_set_quirk(hdev, HCI_QUIRK_USE_BDADDR_PROPERTY);
+
+	SET_HCIDEV_DEV(hdev, dev);
+	platform_set_drvdata(pdev, bdev);
+
+	ret = hci_register_dev(hdev);
+	if (ret < 0) {
+		dev_err(dev, "can't register the HCI device: %d\n", ret);
+		hci_free_dev(hdev);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void btmtkbeif_remove(struct platform_device *pdev)
+{
+	struct btmtkbeif_dev *bdev = platform_get_drvdata(pdev);
+
+	hci_unregister_dev(bdev->hdev);
+	hci_free_dev(bdev->hdev);
+}
+
+static const struct of_device_id btmtkbeif_of_match[] = {
+	{ .compatible = "mediatek,mt6897-bluetooth" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, btmtkbeif_of_match);
+
+static struct platform_driver btmtkbeif_driver = {
+	.probe = btmtkbeif_probe,
+	.remove = btmtkbeif_remove,
+	.driver = {
+		.name = "btmtkbeif",
+		.of_match_table = btmtkbeif_of_match,
+		.pm = pm_sleep_ptr(&btmtkbeif_pm_ops),
+	},
+};
+module_platform_driver(btmtkbeif_driver);
+
+MODULE_DESCRIPTION("MediaTek shared memory HCI transport driver");
+MODULE_LICENSE("GPL");
