+static u8 mt7921_soc_phy_types(enum nl80211_band band, struct ieee80211_sta *sta)
+{
+	u8 types = band == NL80211_BAND_2GHZ ?
+		   BIT(MT7921_SOC_PHY_HR_DSSS) | BIT(MT7921_SOC_PHY_ERP) :
+		   BIT(MT7921_SOC_PHY_OFDM);
+
+	if (!sta)
+		return types;
+
+	if (sta->deflink.ht_cap.ht_supported)
+		types |= BIT(MT7921_SOC_PHY_HT);
+	if (sta->deflink.vht_cap.vht_supported)
+		types |= BIT(MT7921_SOC_PHY_VHT);
+	if (sta->deflink.he_cap.has_he)
+		types |= BIT(MT7921_SOC_PHY_HE);
+
+	return types;
+}
