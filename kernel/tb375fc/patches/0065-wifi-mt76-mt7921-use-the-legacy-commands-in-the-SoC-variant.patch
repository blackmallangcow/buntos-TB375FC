+static void mt7921_soc_queue_rx_skb(struct mt76_dev *mdev, enum mt76_rxq_id q,
+				    struct sk_buff *skb, u32 *info)
+{
+	struct mt792x_dev *dev = container_of(mdev, struct mt792x_dev, mt76);
+	__le32 *rxd = (__le32 *)skb->data;
+
+	if (le32_get_bits(rxd[0], MT_RXD0_PKT_TYPE) == PKT_TYPE_RX_EVENT &&
+	    le32_get_bits(rxd[0], MT_RXD0_PKT_FLAG) != 0x1) {
+		if (mt7921_soc_rx_event(dev, skb))
+			return;
+	} else if (le32_get_bits(rxd[0], MT_RXD0_PKT_TYPE) == PKT_TYPE_NORMAL ||
+		   le32_get_bits(rxd[0], MT_RXD0_PKT_TYPE) == PKT_TYPE_RX_EVENT) {
+		/*
+		 * Of the frames of a scan, those on the 5 GHz channels have 1
+		 * here, with one band or two. There is one phy here, and the
+		 * channel in the descriptor says all it needs to know.
+		 */
+		rxd[1] &= ~cpu_to_le32(MT_RXD1_NORMAL_BAND_IDX);
+
+		/* mac80211 would drop it: mt7921_soc_rx_hdr_trans_off() failed */
+		if (rxd[2] & cpu_to_le32(MT_RXD2_NORMAL_HDR_TRANS))
+			dev_warn_once(mdev->dev,
+				      "a frame with its header translated\n");
+	}
+
+	mt7921_queue_rx_skb(mdev, q, skb, info);
+}
