+/* In the order of the firmware's bits, in units of 100 kb/s */
+static u16 mt7921_soc_rate_set(struct ieee80211_supported_band *sband,
+			       unsigned long bitmap)
+{
+	static const u16 rates[] = {
+		10, 20, 55, 110, 220, 330, 60, 90, 120, 180, 240, 360, 480, 540,
+	};
+	u16 set = 0;
+	int i, j;
+
+	if (!sband)
+		return 0;
+
+	for_each_set_bit(i, &bitmap, sband->n_bitrates) {
+		for (j = 0; j < ARRAY_SIZE(rates); j++) {
+			if (sband->bitrates[i].bitrate == rates[j]) {
+				set |= BIT(j);
+				break;
+			}
+		}
+	}
+
+	return set;
+}
