+void mt7921_soc_set_ops(struct ieee80211_ops *ops)
+{
+	ops->config = mt7921_soc_config;
+	ops->configure_filter = mt7921_soc_configure_filter;
+	ops->bss_info_changed = mt7921_soc_bss_info_changed;
+	ops->change_chanctx = mt7921_soc_change_chanctx;
+	ops->ampdu_action = mt7921_soc_ampdu_action;
+	ops->remain_on_channel = NULL;
+	ops->cancel_remain_on_channel = NULL;
+
+	/* Unified commands, and a station gets by without them */
+	ops->start_ap = NULL;
+	ops->stop_ap = NULL;
+	ops->channel_switch_beacon = NULL;
+	ops->pre_channel_switch = NULL;
+	ops->channel_switch = NULL;
+	ops->abort_channel_switch = NULL;
+	ops->channel_switch_rx_beacon = NULL;
+	ops->sched_scan_start = NULL;
+	ops->sched_scan_stop = NULL;
+	ops->sta_set_decap_offload = NULL;
+#if IS_ENABLED(CONFIG_IPV6)
+	ops->ipv6_addr_change = NULL;
+#endif
+#ifdef CONFIG_PM
+	ops->suspend = NULL;
+	ops->resume = NULL;
+	ops->set_wakeup = NULL;
+	ops->set_rekey_data = NULL;
+#endif
+}
