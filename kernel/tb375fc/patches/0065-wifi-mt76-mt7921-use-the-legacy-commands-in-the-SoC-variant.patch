+/**
+ * mt7921_soc_limit_wiphy() - Take away what the firmware commands can't do
+ * @dev: the device
+ *
+ * This runs before the wiphy is registered, and again after each restart.
+ */
+void mt7921_soc_limit_wiphy(struct mt792x_dev *dev)
+{
+	struct ieee80211_hw *hw = mt76_hw(dev);
+	struct wiphy *wiphy = hw->wiphy;
+
+	if (dev->hw_init_done)
+		return;
+
+	wiphy->interface_modes = BIT(NL80211_IFTYPE_STATION);
+	wiphy->iface_combinations = NULL;
+	wiphy->n_iface_combinations = 0;
+	wiphy->flags &= ~WIPHY_FLAG_HAS_REMAIN_ON_CHANNEL;
+	wiphy->max_sched_scan_reqs = 0;
+
+	/* What these need in the station's table entry is set by a TLV */
+	__clear_bit(IEEE80211_HW_SUPPORTS_TX_ENCAP_OFFLOAD, hw->flags);
+	__clear_bit(IEEE80211_HW_SUPPORTS_RX_DECAP_OFFLOAD, hw->flags);
+}
