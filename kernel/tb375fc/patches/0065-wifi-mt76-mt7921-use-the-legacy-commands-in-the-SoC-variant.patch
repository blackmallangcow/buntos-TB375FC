diff --git a/drivers/net/wireless/mediatek/mt76/mt7921/soc_main.c b/drivers/net/wireless/mediatek/mt76/mt7921/soc_main.c
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt7921/soc_main.c
@@ -0,0 +1,310 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * The mac80211 side of the MT7921 on the MT6897 SoC bus.
+ *
+ * The firmware does not answer the unified commands that mt7921_ops sends for
+ * interfaces, stations, keys and channels. It takes the legacy commands of the
+ * vendor driver instead, so those operations have their own form here.
+ */
+
+#include "mt7921.h"
+#include "soc.h"
+#include "../mt76_connac2_mac.h"
+
+/* Numbers of the events that only this firmware sends */
+#define MT7921_SOC_EVENT_RX_ADDBA	0x0a
+#define MT7921_SOC_EVENT_RX_DELBA	0x0b
+
+static void mt7921_soc_roc_event(struct mt792x_dev *dev, struct sk_buff *skb)
+{
+	struct {
+		u8 bss_idx;
+		u8 token;
+		u8 status;
+		u8 chan;
+		u8 sco;
+		u8 band;
+		u8 width;
+		u8 center1;
+		u8 center2;
+		u8 req_type;
+		u8 dbdc_band;
+		u8 rsv0;
+		__le32 grant_interval;
+		u8 rsv1[8];
+	} __packed *event;
+
+	skb_pull(skb, sizeof(struct mt76_connac2_mcu_rxd));
+	event = (void *)skb->data;
+	if (skb->len < sizeof(*event))
+		return;
+
+	/* Nothing to do but let the wait for a grant run out */
+	if (event->status) {
+		dev_warn(dev->mt76.dev, "channel refused: %u\n", event->status);
+		return;
+	}
+
+	if (event->req_type == MT7921_ROC_REQ_ROC)
+		ieee80211_ready_on_channel(dev->mt76.phy.hw);
+
+	dev->phy.roc_grant = true;
+	wake_up(&dev->phy.roc_wait);
+	mod_timer(&dev->phy.roc_timer,
+		  jiffies +
+		  msecs_to_jiffies(le32_to_cpu(event->grant_interval)));
+}
+
+/**
+ * mt7921_soc_ba_work() - Follow what the firmware decided on block ack
+ * @work: the work
+ *
+ * It answers the access point's requests itself, and leaves the reordering to
+ * the host. Setting that up takes memory, so it can't be done in NAPI.
+ */
+void mt7921_soc_ba_work(struct work_struct *work)
+{
+	struct mt7921_soc *soc = container_of(work, struct mt7921_soc, ba_work);
+	struct mt792x_dev *dev = &soc->dev;
+	struct sk_buff *skb;
+
+	while ((skb = skb_dequeue(&soc->ba_events))) {
+		struct mt76_connac2_mcu_rxd *rxd = (void *)skb->data;
+		struct {
+			u8 sta_idx;
+			u8 token;
+			__le16 params;
+			__le16 timeout;
+			__le16 ssn;
+		} __packed *add = (void *)rxd->tlv;
+		struct {
+			u8 sta_idx;
+			u8 tid;
+			u8 rsv[2];
+		} __packed *del = (void *)rxd->tlv;
+		struct mt76_wcid *wcid;
+
+		if (rxd->eid == MT7921_SOC_EVENT_RX_ADDBA &&
+		    skb->len >= sizeof(*rxd) + sizeof(*add)) {
+			u16 params = le16_to_cpu(add->params);
+			u16 size = u16_get_bits(params,
+						IEEE80211_ADDBA_PARAM_BUF_SIZE_MASK);
+			u16 tid = u16_get_bits(params,
+					       IEEE80211_ADDBA_PARAM_TID_MASK);
+
+			mt792x_mutex_acquire(dev);
+			wcid = mt76_wcid_ptr(dev, add->sta_idx);
+			if (wcid && tid < IEEE80211_NUM_TIDS)
+				mt76_rx_aggr_start(&dev->mt76, wcid, tid,
+						   le16_to_cpu(add->ssn) >> 4,
+						   size ?: IEEE80211_MAX_AMPDU_BUF_HT);
+			mt792x_mutex_release(dev);
+		} else if (rxd->eid == MT7921_SOC_EVENT_RX_DELBA &&
+			   skb->len >= sizeof(*rxd) + sizeof(*del)) {
+			mt792x_mutex_acquire(dev);
+			wcid = mt76_wcid_ptr(dev, del->sta_idx);
+			if (wcid && del->tid < IEEE80211_NUM_TIDS)
+				mt76_rx_aggr_stop(&dev->mt76, wcid, del->tid);
+			mt792x_mutex_release(dev);
+		}
+		dev_kfree_skb(skb);
+	}
+}
+
+/**
+ * mt7921_soc_rx_event() - Take the events that the common code doesn't know
+ * @dev: the device
+ * @skb: the event
+ *
+ * Return: whether it was one of those
+ */
+bool mt7921_soc_rx_event(struct mt792x_dev *dev, struct sk_buff *skb)
+{
+	struct mt7921_soc *soc = mt7921_soc_of(dev);
+	struct mt76_connac2_mcu_rxd *rxd = (void *)skb->data;
+
+	switch (rxd->eid) {
+	case MCU_EVENT_ROC:
+		mt7921_soc_roc_event(dev, skb);
+		dev_kfree_skb(skb);
+		return true;
+	case MT7921_SOC_EVENT_RX_ADDBA:
+	case MT7921_SOC_EVENT_RX_DELBA:
+		skb_queue_tail(&soc->ba_events, skb);
+		ieee80211_queue_work(mt76_hw(dev), &soc->ba_work);
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* Monitor mode takes unified commands, so here it doesn't exist */
+static int mt7921_soc_config(struct ieee80211_hw *hw, int radio_idx, u32 changed)
+{
+	struct mt792x_dev *dev = mt792x_hw_dev(hw);
+	int ret = 0;
+
+	if (!(changed & IEEE80211_CONF_CHANGE_POWER))
+		return 0;
+
+	mt792x_mutex_acquire(dev);
+	ret = mt7921_set_tx_sar_pwr(hw, NULL);
+	mt792x_mutex_release(dev);
+
+	return ret;
+}
+
+/* The vendor's PARAM_PACKET_FILTER_* */
+#define MT7921_SOC_RX_DIRECTED		BIT(0)
+#define MT7921_SOC_RX_ALL_MULTICAST	BIT(2)
+#define MT7921_SOC_RX_BROADCAST		BIT(3)
+
+/*
+ * The first four bytes of this command are the filter here, where mt7921 sends
+ * zeros and has a mode after that. A station needs no more than these.
+ */
+static void mt7921_soc_configure_filter(struct ieee80211_hw *hw,
+					unsigned int changed_flags,
+					unsigned int *total_flags,
+					u64 multicast)
+{
+	struct mt792x_dev *dev = mt792x_hw_dev(hw);
+
+	mt792x_mutex_acquire(dev);
+	mt7921_soc_mcu_set_rx_filter(dev, MT7921_SOC_RX_DIRECTED |
+				     MT7921_SOC_RX_ALL_MULTICAST |
+				     MT7921_SOC_RX_BROADCAST);
+	mt792x_mutex_release(dev);
+
+	*total_flags = 0;
+}
+
+static void mt7921_soc_bss_info_changed(struct ieee80211_hw *hw,
+					struct ieee80211_vif *vif,
+					struct ieee80211_bss_conf *info,
+					u64 changed)
+{
+	struct mt792x_phy *phy = mt792x_hw_phy(hw);
+	struct mt792x_dev *dev = mt792x_hw_dev(hw);
+
+	mt792x_mutex_acquire(dev);
+
+	if (changed & BSS_CHANGED_ERP_SLOT) {
+		int slottime = info->use_short_slot ? 9 : 20;
+
+		if (slottime != phy->slottime) {
+			phy->slottime = slottime;
+			mt792x_mac_set_timeing(phy);
+		}
+	}
+
+	if (changed & BSS_CHANGED_QOS)
+		mt7921_mcu_set_tx(dev, vif);
+
+	/* The firmware keeps the protection and the rates that go in here */
+	if (vif->cfg.assoc &&
+	    (changed & (BSS_CHANGED_ASSOC | BSS_CHANGED_ERP_CTS_PROT |
+			BSS_CHANGED_ERP_PREAMBLE | BSS_CHANGED_ERP_SLOT |
+			BSS_CHANGED_HT | BSS_CHANGED_BASIC_RATES |
+			BSS_CHANGED_BANDWIDTH)))
+		mt7921_soc_mcu_set_bss(dev, vif, true);
+
+	if (changed & BSS_CHANGED_ASSOC)
+		mt7921_mcu_set_bss_pm(dev, vif, vif->cfg.assoc);
+
+	mt792x_mutex_release(dev);
+}
+
+static void mt7921_soc_change_chanctx(struct ieee80211_hw *hw,
+				      struct ieee80211_chanctx_conf *ctx,
+				      u32 changed)
+{
+	struct mt792x_chanctx *mctx = (struct mt792x_chanctx *)ctx->drv_priv;
+	struct mt792x_dev *dev = mt792x_hw_dev(hw);
+	struct ieee80211_vif *vif;
+	struct mt792x_vif *mvif;
+
+	if (!mctx->bss_conf)
+		return;
+
+	mvif = container_of(mctx->bss_conf, struct mt792x_vif, bss_conf);
+	vif = container_of((void *)mvif, struct ieee80211_vif, drv_priv);
+
+	mt792x_mutex_acquire(dev);
+	if (vif->cfg.assoc)
+		mt7921_soc_mcu_set_bss(dev, vif, true);
+	mt792x_mutex_release(dev);
