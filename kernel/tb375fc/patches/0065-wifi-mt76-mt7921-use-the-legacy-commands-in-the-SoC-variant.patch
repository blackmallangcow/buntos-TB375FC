+	struct ieee80211_bss_conf *conf = &vif->bss_conf;
+	enum nl80211_band band = mt7921_soc_vif_band(dev, mvif);
+	struct ieee80211_supported_band *sband;
+	struct ieee80211_sta *sta = NULL;
+	struct mt7921_soc_bss_info req = {
+		.bss_idx = mvif->bss_conf.mt76.idx,
+		.conn_state = connected ? MT7921_SOC_MEDIA_CONNECTED :
+					  MT7921_SOC_MEDIA_DISCONNECTED,
+		.op_mode = MT7921_SOC_OP_MODE_INFRA,
+		.ap_sta_idx = MT7921_SOC_STA_NONE,
+		.auth_mode = MT7921_SOC_AUTH_OPEN,
+		.enc_status = MT7921_SOC_ENC_DISABLED,
+		.bmc_wlan_idx = mvif->sta.deflink.wcid.idx,
+		.dbdc_band = MT7921_SOC_DBDC_AUTO,
+		.wmm_idx = mvif->bss_conf.mt76.wmm_idx,
+		.nss = hweight8(dev->mphy.antenna_mask),
+	};
+	u16 basic_rates, rates;
+
+	BUILD_BUG_ON(sizeof(struct mt7921_soc_bss_rlm) != 22);
+	BUILD_BUG_ON(sizeof(req) != 116);
+
+	sband = dev->mt76.hw->wiphy->bands[band];
+	basic_rates = mt7921_soc_rate_set(sband, conf->basic_rates);
+	mt7921_soc_fill_rlm(dev, vif, &req.rlm, basic_rates);
+
+	req.basic_rates = cpu_to_le16(basic_rates);
+	req.fixed_rate = cpu_to_le16(band == NL80211_BAND_2GHZ ?
+				     MT7921_SOC_RATE_CCK_1M :
+				     MT7921_SOC_RATE_OFDM_6M);
+	req.non_ht_phy = band == NL80211_BAND_2GHZ ? MT7921_SOC_PHY_ERP :
+						     MT7921_SOC_PHY_OFDM;
+	req.phy_types = mt7921_soc_phy_types(band, NULL);
+
+	if (!connected)
+		return mt76_mcu_send_msg(&dev->mt76, MT7921_SOC_CMD_BSS_INFO,
+					 &req, sizeof(req), false);
+
+	rcu_read_lock();
+	if (mvif->wep_sta)
+		sta = container_of((void *)mvif->wep_sta, struct ieee80211_sta,
+				   drv_priv);
+	if (sta) {
+		req.ap_sta_idx = mvif->wep_sta->deflink.wcid.idx;
+		req.phy_types = mt7921_soc_phy_types(band, sta);
+		rates = mt7921_soc_rate_set(sband, sta->deflink.supp_rates[band]);
+		req.op_rates = cpu_to_le16(rates);
+	}
+	rcu_read_unlock();
+
+	req.ssid_len = min_t(size_t, vif->cfg.ssid_len, sizeof(req.ssid));
+	memcpy(req.ssid, vif->cfg.ssid, req.ssid_len);
+	if (conf->bssid)
+		ether_addr_copy(req.bssid, conf->bssid);
+	req.is_qbss = conf->qos;
+
+	/*
+	 * Which of the keys isn't said anywhere in mac80211 before the keys
+	 * come. What counts is only encrypted or not, as far as can be seen.
+	 */
+	if (conf->assoc_capability & WLAN_CAPABILITY_PRIVACY) {
+		req.auth_mode = MT7921_SOC_AUTH_WPA2_PSK;
+		req.enc_status = MT7921_SOC_ENC_CCMP;
+	}
+
+	if (conf->he_support) {
+		u32 params = le32_to_cpu(conf->he_oper.params);
+
+		req.he_op[0] = params;
+		req.he_op[1] = params >> 8;
+		req.he_op[2] = params >> 16;
+		req.bss_color = conf->he_bss_color.color;
+		if (!conf->he_bss_color.enabled)
+			req.bss_color |= BIT(7);
+		req.he_basic_mcs = cpu_to_le16(conf->he_oper.nss_set);
+	}
+	req.max_bssid_indicator = conf->bssid_indicator;
+	req.mbssid_idx = conf->bssid_index;
+
+	return mt76_mcu_send_msg(&dev->mt76, MT7921_SOC_CMD_BSS_INFO, &req,
+				 sizeof(req), false);
+}
+
+/**
+ * mt7921_soc_mcu_add_dev() - Tell the firmware about an interface
+ * @dev: the device
+ * @vif: the interface
+ * @enable: whether it comes or goes
+ *
+ * Return: 0 or a negative error code
+ */
+int mt7921_soc_mcu_add_dev(struct mt792x_dev *dev, struct ieee80211_vif *vif,
+			   bool enable)
+{
+	struct mt792x_vif *mvif = (struct mt792x_vif *)vif->drv_priv;
+	struct {
+		u8 bss_idx;
+		u8 active;
+		u8 network_type;
+		u8 omac_idx;
+		u8 addr[ETH_ALEN];
+		u8 bmc_wlan_idx;
+		u8 link_idx;
+	} __packed req = {
+		.bss_idx = mvif->bss_conf.mt76.idx,
+		.active = enable,
+		.omac_idx = mvif->bss_conf.mt76.omac_idx,
+		/* The common code hasn't set the index in the wcid yet */
+		.bmc_wlan_idx = MT792x_WTBL_RESERVED - mvif->bss_conf.mt76.idx,
+	};
+
+	ether_addr_copy(req.addr, vif->addr);
+
+	return mt76_mcu_send_msg(&dev->mt76, MT7921_SOC_CMD_BSS_ACTIVATE, &req,
+				 sizeof(req), false);
+}
+
+static int mt7921_soc_mcu_sta_remove(struct mt792x_dev *dev,
+				     struct mt792x_vif *mvif,
+				     struct mt76_wcid *wcid)
+{
+	struct {
+		u8 action;
+		u8 sta_idx;
+		u8 bss_idx;
+		u8 rsv;
+	} __packed req = {
+		.sta_idx = wcid->idx,
+		.bss_idx = mvif->bss_conf.mt76.idx,
+	};
+
+	return mt76_mcu_send_msg(&dev->mt76, MT7921_SOC_CMD_STA_REMOVE, &req,
+				 sizeof(req), false);
+}
+
+/**
+ * mt7921_soc_mcu_sta_update() - Tell the firmware about the access point
+ * @dev: the device
+ * @sta: the station, or NULL for the interface itself
+ * @vif: the interface
+ * @enable: whether it comes or goes
+ * @state: how far the connection is
+ *
+ * The firmware is told about the start and the end of a connection, the rest it
+ * has no use for. The vendor driver doesn't wait for anything but state 3.
+ *
+ * Return: 0 or a negative error code
+ */
+int mt7921_soc_mcu_sta_update(struct mt792x_dev *dev, struct ieee80211_sta *sta,
+			      struct ieee80211_vif *vif, bool enable,
+			      enum mt76_sta_info_state state)
+{
+	struct mt792x_vif *mvif = (struct mt792x_vif *)vif->drv_priv;
+	enum nl80211_band band = mt7921_soc_vif_band(dev, mvif);
+	struct ieee80211_sta_ht_cap *ht;
+	struct ieee80211_sta_vht_cap *vht;
+	struct ieee80211_sta_he_cap *he;
+	struct ieee80211_supported_band *sband;
+	struct mt7921_soc_sta_rec *req;
+	struct mt792x_sta *msta;
+	bool assoc = state == MT76_STA_INFO_STATE_ASSOC;
+	int rssi, ret;
+	u16 rates;
+
+	BUILD_BUG_ON(sizeof(*req) != 200);
+	BUILD_BUG_ON(offsetof(struct mt7921_soc_sta_rec, fixed_phy_rate) != 80);
+	BUILD_BUG_ON(offsetof(struct mt7921_soc_sta_rec, tx_amsdu_in_ampdu) !=
+		     128);
+	BUILD_BUG_ON(offsetof(struct mt7921_soc_sta_rec, he_rx_mcs_80) != 156);
+
+	/* It has no such record for the interface */
+	if (!sta)
+		return 0;
+
+	/* mt76_phy_init() says TDLS is there, and this only knows access points */
+	if (sta->tdls)
+		return -EOPNOTSUPP;
+
+	msta = (struct mt792x_sta *)sta->drv_priv;
+	if (!enable)
+		return mt7921_soc_mcu_sta_remove(dev, mvif,
+						 &msta->deflink.wcid);
+
+	req = kzalloc_obj(*req, GFP_KERNEL);
+	if (!req)
+		return -ENOMEM;
+
+	ht = &sta->deflink.ht_cap;
+	vht = &sta->deflink.vht_cap;
+	he = &sta->deflink.he_cap;
+	sband = dev->mt76.hw->wiphy->bands[band];
+	rssi = -ewma_rssi_read(&mvif->bss_conf.rssi);
+
+	req->sta_idx = msta->deflink.wcid.idx;
+	req->wlan_idx = msta->deflink.wcid.idx;
+	req->bmc_wlan_idx = 0xff;
+	req->sta_type = MT7921_SOC_STA_TYPE_LEGACY_AP;
+	ether_addr_copy(req->addr, sta->addr);
+	req->aid = cpu_to_le16(vif->cfg.aid);
+	req->listen_interval = cpu_to_le16(dev->mt76.hw->conf.listen_interval);
+	req->bss_idx = mvif->bss_conf.mt76.idx;
+	req->phy_types = mt7921_soc_phy_types(band, sta);
+	rates = mt7921_soc_rate_set(sband, sta->deflink.supp_rates[band]);
+	req->op_rates = cpu_to_le16(rates);
+	rates = mt7921_soc_rate_set(sband, vif->bss_conf.basic_rates);
+	req->basic_rates = cpu_to_le16(rates);
+	req->qos = sta->wme;
+	req->state = assoc ? MT7921_SOC_STA_STATE_3 : MT7921_SOC_STA_STATE_1;
+	req->version = MT7921_SOC_STA_VERSION_HE;
+	req->rcpi = to_rcpi(rssi);
+	req->need_resp = assoc;
+	req->rts_policy = MT7921_SOC_RTS_LEGACY;
+	req->fixed_rate = cpu_to_le16(band == NL80211_BAND_2GHZ ?
+				      MT7921_SOC_RATE_CCK_1M :
+				      MT7921_SOC_RATE_OFDM_6M);
+	req->tx_ampdu = 1;
+	req->rx_ampdu = 1;
+	req->rx_amsdu_in_ampdu = 1;
+	/* No access to the beamforming memory */
+	req->pfmu_id = cpu_to_le16(0xffff);
+
+	if (he->has_he) {
+		req->ba.he.tx = cpu_to_le16(MT7921_SOC_BA_HE);
+		req->ba.he.rx = cpu_to_le16(MT7921_SOC_BA_HE);
+		memcpy(req->he_mac_cap, he->he_cap_elem.mac_cap_info,
+		       sizeof(req->he_mac_cap));
+		memcpy(req->he_phy_cap, he->he_cap_elem.phy_cap_info,
+		       sizeof(req->he_phy_cap));
+		req->he_rx_mcs_80 = he->he_mcs_nss_supp.rx_mcs_80;
+		req->he_tx_mcs_80 = he->he_mcs_nss_supp.tx_mcs_80;
+		req->he_rx_mcs_160 = he->he_mcs_nss_supp.rx_mcs_160;
+		req->he_tx_mcs_160 = he->he_mcs_nss_supp.tx_mcs_160;
+		req->he_rx_mcs_80p80 = he->he_mcs_nss_supp.rx_mcs_80p80;
+		req->he_tx_mcs_80p80 = he->he_mcs_nss_supp.tx_mcs_80p80;
+		req->he_6g_cap = sta->deflink.he_6ghz_capa.capa;
+	} else {
+		req->ba.ht.tx = MT7921_SOC_BA_LEGACY;
+		req->ba.ht.rx = MT7921_SOC_BA_LEGACY;
+	}
+
+	if (ht->ht_supported) {
+		req->mcs_set = ht->mcs.rx_mask[0];
+		req->mcs32 = ht->mcs.rx_mask[4] & BIT(0);
+		memcpy(req->rx_mcs, ht->mcs.rx_mask, sizeof(req->rx_mcs));
+		req->rx_highest = ht->mcs.rx_highest;
+		req->tx_rate_info = cpu_to_le32(ht->mcs.tx_params);
+		req->ht_cap = cpu_to_le16(ht->cap);
+		req->ampdu_param = ht->ampdu_factor | ht->ampdu_density << 2;
+	}
+
+	if (vht->vht_supported) {
+		req->vht_cap = cpu_to_le32(vht->cap);
+		req->vht_rx_mcs = vht->vht_mcs.rx_mcs_map;
+		req->vht_rx_highest = vht->vht_mcs.rx_highest;
+		req->vht_tx_mcs = vht->vht_mcs.tx_mcs_map;
+		req->vht_tx_highest = vht->vht_mcs.tx_highest;
+	}
+
+	ret = mt76_mcu_send_msg(&dev->mt76, MT7921_SOC_CMD_STA_UPDATE, req,
+				sizeof(*req), assoc);
+	kfree(req);
+
+	return ret;
+}
+
+/**
+ * mt7921_soc_mcu_add_key() - Give the firmware a key
+ * @dev: the device
+ * @vif: the interface
+ * @wcid: the entry of the station, or of the interface for a group key
+ * @key: the key
+ * @cmd: whether it comes or goes
+ *
+ * The group keys of one BSS each have an entry of their own in the vendor
+ * driver, with the access point's address.
+ *
+ * Return: 0 or a negative error code
+ */
+int mt7921_soc_mcu_add_key(struct mt792x_dev *dev, struct ieee80211_vif *vif,
+			   struct mt76_wcid *wcid,
+			   struct ieee80211_key_conf *key, enum set_key_cmd cmd)
+{
+	struct mt792x_vif *mvif = (struct mt792x_vif *)vif->drv_priv;
+	bool pairwise = key->flags & IEEE80211_KEY_FLAG_PAIRWISE;
+	struct ieee80211_sta *sta;
+	struct mt7921_soc_key req = {
+		.add = cmd == SET_KEY,
+		.tx_key = pairwise,
+		.pairwise = pairwise,
+		.bss_idx = mvif->bss_conf.mt76.idx,
+		.key_id = key->keyidx,
+		.key_len = key->keylen,
+		.wlan_idx = pairwise ? wcid->idx :
+			    MT792x_WTBL_RESERVED - key->keyidx,
+	};
+
+	if (vif->type != NL80211_IFTYPE_STATION)
+		return -EOPNOTSUPP;
+
+	switch (key->cipher) {
+	case WLAN_CIPHER_SUITE_TKIP:
+		req.cipher = MT7921_SOC_CIPHER_TKIP;
+		break;
+	case WLAN_CIPHER_SUITE_CCMP:
+		req.cipher = MT7921_SOC_CIPHER_CCMP;
+		break;
+	case WLAN_CIPHER_SUITE_CCMP_256:
+		req.cipher = MT7921_SOC_CIPHER_CCMP_256;
+		break;
+	case WLAN_CIPHER_SUITE_GCMP:
+		req.cipher = MT7921_SOC_CIPHER_GCMP;
+		break;
+	case WLAN_CIPHER_SUITE_GCMP_256:
+		req.cipher = MT7921_SOC_CIPHER_GCMP_256;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	if (key->keylen > sizeof(req.key) || key->keyidx > 3)
+		return -EOPNOTSUPP;
+
+	if (vif->bss_conf.bssid)
+		ether_addr_copy(req.peer, vif->bss_conf.bssid);
+
+	rcu_read_lock();
+	sta = wcid_to_sta(wcid);
+	req.mgmt_protection = sta && sta->mfp;
+	rcu_read_unlock();
+
+	if (cmd == SET_KEY) {
+		memcpy(req.key, key->key, key->keylen);
+		/* The firmware has these the other way around */
+		if (key->cipher == WLAN_CIPHER_SUITE_TKIP) {
+			memcpy(req.key + 16, key->key + 24, 8);
+			memcpy(req.key + 24, key->key + 16, 8);
+		}
+	}
+
+	return mt76_mcu_send_msg(&dev->mt76, MT7921_SOC_CMD_KEY, &req,
+				 sizeof(req), false);
+}
+
+/**
+ * mt7921_soc_mcu_set_roc() - Ask the firmware for time on a channel
+ * @phy: the phy
+ * @vif: the interface
+ * @chan: the channel
+ * @duration: how long, in ms
+ * @type: what for, numbered the same as in the firmware
+ * @token_id: what the answer has to carry
+ *
+ * Return: 0 or a negative error code
+ */
+int mt7921_soc_mcu_set_roc(struct mt792x_phy *phy, struct mt792x_vif *vif,
+			   struct ieee80211_channel *chan, int duration, u8 type,
+			   u8 token_id)
+{
+	struct mt7921_soc_ch_privilege req = {
+		.bss_idx = vif->bss_conf.mt76.idx,
+		.token = token_id,
+		.action = MT7921_SOC_CH_REQ,
+		.chan = chan->hw_value,
+		.band = mt7921_soc_band(chan->band),
+		.width = MT7921_SOC_CW_20_40,
+		.req_type = type,
+		.dbdc_band = MT7921_SOC_DBDC_AUTO,
+		.max_interval = cpu_to_le32(duration),
+	};
+
+	return mt76_mcu_send_msg(&phy->dev->mt76, MCU_CE_CMD(SET_ROC), &req,
+				 sizeof(req), false);
+}
+
+/**
+ * mt7921_soc_mcu_abort_roc() - Give time on a channel back to the firmware
+ * @phy: the phy
+ * @vif: the interface
+ * @token_id: what the request carried
+ *
+ * Return: 0 or a negative error code
+ */
+int mt7921_soc_mcu_abort_roc(struct mt792x_phy *phy, struct mt792x_vif *vif,
+			     u8 token_id)
+{
+	struct mt7921_soc_ch_privilege req = {
+		.bss_idx = vif->bss_conf.mt76.idx,
+		.token = token_id,
+		.action = MT7921_SOC_CH_ABORT,
+		.dbdc_band = MT7921_SOC_DBDC_AUTO,
+	};
+
+	return mt76_mcu_send_msg(&phy->dev->mt76, MCU_CE_CMD(SET_ROC), &req,
+				 sizeof(req), false);
+}
