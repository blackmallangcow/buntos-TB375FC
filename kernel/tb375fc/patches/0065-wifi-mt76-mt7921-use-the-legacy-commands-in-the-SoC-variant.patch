+{
+	struct mt792x_vif *mvif = (struct mt792x_vif *)vif->drv_priv;
+	struct ieee80211_chanctx_conf *ctx = mvif->bss_conf.mt76.ctx;
+	struct ieee80211_bss_conf *conf = &vif->bss_conf;
+	const struct cfg80211_chan_def *def;
+
+	rlm->bss_idx = mvif->bss_conf.mt76.idx;
+	rlm->tx_nss = hweight8(dev->mphy.antenna_mask);
+	rlm->rx_nss = rlm->tx_nss;
+
+	if (!ctx)
+		return;
+
+	def = &ctx->def;
+	rlm->band = mt7921_soc_band(def->chan->band);
+	rlm->chan = def->chan->hw_value;
+	rlm->sco = mt7921_soc_sco(def);
+	rlm->erp_protect = conf->use_cts_prot;
+	rlm->ht_protect = conf->ht_operation_mode &
+			  IEEE80211_HT_OP_MODE_PROTECTION;
+	rlm->ht_op2 = cpu_to_le16(conf->ht_operation_mode);
+	rlm->ht_op1 = rlm->sco;
+	if (rlm->sco)
+		rlm->ht_op1 |= IEEE80211_HT_PARAM_CHAN_WIDTH_ANY;
+	rlm->short_preamble = conf->use_short_preamble;
+	rlm->short_slot = conf->use_short_slot;
+	/* This is what the vendor driver has in here */
+	rlm->vht_basic_mcs = cpu_to_le16(basic_rates);
+
+	switch (def->width) {
+	case NL80211_CHAN_WIDTH_80:
+		rlm->vht_width = MT7921_SOC_CW_80;
+		break;
+	case NL80211_CHAN_WIDTH_160:
+		rlm->vht_width = MT7921_SOC_CW_160;
+		break;
+	case NL80211_CHAN_WIDTH_80P80:
+		rlm->vht_width = MT7921_SOC_CW_80P80;
+		rlm->vht_s2 = ieee80211_frequency_to_channel(def->center_freq2);
+		break;
+	default:
+		rlm->vht_width = MT7921_SOC_CW_20_40;
+		return;
+	}
+	rlm->vht_s1 = ieee80211_frequency_to_channel(def->center_freq1);
+}
