+/*
+ * Where the secondary channel of the primary one's 40 MHz is. In the 5 GHz band
+ * the wider channels are made of these pairs, from 36 up and from 149 up.
+ */
+static u8 mt7921_soc_sco(const struct cfg80211_chan_def *def)
+{
+	int chan = def->chan->hw_value, center;
+
+	switch (def->width) {
+	case NL80211_CHAN_WIDTH_40:
+		center = ieee80211_frequency_to_channel(def->center_freq1);
+		return chan < center ? MT7921_SOC_SCO_ABOVE :
+				       MT7921_SOC_SCO_BELOW;
+	case NL80211_CHAN_WIDTH_80:
+	case NL80211_CHAN_WIDTH_80P80:
+	case NL80211_CHAN_WIDTH_160:
+		chan -= chan >= 149 ? 149 : 36;
+		return chan / 4 % 2 ? MT7921_SOC_SCO_BELOW :
+				      MT7921_SOC_SCO_ABOVE;
+	default:
+		return 0;
+	}
+}
