From: buntOS contributors
Subject: [PATCH] regulator: mt6363: Fix the VEMC voltage selector

VEMC picks its voltage like the other LDOs with a calibration register:
VOSEL selects the range and VOCAL the step in it. Unlike the others, a
hardware trap (TOP_TRAP) selects between two VOSEL fields. The two
callbacks written for this are wrong:

 - mt6363_vemc_get_voltage_sel() looks for the range with != and stops at
   the first selector that differs from VOSEL. That is range 1 if VOSEL is
   0, and range 0 for any other value, so it reads the wrong voltage.
   regulator_range_selector_to_index() in the core uses ==.
 - If the trap is 1, VOSEL_1 is in use: bits [7:4] of the VOSEL register,
   as in MediaTek's driver. Both callbacks only ever use VOSEL_0, bits
   [3:0], for the range. They apply the mask of VOSEL_1 to vsel_reg, which
   is the VOCAL register.

Use the VOSEL field that the trap selects for the range.

This does not change which bits of VOCAL are used: bits [7:4] if the trap
is 1, now with a mask of their own. That part is an assumption. MediaTek's
driver does not program VOCAL on any LDO, but its header names bits [3:0]
of this one VOCAL_0, and the MT6359P has VOCAL_0 and VOCAL_1 next to
VOSEL_0 and VOSEL_1.

Fixes: 3c36965df808 ("regulator: Add support for MediaTek MT6363 SPMI PMIC Regulators")
---
 drivers/regulator/mt6363-regulator.c       | 73 ++++++++++++----------
 include/linux/regulator/mt6363-regulator.h |  1 +
 2 files changed, 41 insertions(+), 33 deletions(-)

diff --git a/drivers/regulator/mt6363-regulator.c b/drivers/regulator/mt6363-regulator.c
index cc2e841..76dbead 100644
--- a/drivers/regulator/mt6363-regulator.c
+++ b/drivers/regulator/mt6363-regulator.c
@@ -485,9 +485,8 @@ static int mt6363_vemc_set_voltage_sel(struct regulator_dev *rdev, unsigned int
 	const u16 tma_unlock_key = MT6363_TMA_UNLOCK_VALUE;
 	const struct regulator_desc *rdesc = rdev->desc;
 	struct regmap *regmap = rdev->regmap;
-	unsigned int range, val;
+	unsigned int range, val, vocal_mask, vosel_mask;
 	int i, ret;
-	u16 mask;
 
 	for (i = 0; i < rdesc->n_linear_ranges; i++) {
 		const struct linear_range *r = &rdesc->linear_ranges[i];
@@ -514,28 +513,32 @@ static int mt6363_vemc_set_voltage_sel(struct regulator_dev *rdev, unsigned int
 	if (ret)
 		return ret;
 
-	/* If HW trapping value is 1, use VEMC_VOSEL_1 instead of VEMC_VOSEL_0 */
+	/*
+	 * If HW trapping value is 1, use VEMC_VOSEL_1 and VEMC_VOCAL_1 instead
+	 * of VEMC_VOSEL_0 and VEMC_VOCAL_0
+	 */
 	if (val == 1) {
-		mask = MT6363_RG_VEMC_VOSEL_1_MASK;
-		sel = FIELD_PREP(MT6363_RG_VEMC_VOSEL_1_MASK, sel);
+		vosel_mask = MT6363_RG_VEMC_VOSEL_1_MASK;
+		vocal_mask = MT6363_RG_VEMC_VOCAL_1_MASK;
 	} else {
-		mask = rdesc->vsel_mask;
+		vosel_mask = rdesc->vsel_range_mask;
+		vocal_mask = rdesc->vsel_mask;
 	}
 
-	sel <<= ffs(rdesc->vsel_mask) - 1;
 	sel += rdesc->linear_ranges[i].min_sel;
-
 	range = rdesc->linear_range_selectors_bitfield[i];
-	range <<= ffs(rdesc->vsel_range_mask) - 1;
 
-	/* Write to the vreg calibration register for voltage finetuning */
-	ret = regmap_update_bits(regmap, rdesc->vsel_range_reg,
-				 rdesc->vsel_range_mask, range);
+	ret = regmap_update_bits(regmap, rdesc->vsel_range_reg, vosel_mask,
+				 field_prep(vosel_mask, range));
 	if (ret)
 		goto lock_tma;
 
-	/* Function must return the result of this write operation */
-	ret = regmap_update_bits(regmap, rdesc->vsel_reg, mask, sel);
+	/*
+	 * Write to the vreg calibration register for voltage finetuning.
+	 * Function must return the result of this write operation
+	 */
+	ret = regmap_update_bits(regmap, rdesc->vsel_reg, vocal_mask,
+				 field_prep(vocal_mask, sel));
 
 lock_tma:
 	/* Unconditionally re-lock TMA */
@@ -548,40 +551,44 @@ lock_tma:
 static int mt6363_vemc_get_voltage_sel(struct regulator_dev *rdev)
 {
 	const struct regulator_desc *rdesc = rdev->desc;
-	unsigned int vosel, trap, calsel;
-	int vcal, vsel, range, ret;
+	unsigned int vocal, vosel, trap;
+	int range, ret;
 
-	ret = regmap_read(rdev->regmap, rdesc->vsel_reg, &vosel);
+	ret = regmap_read(rdev->regmap, rdesc->vsel_reg, &vocal);
 	if (ret)
 		return ret;
 
-	ret = regmap_read(rdev->regmap, rdesc->vsel_range_reg, &calsel);
+	ret = regmap_read(rdev->regmap, rdesc->vsel_range_reg, &vosel);
 	if (ret)
 		return ret;
 
-	calsel &= rdesc->vsel_range_mask;
-	for (range = 0; range < rdesc->n_linear_ranges; range++)
-		if (rdesc->linear_range_selectors_bitfield[range] != calsel)
-			break;
-
-	if (range == rdesc->n_linear_ranges)
-		return -EINVAL;
-
 	ret = regmap_read(rdev->regmap, MT6363_TOP_TRAP, &trap);
 	if (ret)
 		return ret;
 
-	/* If HW trapping value is 1, use VEMC_VOSEL_1 instead of VEMC_VOSEL_0 */
 	if (trap > 1)
 		return -EINVAL;
-	else if (trap == 1)
-		vsel = FIELD_GET(MT6363_RG_VEMC_VOSEL_1_MASK, vosel);
-	else
-		vsel = vosel & rdesc->vsel_mask;
 
-	vcal = linear_range_values_in_range_array(rdesc->linear_ranges, range);
+	/*
+	 * If HW trapping value is 1, use VEMC_VOSEL_1 and VEMC_VOCAL_1 instead
+	 * of VEMC_VOSEL_0 and VEMC_VOCAL_0
+	 */
+	if (trap == 1) {
+		vosel = FIELD_GET(MT6363_RG_VEMC_VOSEL_1_MASK, vosel);
+		vocal = FIELD_GET(MT6363_RG_VEMC_VOCAL_1_MASK, vocal);
+	} else {
+		vosel &= rdesc->vsel_range_mask;
+		vocal &= rdesc->vsel_mask;
+	}
+
+	for (range = 0; range < rdesc->n_linear_ranges; range++)
+		if (rdesc->linear_range_selectors_bitfield[range] == vosel)
+			break;
+
+	if (range == rdesc->n_linear_ranges)
+		return -EINVAL;
 
-	return vsel + vcal;
+	return vocal + linear_range_values_in_range_array(rdesc->linear_ranges, range);
 }
 
 static int mt6363_va15_set_voltage_sel(struct regulator_dev *rdev, unsigned int sel)
diff --git a/include/linux/regulator/mt6363-regulator.h b/include/linux/regulator/mt6363-regulator.h
index 60761f0..df85e0d 100644
--- a/include/linux/regulator/mt6363-regulator.h
+++ b/include/linux/regulator/mt6363-regulator.h
@@ -139,6 +139,7 @@
 #define MT6363_RG_LDO_VSRAM_APU_VOSEL_MASK	GENMASK(6, 0)
 #define MT6363_RG_VEMC_VOCAL_ADDR		0x1b1b
 #define MT6363_RG_VEMC_VOCAL_MASK		GENMASK(3, 0)
+#define MT6363_RG_VEMC_VOCAL_1_MASK		GENMASK(7, 4)
 #define MT6363_RG_LDO_VCN15_ADDR		0x1b57
 #define MT6363_RG_LDO_VCN15_EN_BIT		0
 #define MT6363_RG_LDO_VCN15_LP_BIT		1
