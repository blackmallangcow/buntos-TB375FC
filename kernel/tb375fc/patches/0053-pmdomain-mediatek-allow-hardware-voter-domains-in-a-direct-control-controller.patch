From: buntOS contributors
Subject: [PATCH] pmdomain: mediatek: allow hardware voter domains in a direct control controller

The controllers of MT8196 have only one kind of domains, each. On MT6897
the kinds are mixed: MM_INFRA goes through the hardware voter and the
directly controlled ISP, camera and video encoder domains are its
subdomains. Subdomains are child nodes of their parent, so they have to be
in the same controller.

Add a controller type for that. Its ids index both domain tables and each
domain is in one of them. The voter registers are in another block, so
take its regmap from the mediatek,hardware-voter phandle. For the existing
types it stays the parent syscon, as before.

Choose the operations by the table the domain is in, instead of by the
type of the controller. That is the same for the existing types.

The hardware voter domains of such a controller are not IRQ safe: they
have clocks, and clk_prepare() may sleep, which it must not do under the
spinlock of an IRQ safe genpd.

---
diff --git a/drivers/pmdomain/mediatek/mtk-pm-domains.c b/drivers/pmdomain/mediatek/mtk-pm-domains.c
index 530ba3ef1..4263a65ec 100644
--- a/drivers/pmdomain/mediatek/mtk-pm-domains.c
+++ b/drivers/pmdomain/mediatek/mtk-pm-domains.c
@@ -72,6 +72,7 @@ struct scpsys_domain {
 struct scpsys {
 	struct device *dev;
 	struct regmap *base;
+	struct regmap *hwv_base;
 	const struct scpsys_soc_data *soc_data;
 	u8 bus_prot_index[BUS_PROT_BLOCK_COUNT];
 	struct regmap **bus_prot;
@@ -106,7 +107,7 @@ static bool scpsys_hwv_domain_is_disable_done(struct scpsys_domain *pd)
 	u32 val[2];
 	u32 mask = BIT(hwv->setclr_bit);
 
-	regmap_multi_reg_read(pd->scpsys->base, regs, val, 2);
+	regmap_multi_reg_read(pd->scpsys->hwv_base, regs, val, 2);
 
 	/* Disable is done when the bit is set in DONE, cleared in CLR_STA */
 	return (val[0] & mask) && !(val[1] & mask);
@@ -119,7 +120,7 @@ static bool scpsys_hwv_domain_is_enable_done(struct scpsys_domain *pd)
 	u32 val[3];
 	u32 mask = BIT(hwv->setclr_bit);
 
-	regmap_multi_reg_read(pd->scpsys->base, regs, val, 3);
+	regmap_multi_reg_read(pd->scpsys->hwv_base, regs, val, 3);
 
 	/* Enable is done when the bit is set in DONE and EN, cleared in SET_STA */
 	return (val[0] & mask) && (val[1] & mask) && !(val[2] & mask);
@@ -337,7 +338,7 @@ static int scpsys_hwv_power_on(struct generic_pm_domain *genpd)
 		goto err_disable_clks;
 
 	/* Make sure the HW Voter is idle and able to accept commands */
-	ret = regmap_read_poll_timeout_atomic(scpsys->base, hwv->done, val,
+	ret = regmap_read_poll_timeout_atomic(scpsys->hwv_base, hwv->done, val,
 					      val & BIT(hwv->setclr_bit),
 					      MTK_HWV_POLL_DELAY_US,
 					      MTK_HWV_POLL_TIMEOUT);
@@ -350,13 +351,13 @@ static int scpsys_hwv_power_on(struct generic_pm_domain *genpd)
 	 * Instruct the HWV to power on the MTCMOS (power domain): after that,
 	 * the same bit will be unset immediately by the hardware.
 	 */
-	regmap_write(scpsys->base, hwv->set, BIT(hwv->setclr_bit));
+	regmap_write(scpsys->hwv_base, hwv->set, BIT(hwv->setclr_bit));
 
 	/*
 	 * Wait until the HWV sets the bit again, signalling that its internal
 	 * state machine was started and it now processing the vote command.
 	 */
-	ret = regmap_read_poll_timeout_atomic(scpsys->base, hwv->set, val,
+	ret = regmap_read_poll_timeout_atomic(scpsys->hwv_base, hwv->set, val,
 					      val & BIT(hwv->setclr_bit),
 					      MTK_HWV_PREPARE_DELAY_US,
 					      MTK_HWV_PREPARE_TIMEOUT);
@@ -411,7 +412,7 @@ static int scpsys_hwv_power_off_internal(struct scpsys_domain *pd)
 		goto err_infra;
 
 	/* Make sure the HW Voter is idle and able to accept commands */
-	ret = regmap_read_poll_timeout_atomic(scpsys->base, hwv->done, val,
+	ret = regmap_read_poll_timeout_atomic(scpsys->hwv_base, hwv->done, val,
 					      val & BIT(hwv->setclr_bit),
 					      MTK_HWV_POLL_DELAY_US,
 					      MTK_HWV_POLL_TIMEOUT);
@@ -423,13 +424,13 @@ static int scpsys_hwv_power_off_internal(struct scpsys_domain *pd)
 	 * Instruct the HWV to power off the MTCMOS (power domain): differently
 	 * from poweron, the bit will be kept set.
 	 */
-	regmap_write(scpsys->base, hwv->clr, BIT(hwv->setclr_bit));
+	regmap_write(scpsys->hwv_base, hwv->clr, BIT(hwv->setclr_bit));
 
 	/*
 	 * Wait until the HWV clears the bit, signalling that its internal
 	 * state machine was started and it now processing the clear command.
 	 */
-	ret = regmap_read_poll_timeout_atomic(scpsys->base, hwv->clr, val,
+	ret = regmap_read_poll_timeout_atomic(scpsys->hwv_base, hwv->clr, val,
 					      !(val & BIT(hwv->setclr_bit)),
 					      MTK_HWV_PREPARE_DELAY_US,
 					      MTK_HWV_PREPARE_TIMEOUT);
@@ -762,6 +763,14 @@ generic_pm_domain *scpsys_add_one_domain(struct scpsys *scpsys, struct device_no
 	}
 
 	switch (scpsys->soc_data->type) {
+	case SCPSYS_MTCMOS_TYPE_MIXED:
+		if (id < scpsys->soc_data->num_hwv_domains &&
+		    scpsys->soc_data->hwv_domains_data[id].name) {
+			domain_data = NULL;
+			hwv_domain_data = &scpsys->soc_data->hwv_domains_data[id];
+			break;
+		}
+		fallthrough;
 	case SCPSYS_MTCMOS_TYPE_DIRECT_CTL:
 		if (id >= scpsys->soc_data->num_domains) {
 			dev_err(scpsys->dev, "%pOF: invalid domain id %d\n", node, id);
@@ -870,15 +879,19 @@ generic_pm_domain *scpsys_add_one_domain(struct scpsys *scpsys, struct device_no
 	else
 		pd->genpd.name = node->name;
 
-	if (scpsys->soc_data->type == SCPSYS_MTCMOS_TYPE_DIRECT_CTL) {
+	if (pd->data) {
 		pd->genpd.power_off = scpsys_power_off;
 		pd->genpd.power_on = scpsys_power_on;
 	} else {
 		pd->genpd.power_off = scpsys_hwv_power_off;
 		pd->genpd.power_on = scpsys_hwv_power_on;
 
-		/* HW-Voter code can be invoked in atomic context */
-		pd->genpd.flags |= GENPD_FLAG_IRQ_SAFE;
+		/*
+		 * HW-Voter code can be invoked in atomic context, but the clocks
+		 * of the domains of a mixed controller have to be prepared.
+		 */
+		if (scpsys->soc_data->type == SCPSYS_MTCMOS_TYPE_HW_VOTER)
+			pd->genpd.flags |= GENPD_FLAG_IRQ_SAFE;
 	}
 
 	/*
@@ -890,7 +903,7 @@ generic_pm_domain *scpsys_add_one_domain(struct scpsys *scpsys, struct device_no
 	if (MTK_SCPD_CAPS(pd, MTK_SCPD_KEEP_DEFAULT_OFF)) {
 		bool domain_is_on;
 
-		if (scpsys->soc_data->type == SCPSYS_MTCMOS_TYPE_HW_VOTER)
+		if (pd->hwv_data)
 			domain_is_on = scpsys_hwv_domain_is_enable_done(pd);
 		else
 			domain_is_on = scpsys_domain_is_on(pd);
@@ -984,7 +997,6 @@ err_put_node:
 
 static void scpsys_remove_one_domain(struct scpsys_domain *pd)
 {
-	struct scpsys *scpsys = pd->scpsys;
 	int ret;
 
 	/*
@@ -1007,7 +1019,7 @@ static void scpsys_remove_one_domain(struct scpsys_domain *pd)
 	if (MTK_SCPD_CAPS(pd, MTK_SCPD_KEEP_DEFAULT_OFF))
 		goto put_clocks;
 
-	if (scpsys->soc_data->type == SCPSYS_MTCMOS_TYPE_HW_VOTER) {
+	if (pd->hwv_data) {
 		if (scpsys_hwv_domain_is_enable_done(pd))
 			scpsys_hwv_power_off_internal(pd);
 	} else {
@@ -1259,7 +1271,10 @@ static int scpsys_probe(struct platform_device *pdev)
 		return -EINVAL;
 	}
 
-	num_domains = soc->num_domains + soc->num_hwv_domains;
+	if (soc->type == SCPSYS_MTCMOS_TYPE_MIXED)
+		num_domains = max(soc->num_domains, soc->num_hwv_domains);
+	else
+		num_domains = soc->num_domains + soc->num_hwv_domains;
 
 	scpsys = devm_kzalloc(dev, struct_size(scpsys, domains, num_domains), GFP_KERNEL);
 	if (!scpsys)
@@ -1283,6 +1298,15 @@ static int scpsys_probe(struct platform_device *pdev)
 		return PTR_ERR(scpsys->base);
 	}
 
+	if (soc->type == SCPSYS_MTCMOS_TYPE_MIXED) {
+		scpsys->hwv_base = syscon_regmap_lookup_by_phandle(np, "mediatek,hardware-voter");
+		if (IS_ERR(scpsys->hwv_base))
+			return dev_err_probe(dev, PTR_ERR(scpsys->hwv_base),
+					     "no hardware voter regmap available\n");
+	} else {
+		scpsys->hwv_base = scpsys->base;
+	}
+
 	if (of_find_property(np, "access-controllers", NULL))
 		ret = scpsys_get_bus_protection(dev, scpsys);
 	else
diff --git a/drivers/pmdomain/mediatek/mtk-pm-domains.h b/drivers/pmdomain/mediatek/mtk-pm-domains.h
index a5dca24cb..46ccd5cff 100644
--- a/drivers/pmdomain/mediatek/mtk-pm-domains.h
+++ b/drivers/pmdomain/mediatek/mtk-pm-domains.h
@@ -137,11 +137,14 @@ enum scpsys_rtff_type {
  * enum scpsys_mtcmos_type - Type of power domain controller
  * @SCPSYS_MTCMOS_TYPE_DIRECT_CTL: Power domains are controlled with direct access
  * @SCPSYS_MTCMOS_TYPE_HW_VOTER:   Hardware-assisted voted power domain control
+ * @SCPSYS_MTCMOS_TYPE_MIXED:      Both in one controller: the domain ids index
+ *                                 both tables, and each domain is in one of them
  * @SCPSYS_MTCMOS_TYPE_MAX:        Number of supported power domain types
  */
 enum scpsys_mtcmos_type {
 	SCPSYS_MTCMOS_TYPE_DIRECT_CTL = 0,
 	SCPSYS_MTCMOS_TYPE_HW_VOTER,
+	SCPSYS_MTCMOS_TYPE_MIXED,
 	SCPSYS_MTCMOS_TYPE_MAX
 };
 
