From: buntOS contributors
Subject: [PATCH] wifi: mt76: mt7921: let a variant start firmware it did not download

The MT7921 of the MT6897 connsys starts its firmware from where the
bootloader put it, takes its calibration data with another command and
has other WFDMA prefetch settings. Add hif ops for these three, used by
nothing yet, and leave the country tables, runtime power management and
the init retries to the PCIe, USB and SDIO chips in the places where the
variant can't take part:

 - The firmware mode register is set for a download, and there is none.
 - The country tables are in the firmware file, and there is no file.
 - Nothing is known yet of how the deep sleep of that firmware behaves.
 - A retry can't tell more than the first try, and its reset path takes
   minutes of a device that hangs.

The firmware of the variant has other flags under the chip capability
tag of the NIC capability event, so it does not get read as such there.

Move the TX descriptor preparation of the PCIe chips to the common
module for the variant to share. The code does not change, and for the
PCIe, USB and SDIO chips nothing else does: all of the new branches test
a hif op they don't set.
---
 .../net/wireless/mediatek/mt76/mt7921/init.c  | 18 ++++---
 .../net/wireless/mediatek/mt76/mt7921/mac.c   | 49 +++++++++++++++++++
 .../net/wireless/mediatek/mt76/mt7921/mcu.c   | 21 ++++++--
 .../wireless/mediatek/mt76/mt7921/pci_mac.c   | 48 ------------------
 drivers/net/wireless/mediatek/mt76/mt792x.h   |  4 ++
 .../net/wireless/mediatek/mt76/mt792x_dma.c   |  4 +-
 6 files changed, 84 insertions(+), 60 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt76/mt7921/init.c b/drivers/net/wireless/mediatek/mt76/mt7921/init.c
index 49be2fa..7ab464b 100644
--- a/drivers/net/wireless/mediatek/mt76/mt7921/init.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7921/init.c
@@ -88,7 +88,8 @@ static int __mt7921_init_hardware(struct mt792x_dev *dev)
 	/* force firmware operation mode into normal state,
 	 * which should be set before firmware download stage.
 	 */
-	mt76_wr(dev, MT_SWDEF_MODE, MT_SWDEF_NORMAL_MODE);
+	if (!dev->hif_ops->load_firmware)
+		mt76_wr(dev, MT_SWDEF_MODE, MT_SWDEF_NORMAL_MODE);
 	ret = mt792x_mcu_init(dev);
 	if (ret)
 		goto out;
@@ -108,19 +109,23 @@ out:
 
 static int mt7921_init_hardware(struct mt792x_dev *dev)
 {
-	int ret, i;
+	int ret, i, count;
 
 	set_bit(MT76_STATE_INITIALIZED, &dev->mphy.state);
 
-	for (i = 0; i < MT792x_MCU_INIT_RETRY_COUNT; i++) {
+	/* On the SoC variant the first failure says all there is to know */
+	count = dev->hif_ops->load_firmware ? 1 : MT792x_MCU_INIT_RETRY_COUNT;
+
+	for (i = 0; i < count; i++) {
 		ret = __mt7921_init_hardware(dev);
 		if (!ret)
 			break;
 
-		mt792x_init_reset(dev);
+		if (count > 1)
+			mt792x_init_reset(dev);
 	}
 
-	if (i == MT792x_MCU_INIT_RETRY_COUNT) {
+	if (i == count) {
 		dev_err(dev->mt76.dev, "hardware init failed\n");
 		return ret;
 	}
@@ -208,7 +213,8 @@ int mt7921_register_device(struct mt792x_dev *dev)
 	dev->pm.stats.last_doze_event = jiffies;
 
 	if (!mt76_is_usb(&dev->mt76) &&
-	    !is_mt7902(&dev->mt76)) {
+	    !is_mt7902(&dev->mt76) &&
+	    !dev->hif_ops->load_firmware) {
 		dev->pm.enable_user = true;
 		dev->pm.enable = true;
 		dev->pm.ds_enable_user = true;
diff --git a/drivers/net/wireless/mediatek/mt76/mt7921/mac.c b/drivers/net/wireless/mediatek/mt76/mt7921/mac.c
index e699781..6841baf 100644
--- a/drivers/net/wireless/mediatek/mt76/mt7921/mac.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7921/mac.c
@@ -879,3 +879,52 @@ void mt7921_set_ipv6_ns_work(struct work_struct *work)
 		skb_queue_purge(&dev->ipv6_ns_list);
 }
 #endif
+
+int mt7921e_tx_prepare_skb(struct mt76_dev *mdev, void *txwi_ptr,
+			   enum mt76_txq_id qid, struct mt76_wcid *wcid,
+			   struct ieee80211_sta *sta,
+			   struct mt76_tx_info *tx_info)
+{
+	struct mt792x_dev *dev = container_of(mdev, struct mt792x_dev, mt76);
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(tx_info->skb);
+	struct ieee80211_key_conf *key = info->control.hw_key;
+	struct mt76_connac_hw_txp *txp;
+	struct mt76_txwi_cache *t;
+	int id, pid;
+	u8 *txwi = (u8 *)txwi_ptr;
+
+	if (unlikely(tx_info->skb->len <= ETH_HLEN))
+		return -EINVAL;
+
+	if (!wcid)
+		wcid = &dev->mt76.global_wcid;
+
+	t = (struct mt76_txwi_cache *)(txwi + mdev->drv->txwi_size);
+	t->skb = tx_info->skb;
+
+	id = mt76_token_consume(mdev, &t);
+	if (id < 0)
+		return id;
+
+	if (sta) {
+		struct mt792x_sta *msta = (struct mt792x_sta *)sta->drv_priv;
+
+		if (time_after(jiffies, msta->deflink.last_txs + HZ / 4)) {
+			info->flags |= IEEE80211_TX_CTL_REQ_TX_STATUS;
+			msta->deflink.last_txs = jiffies;
+		}
+	}
+
+	pid = mt76_tx_status_skb_add(mdev, wcid, tx_info->skb);
+	mt76_connac2_mac_write_txwi(mdev, txwi_ptr, tx_info->skb, wcid, key,
+				    pid, qid, 0);
+
+	txp = (struct mt76_connac_hw_txp *)(txwi + MT_TXD_SIZE);
+	memset(txp, 0, sizeof(struct mt76_connac_hw_txp));
+	mt76_connac_write_hw_txp(mdev, tx_info, txp, id);
+
+	tx_info->skb = NULL;
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt7921e_tx_prepare_skb);
diff --git a/drivers/net/wireless/mediatek/mt76/mt7921/mcu.c b/drivers/net/wireless/mediatek/mt76/mt7921/mcu.c
index 4543965..a4728d0 100644
--- a/drivers/net/wireless/mediatek/mt76/mt7921/mcu.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7921/mcu.c
@@ -631,7 +631,9 @@ static int mt7921_mcu_get_nic_capability(struct mt792x_phy *mphy)
 							     skb);
 			break;
 		case MT_NIC_CAP_CHIP_CAP:
-			memcpy(&mphy->chip_cap, (void *)skb->data, sizeof(u64));
+			/* The firmware of the SoC variant has other flags here */
+			if (!mphy->dev->hif_ops->load_firmware)
+				memcpy(&mphy->chip_cap, (void *)skb->data, sizeof(u64));
 			break;
 		default:
 			break;
@@ -661,7 +663,10 @@ int mt7921_run_firmware(struct mt792x_dev *dev)
 {
 	int err;
 
-	err = mt792x_load_firmware(dev);
+	if (dev->hif_ops->load_firmware)
+		err = dev->hif_ops->load_firmware(dev);
+	else
+		err = mt792x_load_firmware(dev);
 	if (err)
 		return err;
 
@@ -669,9 +674,12 @@ int mt7921_run_firmware(struct mt792x_dev *dev)
 	if (err)
 		return err;
 
-	err = mt7921_load_clc(dev, mt792x_ram_name(dev));
-	if (err)
-		return err;
+	/* The country tables are in the firmware file, and there is none */
+	if (!dev->hif_ops->load_firmware) {
+		err = mt7921_load_clc(dev, mt792x_ram_name(dev));
+		if (err)
+			return err;
+	}
 	set_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
 
 	return mt7921_mcu_fw_log_2_host(dev, 1);
@@ -953,6 +961,9 @@ int mt7921_mcu_set_eeprom(struct mt792x_dev *dev)
 		.format = EE_FORMAT_WHOLE,
 	};
 
+	if (dev->hif_ops->set_eeprom)
+		return dev->hif_ops->set_eeprom(dev);
+
 	return mt76_mcu_send_msg(&dev->mt76, MCU_EXT_CMD(EFUSE_BUFFER_MODE),
 				 &req, sizeof(req), true);
 }
