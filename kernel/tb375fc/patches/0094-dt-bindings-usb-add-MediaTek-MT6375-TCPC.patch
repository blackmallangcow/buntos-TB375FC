From: buntOS contributors
Subject: [PATCH] dt-bindings: usb: add MediaTek MT6375 TCPC

Add the USB Type-C port controller of MT6375, and the interrupt that it
needs on the MFD device.

---
 .../bindings/mfd/mediatek,mt6375.yaml         | 27 +++++++++++++-
 .../bindings/usb/mediatek,mt6375-tcpc.yaml    | 35 +++++++++++++++++++
 2 files changed, 61 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/mfd/mediatek,mt6375.yaml b/Documentation/devicetree/bindings/mfd/mediatek,mt6375.yaml
index 7906f28..5ccb45f 100644
--- a/Documentation/devicetree/bindings/mfd/mediatek,mt6375.yaml
+++ b/Documentation/devicetree/bindings/mfd/mediatek,mt6375.yaml
@@ -27,6 +27,9 @@ properties:
   charger:
     $ref: /schemas/power/supply/mediatek,mt6375-charger.yaml#
 
+  tcpc:
+    $ref: /schemas/usb/mediatek,mt6375-tcpc.yaml#
+
 required:
   - compatible
   - reg
@@ -35,6 +38,8 @@ additionalProperties: false
 
 examples:
   - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
     i2c {
         #address-cells = <1>;
         #size-cells = <0>;
@@ -42,15 +47,35 @@ examples:
         pmic@34 {
             compatible = "mediatek,mt6375";
             reg = <0x34>;
+            interrupt-parent = <&pio>;
+            interrupts = <7 IRQ_TYPE_LEVEL_LOW>;
 
             charger {
                 compatible = "mediatek,mt6375-charger";
+                monitored-battery = <&battery>;
+                mediatek,fuel-gauge = <&fuel_gauge>;
+                mediatek,usb-port = <&mt6375_tcpc>;
 
-                usb-otg-vbus-regulator {
+                mt6375_otg_vbus: usb-otg-vbus-regulator {
                     regulator-name = "usb-otg-vbus";
                     regulator-min-microvolt = <5000000>;
                     regulator-max-microvolt = <5000000>;
                 };
             };
+
+            mt6375_tcpc: tcpc {
+                compatible = "mediatek,mt6375-tcpc";
+                vbus-supply = <&mt6375_otg_vbus>;
+
+                connector {
+                    compatible = "usb-c-connector";
+                    label = "USB-C";
+                    data-role = "dual";
+                    power-role = "dual";
+                    try-power-role = "sink";
+                    typec-power-opmode = "1.5A";
+                    pd-disable;
+                };
+            };
         };
     };
diff --git a/Documentation/devicetree/bindings/usb/mediatek,mt6375-tcpc.yaml b/Documentation/devicetree/bindings/usb/mediatek,mt6375-tcpc.yaml
new file mode 100644
index 0000000..08d1c6e
--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/mediatek,mt6375-tcpc.yaml
@@ -0,0 +1,35 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/mediatek,mt6375-tcpc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6375 USB Type-C Port Controller
+
+maintainers:
+  - buntOS contributors <buntos@localhost>
+
+description:
+  This module is part of the MT6375 MFD device. It is a USB Type-C port and
+  Power Delivery controller. Its interrupt comes from the MFD device, which
+  therefore needs one for this device to be there.
+
+properties:
+  compatible:
+    const: mediatek,mt6375-tcpc
+
+  vbus-supply:
+    description:
+      The regulator that sources VBUS, normally the boost of the charger of the
+      same chip. Not needed for a port that only sinks.
+
+  connector:
+    type: object
+    $ref: /schemas/connector/usb-connector.yaml#
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - connector
+
+additionalProperties: false
