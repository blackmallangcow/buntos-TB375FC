+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+/*
+ * MediaTek MT6897 multimedia IOMMU ports
+ *
+ * The SoC has two multimedia IOMMUs that walk one page table, and each larb
+ * hangs on one of them:
+ * iommu-disp: larb0/2/5/7/11/12/13/14/16/19/21/25/28/29/33/37/38
+ * iommu-mdp:  larb1/3/4/8/9/11/13/14/15/17/18/20/22/26/27/29/30/32/35/36
+ *
+ * Only the ports of the video decoder are listed so far.
+ */
+#ifndef _DT_BINDINGS_MEMORY_MEDIATEK_MT6897_MEMORY_PORT_H_
+#define _DT_BINDINGS_MEMORY_MEDIATEK_MT6897_MEMORY_PORT_H_
+
+#include <dt-bindings/memory/mtk-memory-port.h>
+
+/* larb4: video decoder core, on iommu-mdp */
+#define M4U_PORT_L4_HW_VDEC_MC_EXT		MTK_M4U_ID(4, 0)
+#define M4U_PORT_L4_HW_VDEC_UFO_EXT		MTK_M4U_ID(4, 1)
+#define M4U_PORT_L4_HW_VDEC_PP_EXT		MTK_M4U_ID(4, 2)
+#define M4U_PORT_L4_HW_VDEC_UFO_ENC_EXT		MTK_M4U_ID(4, 3)
+#define M4U_PORT_L4_HW_VDEC_PRED_RD_EXT		MTK_M4U_ID(4, 4)
+#define M4U_PORT_L4_HW_VDEC_PRED_WR_EXT		MTK_M4U_ID(4, 5)
+#define M4U_PORT_L4_HW_VDEC_PPWRAP_EXT		MTK_M4U_ID(4, 6)
+#define M4U_PORT_L4_HW_VDEC_TILE_EXT		MTK_M4U_ID(4, 7)
+#define M4U_PORT_L4_HW_VDEC_VLD_EXT		MTK_M4U_ID(4, 8)
+#define M4U_PORT_L4_HW_VDEC_VLD2_EXT		MTK_M4U_ID(4, 9)
+#define M4U_PORT_L4_HW_VDEC_AVC_MV_EXT		MTK_M4U_ID(4, 10)
+
+/* larb5: video decoder front end (LAT), on iommu-disp */
+#define M4U_PORT_L5_HW_VDEC_LAT0_VLD_EXT	MTK_M4U_ID(5, 0)
+#define M4U_PORT_L5_HW_VDEC_LAT0_VLD2_EXT	MTK_M4U_ID(5, 1)
+#define M4U_PORT_L5_HW_VDEC_LAT0_AVC_MV_EXT	MTK_M4U_ID(5, 2)
+#define M4U_PORT_L5_HW_VDEC_LAT0_MC_EXT		MTK_M4U_ID(5, 3)
+#define M4U_PORT_L5_HW_VDEC_LAT0_PRED_RD_EXT	MTK_M4U_ID(5, 4)
+#define M4U_PORT_L5_HW_VDEC_LAT0_TILE_EXT	MTK_M4U_ID(5, 5)
+#define M4U_PORT_L5_HW_VDEC_LAT0_WDMA_EXT	MTK_M4U_ID(5, 6)
+#define M4U_PORT_L5_HW_VDEC_LAT0_UFO_ENC_EXT	MTK_M4U_ID(5, 7)
+#define M4U_PORT_L5_HW_VDEC_LAT0_UFO_ENC_C_EXT	MTK_M4U_ID(5, 8)
+
+#endif
