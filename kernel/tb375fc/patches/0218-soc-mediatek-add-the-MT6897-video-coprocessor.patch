diff --git a/drivers/soc/mediatek/mt6897-vcp.c b/drivers/soc/mediatek/mt6897-vcp.c
new file mode 100644
index 000000000..511cbb26a
--- /dev/null
+++ b/drivers/soc/mediatek/mt6897-vcp.c
@@ -0,0 +1,1002 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MT6897 video coprocessor (VCP): power, secure reset, mailboxes and the log
+ * of the firmware.
+ *
+ * The VCP is a RISC-V core that runs the video codec firmware. The bootloader
+ * loads the firmware and maps it for the coprocessor. The kernel gives the
+ * coprocessor a window of shared memory, asks the secure monitor to release
+ * the reset and waits for the ready message. A user of the firmware, such as
+ * a video decoder, starts the coprocessor and talks to it through messages
+ * (IPI) that live in fixed slots of five mailboxes.
+ *
+ * The sequence, the registers and the layout of the mailboxes are those of
+ * the MediaTek driver in the OnePlus MT6897 kernel
+ * (drivers/misc/mediatek/vcp/rv). The shape follows drivers/remoteproc/
+ * mtk_vcp.c of the MT6895-Mainline tree, which does the same on the MT6895.
+ *
+ * The registers of the coprocessor are closed outside the time between the
+ * call that opens them and the secure reset: an access ends in an SError.
+ */
+#include <linux/arm-smccc.h>
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iommu.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/sched/clock.h>
+#include <linux/seq_file.h>
+#include <linux/sizes.h>
+#include <linux/uaccess.h>
+#include <linux/workqueue.h>
+#include <linux/soc/mediatek/mt6897-vcp.h>
+#include <linux/soc/mediatek/mtk_sip_svc.h>
+
+#define VCP_CONTROL		MTK_SIP_SMC_CMD(0x52c)
+#define VCP_OP_RESET_SET	2
+#define VCP_OP_RESET_RELEASE	3
+/* Opens the registers of the coprocessor to the kernel, or closes them */
+#define VCP_DAPC_CONTROL	MTK_SIP_SMC_CMD(0x52e)
+
+#define VCP_TCM_SIZE		0x40000
+#define VCP_REGION_OFFSET	4
+
+/* cfg */
+#define VCP_TO_SPM		0x94
+#define VCP_GIPC_IN_SET		0x98
+#define VCP_GIPC_HALT		BIT(13)	/* both harts park */
+
+/* core 0 */
+#define VCP_CORE_WDT_IRQ	0x30
+#define VCP_CORE_SHM_ADDR	0x44	/* general register 1 */
+#define VCP_CORE_SHM_SIZE	0x48	/* general register 2 */
+#define VCP_CORE_REBOOT_H0	0x54	/* general register 5 */
+#define VCP_CORE_REBOOT_H1	0x58
+#define VCP_READY_TO_REBOOT	0x34
+#define VCP_CORE_STATUS		0x70
+#define VCP_STATUS_STOPPED	0x7	/* gated, both harts halted */
+#define VCP_CORE_MON_PC		0x80
+#define VCP_CORE_MON_LR		0x84
+#define VCP_CORE_MON_SP		0x88
+#define VCP_CORE_H1_MON_PC	0x160
+
+#define VCP_MBOX_COUNT		5
+#define VCP_MBOX_WORDS		64
+#define VCP_MBOX_PINS		32
+#define VCP_MBOX_SET		0x100	/* to the coprocessor */
+#define VCP_MBOX_CLR		0x10c	/* from the coprocessor */
+#define VCP_IPI_MAX_WORDS	18
+
+/* The window of the coprocessor for shared memory: IOMMU region 5 */
+#define VCP_SHM_BASE		0x140000000ULL
+#define VCP_SHM_END		0x1a0000000ULL
+
+#define VCP_READY_MS		800
+#define VCP_SEND_US		100000
+
+/* The log: a ring in shared memory, set up by the kernel, filled by the firmware */
+#define VCP_LOG_MAGIC		0x504c5402
+#define VCP_LOG_INFO_OFFSET	24
+#define VCP_LOG_BUF_OFFSET	32
+#define VCP_LOG_BUF_SIZE	SZ_1M
+#define VCP_LOG_IPI_INIT	0x4c4f4701
+#define VCP_LOG_IPI_ENABLE	0x4c4f4702
+#define VCP_LOG_ON		0x101
+
+struct vcp_log_ctrl {
+	__le32 magic, size, enable, info_offset, buf_offset, buf_size;
+};
+
+struct vcp_log_pos {
+	__le32 read, write;
+};
+
+/* The table the bootloader leaves at the head of the SRAM */
+struct vcp_region_info {
+	__le32 loader_start, loader_size;
+	__le32 firmware_start, firmware_size;
+	__le32 dram_start, dram_size, dram_backup_start;
+	__le32 struct_size;
+};
+
+/* A slot of a mailbox. Sizes are in words. */
+struct vcp_pin {
+	u8 ipi, mbox, words;
+};
+
+/* In the order of the stock device tree: the order gives the place in the mailbox */
+static const struct vcp_pin vcp_send_pins[] = {
+	{ MT6897_VCP_IPI_OUT_VDEC_1, 0, 18 },
+	{ MT6897_VCP_IPI_C_SLEEP_0, 1, 2 },
+	{ MT6897_VCP_IPI_OUT_TEST_0, 1, 2 },
+	{ MT6897_VCP_IPI_OUT_MMDVFS, 1, 2 },
+	{ MT6897_VCP_IPI_OUT_MMQOS, 1, 2 },
+	{ MT6897_VCP_IPI_OUT_MMDEBUG, 1, 2 },
+	{ MT6897_VCP_IPI_HWVOTER_DEBUG, 1, 4 },
+	{ MT6897_VCP_IPI_OUT_VENC_0, 2, 18 },
+	{ MT6897_VCP_IPI_OUT_MPOOL_0, 2, 4 },
+	{ MT6897_VCP_IPI_C_SLEEP_1, 3, 2 },
+	{ MT6897_VCP_IPI_OUT_TEST_1, 3, 2 },
+	{ MT6897_VCP_IPI_OUT_LOGGER_CTRL, 3, 6 },
+	{ MT6897_VCP_IPI_OUT_VCPCTL_1, 3, 2 },
+	{ MT6897_VCP_IPI_OUT_MPOOL_1, 4, 4 },
+};
+
+static const struct vcp_pin vcp_recv_pins[] = {
+	{ MT6897_VCP_IPI_IN_VDEC_1, 0, 18 },
+	{ MT6897_VCP_IPI_C_SLEEP_0, 1, 1 },
+	{ MT6897_VCP_IPI_IN_ERROR_INFO_0, 1, 10 },
+	{ MT6897_VCP_IPI_IN_READY_0, 1, 1 },
+	{ MT6897_VCP_IPI_IN_RAM_DUMP_0, 1, 2 },
+	{ MT6897_VCP_IPI_IN_MMDVFS, 1, 2 },
+	{ MT6897_VCP_IPI_IN_MMQOS, 1, 2 },
+	{ MT6897_VCP_IPI_IN_MMDEBUG, 1, 2 },
+	{ MT6897_VCP_IPI_HWVOTER_DEBUG, 1, 4 },
+	{ MT6897_VCP_IPI_IN_VENC_0, 2, 18 },
+	{ MT6897_VCP_IPI_IN_MPOOL_0, 2, 4 },
+	{ MT6897_VCP_IPI_C_SLEEP_1, 3, 1 },
+	{ MT6897_VCP_IPI_IN_ERROR_INFO_1, 3, 10 },
+	{ MT6897_VCP_IPI_IN_LOGGER_CTRL, 3, 6 },
+	{ MT6897_VCP_IPI_IN_READY_1, 3, 1 },
+	{ MT6897_VCP_IPI_IN_RAM_DUMP_1, 3, 2 },
+	{ MT6897_VCP_IPI_IN_MPOOL_1, 4, 4 },
+};
+
+struct vcp_slot {
+	u8 mbox, pin, words;
+	bool valid;
+};
+
+/*
+ * The firmware takes the decoder, encoder and log buffers as one block, in
+ * this order. The others stand alone.
+ */
+enum {
+	VCP_BLOCK_VSI_LOG, VCP_BLOCK_VDEC_PROP, VCP_BLOCK_VENC_PROP,
+	VCP_BLOCK_VDEC_LOG, VCP_BLOCK_VENC_LOG, VCP_BLOCK_GCE,
+	VCP_BLOCK_MMDVFS, VCP_BLOCK_MMQOS, VCP_BLOCK_COUNT
+};
+
+static const struct {
+	u8 block;
+	u32 offset, size;
+} vcp_mem_layout[MT6897_VCP_MEM_COUNT] = {
+	[MT6897_VCP_MEM_VDEC]		= { VCP_BLOCK_VSI_LOG, 0, 0x78000 },
+	[MT6897_VCP_MEM_VENC]		= { VCP_BLOCK_VSI_LOG, 0x78000, 0x12000 },
+	[MT6897_VCP_MEM_LOGGER]		= { VCP_BLOCK_VSI_LOG, 0x8a000, 0x180000 },
+	[MT6897_VCP_MEM_VDEC_PROP]	= { VCP_BLOCK_VDEC_PROP, 0, 0x400 },
+	[MT6897_VCP_MEM_VENC_PROP]	= { VCP_BLOCK_VENC_PROP, 0, 0x400 },
+	[MT6897_VCP_MEM_VDEC_LOG]	= { VCP_BLOCK_VDEC_LOG, 0, 0x400 },
+	[MT6897_VCP_MEM_VENC_LOG]	= { VCP_BLOCK_VENC_LOG, 0, 0x400 },
+	[MT6897_VCP_MEM_GCE]		= { VCP_BLOCK_GCE, 0, 0x100000 },
+	[MT6897_VCP_MEM_MMDVFS]		= { VCP_BLOCK_MMDVFS, 0, 0x1000 },
+	[MT6897_VCP_MEM_MMQOS]		= { VCP_BLOCK_MMQOS, 0, 0x1000 },
+};
+
+static const size_t vcp_block_sizes[VCP_BLOCK_COUNT] = {
+	0x78000 + 0x12000 + 0x180000, 0x400, 0x400, 0x400, 0x400,
+	0x100000, 0x1000, 0x1000,
+};
+
+struct vcp_mbox {
+	struct mt6897_vcp *vcp;
+	void __iomem *base;
+	unsigned int index;
+	int irq;
+};
+
+struct mt6897_vcp {
+	struct device *dev;
+	void __iomem *sram, *cfg, *core;
+	struct clk_bulk_data clocks[3];	/* sel, clk, 26m */
+	struct vcp_mbox mbox[VCP_MBOX_COUNT];
+	struct vcp_slot send[MT6897_VCP_IPI_COUNT], recv[MT6897_VCP_IPI_COUNT];
+	struct mt6897_vcp_mem block[VCP_BLOCK_COUNT];
+	dma_addr_t shm_lower, shm_upper;
+	int wdt_irq;
+
+	struct mutex lock;		/* start and stop, the memory */
+	unsigned int users;
+	bool held;			/* by the debugfs switch */
+	struct completion ready;
+	u32 ready_size;
+
+	struct mutex send_lock;		/* a slot being filled, and @up */
+	bool up;			/* the firmware takes messages */
+
+	struct mutex handler_lock;
+	mt6897_vcp_ipi_handler_t handler[MT6897_VCP_IPI_COUNT];
+	void *handler_priv[MT6897_VCP_IPI_COUNT];
+
+	struct work_struct log_work;
+	u32 log_sram;			/* where the firmware reads the log address */
+	struct dentry *debugfs;
+};
+
+/* The coprocessor takes a 36-bit address as 32 bits: the top nibble moves down */
+u32 mt6897_vcp_pack_iova(dma_addr_t iova)
+{
+	return lower_32_bits(iova) | (upper_32_bits(iova) & 0xf);
+}
+EXPORT_SYMBOL_GPL(mt6897_vcp_pack_iova);
+
+static long vcp_smc(struct mt6897_vcp *vcp, u32 function, u32 op, u32 arg)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(function, op, arg, 0, 0, 0, 0, 0, &res);
+	if (res.a0)
+		dev_err(vcp->dev, "secure call %#x(%u, %u) failed: %ld\n", function,
+			op, arg, (long)res.a0);
+	return (long)res.a0;
+}
+
+/* The vendor's rule: a slot starts at an even word, and its pin is half of that */
+static int vcp_layout(struct mt6897_vcp *vcp)
+{
+	unsigned int mbox, i, pin;
+
+	for (mbox = 0; mbox < VCP_MBOX_COUNT; mbox++) {
+		pin = 0;
+		for (i = 0; i < ARRAY_SIZE(vcp_send_pins); i++) {
+			const struct vcp_pin *p = &vcp_send_pins[i];
+
+			if (p->mbox != mbox)
+				continue;
+			vcp->send[p->ipi] = (struct vcp_slot){ mbox, pin, p->words, true };
+			pin += DIV_ROUND_UP(p->words, 2);
+		}
+		for (i = 0; i < ARRAY_SIZE(vcp_recv_pins); i++) {
+			const struct vcp_pin *p = &vcp_recv_pins[i];
+
+			if (p->mbox != mbox)
+				continue;
+			vcp->recv[p->ipi] = (struct vcp_slot){ mbox, pin, p->words, true };
+			pin += DIV_ROUND_UP(p->words, 2);
+		}
+		if (pin > VCP_MBOX_PINS)
+			return -EINVAL;
+	}
+	return 0;
+}
+
+int mt6897_vcp_mem(struct mt6897_vcp *vcp, unsigned int id, struct mt6897_vcp_mem *mem)
+{
+	const struct mt6897_vcp_mem *block;
+
+	if (id >= MT6897_VCP_MEM_COUNT)
+		return -EINVAL;
+	block = &vcp->block[vcp_mem_layout[id].block];
+	if (!block->cpu)
+		return -ENODEV;
+	mem->cpu = block->cpu + vcp_mem_layout[id].offset;
+	mem->iova = block->iova + vcp_mem_layout[id].offset;
+	mem->size = vcp_mem_layout[id].size;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6897_vcp_mem);
+
+/**
+ * mt6897_vcp_dma_device() - the device whose mappings the coprocessor can reach
+ * @vcp: the coprocessor
+ *
+ * The firmware asks its users for working memory of its own. Memory allocated
+ * for this device lies in the window of the coprocessor.
+ */
+struct device *mt6897_vcp_dma_device(struct mt6897_vcp *vcp)
+{
+	return vcp->dev;
+}
+EXPORT_SYMBOL_GPL(mt6897_vcp_dma_device);
+
+static void vcp_free_memory(struct mt6897_vcp *vcp)
+{
+	int i;
+
+	for (i = VCP_BLOCK_COUNT - 1; i >= 0; i--) {
+		struct mt6897_vcp_mem *block = &vcp->block[i];
+
+		if (block->cpu)
+			dma_free_coherent(vcp->dev, block->size, block->cpu, block->iova);
+		block->cpu = NULL;
+	}
+}
+
+static int vcp_alloc_memory(struct mt6897_vcp *vcp)
+{
+	int i;
+
+	if (vcp->block[0].cpu)
+		return 0;
+	vcp->shm_lower = VCP_SHM_END;
+	vcp->shm_upper = VCP_SHM_BASE;
+	for (i = 0; i < VCP_BLOCK_COUNT; i++) {
+		struct mt6897_vcp_mem *block = &vcp->block[i];
+
+		block->size = vcp_block_sizes[i];
+		block->cpu = dma_alloc_coherent(vcp->dev, block->size, &block->iova,
+						GFP_KERNEL);
+		if (!block->cpu) {
+			vcp_free_memory(vcp);
+			return -ENOMEM;
+		}
+		if (block->iova < VCP_SHM_BASE || block->iova + block->size > VCP_SHM_END ||
+		    (block->iova & 0xf)) {
+			dev_err(vcp->dev, "memory at %pad is outside the window\n",
+				&block->iova);
+			vcp_free_memory(vcp);
+			return -ERANGE;
+		}
+		vcp->shm_lower = min(vcp->shm_lower, block->iova);
+		vcp->shm_upper = max(vcp->shm_upper, block->iova + block->size);
+	}
+	return 0;
+}
+
+int mt6897_vcp_ipi_register(struct mt6897_vcp *vcp, unsigned int ipi,
+			    mt6897_vcp_ipi_handler_t handler, void *priv)
+{
+	int ret = 0;
+
+	if (ipi >= MT6897_VCP_IPI_COUNT || !vcp->recv[ipi].valid || !handler ||
+	    ipi == MT6897_VCP_IPI_IN_READY_0 || ipi == MT6897_VCP_IPI_IN_READY_1 ||
+	    ipi == MT6897_VCP_IPI_IN_LOGGER_CTRL)
+		return -EINVAL;
+	mutex_lock(&vcp->handler_lock);
+	if (vcp->handler[ipi]) {
+		ret = -EBUSY;
+	} else {
+		vcp->handler_priv[ipi] = priv;
+		vcp->handler[ipi] = handler;
+	}
+	mutex_unlock(&vcp->handler_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6897_vcp_ipi_register);
+
+void mt6897_vcp_ipi_unregister(struct mt6897_vcp *vcp, unsigned int ipi)
+{
+	if (ipi >= MT6897_VCP_IPI_COUNT)
+		return;
+	mutex_lock(&vcp->handler_lock);
+	vcp->handler[ipi] = NULL;
+	vcp->handler_priv[ipi] = NULL;
+	mutex_unlock(&vcp->handler_lock);
+}
+EXPORT_SYMBOL_GPL(mt6897_vcp_ipi_unregister);
+
+/*
+ * Fill the slot and raise its pin. The firmware lowers the pin when it has
+ * taken the message; an answer, if the message has one, comes as a message of
+ * its own.
+ */
+int mt6897_vcp_ipi_send(struct mt6897_vcp *vcp, unsigned int ipi,
+			const void *data, size_t len)
+{
+	const struct vcp_slot *slot;
+	u32 words[VCP_IPI_MAX_WORDS] = {};
+	void __iomem *base;
+	u32 status;
+	int ret;
+
+	if (ipi >= MT6897_VCP_IPI_COUNT || !vcp->send[ipi].valid)
+		return -EINVAL;
+	slot = &vcp->send[ipi];
+	if (!data || !len || len > slot->words * sizeof(u32))
+		return -EINVAL;
+	memcpy(words, data, len);
+	base = vcp->mbox[slot->mbox].base;
+
+	mutex_lock(&vcp->send_lock);
+	if (!vcp->up) {
+		ret = -EHOSTDOWN;
+		goto unlock;
+	}
+	ret = readl_poll_timeout(base + VCP_MBOX_SET, status, !(status & BIT(slot->pin)),
+				 50, VCP_SEND_US);
+	if (ret)
+		goto unlock;
+	__iowrite32_copy(base + slot->pin * 2 * sizeof(u32), words, slot->words);
+	/* The message has to be there before the pin goes up */
+	wmb();
+	writel(BIT(slot->pin), base + VCP_MBOX_SET);
+	ret = readl_poll_timeout(base + VCP_MBOX_SET, status, !(status & BIT(slot->pin)),
+				 50, VCP_SEND_US);
+unlock:
+	mutex_unlock(&vcp->send_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6897_vcp_ipi_send);
+
+static void vcp_ready(struct mt6897_vcp *vcp, u32 size)
+{
+	vcp->ready_size = size;
+	if (size == VCP_TCM_SIZE) {
+		mutex_lock(&vcp->send_lock);
+		/* The vendor's patch: take the interrupt to the SPM away */
+		writel(0xff, vcp->cfg + VCP_TO_SPM);
+		vcp->up = true;
+		mutex_unlock(&vcp->send_lock);
+	}
+	complete(&vcp->ready);
+}
+
+static void vcp_receive(struct mt6897_vcp *vcp, unsigned int ipi, const u32 *words,
+			unsigned int count)
+{
+	switch (ipi) {
+	case MT6897_VCP_IPI_IN_READY_0:
+	case MT6897_VCP_IPI_IN_READY_1:
+		/* Either hart may say it: the vendor takes the first */
+		vcp_ready(vcp, words[0]);
+		return;
+	case MT6897_VCP_IPI_IN_LOGGER_CTRL:
+		if (words[0] == VCP_LOG_IPI_INIT) {
+			vcp->log_sram = words[1];
+			schedule_work(&vcp->log_work);
+		}
+		return;
+	case MT6897_VCP_IPI_IN_ERROR_INFO_0:
+	case MT6897_VCP_IPI_IN_ERROR_INFO_1:
+		dev_err(vcp->dev, "the firmware reports an error: %*ph\n",
+			(int)(count * sizeof(u32)), words);
+		return;
+	}
+
+	mutex_lock(&vcp->handler_lock);
+	if (vcp->handler[ipi])
+		vcp->handler[ipi](vcp->handler_priv[ipi], words, count * sizeof(u32));
+	else
+		dev_warn_ratelimited(vcp->dev, "message %u has no taker\n", ipi);
+	mutex_unlock(&vcp->handler_lock);
+}
+
+static irqreturn_t vcp_mbox_irq(int irq, void *priv)
+{
+	struct vcp_mbox *mbox = priv;
+	struct mt6897_vcp *vcp = mbox->vcp;
+	u32 words[VCP_MBOX_WORDS], status;
+	unsigned int ipi;
+
+	status = readl(mbox->base + VCP_MBOX_CLR);
+	if (!status)
+		return IRQ_NONE;
+	/* Copy before the acknowledge: the firmware may use a slot again at once */
+	__ioread32_copy(words, mbox->base, ARRAY_SIZE(words));
+	writel(status, mbox->base + VCP_MBOX_CLR);
+
+	for (ipi = 0; ipi < MT6897_VCP_IPI_COUNT; ipi++) {
+		const struct vcp_slot *slot = &vcp->recv[ipi];
+
+		if (!slot->valid || slot->mbox != mbox->index || !(status & BIT(slot->pin)))
+			continue;
+		status &= ~BIT(slot->pin);
+		vcp_receive(vcp, ipi, &words[slot->pin * 2], slot->words);
+	}
+	if (status)
+		dev_warn_ratelimited(vcp->dev, "mailbox %u: pins %#x are not known\n",
+				     mbox->index, status);
+	return IRQ_HANDLED;
+}
+
+/* The firmware stopped answering its own watchdog. Nobody restarts it here. */
+static irqreturn_t vcp_wdt_irq(int irq, void *priv)
+{
+	struct mt6897_vcp *vcp = priv;
+	u32 value;
+
+	if (!(readl(vcp->core + VCP_CORE_WDT_IRQ) & BIT(0)))
+		return IRQ_NONE;
+	dev_err(vcp->dev, "watchdog: status %#x pc %#x lr %#x\n",
+		readl(vcp->core + VCP_CORE_STATUS), readl(vcp->core + VCP_CORE_MON_PC),
+		readl(vcp->core + VCP_CORE_MON_LR));
+	/* The firmware has to finish its own handler before the interrupt is cleared */
+	readl_poll_timeout(vcp->core + VCP_CORE_REBOOT_H0, value,
+			   value == VCP_READY_TO_REBOOT, 10, 50000);
+	writel(BIT(0), vcp->core + VCP_CORE_WDT_IRQ);
+	mutex_lock(&vcp->send_lock);
+	vcp->up = false;
+	mutex_unlock(&vcp->send_lock);
+	return IRQ_HANDLED;
+}
+
+static void vcp_irqs(struct mt6897_vcp *vcp, bool on)
+{
+	int i;
+
+	for (i = 0; i < VCP_MBOX_COUNT; i++) {
+		void __iomem *base = vcp->mbox[i].base;
+
+		if (on) {
+			writel(readl(base + VCP_MBOX_CLR), base + VCP_MBOX_CLR);
+			enable_irq(vcp->mbox[i].irq);
+		} else {
+			disable_irq(vcp->mbox[i].irq);
+		}
+	}
+	if (on)
+		enable_irq(vcp->wdt_irq);
+	else
+		disable_irq(vcp->wdt_irq);
+}
+
+/* The log ring starts empty at every start of the firmware */
+static void vcp_log_reset(struct mt6897_vcp *vcp)
+{
+	struct mt6897_vcp_mem mem;
+	struct vcp_log_ctrl *ctrl;
+
+	mt6897_vcp_mem(vcp, MT6897_VCP_MEM_LOGGER, &mem);
+	ctrl = mem.cpu;
+	memset(mem.cpu, 0, VCP_LOG_BUF_OFFSET);
+	ctrl->magic = cpu_to_le32(VCP_LOG_MAGIC);
+	ctrl->size = cpu_to_le32(sizeof(*ctrl));
+	ctrl->info_offset = cpu_to_le32(VCP_LOG_INFO_OFFSET);
+	ctrl->buf_offset = cpu_to_le32(VCP_LOG_BUF_OFFSET);
+	ctrl->buf_size = cpu_to_le32(VCP_LOG_BUF_SIZE);
+}
+
+/*
+ * The firmware asked for its log buffer. It reads the address from a word of
+ * its SRAM and from the answer, and writes only once the log is switched on.
+ */
+static void vcp_log_work(struct work_struct *work)
+{
+	struct mt6897_vcp *vcp = container_of(work, struct mt6897_vcp, log_work);
+	struct mt6897_vcp_mem mem;
+	struct vcp_log_ctrl *ctrl;
+	u64 now = local_clock();
+	u32 msg[6] = {};
+	int ret;
+
+	if (mt6897_vcp_mem(vcp, MT6897_VCP_MEM_LOGGER, &mem))
+		return;
+	ctrl = mem.cpu;
+
+	mutex_lock(&vcp->send_lock);
+	if (vcp->up && vcp->log_sram <= VCP_TCM_SIZE - sizeof(u32) && !(vcp->log_sram & 3))
+		writel(mt6897_vcp_pack_iova(mem.iova), vcp->sram + vcp->log_sram);
+	mutex_unlock(&vcp->send_lock);
+
+	msg[0] = VCP_LOG_IPI_INIT;
+	msg[1] = mt6897_vcp_pack_iova(mem.iova);
+	msg[2] = mem.size;
+	msg[3] = upper_32_bits(now);
+	msg[4] = lower_32_bits(now);
+	ret = mt6897_vcp_ipi_send(vcp, MT6897_VCP_IPI_OUT_LOGGER_CTRL, msg, sizeof(msg));
+	if (!ret) {
+		usleep_range(1000, 2000);
+		memset(msg, 0, sizeof(msg));
+		msg[0] = VCP_LOG_IPI_ENABLE;
+		msg[1] = VCP_LOG_ON;
+		ret = mt6897_vcp_ipi_send(vcp, MT6897_VCP_IPI_OUT_LOGGER_CTRL, msg,
+					  sizeof(msg));
+	}
+	if (ret)
+		dev_warn(vcp->dev, "the firmware did not take the log setup: %d\n", ret);
+	else
+		ctrl->enable = cpu_to_le32(1);
+}
+
+static void vcp_power_off(struct mt6897_vcp *vcp)
+{
+	pm_runtime_put_sync(vcp->dev);
+	clk_bulk_disable_unprepare(ARRAY_SIZE(vcp->clocks), vcp->clocks);
+}
+
+/* Reset through the secure monitor, then close the registers again */
+static void vcp_reset(struct mt6897_vcp *vcp, bool orderly)
+{
+	mutex_lock(&vcp->send_lock);
+	vcp->up = false;
+	mutex_unlock(&vcp->send_lock);
+	vcp_smc(vcp, VCP_CONTROL, VCP_OP_RESET_SET, orderly);
+	vcp_smc(vcp, VCP_DAPC_CONTROL, 0, 0);
+}
+
+/* Called with the coprocessor released: its SRAM and registers can be read */
+static void vcp_report_timeout(struct mt6897_vcp *vcp)
+{
+	struct vcp_region_info info;
+
+	memcpy_fromio(&info, vcp->sram + VCP_REGION_OFFSET, sizeof(info));
+	dev_err(vcp->dev,
+		"no ready message in %u ms: status %#x pc %#x lr %#x sp %#x hart1 pc %#x\n",
+		VCP_READY_MS, readl(vcp->core + VCP_CORE_STATUS),
+		readl(vcp->core + VCP_CORE_MON_PC), readl(vcp->core + VCP_CORE_MON_LR),
+		readl(vcp->core + VCP_CORE_MON_SP), readl(vcp->core + VCP_CORE_H1_MON_PC));
+	dev_err(vcp->dev,
+		"what the bootloader left: loader %#x+%#x firmware %#x+%#x data %#x+%#x, first word of the firmware %#x\n",
+		le32_to_cpu(info.loader_start), le32_to_cpu(info.loader_size),
+		le32_to_cpu(info.firmware_start), le32_to_cpu(info.firmware_size),
+		le32_to_cpu(info.dram_start), le32_to_cpu(info.dram_size),
+		readl(vcp->sram + (le32_to_cpu(info.loader_size) & (VCP_TCM_SIZE - 4))));
+}
+
+static int vcp_boot(struct mt6897_vcp *vcp)
+{
+	int ret;
+
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(vcp->clocks), vcp->clocks);
+	if (ret)
+		return ret;
+	ret = pm_runtime_resume_and_get(vcp->dev);
+	if (ret < 0) {
+		clk_bulk_disable_unprepare(ARRAY_SIZE(vcp->clocks), vcp->clocks);
+		return ret;
+	}
+	ret = vcp_alloc_memory(vcp);
+	if (ret)
+		goto power_off;
+	vcp_log_reset(vcp);
+
+	if (vcp_smc(vcp, VCP_DAPC_CONTROL, 1, 0)) {
+		ret = -EIO;
+		goto power_off;
+	}
+	/* The vendor selects 26 MHz first and the PLL then, to have both in step */
+	ret = clk_set_parent(vcp->clocks[0].clk, vcp->clocks[2].clk);
+	if (!ret)
+		ret = clk_set_parent(vcp->clocks[0].clk, vcp->clocks[1].clk);
+	if (ret) {
+		dev_err(vcp->dev, "clock parent: %d\n", ret);
+		goto close;
+	}
+	writel(mt6897_vcp_pack_iova(vcp->shm_lower), vcp->core + VCP_CORE_SHM_ADDR);
+	writel(vcp->shm_upper - vcp->shm_lower, vcp->core + VCP_CORE_SHM_SIZE);
+
+	reinit_completion(&vcp->ready);
+	vcp->ready_size = 0;
+	vcp_irqs(vcp, true);
+	if (vcp_smc(vcp, VCP_CONTROL, VCP_OP_RESET_RELEASE, 1)) {
+		ret = -EIO;
+		goto irqs_off;
+	}
+	if (!wait_for_completion_timeout(&vcp->ready, msecs_to_jiffies(VCP_READY_MS))) {
+		vcp_report_timeout(vcp);
+		ret = -ETIMEDOUT;
+		goto irqs_off;
+	}
+	if (vcp->ready_size != VCP_TCM_SIZE) {
+		dev_err(vcp->dev, "the firmware reports an SRAM of %#x\n", vcp->ready_size);
+		ret = -EPROTO;
+		goto irqs_off;
+	}
+	return 0;
+
+irqs_off:
+	vcp_irqs(vcp, false);
+	cancel_work_sync(&vcp->log_work);
+	vcp_reset(vcp, false);
+	goto power_off;
+close:
+	vcp_smc(vcp, VCP_DAPC_CONTROL, 0, 0);
+power_off:
+	vcp_power_off(vcp);
+	return ret;
+}
+
+static bool vcp_parked(struct mt6897_vcp *vcp)
+{
+	return readl(vcp->core + VCP_CORE_REBOOT_H0) == VCP_READY_TO_REBOOT &&
+	       readl(vcp->core + VCP_CORE_REBOOT_H1) == VCP_READY_TO_REBOOT;
+}
+
+static void vcp_shutdown(struct mt6897_vcp *vcp)
+{
+	bool parked;
+	u32 status;
+	int ret;
+
+	mutex_lock(&vcp->send_lock);
+	vcp->up = false;
+	mutex_unlock(&vcp->send_lock);
+	vcp_irqs(vcp, false);
+	cancel_work_sync(&vcp->log_work);
+
+	/* Ask both harts to park, then wait for the core to stop */
+	writel(VCP_GIPC_HALT, vcp->cfg + VCP_GIPC_IN_SET);
+	ret = read_poll_timeout(vcp_parked, parked, parked, 100, 200000, false, vcp);
+	if (!ret)
+		ret = readl_poll_timeout(vcp->core + VCP_CORE_STATUS, status,
+					 status == VCP_STATUS_STOPPED, 1000, 500000);
+	if (ret)
+		dev_warn(vcp->dev, "the firmware did not park: %#x %#x, status %#x\n",
+			 readl(vcp->core + VCP_CORE_REBOOT_H0),
+			 readl(vcp->core + VCP_CORE_REBOOT_H1),
+			 readl(vcp->core + VCP_CORE_STATUS));
+	udelay(10);
+	vcp_reset(vcp, !ret);
+	vcp_power_off(vcp);
+}
+
+/**
+ * mt6897_vcp_start() - have the firmware running
+ * @vcp: the coprocessor
+ *
+ * The first user starts the coprocessor and waits for its ready message.
+ * Every call that returns 0 is paired with mt6897_vcp_stop().
+ */
+int mt6897_vcp_start(struct mt6897_vcp *vcp)
+{
+	int ret = 0;
+
+	mutex_lock(&vcp->lock);
+	if (!vcp->users)
+		ret = vcp_boot(vcp);
+	if (!ret)
+		vcp->users++;
+	mutex_unlock(&vcp->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6897_vcp_start);
+
+void mt6897_vcp_stop(struct mt6897_vcp *vcp)
+{
+	mutex_lock(&vcp->lock);
+	if (!WARN_ON(!vcp->users) && !--vcp->users)
+		vcp_shutdown(vcp);
+	mutex_unlock(&vcp->lock);
+}
+EXPORT_SYMBOL_GPL(mt6897_vcp_stop);
+
+/**
+ * mt6897_vcp_get() - find the coprocessor a device names with "mediatek,vcp"
+ * @consumer: the user of the firmware
+ *
+ * The consumer is unbound before the coprocessor goes away.
+ */
+struct mt6897_vcp *mt6897_vcp_get(struct device *consumer)
+{
+	struct platform_device *pdev;
+	struct device_node *node;
+	struct mt6897_vcp *vcp;
+
+	node = of_parse_phandle(consumer->of_node, "mediatek,vcp", 0);
+	if (!node)
+		return ERR_PTR(-ENODEV);
+	pdev = of_find_device_by_node(node);
+	of_node_put(node);
+	if (!pdev)
+		return ERR_PTR(-EPROBE_DEFER);
+	vcp = platform_get_drvdata(pdev);
+	if (!vcp || !device_link_add(consumer, &pdev->dev, DL_FLAG_AUTOREMOVE_CONSUMER))
+		vcp = ERR_PTR(-EPROBE_DEFER);
+	put_device(&pdev->dev);
+	return vcp;
+}
+EXPORT_SYMBOL_GPL(mt6897_vcp_get);
+
+/* debugfs: hold (start without a user, for bring-up), state, log */
+
+static int vcp_hold_get(void *data, u64 *value)
+{
+	struct mt6897_vcp *vcp = data;
+
+	*value = vcp->held;
+	return 0;
+}
+
+static int vcp_hold_set(void *data, u64 value)
+{
+	struct mt6897_vcp *vcp = data;
+	int ret = 0;
+
+	if (!!value == vcp->held)
+		return 0;
+	if (value)
+		ret = mt6897_vcp_start(vcp);
+	else
+		mt6897_vcp_stop(vcp);
+	if (!ret)
+		vcp->held = value;
+	return ret;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(vcp_hold_fops, vcp_hold_get, vcp_hold_set, "%llu\n");
+
+static int vcp_state_show(struct seq_file *s, void *unused)
+{
+	struct mt6897_vcp *vcp = s->private;
+	struct mt6897_vcp_mem mem;
+
+	mutex_lock(&vcp->lock);
+	seq_printf(s, "users %u up %d ready size %#x\n", vcp->users, vcp->up,
+		   vcp->ready_size);
+	if (vcp->users) {
+		seq_printf(s, "status %#x pc %#x lr %#x sp %#x hart1 pc %#x\n",
+			   readl(vcp->core + VCP_CORE_STATUS),
+			   readl(vcp->core + VCP_CORE_MON_PC),
+			   readl(vcp->core + VCP_CORE_MON_LR),
+			   readl(vcp->core + VCP_CORE_MON_SP),
+			   readl(vcp->core + VCP_CORE_H1_MON_PC));
+		seq_printf(s, "shared memory %pad..%pad\n", &vcp->shm_lower,
+			   &vcp->shm_upper);
+	}
+	if (!mt6897_vcp_mem(vcp, MT6897_VCP_MEM_LOGGER, &mem)) {
+		const struct vcp_log_ctrl *ctrl = mem.cpu;
+		const struct vcp_log_pos *pos = mem.cpu + VCP_LOG_INFO_OFFSET;
+
+		seq_printf(s, "log on %u read %#x write %#x\n", le32_to_cpu(ctrl->enable),
+			   le32_to_cpu(pos->read), le32_to_cpu(pos->write));
+	}
+	mutex_unlock(&vcp->lock);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(vcp_state);
+
+/* What the firmware wrote since the last read. Nothing new reads as the end. */
+static ssize_t vcp_log_read(struct file *file, char __user *buf, size_t len, loff_t *ppos)
+{
+	struct mt6897_vcp *vcp = file->private_data;
+	struct mt6897_vcp_mem mem;
+	struct vcp_log_pos *pos;
+	u32 read, write;
+	ssize_t ret = 0;
+
+	mutex_lock(&vcp->lock);
+	if (mt6897_vcp_mem(vcp, MT6897_VCP_MEM_LOGGER, &mem))
+		goto unlock;
+	pos = mem.cpu + VCP_LOG_INFO_OFFSET;
+	read = le32_to_cpu(pos->read);
+	write = le32_to_cpu(pos->write);
+	if (read >= VCP_LOG_BUF_SIZE || write > VCP_LOG_BUF_SIZE) {
+		ret = -EIO;
+		goto unlock;
+	}
+	if (read == write || (!read && write == VCP_LOG_BUF_SIZE))
+		goto unlock;
+	len = min_t(size_t, len, read > write ? VCP_LOG_BUF_SIZE - read : write - read);
+	if (copy_to_user(buf, mem.cpu + VCP_LOG_BUF_OFFSET + read, len)) {
+		ret = -EFAULT;
+		goto unlock;
+	}
+	read += len;
+	if (read >= VCP_LOG_BUF_SIZE)
+		read -= VCP_LOG_BUF_SIZE;
+	pos->read = cpu_to_le32(read);
+	ret = len;
+unlock:
+	mutex_unlock(&vcp->lock);
+	return ret;
+}
+
+static const struct file_operations vcp_log_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = vcp_log_read,
+};
+
+static int vcp_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mt6897_vcp *vcp;
+	int i, ret;
+
+	if (!iommu_get_domain_for_dev(dev))
+		return dev_err_probe(dev, -EPROBE_DEFER, "no IOMMU domain yet\n");
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(34));
+	if (ret)
+		return ret;
+
+	vcp = devm_kzalloc(dev, sizeof(*vcp), GFP_KERNEL);
+	if (!vcp)
+		return -ENOMEM;
+	vcp->dev = dev;
+	mutex_init(&vcp->lock);
+	mutex_init(&vcp->send_lock);
+	mutex_init(&vcp->handler_lock);
+	init_completion(&vcp->ready);
+	INIT_WORK(&vcp->log_work, vcp_log_work);
+	ret = vcp_layout(vcp);
+	if (ret)
+		return ret;
+
+	vcp->sram = devm_platform_ioremap_resource_byname(pdev, "sram");
+	if (IS_ERR(vcp->sram))
+		return PTR_ERR(vcp->sram);
+	vcp->cfg = devm_platform_ioremap_resource_byname(pdev, "cfg");
+	if (IS_ERR(vcp->cfg))
+		return PTR_ERR(vcp->cfg);
+	vcp->core = devm_platform_ioremap_resource_byname(pdev, "core0");
+	if (IS_ERR(vcp->core))
+		return PTR_ERR(vcp->core);
+
+	vcp->clocks[0].id = "mmup-sel";
+	vcp->clocks[1].id = "mmup-clk";
+	vcp->clocks[2].id = "mmup-26m";
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(vcp->clocks), vcp->clocks);
+	if (ret)
+		return dev_err_probe(dev, ret, "clocks\n");
+
+	for (i = 0; i < VCP_MBOX_COUNT; i++) {
+		struct vcp_mbox *mbox = &vcp->mbox[i];
+		char name[8];
+
+		snprintf(name, sizeof(name), "mbox%d", i);
+		mbox->vcp = vcp;
+		mbox->index = i;
+		mbox->base = devm_platform_ioremap_resource_byname(pdev, name);
+		if (IS_ERR(mbox->base))
+			return PTR_ERR(mbox->base);
+		mbox->irq = platform_get_irq_byname(pdev, name);
+		if (mbox->irq < 0)
+			return mbox->irq;
+		ret = devm_request_threaded_irq(dev, mbox->irq, NULL, vcp_mbox_irq,
+						IRQF_ONESHOT | IRQF_NO_AUTOEN,
+						dev_name(dev), mbox);
+		if (ret)
+			return ret;
+	}
+	vcp->wdt_irq = platform_get_irq_byname(pdev, "wdt");
+	if (vcp->wdt_irq < 0)
+		return vcp->wdt_irq;
+	ret = devm_request_threaded_irq(dev, vcp->wdt_irq, NULL, vcp_wdt_irq,
+					IRQF_ONESHOT | IRQF_NO_AUTOEN, dev_name(dev), vcp);
+	if (ret)
+		return ret;
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+	platform_set_drvdata(pdev, vcp);
+
+	vcp->debugfs = debugfs_create_dir("mt6897-vcp", NULL);
+	debugfs_create_file("hold", 0600, vcp->debugfs, vcp, &vcp_hold_fops);
+	debugfs_create_file("state", 0400, vcp->debugfs, vcp, &vcp_state_fops);
+	debugfs_create_file("log", 0400, vcp->debugfs, vcp, &vcp_log_fops);
+	return 0;
+}
+
+static void vcp_remove(struct platform_device *pdev)
+{
+	struct mt6897_vcp *vcp = platform_get_drvdata(pdev);
+
+	debugfs_remove_recursive(vcp->debugfs);
+	mutex_lock(&vcp->lock);
+	/* Users are unbound by now: what is left is the debugfs switch */
+	if (vcp->users) {
+		vcp->users = 0;
+		vcp_shutdown(vcp);
+	}
+	vcp_free_memory(vcp);
+	mutex_unlock(&vcp->lock);
+}
+
+/* A sleep with the firmware running is not worked out: its user stops it first */
+static int vcp_suspend(struct device *dev)
+{
+	struct mt6897_vcp *vcp = dev_get_drvdata(dev);
+
+	return vcp->users ? -EBUSY : 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(vcp_pm_ops, vcp_suspend, NULL);
+
+static const struct of_device_id vcp_of_match[] = {
+	{ .compatible = "mediatek,mt6897-vcp" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, vcp_of_match);
+
+static struct platform_driver vcp_driver = {
+	.probe = vcp_probe,
+	.remove = vcp_remove,
+	.driver = {
+		.name = "mt6897-vcp",
+		.of_match_table = vcp_of_match,
+		.pm = pm_sleep_ptr(&vcp_pm_ops),
+	},
+};
+module_platform_driver(vcp_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6897 video coprocessor");
+MODULE_LICENSE("GPL");
