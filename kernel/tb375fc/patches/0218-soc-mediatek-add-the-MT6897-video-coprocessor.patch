+++ b/include/linux/soc/mediatek/mt6897-vcp.h
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * MT6897 video coprocessor (VCP): what a user of the firmware needs.
+ */
+#ifndef __SOC_MEDIATEK_MT6897_VCP_H
+#define __SOC_MEDIATEK_MT6897_VCP_H
+
+#include <linux/types.h>
+
+struct device;
+struct mt6897_vcp;
+
+/*
+ * Messages of the firmware. The numbers are those of the stock device tree
+ * (send-table and recv-table of the vcp node).
+ */
+enum {
+	MT6897_VCP_IPI_OUT_VDEC_1		= 0,
+	MT6897_VCP_IPI_IN_VDEC_1		= 1,
+	MT6897_VCP_IPI_C_SLEEP_0		= 2,
+	MT6897_VCP_IPI_OUT_TEST_0		= 3,
+	MT6897_VCP_IPI_IN_ERROR_INFO_0		= 4,
+	MT6897_VCP_IPI_IN_READY_0		= 5,
+	MT6897_VCP_IPI_IN_RAM_DUMP_0		= 6,
+	MT6897_VCP_IPI_OUT_MMDVFS		= 9,
+	MT6897_VCP_IPI_IN_MMDVFS		= 10,
+	MT6897_VCP_IPI_OUT_MMQOS		= 11,
+	MT6897_VCP_IPI_IN_MMQOS			= 12,
+	MT6897_VCP_IPI_OUT_MMDEBUG		= 13,
+	MT6897_VCP_IPI_IN_MMDEBUG		= 14,
+	MT6897_VCP_IPI_HWVOTER_DEBUG		= 15,
+	MT6897_VCP_IPI_OUT_VENC_0		= 16,
+	MT6897_VCP_IPI_IN_VENC_0		= 17,
+	MT6897_VCP_IPI_OUT_MPOOL_0		= 18,
+	MT6897_VCP_IPI_IN_MPOOL_0		= 19,
+	MT6897_VCP_IPI_C_SLEEP_1		= 20,
+	MT6897_VCP_IPI_OUT_TEST_1		= 21,
+	MT6897_VCP_IPI_OUT_LOGGER_CTRL		= 22,
+	MT6897_VCP_IPI_OUT_VCPCTL_1		= 23,
+	MT6897_VCP_IPI_IN_ERROR_INFO_1		= 24,
+	MT6897_VCP_IPI_IN_LOGGER_CTRL		= 25,
+	MT6897_VCP_IPI_IN_READY_1		= 26,
+	MT6897_VCP_IPI_IN_RAM_DUMP_1		= 27,
+	MT6897_VCP_IPI_OUT_MPOOL_1		= 28,
+	MT6897_VCP_IPI_IN_MPOOL_1		= 29,
+	MT6897_VCP_IPI_COUNT
+};
+
+/* Memory the firmware shares with the kernel (vcp-mem-tbl of the stock tree) */
+enum {
+	MT6897_VCP_MEM_VDEC,
+	MT6897_VCP_MEM_VENC,
+	MT6897_VCP_MEM_LOGGER,
+	MT6897_VCP_MEM_VDEC_PROP,
+	MT6897_VCP_MEM_VENC_PROP,
+	MT6897_VCP_MEM_VDEC_LOG,
+	MT6897_VCP_MEM_VENC_LOG,
+	MT6897_VCP_MEM_GCE,
+	MT6897_VCP_MEM_MMDVFS,
+	MT6897_VCP_MEM_MMQOS,
+	MT6897_VCP_MEM_COUNT
+};
+
+struct mt6897_vcp_mem {
+	void *cpu;
+	dma_addr_t iova;
+	size_t size;
+};
+
+/* Called from a thread. @data is a copy and @len is the size of the slot. */
+typedef void (*mt6897_vcp_ipi_handler_t)(void *priv, const void *data, size_t len);
+
+struct mt6897_vcp *mt6897_vcp_get(struct device *consumer);
+int mt6897_vcp_start(struct mt6897_vcp *vcp);
+void mt6897_vcp_stop(struct mt6897_vcp *vcp);
+int mt6897_vcp_ipi_register(struct mt6897_vcp *vcp, unsigned int ipi,
+			    mt6897_vcp_ipi_handler_t handler, void *priv);
+void mt6897_vcp_ipi_unregister(struct mt6897_vcp *vcp, unsigned int ipi);
+int mt6897_vcp_ipi_send(struct mt6897_vcp *vcp, unsigned int ipi,
+			const void *data, size_t len);
+int mt6897_vcp_mem(struct mt6897_vcp *vcp, unsigned int id,
+		   struct mt6897_vcp_mem *mem);
+u32 mt6897_vcp_pack_iova(dma_addr_t iova);
+struct device *mt6897_vcp_dma_device(struct mt6897_vcp *vcp);
+
+#endif
