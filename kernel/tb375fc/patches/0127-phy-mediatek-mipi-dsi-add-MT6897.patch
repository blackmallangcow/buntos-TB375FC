index 0000000000000000000000000000000000000000..d7272302f167a239411bac62664e4aa2ea791fe6
--- /dev/null
+++ b/drivers/phy/mediatek/phy-mtk-mipi-dsi-mt6897.c
@@ -0,0 +1,239 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2019 MediaTek Inc.
+ * Author: jitao.shi <jitao.shi@mediatek.com>
+ *
+ * Copyright (c) 2026 buntOS contributors
+ */
+
+#include "phy-mtk-io.h"
+#include "phy-mtk-mipi-dsi.h"
+
+#define MIPITX_LANE_CON		0x0004
+#define RG_DSI_LANE_CON_TIE_LOW		0x3fff0100
+#define RG_DSI_LANE_CON_BG_ON_TIE_LOW	0x3fff0180
+#define RG_DSI_LANE_CON_BG_ON		0x3fff0080
+#define RG_DSI_DEM_EN			BIT(9)
+
+#define MIPITX_VOLTAGE_SEL	0x0008
+#define RG_DSI_PRD_REF_SEL		GENMASK(5, 0)
+
+#define MIPITX_PRESERVED	0x000c
+#define MIPITX_PRESERVED_VALUE		0xffff00f0
+#define MIPITX_PRESERVED_VALUE_HIGH	0xffff0030
+
+#define MIPITX_PLL_PWR		0x0028
+#define AD_DSI_PLL_SDM_PWR_ON		BIT(0)
+#define AD_DSI_PLL_SDM_ISO_EN		BIT(1)
+
+#define MIPITX_PLL_CON0		0x002c
+#define MIPITX_PLL_CON1		0x0030
+#define RG_DSI_PLL_EN			BIT(0)
+#define RG_DSI_PLL_POSDIV		GENMASK(10, 8)
+#define RG_DSI_PLL_FBSEL		BIT(13)
+#define RG_DSI_PLL_DIV3_EN		BIT(28)
+
+#define MIPITX_PLL_CON4		0x003c
+#define MIPITX_PLL_CON4_VALUE		0x00ff12e0
+
+#define MIPITX_PHY_SEL0		0x0040
+#define MIPITX_LPRX0_LN_SEL		GENMASK(6, 4)
+#define MIPITX_LPRX1_LN_SEL		GENMASK(10, 8)
+
+#define MIPITX_SW_CTRL_CON4	0x0050
+#define MIPITX_SW_ANA_CK_EN		BIT(0)
+
+#define MIPITX_D2P_RTCODE0	0x0100
+#define MIPITX_D2N_RTCODE0	0x0108
+#define MIPITX_D2P_RT_DEM_CODE	0x01c4
+#define MIPITX_D2N_RT_DEM_CODE	0x01c8
+#define MIPITX_NUM_RT_LANES	6
+
+#define MIPITX_CK_CKMODE_EN	0x0320
+#define DSI_CK_CKMODE_EN		BIT(0)
+
+/*
+ * The vendor's panel asks for 1004 Mbps, and programs the PLL to 998.137 Mbps
+ * with the divider of the higher rate. Stay on the same side of that divider.
+ */
+#define MIPITX_DIV2_MIN_RATE	990000000
+
+/*
+ * The bootloader trims the lanes. Nothing here knows the trim values, so keep
+ * what it left, and write it back whenever the PHY comes up again.
+ */
+struct mt6897_mipi_tx_trim {
+	u32 p[MIPITX_NUM_RT_LANES];
+	u32 n[MIPITX_NUM_RT_LANES];
+	u32 dem_p[MIPITX_NUM_RT_LANES];
+	u32 dem_n[MIPITX_NUM_RT_LANES];
+};
+
+/* Lanes D2, D0, CK, D1, D3 and the second clock lane, skipping one block */
+static unsigned int mt6897_mipi_tx_lane_ofs(unsigned int lane)
+{
+	return (lane == MIPITX_NUM_RT_LANES - 1 ? lane + 1 : lane) * 0x100;
+}
+
+static void mt6897_mipi_tx_save_trim(struct mtk_mipi_tx *mipi_tx)
+{
+	struct mt6897_mipi_tx_trim *trim = mipi_tx->priv;
+	void __iomem *base = mipi_tx->regs;
+	unsigned int i, ofs;
+
+	for (i = 0; i < MIPITX_NUM_RT_LANES; i++) {
+		ofs = mt6897_mipi_tx_lane_ofs(i);
+		trim->p[i] = readl(base + MIPITX_D2P_RTCODE0 + ofs);
+		trim->n[i] = readl(base + MIPITX_D2N_RTCODE0 + ofs);
+		trim->dem_p[i] = readl(base + MIPITX_D2P_RT_DEM_CODE + ofs);
+		trim->dem_n[i] = readl(base + MIPITX_D2N_RT_DEM_CODE + ofs);
+	}
+}
+
+static void mt6897_mipi_tx_restore_trim(struct mtk_mipi_tx *mipi_tx)
+{
+	struct mt6897_mipi_tx_trim *trim = mipi_tx->priv;
+	void __iomem *base = mipi_tx->regs;
+	unsigned int i, ofs;
+
+	for (i = 0; i < MIPITX_NUM_RT_LANES; i++) {
+		ofs = mt6897_mipi_tx_lane_ofs(i);
+		writel(trim->p[i], base + MIPITX_D2P_RTCODE0 + ofs);
+		writel(trim->n[i], base + MIPITX_D2N_RTCODE0 + ofs);
+		writel(trim->dem_p[i], base + MIPITX_D2P_RT_DEM_CODE + ofs);
+		writel(trim->dem_n[i], base + MIPITX_D2N_RT_DEM_CODE + ofs);
+	}
+}
+
+static int mtk_mipi_tx_pll_enable(struct clk_hw *hw)
+{
+	struct mtk_mipi_tx *mipi_tx = mtk_mipi_tx_from_clk_hw(hw);
+	void __iomem *base = mipi_tx->regs;
+	unsigned int txdiv, txdiv0;
+	u64 pcw;
+
+	dev_dbg(mipi_tx->dev, "enable: %u bps\n", mipi_tx->data_rate);
+
+	/*
+	 * It is not in a power domain, so it can still run from the bootloader. It
+	 * has the rate of the panel, and the vendor leaves it alone as well.
+	 */
+	if (readl(base + MIPITX_PLL_CON1) & RG_DSI_PLL_EN)
+		return 0;
+
+	if (mipi_tx->data_rate >= 2000000000) {
+		txdiv = 1;
+		txdiv0 = 0;
+	} else if (mipi_tx->data_rate >= MIPITX_DIV2_MIN_RATE) {
+		txdiv = 2;
+		txdiv0 = 1;
+	} else if (mipi_tx->data_rate >= 500000000) {
+		txdiv = 4;
+		txdiv0 = 2;
+	} else if (mipi_tx->data_rate >= 250000000) {
+		txdiv = 8;
+		txdiv0 = 3;
+	} else if (mipi_tx->data_rate >= 125000000) {
+		txdiv = 16;
+		txdiv0 = 4;
+	} else {
+		return -EINVAL;
+	}
+
+	mtk_phy_update_field(base + MIPITX_VOLTAGE_SEL, RG_DSI_PRD_REF_SEL, 0);
+	writel(MIPITX_PRESERVED_VALUE, base + MIPITX_PRESERVED);
+
+	writel(MIPITX_PLL_CON4_VALUE, base + MIPITX_PLL_CON4);
+	/* BG_LPF_EN / BG_CORE_EN */
+	writel(RG_DSI_LANE_CON_BG_ON_TIE_LOW, base + MIPITX_LANE_CON);
+	fsleep(500);
+	writel(RG_DSI_LANE_CON_BG_ON, base + MIPITX_LANE_CON);
+
+	mtk_phy_set_bits(base + MIPITX_PLL_PWR, AD_DSI_PLL_SDM_PWR_ON);
+	fsleep(30);
+	mtk_phy_clear_bits(base + MIPITX_PLL_PWR, AD_DSI_PLL_SDM_ISO_EN);
+
+	mtk_phy_clear_bits(base + MIPITX_PLL_CON1, RG_DSI_PLL_FBSEL);
+
+	/* The PLL doubles its 26 MHz reference. This counts in kHz like the vendor. */
+	pcw = div_u64((u64)(mipi_tx->data_rate / 1000 / 2) * txdiv << 24, 26000);
+	writel(pcw, base + MIPITX_PLL_CON0);
+
+	mtk_phy_update_field(base + MIPITX_PLL_CON1, RG_DSI_PLL_POSDIV, txdiv0);
+	mtk_phy_clear_bits(base + MIPITX_PLL_CON1, RG_DSI_PLL_DIV3_EN);
+	mtk_phy_set_bits(base + MIPITX_PLL_CON1, RG_DSI_PLL_EN);
+
+	mtk_phy_set_bits(base + MIPITX_LANE_CON, RG_DSI_DEM_EN);
+
+	fsleep(50);
+
+	return 0;
+}
+
+static void mtk_mipi_tx_pll_disable(struct clk_hw *hw)
+{
+	struct mtk_mipi_tx *mipi_tx = mtk_mipi_tx_from_clk_hw(hw);
+	void __iomem *base = mipi_tx->regs;
+
+	mtk_phy_clear_bits(base + MIPITX_PLL_CON1, RG_DSI_PLL_EN);
+	mtk_phy_clear_bits(base + MIPITX_SW_CTRL_CON4, MIPITX_SW_ANA_CK_EN);
+
+	mtk_phy_set_bits(base + MIPITX_PLL_PWR, AD_DSI_PLL_SDM_ISO_EN);
+	mtk_phy_clear_bits(base + MIPITX_PLL_PWR, AD_DSI_PLL_SDM_PWR_ON);
+
+	writel(RG_DSI_LANE_CON_BG_ON_TIE_LOW, base + MIPITX_LANE_CON);
+	writel(RG_DSI_LANE_CON_TIE_LOW, base + MIPITX_LANE_CON);
+}
+
+static int mtk_mipi_tx_pll_determine_rate(struct clk_hw *hw,
+					  struct clk_rate_request *req)
+{
+	req->rate = clamp_val(req->rate, 125000000, 2500000000);
+
+	return 0;
+}
+
+/* The enable and disable sleep, so these have to be prepare and unprepare */
+static const struct clk_ops mtk_mipi_tx_pll_ops = {
+	.prepare = mtk_mipi_tx_pll_enable,
+	.unprepare = mtk_mipi_tx_pll_disable,
+	.determine_rate = mtk_mipi_tx_pll_determine_rate,
+	.set_rate = mtk_mipi_tx_pll_set_rate,
+	.recalc_rate = mtk_mipi_tx_pll_recalc_rate,
+};
+
+static void mtk_mipi_tx_power_on_signal(struct phy *phy)
+{
+	struct mtk_mipi_tx *mipi_tx = phy_get_drvdata(phy);
+	void __iomem *base = mipi_tx->regs;
+
+	mtk_phy_set_bits(base + MIPITX_CK_CKMODE_EN, DSI_CK_CKMODE_EN);
+	mtk_phy_update_field(base + MIPITX_PHY_SEL0, MIPITX_LPRX0_LN_SEL, 0);
+	mtk_phy_update_field(base + MIPITX_PHY_SEL0, MIPITX_LPRX1_LN_SEL, 5);
+
+	mt6897_mipi_tx_restore_trim(mipi_tx);
+}
+
+static void mtk_mipi_tx_power_off_signal(struct phy *phy)
+{
+}
+
+static int mt6897_mipi_tx_probe(struct mtk_mipi_tx *mipi_tx)
+{
+	mipi_tx->priv = devm_kzalloc(mipi_tx->dev,
+				     sizeof(struct mt6897_mipi_tx_trim),
+				     GFP_KERNEL);
+	if (!mipi_tx->priv)
+		return -ENOMEM;
+
+	mt6897_mipi_tx_save_trim(mipi_tx);
+
+	return 0;
+}
+
+const struct mtk_mipitx_data mt6897_mipitx_data = {
+	.mipi_tx_clk_ops = &mtk_mipi_tx_pll_ops,
+	.mipi_tx_enable_signal = mtk_mipi_tx_power_on_signal,
+	.mipi_tx_disable_signal = mtk_mipi_tx_power_off_signal,
+	.mipi_tx_probe = mt6897_mipi_tx_probe,
+};
diff --git a/drivers/phy/mediatek/phy-mtk-mipi-dsi.c b/drivers/phy/mediatek/phy-mtk-mipi-dsi.c
index 065ea626093aaac08b7dc9d091a37abcab5a0918..32afea94682465fcac79659669d1e1af0fc1a254 100644
--- a/drivers/phy/mediatek/phy-mtk-mipi-dsi.c
+++ b/drivers/phy/mediatek/phy-mtk-mipi-dsi.c
@@ -176,11 +176,18 @@ static int mtk_mipi_tx_probe(struct platform_device *pdev)
 
 	mtk_mipi_tx_get_calibration_datal(mipi_tx);
 
+	if (mipi_tx->driver_data->mipi_tx_probe) {
+		ret = mipi_tx->driver_data->mipi_tx_probe(mipi_tx);
+		if (ret)
+			return ret;
+	}
+
 	return devm_of_clk_add_hw_provider(dev, of_clk_hw_simple_get, &mipi_tx->pll_hw);
 }
 
 static const struct of_device_id mtk_mipi_tx_match[] = {
 	{ .compatible = "mediatek,mt2701-mipi-tx", .data = &mt2701_mipitx_data },
+	{ .compatible = "mediatek,mt6897-mipi-tx", .data = &mt6897_mipitx_data },
 	{ .compatible = "mediatek,mt8173-mipi-tx", .data = &mt8173_mipitx_data },
 	{ .compatible = "mediatek,mt8183-mipi-tx", .data = &mt8183_mipitx_data },
 	{ /* sentinel */ }
diff --git a/drivers/phy/mediatek/phy-mtk-mipi-dsi.h b/drivers/phy/mediatek/phy-mtk-mipi-dsi.h
index 5d4876f1dc9509e0bd9a0760e7c6fb9e14a86d47..9a8f54e42151b1085a38d78661feb526ba8a4ea8 100644
--- a/drivers/phy/mediatek/phy-mtk-mipi-dsi.h
+++ b/drivers/phy/mediatek/phy-mtk-mipi-dsi.h
@@ -16,11 +16,14 @@
 #include <linux/phy/phy.h>
 #include <linux/slab.h>
 
+struct mtk_mipi_tx;
+
 struct mtk_mipitx_data {
 	const u32 mppll_preserve;
 	const struct clk_ops *mipi_tx_clk_ops;
 	void (*mipi_tx_enable_signal)(struct phy *phy);
 	void (*mipi_tx_disable_signal)(struct phy *phy);
+	int (*mipi_tx_probe)(struct mtk_mipi_tx *mipi_tx);
 };
 
 struct mtk_mipi_tx {
@@ -31,6 +34,7 @@ struct mtk_mipi_tx {
 	u32 rt_code[5];
 	const struct mtk_mipitx_data *driver_data;
 	struct clk_hw pll_hw;
+	void *priv;
 };
 
 struct mtk_mipi_tx *mtk_mipi_tx_from_clk_hw(struct clk_hw *hw);
@@ -40,6 +44,7 @@ unsigned long mtk_mipi_tx_pll_recalc_rate(struct clk_hw *hw,
 					  unsigned long parent_rate);
 
 extern const struct mtk_mipitx_data mt2701_mipitx_data;
+extern const struct mtk_mipitx_data mt6897_mipitx_data;
 extern const struct mtk_mipitx_data mt8173_mipitx_data;
 extern const struct mtk_mipitx_data mt8183_mipitx_data;
 
