diff --git a/drivers/clk/mediatek/clk-mt6897-apmixedsys.c b/drivers/clk/mediatek/clk-mt6897-apmixedsys.c
new file mode 100644
index 000000000..69d77dbcc
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6897-apmixedsys.c
@@ -0,0 +1,208 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2023 MediaTek Inc.
+ * Author: Benjamin Chao <benjamin.chao@mediatek.com>
+ *
+ * Copyright (c) 2026 buntOS contributors
+ */
+#include <dt-bindings/clock/mediatek,mt6897-clock.h>
+
+#include <linux/clk.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_device.h>
+#include <linux/platform_device.h>
+
+#include "clk-mtk.h"
+#include "clk-pll.h"
+
+/* APMIXEDSYS PLL control register offsets */
+#define AP_PLL_CON3		0x000c
+#define APLL1_TUNER_CON0	0x0040
+#define APLL2_TUNER_CON0	0x0044
+#define TVDPLL_CON0		0x0248
+#define TVDPLL_CON1		0x024c
+#define TVDPLL_CON3		0x0254
+#define UNIVPLL_CON0		0x0308
+#define UNIVPLL_CON1		0x030c
+#define UNIVPLL_CON3		0x0314
+#define APLL1_CON0		0x0328
+#define APLL1_CON1		0x032c
+#define APLL1_CON2		0x0330
+#define APLL1_CON4		0x0338
+#define APLL2_CON0		0x033c
+#define APLL2_CON1		0x0340
+#define APLL2_CON2		0x0344
+#define APLL2_CON4		0x034c
+#define MAINPLL_CON0		0x0350
+#define MAINPLL_CON1		0x0354
+#define MAINPLL_CON3		0x035c
+#define MSDCPLL_CON0		0x0360
+#define MSDCPLL_CON1		0x0364
+#define MSDCPLL_CON3		0x036c
+#define IMGPLL_CON0		0x0370
+#define IMGPLL_CON1		0x0374
+#define IMGPLL_CON3		0x037c
+#define ADSPPLL_CON0		0x0380
+#define ADSPPLL_CON1		0x0384
+#define ADSPPLL_CON3		0x038c
+#define MPLL_CON0		0x0390
+#define MPLL_CON1		0x0394
+#define MPLL_CON3		0x039c
+#define MMPLL_CON0		0x03a0
+#define MMPLL_CON1		0x03a4
+#define MMPLL_CON3		0x03ac
+#define EMIPLL_CON0		0x03b0
+#define EMIPLL_CON1		0x03b4
+#define EMIPLL_CON3		0x03bc
+
+/* HW Voter PLL vote, done and pending status register offsets */
+#define HWV_PLL_SET		0x0190
+#define HWV_PLL_CLR		0x0194
+#define HWV_PLL_DONE		0x140c
+#define HWV_PLL_SET_STA		0x1464
+#define HWV_PLL_CLR_STA		0x1468
+
+#define MT6897_PLL_FMAX		(3800UL * MHZ)
+#define MT6897_PLL_FMIN		(1500UL * MHZ)
+#define MT6897_INTEGER_BITS	8
+
+#define PLL(_id, _name, _reg, _pwr_reg, _flags, _rst_bar_mask,			\
+	    _pd_reg, _pd_shift, _tuner_reg, _tuner_en_reg, _tuner_en_bit,	\
+	    _pcw_reg, _pcw_shift, _pcwbits) {					\
+		.id = _id,							\
+		.name = _name,							\
+		.reg = _reg,							\
+		.pwr_reg = _pwr_reg,						\
+		.flags = _flags,						\
+		.rst_bar_mask = _rst_bar_mask,					\
+		.fmax = MT6897_PLL_FMAX,					\
+		.fmin = MT6897_PLL_FMIN,					\
+		.pd_reg = _pd_reg,						\
+		.pd_shift = _pd_shift,						\
+		.tuner_reg = _tuner_reg,					\
+		.tuner_en_reg = _tuner_en_reg,					\
+		.tuner_en_bit = _tuner_en_bit,					\
+		.pcw_reg = _pcw_reg,						\
+		.pcw_shift = _pcw_shift,					\
+		.pcwbits = _pcwbits,						\
+		.pcwibits = MT6897_INTEGER_BITS,				\
+	}
+
+/*
+ * These PLLs are switched by the HW voter: it runs the power-up sequence
+ * (power, isolation, enable, reset) itself once the AP votes.
+ */
+#define PLL_HWV(_id, _name, _reg, _flags, _pd_reg, _pd_shift,	\
+		_pcw_reg, _pcw_shift, _pcwbits, _hwv_shift) {	\
+		.id = _id,					\
+		.name = _name,					\
+		.reg = _reg,					\
+		.flags = _flags,				\
+		.fmax = MT6897_PLL_FMAX,			\
+		.fmin = MT6897_PLL_FMIN,			\
+		.pd_reg = _pd_reg,				\
+		.pd_shift = _pd_shift,				\
+		.pcw_reg = _pcw_reg,				\
+		.pcw_shift = _pcw_shift,			\
+		.pcwbits = _pcwbits,				\
+		.pcwibits = MT6897_INTEGER_BITS,		\
+		.hwv_set_ofs = HWV_PLL_SET,			\
+		.hwv_clr_ofs = HWV_PLL_CLR,			\
+		.hwv_done_ofs = HWV_PLL_DONE,			\
+		.hwv_set_sta_ofs = HWV_PLL_SET_STA,		\
+		.hwv_clr_sta_ofs = HWV_PLL_CLR_STA,		\
+		.hwv_shift = _hwv_shift,			\
+		.ops = &mtk_pll_hwv_ops,			\
+	}
+
+static const struct mtk_pll_data apmixed_plls[] = {
+	PLL_HWV(CLK_APMIXED_MAINPLL, "mainpll", MAINPLL_CON0, PLL_AO,
+		MAINPLL_CON1, 24, MAINPLL_CON1, 0, 22, 0),
+	PLL_HWV(CLK_APMIXED_UNIVPLL, "univpll", UNIVPLL_CON0, 0,
+		UNIVPLL_CON1, 24, UNIVPLL_CON1, 0, 22, 1),
+	PLL(CLK_APMIXED_MSDCPLL, "msdcpll", MSDCPLL_CON0, MSDCPLL_CON3, 0, 0,
+	    MSDCPLL_CON1, 24, 0, 0, 0,
+	    MSDCPLL_CON1, 0, 22),
+	PLL_HWV(CLK_APMIXED_MMPLL, "mmpll", MMPLL_CON0, 0,
+		MMPLL_CON1, 24, MMPLL_CON1, 0, 22, 2),
+	PLL(CLK_APMIXED_ADSPPLL, "adsppll", ADSPPLL_CON0, ADSPPLL_CON3, 0, 0,
+	    ADSPPLL_CON1, 24, 0, 0, 0,
+	    ADSPPLL_CON1, 0, 22),
+	PLL_HWV(CLK_APMIXED_TVDPLL, "tvdpll", TVDPLL_CON0, 0,
+		TVDPLL_CON1, 24, TVDPLL_CON1, 0, 22, 3),
+	PLL(CLK_APMIXED_APLL1, "apll1", APLL1_CON0, APLL1_CON4, 0, 0,
+	    APLL1_CON1, 24, APLL1_TUNER_CON0, AP_PLL_CON3, 0,
+	    APLL1_CON2, 0, 32),
+	PLL(CLK_APMIXED_APLL2, "apll2", APLL2_CON0, APLL2_CON4, 0, 0,
+	    APLL2_CON1, 24, APLL2_TUNER_CON0, AP_PLL_CON3, 1,
+	    APLL2_CON2, 0, 32),
+	PLL(CLK_APMIXED_MPLL, "mpll", MPLL_CON0, MPLL_CON3, PLL_AO, 0,
+	    MPLL_CON1, 24, 0, 0, 0,
+	    MPLL_CON1, 0, 22),
+	PLL(CLK_APMIXED_EMIPLL, "emipll", EMIPLL_CON0, EMIPLL_CON3, PLL_AO, 0,
+	    EMIPLL_CON1, 24, 0, 0, 0,
+	    EMIPLL_CON1, 0, 22),
+	PLL_HWV(CLK_APMIXED_IMGPLL, "imgpll", IMGPLL_CON0, 0,
+		IMGPLL_CON1, 24, IMGPLL_CON1, 0, 22, 4),
+};
+
+static int clk_mt6897_apmixed_probe(struct platform_device *pdev)
+{
+	struct device_node *node = pdev->dev.of_node;
+	struct clk_hw_onecell_data *clk_data;
+	int r;
+
+	clk_data = mtk_alloc_clk_data(ARRAY_SIZE(apmixed_plls));
+	if (!clk_data)
+		return -ENOMEM;
+
+	r = mtk_clk_register_plls(&pdev->dev, apmixed_plls,
+				  ARRAY_SIZE(apmixed_plls), clk_data);
+	if (r)
+		goto free_apmixed_data;
+
+	r = of_clk_add_hw_provider(node, of_clk_hw_onecell_get, clk_data);
+	if (r)
+		goto unregister_plls;
+
+	platform_set_drvdata(pdev, clk_data);
+
+	return 0;
+
+unregister_plls:
+	mtk_clk_unregister_plls(apmixed_plls, ARRAY_SIZE(apmixed_plls), clk_data);
+free_apmixed_data:
+	mtk_free_clk_data(clk_data);
+	return r;
+}
+
+static void clk_mt6897_apmixed_remove(struct platform_device *pdev)
+{
+	struct clk_hw_onecell_data *clk_data = platform_get_drvdata(pdev);
+	struct device_node *node = pdev->dev.of_node;
+
+	of_clk_del_provider(node);
+	mtk_clk_unregister_plls(apmixed_plls, ARRAY_SIZE(apmixed_plls), clk_data);
+	mtk_free_clk_data(clk_data);
+}
+
+static const struct of_device_id of_match_clk_mt6897_apmixed[] = {
+	{ .compatible = "mediatek,mt6897-apmixedsys" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt6897_apmixed);
+
+static struct platform_driver clk_mt6897_apmixed_drv = {
+	.probe = clk_mt6897_apmixed_probe,
+	.remove = clk_mt6897_apmixed_remove,
+	.driver = {
+		.name = "clk-mt6897-apmixed",
+		.of_match_table = of_match_clk_mt6897_apmixed,
+	},
+};
+module_platform_driver(clk_mt6897_apmixed_drv);
+
+MODULE_DESCRIPTION("MediaTek MT6897 apmixedsys clocks driver");
+MODULE_LICENSE("GPL");
