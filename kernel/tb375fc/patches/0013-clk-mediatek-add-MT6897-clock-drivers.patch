+	GATE_HWV_PERI_AO0(CLK_PERI_AO_DISP_PWM1, "peri_ao_disp_pwm1", "disp_pwm", 11),
+	GATE_HWV_PERI_AO0(CLK_PERI_AO_SPI0_BCLK, "peri_ao_spi0_bclk", "spi0", 12),
+	GATE_PERI_AO0(CLK_PERI_AO_SPI1_BCLK, "peri_ao_spi1_bclk", "spi1", 13),
