new file mode 100644
index 000000000..6a84f67fb
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/mediatek,mt6897-sys-clock.yaml
@@ -0,0 +1,87 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/mediatek,mt6897-sys-clock.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek System Clock Controller for MT6897
+
+maintainers:
+  - buntOS contributors <buntos@localhost>
+
+description: |
+  The clock architecture in MediaTek SoCs is structured like below:
+  PLLs -->
+          dividers -->
+                      muxes
+                           -->
+                              clock gate
+
+  The apmixedsys provides most of the PLLs, which are generated from the
+  SoC's 26MHz crystal oscillator. The topckgen and vlpckgen provide dividers
+  and muxes which provide the clock source to other IP blocks.
+
+  The identifiers of the clocks are in
+  include/dt-bindings/clock/mediatek,mt6897-clock.h.
+
+properties:
+  compatible:
+    items:
+      - enum:
+          - mediatek,mt6897-apmixedsys
+          - mediatek,mt6897-topckgen
+          - mediatek,mt6897-vlpckgen
+      - const: syscon
+
+  reg:
+    maxItems: 1
+
+  '#clock-cells':
+    const: 1
+
+  mediatek,hardware-voter:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle to the hardware voter (HWV) register block. The HWV is a
+      SoC-internal MCU that collects clock votes from the application
+      processor and the remote processors. On MT6897 it powers some PLLs up
+      and down and opens or closes the gates of some topckgen muxes. The
+      parent selection of those muxes and the rate of those PLLs are still
+      set through the clock controller registers.
+
+required:
+  - compatible
+  - reg
+  - '#clock-cells'
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - mediatek,mt6897-apmixedsys
+              - mediatek,mt6897-topckgen
+    then:
+      required:
+        - mediatek,hardware-voter
+    else:
+      properties:
+        mediatek,hardware-voter: false
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller@1000c000 {
+        compatible = "mediatek,mt6897-apmixedsys", "syscon";
+        reg = <0x1000c000 0x1000>;
+        mediatek,hardware-voter = <&hwv>;
+        #clock-cells = <1>;
+    };
+  - |
+    clock-controller@1c013000 {
+        compatible = "mediatek,mt6897-vlpckgen", "syscon";
+        reg = <0x1c013000 0x1000>;
+        #clock-cells = <1>;
+    };
