From: buntOS contributors
Subject: [PATCH] pmdomain: mediatek: add MT6897 power domains

Add the System Power Manager domains of the MediaTek MT6897 (Dimensity
8300) SoC. The tables come from the vendor driver (mtk-scpsys-mt6897.c in
the OnePlus Pad GPL release): 25 directly controlled domains and 7 behind
the hardware voter, with bus protection in the IFR and VLP blocks.

Differences from the vendor tables:

- All domains are default off, so that probe does not touch them. The
  vendor powers on all but the modem and connectivity ones at probe, and
  powers off the unused ones late in the boot, when its display driver
  holds its domains. Here the bootloader leaves the display on for a
  framebuffer with no consumer of the domains, and genpd powers off a
  domain that it sees as on and unused at sync_state, even with
  pd_ignore_unused.
- The APU domain has no registers here, the vendor calls into its APU
  driver. It was the last number, so the others keep theirs.
- The GPU_EB_RPC domains are not in this controller: the vendor switches
  them from the GPUEB firmware (gpueb-support, CMD_POWER_CONTROL) and
  nothing in its device tree uses them. That is the mtk-mfg-pmdomain way.
- The modem domain only looks at the first acknowledge bit. The vendor
  does the same, and so does MT6858.
- ISP_MAIN and CAM_MAIN take their supply as domain-supply. The vendor
  finds isp-main-supply and cam-main-supply by the domain names.

The vendor waits for the first power switch of a domain and 50 us more
before it closes the second one, in the OnePlus sources and in the stock
kernel of the Lenovo TB375FC. Mainline closes both at once on every SoC.
That may well be fine here too, but it can only be tested on a device, and
the wait costs next to nothing. Add staged_pwr_on to do as the vendor does.

The OnePlus sources also wait 50 us before they clear the isolation of
CAM_MAIN, which the older stock kernel does not. Add MTK_SCPD_ISO_DELAY for
that.

Add the VLP bus protection block, which mainline has as of the MT6858
support.

---
diff --git a/drivers/pmdomain/mediatek/mtk-pm-domains.c b/drivers/pmdomain/mediatek/mtk-pm-domains.c
index 4263a65ec..9fd09bd80 100644
--- a/drivers/pmdomain/mediatek/mtk-pm-domains.c
+++ b/drivers/pmdomain/mediatek/mtk-pm-domains.c
@@ -21,6 +21,7 @@
 #include "mt6735-pm-domains.h"
 #include "mt6795-pm-domains.h"
 #include "mt6893-pm-domains.h"
+#include "mt6897-pm-domains.h"
 #include "mt8167-pm-domains.h"
 #include "mt8173-pm-domains.h"
 #include "mt8183-pm-domains.h"
@@ -479,6 +480,20 @@ static int scpsys_ctl_pwrseq_on(struct scpsys_domain *pd)
 
 	/* subsys power on */
 	regmap_set_bits(scpsys->base, pd->data->ctl_offs, PWR_ON_BIT);
+
+	if (scpsys->soc_data->staged_pwr_on) {
+		u32 sta;
+
+		/* Let the first power switch settle before closing the second one */
+		ret = regmap_read_poll_timeout(scpsys->base, pd->data->pwr_sta_offs, sta,
+					       sta & pd->data->sta_mask, MTK_POLL_DELAY_US,
+					       MTK_POLL_TIMEOUT);
+		if (ret < 0)
+			return ret;
+
+		fsleep(50);
+	}
+
 	regmap_set_bits(scpsys->base, pd->data->ctl_offs, PWR_ON_2ND_BIT);
 
 	/* wait until PWR_ACK = 1 */
@@ -487,6 +502,9 @@ static int scpsys_ctl_pwrseq_on(struct scpsys_domain *pd)
 	if (ret < 0)
 		return ret;
 
+	if (MTK_SCPD_CAPS(pd, MTK_SCPD_ISO_DELAY))
+		fsleep(50);
+
 	regmap_clear_bits(scpsys->base, pd->data->ctl_offs, PWR_CLK_DIS_BIT);
 	regmap_clear_bits(scpsys->base, pd->data->ctl_offs, PWR_ISO_BIT);
 	regmap_set_bits(scpsys->base, pd->data->ctl_offs, PWR_RST_B_BIT);
@@ -1205,6 +1223,10 @@ static const struct of_device_id scpsys_of_match[] = {
 		.compatible = "mediatek,mt6893-power-controller",
 		.data = &mt6893_scpsys_data,
 	},
+	{
+		.compatible = "mediatek,mt6897-power-controller",
+		.data = &mt6897_scpsys_data,
+	},
 	{
 		.compatible = "mediatek,mt8167-power-controller",
 		.data = &mt8167_scpsys_data,
diff --git a/drivers/pmdomain/mediatek/mtk-pm-domains.h b/drivers/pmdomain/mediatek/mtk-pm-domains.h
index 46ccd5cff..74ff045cd 100644
--- a/drivers/pmdomain/mediatek/mtk-pm-domains.h
+++ b/drivers/pmdomain/mediatek/mtk-pm-domains.h
@@ -17,6 +17,7 @@
 #define MTK_SCPD_MODEM_PWRSEQ		BIT(10)
 #define MTK_SCPD_SKIP_RESET_B		BIT(11)
 #define MTK_SCPD_INFRA_PWR_CTL		BIT(12)
+#define MTK_SCPD_ISO_DELAY		BIT(13)
 #define MTK_SCPD_CAPS(_scpd, _x)	((_scpd)->data ?		\
 					 (_scpd)->data->caps & (_x) :	\
 					 (_scpd)->hwv_data->caps & (_x))
@@ -64,6 +65,7 @@ enum scpsys_bus_prot_block {
 	BUS_PROT_BLOCK_INFRA_NAO,
 	BUS_PROT_BLOCK_SMI,
 	BUS_PROT_BLOCK_SPM,
+	BUS_PROT_BLOCK_VLP,
 	BUS_PROT_BLOCK_COUNT,
 };
 
@@ -212,6 +214,7 @@ struct scpsys_soc_data {
 	enum scpsys_bus_prot_block *bus_prot_blocks;
 	int num_bus_prot_blocks;
 	enum scpsys_mtcmos_type type;
+	bool staged_pwr_on;
 };
 
 #endif /* __SOC_MEDIATEK_MTK_PM_DOMAINS_H */
