diff --git a/sound/soc/codecs/mt6368.c b/sound/soc/codecs/mt6368.c
new file mode 100644
index 0000000..e08cf81
--- /dev/null
+++ b/sound/soc/codecs/mt6368.c
@@ -0,0 +1,991 @@
+// SPDX-License-Identifier: GPL-2.0
+//
+// mt6368.c  --  MediaTek MT6368 audio codec, the capture path for now
+//
+// Copyright (c) 2018 MediaTek Inc.
+// Author: Tina Tsai <tina.tsai@mediatek.com>
+
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/spmi.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+
+#include "mt6368.h"
+
+/* The 26 MHz of the codec comes from a clock buffer of the MT6685 */
+#define MT6685_DCXO_EXTBUF5_CW0		0x79e
+#define  XO_BBCK5_MODE_MASK		GENMASK(1, 0)
+#define  XO_BBCK5_EN_M			BIT(2)
+
+enum {
+	MT6368_MIC_TYPE_IDLE,
+	MT6368_MIC_TYPE_ACC,
+	MT6368_MIC_TYPE_DMIC,
+	MT6368_MIC_TYPE_DCC,
+	MT6368_MIC_TYPE_DCC_ECM_DIFF,
+	MT6368_MIC_TYPE_DCC_ECM_SINGLE,
+	MT6368_MIC_TYPE_NUM,
+};
+
+#define MT6368_MIC_INPUTS 3
+
+enum {
+	MIC_BIAS_1P7 = 0,
+	MIC_BIAS_1P8,
+	MIC_BIAS_1P9,
+	MIC_BIAS_2P0,
+	MIC_BIAS_2P1,
+	MIC_BIAS_2P5,
+	MIC_BIAS_2P6,
+	MIC_BIAS_2P7,
+};
+
+enum {
+	PGA_L_MUX_NONE,
+	PGA_L_MUX_AIN0,
+	PGA_L_MUX_AIN1,
+};
+
+enum {
+	PGA_R_MUX_NONE,
+	PGA_R_MUX_AIN2,
+	PGA_R_MUX_AIN3,
+	PGA_R_MUX_AIN0,
+};
+
+enum {
+	ADC_MUX_IDLE,
+	ADC_MUX_AIN0,
+	ADC_MUX_PREAMPLIFIER,
+	ADC_MUX_IDLE1,
+};
+
+enum {
+	SUPPLY_SEQ_CLK_BUF,
+	SUPPLY_SEQ_AUD_GLB,
+	SUPPLY_SEQ_UL_GPIO,
+	SUPPLY_SEQ_CLKSQ,
+	SUPPLY_SEQ_ADC_CLKGEN,
+	SUPPLY_SEQ_TOP_CK,
+	SUPPLY_SEQ_TOP_CK_LAST,
+	SUPPLY_SEQ_DCC_CLK,
+	SUPPLY_SEQ_MIC_BIAS,
+	SUPPLY_SEQ_AUD_TOP,
+	SUPPLY_SEQ_AUD_TOP_LAST,
+	SUPPLY_SEQ_AFE,
+	SUPPLY_SEQ_UL_PGA,
+	SUPPLY_SEQ_UL_ADC,
+	SUPPLY_SEQ_UL_MTKAIF,
+	SUPPLY_SEQ_UL_SRC,
+};
+
+struct mt6368_priv {
+	struct device *dev;
+	struct regmap *regmap;
+	struct spmi_device *dcxo;
+	struct regulator *vaud18;
+	int mtkaif_protocol;
+	/* the types of AIN0, AIN1 and of AIN2 and AIN3 */
+	unsigned int mic_type[MT6368_MIC_INPUTS];
+};
+
+static void mt6368_set_dcxo(struct mt6368_priv *priv, bool enable)
+{
+	u8 val;
+
+	if (spmi_ext_register_readl(priv->dcxo, MT6685_DCXO_EXTBUF5_CW0, &val, 1)) {
+		dev_err(priv->dev, "failed to read the clock buffer\n");
+		return;
+	}
+
+	/* Mode 0: the buffer follows EN_M */
+	val &= ~(XO_BBCK5_MODE_MASK | XO_BBCK5_EN_M);
+	if (enable)
+		val |= XO_BBCK5_EN_M;
+
+	if (spmi_ext_register_writel(priv->dcxo, MT6685_DCXO_EXTBUF5_CW0, &val, 1)) {
+		dev_err(priv->dev, "failed to write the clock buffer\n");
+		return;
+	}
+
+	if (enable)
+		usleep_range(400, 420);
+}
+
+static void mt6368_set_playback_gpio(struct mt6368_priv *priv)
+{
+	unsigned int val;
+
+	/* gpio mosi mode: clk, data and sync */
+	regmap_read(priv->regmap, MT6368_GPIO_MODE4, &val);
+	if ((val & 0x38) != 0x8) {
+		regmap_write(priv->regmap, MT6368_GPIO_MODE4_CLR, 0x38);
+		regmap_write(priv->regmap, MT6368_GPIO_MODE4_SET, 0x8);
+	}
+
+	regmap_write(priv->regmap, MT6368_GPIO_MODE5_CLR, 0x3f);
+	regmap_write(priv->regmap, MT6368_GPIO_MODE5_SET, 0x9);
+	regmap_write(priv->regmap, MT6368_GPIO_MODE6_CLR, 0x3f);
+	regmap_write(priv->regmap, MT6368_GPIO_MODE6_SET, 0x9);
+}
+
+/* The data pins are boot straps, and the clock and sync stay for MTKAIF 2 */
+static void mt6368_reset_playback_gpio(struct mt6368_priv *priv)
+{
+	regmap_write(priv->regmap, MT6368_GPIO_MODE5_CLR, 0x3f);
+	regmap_write(priv->regmap, MT6368_GPIO_MODE6_CLR, 0x7);
+	regmap_update_bits(priv->regmap, MT6368_GPIO_DIR1, 0x7 << 1, 0);
+}
+
+static void mt6368_set_capture_gpio(struct mt6368_priv *priv)
+{
+	regmap_write(priv->regmap, MT6368_GPIO_MODE8_CLR, 0x3f);
+	regmap_write(priv->regmap, MT6368_GPIO_MODE8_SET, 0x09);
+	regmap_write(priv->regmap, MT6368_GPIO_MODE9_CLR, 0x7);
+	regmap_write(priv->regmap, MT6368_GPIO_MODE9_SET, 0x1);
+}
+
+/*
+ * To GPIO mode and input: the clock would leak without a capture, and the data
+ * pins are boot straps.
+ */
+static void mt6368_reset_capture_gpio(struct mt6368_priv *priv)
+{
+	regmap_write(priv->regmap, MT6368_GPIO_MODE8_CLR, 0x3f);
+	regmap_write(priv->regmap, MT6368_GPIO_MODE9_CLR, 0x7);
+	regmap_update_bits(priv->regmap, MT6368_GPIO_DIR1, 0x7 << 5, 0);
+	regmap_update_bits(priv->regmap, MT6368_GPIO_DIR2, 0x3, 0);
+}
+
+static void mt6368_set_clksq(struct mt6368_priv *priv, bool enable)
+{
+	regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON47,
+			   RG_CLKSQ_EN_MASK_SFT,
+			   (enable ? 1 : 0) << RG_CLKSQ_EN_SFT);
+}
+
+static void mt6368_set_aud_global_bias(struct mt6368_priv *priv, bool enable)
+{
+	regmap_update_bits(priv->regmap, MT6368_AUDDEC_ANA_CON26,
+			   RG_AUDGLB_PWRDN_VA32_MASK_SFT,
+			   (enable ? 0 : 1) << RG_AUDGLB_PWRDN_VA32_SFT);
+}
+
+static void mt6368_set_topck(struct mt6368_priv *priv, bool enable)
+{
+	regmap_update_bits(priv->regmap, MT6368_AUD_TOP_CKPDN_CON0,
+			   0x66, enable ? 0x0 : 0x66);
+}
+
+static void mt6368_mtkaif_tx_enable(struct mt6368_priv *priv)
+{
+	switch (priv->mtkaif_protocol) {
+	case MT6368_MTKAIF_PROTOCOL_2_CLK_P2:
+		regmap_update_bits(priv->regmap, MT6368_AFE_ADDA_MTKAIF_CFG0, 0xff, 0x10);
+		regmap_update_bits(priv->regmap, MT6368_AFE_ADDA_MTKAIF_CFG1, 0xff, 0x2);
+		/* enable the TX FIFOs of aud_pad */
+		regmap_update_bits(priv->regmap, MT6368_AFE_AUD_PAD_TOP, 0xff, 0x12);
+		regmap_update_bits(priv->regmap, MT6368_AFE_AUD_PAD_TOP, 0xff, 0x13);
+		break;
+	case MT6368_MTKAIF_PROTOCOL_2:
+		regmap_update_bits(priv->regmap, MT6368_AFE_ADDA_MTKAIF_CFG0, 0xff, 0x10);
+		regmap_update_bits(priv->regmap, MT6368_AFE_ADDA_MTKAIF_CFG1, 0xff, 0x2);
+		regmap_update_bits(priv->regmap, MT6368_AFE_AUD_PAD_TOP, 0xff, 0x11);
+		break;
+	default:
+		regmap_update_bits(priv->regmap, MT6368_AFE_ADDA_MTKAIF_CFG0, 0xff, 0x0);
+		regmap_update_bits(priv->regmap, MT6368_AFE_ADDA_MTKAIF_CFG1, 0xff, 0x0);
+		regmap_update_bits(priv->regmap, MT6368_AFE_AUD_PAD_TOP, 0xff, 0x11);
+		break;
+	}
+}
+
+static void mt6368_mtkaif_tx_disable(struct mt6368_priv *priv)
+{
+	regmap_update_bits(priv->regmap, MT6368_AFE_AUD_PAD_TOP, 0xff, 0x10);
+}
+
+int mt6368_set_mtkaif_protocol(struct snd_soc_component *cmpnt, int protocol)
+{
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+
+	priv->mtkaif_protocol = protocol;
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6368_set_mtkaif_protocol);
+
+int mt6368_mtkaif_calibration_enable(struct snd_soc_component *cmpnt)
+{
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+	int ret;
+
+	ret = regulator_enable(priv->vaud18);
+	if (ret)
+		return ret;
+
+	mt6368_set_playback_gpio(priv);
+	mt6368_set_capture_gpio(priv);
+	mt6368_mtkaif_tx_enable(priv);
+
+	mt6368_set_dcxo(priv, true);
+	mt6368_set_aud_global_bias(priv, true);
+	mt6368_set_clksq(priv, true);
+	mt6368_set_topck(priv, true);
+
+	/* The data pins return what the clock pins bring */
+	regmap_update_bits(priv->regmap, MT6368_AUDIO_DIG_CFG1,
+			   RG_AUD_PAD_TOP_DAT_MISO2_LOOPBACK_MASK_SFT,
+			   1 << RG_AUD_PAD_TOP_DAT_MISO2_LOOPBACK_SFT);
+	regmap_update_bits(priv->regmap, MT6368_AUDIO_DIG_CFG0,
+			   RG_AUD_PAD_TOP_DAT_MISO_LOOPBACK_MASK_SFT,
+			   1 << RG_AUD_PAD_TOP_DAT_MISO_LOOPBACK_SFT);
+	regmap_update_bits(priv->regmap, MT6368_AUDIO_DIG_CFG2,
+			   RG_AUD_PAD_TOP_DAT_MISO3_LOOPBACK_MASK_SFT,
+			   1 << RG_AUD_PAD_TOP_DAT_MISO3_LOOPBACK_SFT);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6368_mtkaif_calibration_enable);
+
+void mt6368_mtkaif_calibration_disable(struct snd_soc_component *cmpnt)
+{
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+
+	regmap_update_bits(priv->regmap, MT6368_AUDIO_DIG_CFG1,
+			   RG_AUD_PAD_TOP_DAT_MISO2_LOOPBACK_MASK_SFT, 0);
+	regmap_update_bits(priv->regmap, MT6368_AUDIO_DIG_CFG0,
+			   RG_AUD_PAD_TOP_DAT_MISO_LOOPBACK_MASK_SFT, 0);
+	regmap_update_bits(priv->regmap, MT6368_AUDIO_DIG_CFG2,
+			   RG_AUD_PAD_TOP_DAT_MISO3_LOOPBACK_MASK_SFT, 0);
+
+	mt6368_set_topck(priv, false);
+	mt6368_set_clksq(priv, false);
+	mt6368_set_aud_global_bias(priv, false);
+	mt6368_set_dcxo(priv, false);
+
+	mt6368_mtkaif_tx_disable(priv);
+	mt6368_reset_playback_gpio(priv);
+	mt6368_reset_capture_gpio(priv);
+
+	regulator_disable(priv->vaud18);
+}
+EXPORT_SYMBOL_GPL(mt6368_mtkaif_calibration_disable);
+
+void mt6368_set_mtkaif_calibration_phase(struct snd_soc_component *cmpnt,
+					 int phase_1, int phase_2, int phase_3)
+{
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+
+	regmap_update_bits(priv->regmap, MT6368_AUDIO_DIG_CFG0,
+			   RG_AUD_PAD_TOP_PHASE_MODE_MASK_SFT,
+			   phase_1 << RG_AUD_PAD_TOP_PHASE_MODE_SFT);
+	regmap_update_bits(priv->regmap, MT6368_AUDIO_DIG_CFG1,
+			   RG_AUD_PAD_TOP_PHASE_MODE2_MASK_SFT,
+			   phase_2 << RG_AUD_PAD_TOP_PHASE_MODE2_SFT);
+	regmap_update_bits(priv->regmap, MT6368_AUDIO_DIG_CFG2,
+			   RG_AUD_PAD_TOP_PHASE_MODE3_MASK_SFT,
+			   phase_3 << RG_AUD_PAD_TOP_PHASE_MODE3_SFT);
+}
+EXPORT_SYMBOL_GPL(mt6368_set_mtkaif_calibration_phase);
+
+static bool mt6368_is_dcc(unsigned int type)
+{
+	return type == MT6368_MIC_TYPE_DCC ||
+	       type == MT6368_MIC_TYPE_DCC_ECM_DIFF ||
+	       type == MT6368_MIC_TYPE_DCC_ECM_SINGLE;
+}
+
+static const DECLARE_TLV_DB_SCALE(capture_tlv, 0, 600, 0);
+
+static const struct snd_kcontrol_new mt6368_snd_controls[] = {
+	/* (000) 0 dB, (001) 6 dB, (010) 12 dB, (011) 18 dB, (100) 24 dB */
+	SOC_SINGLE_TLV("PGA1 Volume", MT6368_AUDENC_ANA_CON1,
+		       RG_AUDPREAMPLGAIN_SFT, 4, 0, capture_tlv),
+	SOC_SINGLE_TLV("PGA2 Volume", MT6368_AUDENC_ANA_CON3,
+		       RG_AUDPREAMPRGAIN_SFT, 4, 0, capture_tlv),
+};
+
+static const char *const miso_mux_map[] = {
+	"UL1_CH1", "UL1_CH2", "UL2_CH1", "UL2_CH2",
+};
+
+static SOC_ENUM_SINGLE_DECL(miso0_mux_map_enum, MT6368_AFE_MTKAIF_MUX_CFG0,
+			    RG_ADDA_CH1_SEL_SFT, miso_mux_map);
+static const struct snd_kcontrol_new miso0_mux_control =
+	SOC_DAPM_ENUM("MISO_MUX Select", miso0_mux_map_enum);
+
+static SOC_ENUM_SINGLE_DECL(miso1_mux_map_enum, MT6368_AFE_MTKAIF_MUX_CFG0,
+			    RG_ADDA_CH2_SEL_SFT, miso_mux_map);
+static const struct snd_kcontrol_new miso1_mux_control =
+	SOC_DAPM_ENUM("MISO_MUX Select", miso1_mux_map_enum);
+
+static const char *const adc_left_mux_map[] = {
+	"Idle", "AIN0", "Left Preamplifier", "Idle_1",
+};
+
+static SOC_ENUM_SINGLE_DECL(adc_left_mux_map_enum, MT6368_AUDENC_ANA_CON1,
+			    RG_AUDADCLINPUTSEL_SFT, adc_left_mux_map);
+static const struct snd_kcontrol_new adc_left_mux_control =
+	SOC_DAPM_ENUM("ADC L Select", adc_left_mux_map_enum);
+
+static const char *const adc_right_mux_map[] = {
+	"Idle", "AIN0", "Right Preamplifier", "Idle_1",
+};
+
+static SOC_ENUM_SINGLE_DECL(adc_right_mux_map_enum, MT6368_AUDENC_ANA_CON3,
+			    RG_AUDADCRINPUTSEL_SFT, adc_right_mux_map);
+static const struct snd_kcontrol_new adc_right_mux_control =
+	SOC_DAPM_ENUM("ADC R Select", adc_right_mux_map_enum);
+
+static const char *const pga_l_mux_map[] = {
+	"None", "AIN0", "AIN1",
+};
+
+static SOC_ENUM_SINGLE_DECL(pga_left_mux_map_enum, MT6368_AUDENC_ANA_CON0,
+			    RG_AUDPREAMPLINPUTSEL_SFT, pga_l_mux_map);
+static const struct snd_kcontrol_new pga_left_mux_control =
+	SOC_DAPM_ENUM("PGA L Select", pga_left_mux_map_enum);
+
+static const char *const pga_r_mux_map[] = {
+	"None", "AIN2", "AIN3", "AIN0",
+};
+
+static SOC_ENUM_SINGLE_DECL(pga_right_mux_map_enum, MT6368_AUDENC_ANA_CON2,
+			    RG_AUDPREAMPRINPUTSEL_SFT, pga_r_mux_map);
+static const struct snd_kcontrol_new pga_right_mux_control =
+	SOC_DAPM_ENUM("PGA R Select", pga_right_mux_map_enum);
+
+static int mt_dcxo_event(struct snd_soc_dapm_widget *w,
+			 struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(w->dapm);
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+
+	mt6368_set_dcxo(priv, event == SND_SOC_DAPM_PRE_PMU);
+
+	return 0;
+}
+
+static int mt_delay_250_event(struct snd_soc_dapm_widget *w,
+			      struct snd_kcontrol *kcontrol, int event)
+{
+	usleep_range(250, 270);
+
+	return 0;
+}
+
+static int mt_ul_gpio_event(struct snd_soc_dapm_widget *w,
+			    struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(w->dapm);
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+
+	if (event == SND_SOC_DAPM_PRE_PMU)
+		mt6368_set_capture_gpio(priv);
+	else
+		mt6368_reset_capture_gpio(priv);
+
+	return 0;
+}
+
+static int mt_mtkaif_tx_event(struct snd_soc_dapm_widget *w,
+			      struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(w->dapm);
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+
+	if (event == SND_SOC_DAPM_PRE_PMU)
+		mt6368_mtkaif_tx_enable(priv);
+	else
+		mt6368_mtkaif_tx_disable(priv);
+
+	return 0;
+}
+
+static int mt_adc_clk_gen_event(struct snd_soc_dapm_widget *w,
+				struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(w->dapm);
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+
+	switch (event) {
+	case SND_SOC_DAPM_POST_PMU:
+		/* From the clock generator: 13 MHz in, divided by 4, 6.5 MHz out */
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON10,
+				   RG_AUDADCCLKRSTB_MASK_SFT,
+				   1 << RG_AUDADCCLKRSTB_SFT);
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON10,
+				   RG_AUDADCCLKSOURCE_MASK_SFT, 0);
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON10,
+				   RG_AUDADCCLKSEL_MASK_SFT, 0);
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON10,
+				   RG_AUDADCCLKGENMODE_MASK_SFT,
+				   1 << RG_AUDADCCLKGENMODE_SFT);
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON10,
+				   RG_AUDADCCLKSOURCE_MASK_SFT, 0);
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON10,
+				   RG_AUDADCCLKSEL_MASK_SFT, 0);
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON10,
+				   RG_AUDADCCLKGENMODE_MASK_SFT, 0);
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON10,
+				   RG_AUDADCCLKRSTB_MASK_SFT, 0);
+		break;
+	}
+
+	return 0;
+}
+
+static int mt_dcc_clk_event(struct snd_soc_dapm_widget *w,
+			    struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(w->dapm);
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		/* DCC 50 kHz clock, from the 26 MHz */
+		regmap_update_bits(priv->regmap, MT6368_AFE_DCCLK_CFG1, 0xff, 0x3);
+		regmap_update_bits(priv->regmap, MT6368_AFE_DCCLK_CFG0, 0xf7, 0x22);
+		regmap_update_bits(priv->regmap, MT6368_AFE_DCCLK_CFG0, 0xf7, 0x20);
+		regmap_update_bits(priv->regmap, MT6368_AFE_DCCLK_CFG0, 0xf7, 0x21);
+		regmap_write(priv->regmap, MT6368_AFE_DCCLK_CFG2, 0x10);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		regmap_update_bits(priv->regmap, MT6368_AFE_DCCLK_CFG1, 0xff, 0x3);
+		regmap_update_bits(priv->regmap, MT6368_AFE_DCCLK_CFG0, 0xf7, 0x20);
+		regmap_update_bits(priv->regmap, MT6368_AFE_DCCLK_CFG0, 0xf7, 0x22);
+		break;
+	}
+
+	return 0;
+}
+
+static int mt_dcc_clk_connect(struct snd_soc_dapm_widget *source,
+			      struct snd_soc_dapm_widget *sink)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(sink->dapm);
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+	int i;
+
+	for (i = 0; i < MT6368_MIC_INPUTS; i++)
+		if (mt6368_is_dcc(priv->mic_type[i]))
+			return 1;
+
+	return 0;
+}
+
+static int mt_mic_bias_0_event(struct snd_soc_dapm_widget *w,
+			       struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(w->dapm);
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+	unsigned int val;
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		switch (priv->mic_type[0]) {
+		case MT6368_MIC_TYPE_DCC_ECM_DIFF:
+			val = 0x77;
+			break;
+		case MT6368_MIC_TYPE_DCC_ECM_SINGLE:
+			val = 0x11;
+			break;
+		default:
+			val = 0x00;
+			break;
+		}
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON32, 0xff, val);
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON31,
+				   RG_AUDMICBIAS0VREF_MASK_SFT,
+				   MIC_BIAS_2P5 << RG_AUDMICBIAS0VREF_SFT);
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON31,
+				   RG_AUDMICBIAS0LOWPEN_MASK_SFT, 0);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		regmap_write(priv->regmap, MT6368_AUDENC_ANA_CON31, 0x0);
+		regmap_write(priv->regmap, MT6368_AUDENC_ANA_CON32, 0x0);
+		break;
+	}
+
+	return 0;
+}
+
+static int mt_mic_bias_1_event(struct snd_soc_dapm_widget *w,
+			       struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(w->dapm);
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+
+	/* MICBIAS1 at 2.7 V */
+	regmap_write(priv->regmap, MT6368_AUDENC_ANA_CON33, 0x70);
+	regmap_write(priv->regmap, MT6368_AUDENC_ANA_CON34,
+		     priv->mic_type[1] == MT6368_MIC_TYPE_DCC_ECM_SINGLE ? 0x1 : 0x0);
+	regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON33,
+			   RG_AUDMICBIAS1LOWPEN_MASK_SFT, 0);
+
+	return 0;
+}
+
+static int mt_mic_bias_2_event(struct snd_soc_dapm_widget *w,
+			       struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(w->dapm);
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+	unsigned int val;
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		switch (priv->mic_type[2]) {
+		case MT6368_MIC_TYPE_DCC_ECM_DIFF:
+			val = 0x77;
+			break;
+		case MT6368_MIC_TYPE_DCC_ECM_SINGLE:
+			val = 0x11;
+			break;
+		default:
+			val = 0x00;
+			break;
+		}
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON36, 0xff, val);
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON35,
+				   RG_AUDMICBIAS2VREF_MASK_SFT,
+				   MIC_BIAS_2P5 << RG_AUDMICBIAS2VREF_SFT);
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON35,
+				   RG_AUDMICBIAS2LOWPEN_MASK_SFT, 0);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		regmap_write(priv->regmap, MT6368_AUDENC_ANA_CON35, 0x0);
+		regmap_write(priv->regmap, MT6368_AUDENC_ANA_CON36, 0x0);
+		break;
+	}
+
+	return 0;
+}
+
+static unsigned int mt6368_pga_l_type(struct mt6368_priv *priv)
+{
+	unsigned int val;
+
+	regmap_read(priv->regmap, MT6368_AUDENC_ANA_CON0, &val);
+	val = (val & RG_AUDPREAMPLINPUTSEL_MASK_SFT) >> RG_AUDPREAMPLINPUTSEL_SFT;
+
+	return priv->mic_type[val == PGA_L_MUX_AIN1 ? 1 : 0];
+}
+
+static unsigned int mt6368_pga_r_type(struct mt6368_priv *priv)
+{
+	unsigned int val;
+
+	regmap_read(priv->regmap, MT6368_AUDENC_ANA_CON2, &val);
+	val = (val & RG_AUDPREAMPRINPUTSEL_MASK_SFT) >> RG_AUDPREAMPRINPUTSEL_SFT;
+
+	return priv->mic_type[val == PGA_R_MUX_AIN0 ? 0 : 2];
+}
+
+static int mt_pga_l_event(struct snd_soc_dapm_widget *w,
+			  struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(w->dapm);
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		if (mt6368_is_dcc(mt6368_pga_l_type(priv)))
+			regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON0,
+					   RG_AUDPREAMPLDCPRECHARGE_MASK_SFT,
+					   1 << RG_AUDPREAMPLDCPRECHARGE_SFT);
+		break;
+	case SND_SOC_DAPM_POST_PMU:
+		if (mt6368_is_dcc(mt6368_pga_l_type(priv)))
+			regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON0,
+					   RG_AUDPREAMPLDCCEN_MASK_SFT,
+					   1 << RG_AUDPREAMPLDCCEN_SFT);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON0,
+				   RG_AUDPREAMPLDCCEN_MASK_SFT, 0);
+		break;
+	}
+
+	return 0;
+}
+
+static int mt_pga_r_event(struct snd_soc_dapm_widget *w,
+			  struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(w->dapm);
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		if (mt6368_is_dcc(mt6368_pga_r_type(priv)))
+			regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON2,
+					   RG_AUDPREAMPRDCPRECHARGE_MASK_SFT,
+					   1 << RG_AUDPREAMPRDCPRECHARGE_SFT);
+		break;
+	case SND_SOC_DAPM_POST_PMU:
+		if (mt6368_is_dcc(mt6368_pga_r_type(priv)))
+			regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON2,
+					   RG_AUDPREAMPRDCCEN_MASK_SFT,
+					   1 << RG_AUDPREAMPRDCCEN_SFT);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON2,
+				   RG_AUDPREAMPRDCCEN_MASK_SFT, 0);
+		break;
+	}
+
+	return 0;
+}
+
+static int mt_adc_l_event(struct snd_soc_dapm_widget *w,
+			  struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(w->dapm);
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+	unsigned int rc;
+
+	usleep_range(500, 520);
+
+	/* A failed RC calibration reads all zeros or ones: run it again */
+	regmap_read(priv->regmap, MT6368_AUDENC_ANA_CON21, &rc);
+	if (rc == 0x0 || rc == 0x1f) {
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON1,
+				   RG_AUDADCLPWRUP_MASK_SFT, 0);
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON1,
+				   RG_AUDADCLPWRUP_MASK_SFT,
+				   1 << RG_AUDADCLPWRUP_SFT);
+	}
+
+	usleep_range(600, 640);
+
+	regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON0,
+			   RG_AUDPREAMPLDCPRECHARGE_MASK_SFT, 0);
+
+	return 0;
+}
+
+static int mt_adc_r_event(struct snd_soc_dapm_widget *w,
+			  struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(w->dapm);
+	struct mt6368_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+	unsigned int rc;
+
+	usleep_range(500, 520);
+
+	regmap_read(priv->regmap, MT6368_AUDENC_ANA_CON22, &rc);
+	if (rc == 0x0 || rc == 0x1f) {
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON3,
+				   RG_AUDADCRPWRUP_MASK_SFT, 0);
+		regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON3,
+				   RG_AUDADCRPWRUP_MASK_SFT,
+				   1 << RG_AUDADCRPWRUP_SFT);
+	}
+
+	usleep_range(600, 640);
+
+	regmap_update_bits(priv->regmap, MT6368_AUDENC_ANA_CON2,
+			   RG_AUDPREAMPRDCPRECHARGE_MASK_SFT, 0);
+
+	return 0;
+}
