From: buntOS contributors
Subject: [PATCH] dt-bindings: mfd: add MediaTek MT6375

MT6375 is the SubPMIC next to MT6897 and other MediaTek SoCs: a battery
charger with a boost for USB VBUS, a USB Type-C and PD controller, a
fuel gauge and ADCs on one I2C bus. Add its binding and the one of its
charger.

The boost runs at the 5 V and the 1.8 A limit that stock uses. On the
Lenovo TB375FC the boost reaches the connector through a switch that
must close first and open last, which vbus-switch-supply describes.

---
 .../bindings/mfd/mediatek,mt6375.yaml         | 56 +++++++++++++++++++
 .../power/supply/mediatek,mt6375-charger.yaml | 42 ++++++++++++++
 2 files changed, 98 insertions(+)

diff --git a/Documentation/devicetree/bindings/mfd/mediatek,mt6375.yaml b/Documentation/devicetree/bindings/mfd/mediatek,mt6375.yaml
new file mode 100644
index 0000000..7906f28
--- /dev/null
+++ b/Documentation/devicetree/bindings/mfd/mediatek,mt6375.yaml
@@ -0,0 +1,56 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/mediatek,mt6375.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6375 SubPMIC
+
+maintainers:
+  - buntOS contributors <buntos@localhost>
+
+description: |
+  MT6375 has a single cell battery charger with a boost for USB VBUS, a USB
+  Type-C and PD controller, a fuel gauge and ADCs. It answers on one I2C
+  address per block and reg gives the one of the charger block.
+
+properties:
+  compatible:
+    const: mediatek,mt6375
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  charger:
+    $ref: /schemas/power/supply/mediatek,mt6375-charger.yaml#
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        pmic@34 {
+            compatible = "mediatek,mt6375";
+            reg = <0x34>;
+
+            charger {
+                compatible = "mediatek,mt6375-charger";
+
+                usb-otg-vbus-regulator {
+                    regulator-name = "usb-otg-vbus";
+                    regulator-min-microvolt = <5000000>;
+                    regulator-max-microvolt = <5000000>;
+                };
+            };
+        };
+    };
diff --git a/Documentation/devicetree/bindings/power/supply/mediatek,mt6375-charger.yaml b/Documentation/devicetree/bindings/power/supply/mediatek,mt6375-charger.yaml
new file mode 100644
index 0000000..e0a221e
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/mediatek,mt6375-charger.yaml
@@ -0,0 +1,42 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/mediatek,mt6375-charger.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6375 Battery Charger
+
+maintainers:
+  - buntOS contributors <buntos@localhost>
+
+description:
+  This module is part of the MT6375 MFD device. It charges the battery and
+  has a boost that sources USB VBUS from the battery.
+
+properties:
+  compatible:
+    const: mediatek,mt6375-charger
+
+  usb-otg-vbus-regulator:
+    type: object
+    $ref: /schemas/regulator/regulator.yaml#
+    description:
+      The boost. It runs at 5 V with a current limit of 1.8 A.
+    unevaluatedProperties: false
+
+    properties:
+      regulator-min-microvolt:
+        const: 5000000
+
+      regulator-max-microvolt:
+        const: 5000000
+
+      vbus-switch-supply:
+        description:
+          A switch between the boost and the USB connector that has to close
+          before the boost starts and open after it stops.
+
+required:
+  - compatible
+
+additionalProperties: false
