+ * driver has its own check of the same limits for every write.
  */
 #define MT6375_CHG_CV_MAX_UV		4340000
-#define MT6375_CHG_CC_MAX_UA		2000000
-#define MT6375_CHG_AICR_MAX_UA		2000000
+#define MT6375_CHG_CC_MAX_UA		3000000
+#define MT6375_CHG_AICR_MAX_UA		3000000
 /*
  * usb-charger-current: for when nobody says more, and where the MediaTek LK2
  * code leaves both
