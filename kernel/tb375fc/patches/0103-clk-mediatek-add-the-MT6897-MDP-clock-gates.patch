+
+static const struct mtk_clk_desc mdp1_mcd = {
+	.clks = mdp1_clks,
+	.num_clks = ARRAY_SIZE(mdp1_clks),
+};
+
+static const struct of_device_id of_match_clk_mt6897_mdpsys[] = {
+	{ .compatible = "mediatek,mt6897-mdpsys0", .data = &mdp0_mcd },
+	{ .compatible = "mediatek,mt6897-mdpsys1", .data = &mdp1_mcd },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt6897_mdpsys);
+
+static struct platform_driver clk_mt6897_mdpsys_drv = {
+	.probe = mtk_clk_simple_probe,
+	.remove = mtk_clk_simple_remove,
+	.driver = {
+		.name = "clk-mt6897-mdpsys",
+		.of_match_table = of_match_clk_mt6897_mdpsys,
+	},
+};
+module_platform_driver(clk_mt6897_mdpsys_drv);
+
+MODULE_DESCRIPTION("MediaTek MT6897 mdpsys clocks driver");
+MODULE_LICENSE("GPL");
