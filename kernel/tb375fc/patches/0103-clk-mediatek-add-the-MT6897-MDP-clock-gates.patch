+	GATE_MDP_CG0(CLK_MDP1_MDP_WROT1, "mdp1_mdp_wrot1", 22),
+	GATE_MDP_CG0(CLK_MDP1_MDP_FG0, "mdp1_mdp_fg0", 23),
+	GATE_MDP_CG0(CLK_MDP1_MDP_RSZ2, "mdp1_mdp_rsz2", 24),
+	GATE_MDP_CG0(CLK_MDP1_MDP_WROT2, "mdp1_mdp_wrot2", 25),
+	GATE_MDP_CG0(CLK_MDP1_MDP_DLO_ASYNC0, "mdp1_mdp_dlo_async0", 26),
+	GATE_MDP_CG0(CLK_MDP1_MDP_FG1, "mdp1_mdp_fg1", 27),
