+	GATE_MDP_CG1(CLK_MDP0_MDP_DLI_ASYNC3, "mdp0_mdp_dli_async3", 0),
+	GATE_MDP_CG1(CLK_MDP0_MDP_DLO_ASYNC2, "mdp0_mdp_dlo_async2", 1),
