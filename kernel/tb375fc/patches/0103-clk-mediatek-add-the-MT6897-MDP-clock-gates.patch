+	GATE_MDP_CG0(CLK_MDP0_MDP_WROT1, "mdp0_mdp_wrot1", 22),
+	GATE_MDP_CG0(CLK_MDP0_MDP_FG0, "mdp0_mdp_fg0", 23),
+	GATE_MDP_CG0(CLK_MDP0_MDP_RSZ2, "mdp0_mdp_rsz2", 24),
+	GATE_MDP_CG0(CLK_MDP0_MDP_WROT2, "mdp0_mdp_wrot2", 25),
+	GATE_MDP_CG0(CLK_MDP0_MDP_DLO_ASYNC0, "mdp0_mdp_dlo_async0", 26),
