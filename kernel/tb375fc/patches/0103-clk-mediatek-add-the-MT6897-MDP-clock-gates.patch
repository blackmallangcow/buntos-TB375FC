+#include <dt-bindings/clock/mediatek,mt6897-clock.h>
+
+#include <linux/clk-provider.h>
+#include <linux/module.h>
+#include <linux/of_device.h>
+#include <linux/platform_device.h>
+
+#include "clk-gate.h"
+#include "clk-mtk.h"
+
+/*
+ * These blocks only answer while their power domain is on, and the driver has
+ * no way to tell. So their gates have no .is_enabled, see the ops in
+ * clk-gate.c. A consumer has to power the domain up before it enables a gate.
+ */
+static const struct mtk_gate_regs mdp_cg0_regs = {
+	.set_ofs = 0x104,
+	.clr_ofs = 0x108,
+	.sta_ofs = 0x100,
+};
+
+static const struct mtk_gate_regs mdp_cg1_regs = {
+	.set_ofs = 0x114,
+	.clr_ofs = 0x118,
+	.sta_ofs = 0x110,
+};
+
+#define GATE_MDP_CG0(_id, _name, _shift) {			\
+		.id = _id,					\
+		.name = _name,					\
+		.parent_name = "mdp0",				\
+		.regs = &mdp_cg0_regs,				\
+		.shift = _shift,				\
+		.ops = &mtk_clk_gate_ops_setclr_no_status,	\
+	}
+
+#define GATE_MDP_CG1(_id, _name, _shift) {			\
+		.id = _id,					\
+		.name = _name,					\
+		.parent_name = "mdp0",				\
+		.regs = &mdp_cg1_regs,				\
+		.shift = _shift,				\
+		.ops = &mtk_clk_gate_ops_setclr_no_status,	\
+	}
+
+static const struct mtk_gate mdp0_clks[] = {
+	GATE_MDP_CG0(CLK_MDP0_MDP_MUTEX0, "mdp0_mdp_mutex0", 0),
+	GATE_MDP_CG0(CLK_MDP0_APB_BUS, "mdp0_apb_bus", 1),
+	GATE_MDP_CG0(CLK_MDP0_SMI0, "mdp0_smi0", 2),
+	GATE_MDP_CG0(CLK_MDP0_MDP_RDMA0, "mdp0_mdp_rdma0", 3),
+	GATE_MDP_CG0(CLK_MDP0_MDP_RDMA2, "mdp0_mdp_rdma2", 4),
+	GATE_MDP_CG0(CLK_MDP0_MDP_HDR0, "mdp0_mdp_hdr0", 5),
+	GATE_MDP_CG0(CLK_MDP0_MDP_AAL0, "mdp0_mdp_aal0", 6),
+	GATE_MDP_CG0(CLK_MDP0_MDP_RSZ0, "mdp0_mdp_rsz0", 7),
+	GATE_MDP_CG0(CLK_MDP0_MDP_TDSHP0, "mdp0_mdp_tdshp0", 8),
+	GATE_MDP_CG0(CLK_MDP0_MDP_COLOR0, "mdp0_mdp_color0", 9),
+	GATE_MDP_CG0(CLK_MDP0_MDP_WROT0, "mdp0_mdp_wrot0", 10),
+	GATE_MDP_CG0(CLK_MDP0_MDP_FAKE_ENG0, "mdp0_mdp_fake_eng0", 11),
+	GATE_MDP_CG0(CLK_MDP0_MDP_DLI_ASYNC0, "mdp0_mdp_dli_async0", 12),
