+	GATE_MDP_CG0(CLK_MDP0_MDP_RSZ3, "mdp0_mdp_rsz3", 28),
+	GATE_MDP_CG0(CLK_MDP0_MDP_WROT3, "mdp0_mdp_wrot3", 29),
+	GATE_MDP_CG0(CLK_MDP0_MDP_DLO_ASYNC1, "mdp0_mdp_dlo_async1", 30),
