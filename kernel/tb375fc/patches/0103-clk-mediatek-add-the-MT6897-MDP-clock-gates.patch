From: buntOS contributors
Subject: [PATCH] clk: mediatek: add the MT6897 MDP clock gates

Add the mdpsys0 and mdpsys1 blocks of MT6897, with the registers and bits
of the MediaTek driver in the OnePlus MT6897 kernel (clk-mt6897-mdpsys.c).
The same module of the stock firmware of the Lenovo TB375FC has the same
tables. As in the vendor tables, the gates of mdpsys1 have the mdp0 mux as
their parent.

The MDP power domains take one gate each from these blocks to come up, so
the blocks cannot use runtime PM and their gates have no status read.

---
 drivers/clk/mediatek/Kconfig             |  10 ++
 drivers/clk/mediatek/Makefile            |   1 +
 drivers/clk/mediatek/clk-mt6897-mdpsys.c | 167 +++++++++++++++++++++++++++++
 3 files changed, 178 insertions(+)

diff --git a/drivers/clk/mediatek/Kconfig b/drivers/clk/mediatek/Kconfig
index f538cdd24..932229bb6 100644
--- a/drivers/clk/mediatek/Kconfig
+++ b/drivers/clk/mediatek/Kconfig
@@ -395,6 +395,16 @@ config COMMON_CLK_MT6897_IMP_IIC_WRAP
 	  clock from one of these gates. Say Y or M here when a device on the
 	  I2C buses is used.
 
+config COMMON_CLK_MT6897_MDPSYS
+	tristate "Clock driver for MediaTek MT6897 mdpsys"
+	depends on COMMON_CLK_MT6897
+	default COMMON_CLK_MT6897
+	help
+	  This driver supports the MediaTek MT6897 clock gates of the mdpsys0
+	  and mdpsys1 blocks, used by the MDP engines for rotation, scaling and
+	  colour conversion. The two MDP power domains need one gate each to
+	  come up, so build it in if they are listed in the device tree.
+
 config COMMON_CLK_MT6897_MMSYS
 	tristate "Clock driver for MediaTek MT6897 mmsys"
 	depends on COMMON_CLK_MT6897
diff --git a/drivers/clk/mediatek/Makefile b/drivers/clk/mediatek/Makefile
index 1f4c9a1d3..8fbafab15 100644
--- a/drivers/clk/mediatek/Makefile
+++ b/drivers/clk/mediatek/Makefile
@@ -37,6 +37,7 @@ obj-$(CONFIG_COMMON_CLK_MT6797_VENCSYS) += clk-mt6797-venc.o
 obj-$(CONFIG_COMMON_CLK_MT6897) += clk-mt6897-apmixedsys.o clk-mt6897-topckgen.o \
 				   clk-mt6897-vlpckgen.o clk-mt6897-peri_ao.o
 obj-$(CONFIG_COMMON_CLK_MT6897_IMP_IIC_WRAP) += clk-mt6897-imp_iic_wrap.o
+obj-$(CONFIG_COMMON_CLK_MT6897_MDPSYS) += clk-mt6897-mdpsys.o
 obj-$(CONFIG_COMMON_CLK_MT6897_MMSYS) += clk-mt6897-mmsys.o
 obj-$(CONFIG_COMMON_CLK_MT6897_UFSSYS) += clk-mt6897-ufs.o
 obj-$(CONFIG_COMMON_CLK_MT2701) += clk-mt2701.o
diff --git a/drivers/clk/mediatek/clk-mt6897-mdpsys.c b/drivers/clk/mediatek/clk-mt6897-mdpsys.c
new file mode 100644
index 000000000..36d4b31b6
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6897-mdpsys.c
@@ -0,0 +1,167 @@
