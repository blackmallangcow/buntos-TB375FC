From: buntOS contributors
Subject: [PATCH] clk: mediatek: add the MT6897 video codec clock gates

Add the vdecsys, vdecsys-soc, vencsys and vencsys-c1 blocks of MT6897,
with the registers and bits of the MediaTek driver in the OnePlus MT6897
kernel (clk-mt6897-vcodec.c). The same module of the stock firmware of the
Lenovo TB375FC has the same tables. Setting a bit opens these gates.

The VEN power domains take two gates each from the encoder blocks to come
up, so those blocks cannot use runtime PM and their gates have no status
read. The decoder blocks do the same: with runtime PM, probing would power
their domain and mminfra, which the display depends on, up and down again.

---
 drivers/clk/mediatek/Kconfig           | 20 +++++++
 drivers/clk/mediatek/Makefile          |  2 +
 drivers/clk/mediatek/clk-mt6897-vdec.c | 99 ++++++++++++++++++++++++++++++++
 drivers/clk/mediatek/clk-mt6897-venc.c | 86 +++++++++++++++++++++++++++
 4 files changed, 207 insertions(+)

diff --git a/drivers/clk/mediatek/Kconfig b/drivers/clk/mediatek/Kconfig
index 932229bb6..16a826017 100644
--- a/drivers/clk/mediatek/Kconfig
+++ b/drivers/clk/mediatek/Kconfig
@@ -425,6 +425,26 @@ config COMMON_CLK_MT6897_UFSSYS
 	  resets found in the same blocks. Say Y or M here when the UFS
 	  storage is used.
 
+config COMMON_CLK_MT6897_VDECSYS
+	tristate "Clock driver for MediaTek MT6897 vdecsys"
+	depends on COMMON_CLK_MT6897
+	default COMMON_CLK_MT6897
+	help
+	  This driver supports the MediaTek MT6897 clock gates of the video
+	  decoder blocks, vdecsys and vdecsys-soc. The blocks only answer
+	  while their power domains are on, so the decoder has to power them
+	  up before it enables a gate.
+
+config COMMON_CLK_MT6897_VENCSYS
+	tristate "Clock driver for MediaTek MT6897 vencsys"
+	depends on COMMON_CLK_MT6897
+	default COMMON_CLK_MT6897
+	help
+	  This driver supports the MediaTek MT6897 clock gates of the video
+	  encoder blocks, vencsys and vencsys-c1. The two VEN power domains
+	  need two gates each to come up, so build it in if they are listed in
+	  the device tree.
+
 config COMMON_CLK_MT7622
 	tristate "Clock driver for MediaTek MT7622"
 	depends on ARCH_MEDIATEK || COMPILE_TEST
diff --git a/drivers/clk/mediatek/Makefile b/drivers/clk/mediatek/Makefile
index 8fbafab15..02225361b 100644
--- a/drivers/clk/mediatek/Makefile
+++ b/drivers/clk/mediatek/Makefile
@@ -40,6 +40,8 @@ obj-$(CONFIG_COMMON_CLK_MT6897_IMP_IIC_WRAP) += clk-mt6897-imp_iic_wrap.o
 obj-$(CONFIG_COMMON_CLK_MT6897_MDPSYS) += clk-mt6897-mdpsys.o
 obj-$(CONFIG_COMMON_CLK_MT6897_MMSYS) += clk-mt6897-mmsys.o
 obj-$(CONFIG_COMMON_CLK_MT6897_UFSSYS) += clk-mt6897-ufs.o
+obj-$(CONFIG_COMMON_CLK_MT6897_VDECSYS) += clk-mt6897-vdec.o
+obj-$(CONFIG_COMMON_CLK_MT6897_VENCSYS) += clk-mt6897-venc.o
 obj-$(CONFIG_COMMON_CLK_MT2701) += clk-mt2701.o
 obj-$(CONFIG_COMMON_CLK_MT2701_AUDSYS) += clk-mt2701-aud.o
 obj-$(CONFIG_COMMON_CLK_MT2701_BDPSYS) += clk-mt2701-bdp.o
diff --git a/drivers/clk/mediatek/clk-mt6897-vdec.c b/drivers/clk/mediatek/clk-mt6897-vdec.c
new file mode 100644
index 000000000..00ff7fecb
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6897-vdec.c
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2023 MediaTek Inc.
+ * Author: Benjamin Chao <benjamin.chao@mediatek.com>
+ *
+ * Copyright (c) 2026 buntOS contributors
+ */
+#include <dt-bindings/clock/mediatek,mt6897-clock.h>
+
+#include <linux/clk-provider.h>
+#include <linux/module.h>
+#include <linux/of_device.h>
+#include <linux/platform_device.h>
+
+#include "clk-gate.h"
+#include "clk-mtk.h"
+
+/*
+ * These blocks only answer while their power domain is on, and the driver has
+ * no way to tell. So their gates have no .is_enabled, see the ops in
+ * clk-gate.c. A consumer has to power the domain up before it enables a gate.
+ */
+static const struct mtk_gate_regs vde_cg0_regs = {
+	.set_ofs = 0x0,
+	.clr_ofs = 0x4,
+	.sta_ofs = 0x0,
+};
+
+static const struct mtk_gate_regs vde_cg1_regs = {
+	.set_ofs = 0x200,
+	.clr_ofs = 0x204,
+	.sta_ofs = 0x200,
+};
+
+#define GATE_VDE_CG0(_id, _name, _shift) {			\
+		.id = _id,					\
+		.name = _name,					\
+		.parent_name = "vdec",				\
+		.regs = &vde_cg0_regs,				\
+		.shift = _shift,				\
+		.ops = &mtk_clk_gate_ops_setclr_inv_no_status,	\
+	}
+
+#define GATE_VDE_CG1(_id, _name, _shift) {			\
+		.id = _id,					\
+		.name = _name,					\
+		.parent_name = "vdec",				\
+		.regs = &vde_cg1_regs,				\
+		.shift = _shift,				\
+		.ops = &mtk_clk_gate_ops_setclr_inv_no_status,	\
+	}
+
+static const struct mtk_gate vde1_clks[] = {
+	GATE_VDE_CG0(CLK_VDE1_VDEC_CKEN, "vde1_vdec_cken", 0),
+	GATE_VDE_CG0(CLK_VDE1_VDEC_ACTIVE, "vde1_vdec_active", 4),
+	GATE_VDE_CG0(CLK_VDE1_VDEC_CKEN_ENG, "vde1_vdec_cken_eng", 8),
+	GATE_VDE_CG1(CLK_VDE1_LAT_CKEN, "vde1_lat_cken", 0),
+	GATE_VDE_CG1(CLK_VDE1_LAT_ACTIVE, "vde1_lat_active", 4),
+	GATE_VDE_CG1(CLK_VDE1_LAT_CKEN_ENG, "vde1_lat_cken_eng", 8),
+};
+
+static const struct mtk_clk_desc vde1_mcd = {
+	.clks = vde1_clks,
+	.num_clks = ARRAY_SIZE(vde1_clks),
+};
+
+static const struct mtk_gate vde2_clks[] = {
+	GATE_VDE_CG0(CLK_VDE2_VDEC_CKEN, "vde2_vdec_cken", 0),
+	GATE_VDE_CG0(CLK_VDE2_VDEC_ACTIVE, "vde2_vdec_active", 4),
+	GATE_VDE_CG0(CLK_VDE2_VDEC_CKEN_ENG, "vde2_vdec_cken_eng", 8),
+	GATE_VDE_CG1(CLK_VDE2_LAT_CKEN, "vde2_lat_cken", 0),
+	GATE_VDE_CG1(CLK_VDE2_LAT_ACTIVE, "vde2_lat_active", 4),
+	GATE_VDE_CG1(CLK_VDE2_LAT_CKEN_ENG, "vde2_lat_cken_eng", 8),
+};
+
+static const struct mtk_clk_desc vde2_mcd = {
+	.clks = vde2_clks,
+	.num_clks = ARRAY_SIZE(vde2_clks),
+};
+
+static const struct of_device_id of_match_clk_mt6897_vdec[] = {
+	{ .compatible = "mediatek,mt6897-vdecsys-soc", .data = &vde1_mcd },
+	{ .compatible = "mediatek,mt6897-vdecsys", .data = &vde2_mcd },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt6897_vdec);
+
+static struct platform_driver clk_mt6897_vdec_drv = {
+	.probe = mtk_clk_simple_probe,
+	.remove = mtk_clk_simple_remove,
+	.driver = {
+		.name = "clk-mt6897-vdec",
+		.of_match_table = of_match_clk_mt6897_vdec,
+	},
+};
+module_platform_driver(clk_mt6897_vdec_drv);
+
+MODULE_DESCRIPTION("MediaTek MT6897 video decoder clocks driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/clk/mediatek/clk-mt6897-venc.c b/drivers/clk/mediatek/clk-mt6897-venc.c
new file mode 100644
index 000000000..80a8fa748
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6897-venc.c
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2023 MediaTek Inc.
+ * Author: Benjamin Chao <benjamin.chao@mediatek.com>
+ *
+ * Copyright (c) 2026 buntOS contributors
+ */
+#include <dt-bindings/clock/mediatek,mt6897-clock.h>
+
+#include <linux/clk-provider.h>
+#include <linux/module.h>
+#include <linux/of_device.h>
+#include <linux/platform_device.h>
+
+#include "clk-gate.h"
+#include "clk-mtk.h"
+
+/*
+ * These blocks only answer while their power domain is on, and the driver has
+ * no way to tell. So their gates have no .is_enabled, see the ops in
+ * clk-gate.c. A consumer has to power the domain up before it enables a gate.
+ */
+static const struct mtk_gate_regs ven_cg_regs = {
+	.set_ofs = 0x4,
+	.clr_ofs = 0x8,
+	.sta_ofs = 0x0,
+};
+
+#define GATE_VEN(_id, _name, _shift) {				\
+		.id = _id,					\
+		.name = _name,					\
+		.parent_name = "venc",				\
+		.regs = &ven_cg_regs,				\
+		.shift = _shift,				\
+		.ops = &mtk_clk_gate_ops_setclr_inv_no_status,	\
+	}
+
+static const struct mtk_gate ven1_clks[] = {
+	GATE_VEN(CLK_VEN1_CKE0_LARB, "ven1_cke0_larb", 0),
+	GATE_VEN(CLK_VEN1_CKE1_VENC, "ven1_cke1_venc", 4),
+	GATE_VEN(CLK_VEN1_CKE2_JPGENC, "ven1_cke2_jpgenc", 8),
+	GATE_VEN(CLK_VEN1_CKE3_JPGDEC, "ven1_cke3_jpgdec", 12),
+	GATE_VEN(CLK_VEN1_CKE4_JPGDEC_C1, "ven1_cke4_jpgdec_c1", 16),
+	GATE_VEN(CLK_VEN1_CKE5_GALS, "ven1_cke5_gals", 28),
+	GATE_VEN(CLK_VEN1_CKE6_GALS_SRAM, "ven1_cke6_gals_sram", 31),
+};
+
+static const struct mtk_clk_desc ven1_mcd = {
+	.clks = ven1_clks,
+	.num_clks = ARRAY_SIZE(ven1_clks),
+};
+
+static const struct mtk_gate ven2_clks[] = {
+	GATE_VEN(CLK_VEN2_CKE0_LARB, "ven2_cke0_larb", 0),
+	GATE_VEN(CLK_VEN2_CKE1_VENC, "ven2_cke1_venc", 4),
+	GATE_VEN(CLK_VEN2_CKE2_JPGENC, "ven2_cke2_jpgenc", 8),
+	GATE_VEN(CLK_VEN2_CKE3_JPGDEC, "ven2_cke3_jpgdec", 12),
+	GATE_VEN(CLK_VEN2_CKE4_JPGDEC_C1, "ven2_cke4_jpgdec_c1", 16),
+	GATE_VEN(CLK_VEN2_CKE5_GALS, "ven2_cke5_gals", 28),
+	GATE_VEN(CLK_VEN2_CKE6_GALS_SRAM, "ven2_cke6_gals_sram", 31),
+};
+
+static const struct mtk_clk_desc ven2_mcd = {
+	.clks = ven2_clks,
+	.num_clks = ARRAY_SIZE(ven2_clks),
+};
+
+static const struct of_device_id of_match_clk_mt6897_venc[] = {
+	{ .compatible = "mediatek,mt6897-vencsys", .data = &ven1_mcd },
+	{ .compatible = "mediatek,mt6897-vencsys-c1", .data = &ven2_mcd },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt6897_venc);
+
+static struct platform_driver clk_mt6897_venc_drv = {
+	.probe = mtk_clk_simple_probe,
+	.remove = mtk_clk_simple_remove,
+	.driver = {
+		.name = "clk-mt6897-venc",
+		.of_match_table = of_match_clk_mt6897_venc,
+	},
+};
+module_platform_driver(clk_mt6897_venc_drv);
+
+MODULE_DESCRIPTION("MediaTek MT6897 video encoder clocks driver");
+MODULE_LICENSE("GPL");
