From: buntOS contributors
Subject: [PATCH] regulator: mt6368: add the VSIM2 LDO

Add VSIM2. Its enable, VOCAL and VOSEL registers are 0x1b96, 0x1d90 and
0x1d91, less the 0x30 base of the regulators node, its voltages are those
of VIBR (table 1 of the vendor driver) and its overcurrent interrupt is
number 9. These are the values of the MediaTek MT6368 driver in the
OnePlus MT6897 kernel and in the Lenovo TB375FC module tree, which agree.

On the Lenovo TB375FC VSIM2 is the I/O supply of both cameras. Read on the
device before this change, it was off with VOSEL 4 (1.8 V) and VOCAL 6.
---
diff --git a/drivers/regulator/mt6368-regulator.c b/drivers/regulator/mt6368-regulator.c
index 122422707..085b62803 100644
--- a/drivers/regulator/mt6368-regulator.c
+++ b/drivers/regulator/mt6368-regulator.c
@@ -60,6 +60,7 @@ enum {
 	MT6368_ID_VMCH_EINT_LOW,
 	MT6368_ID_VRF13_AIF,
 	MT6368_ID_VRF18_AIF,
+	MT6368_ID_VSIM2,
 	MT6368_ID_VTP,
 	MT6368_ID_VUSB,
 };
@@ -515,6 +516,7 @@ static struct mt6368_regulator_info mt6368_regulators[] = {
 	MT6368_LDO_EI("vmch-eint-low", VMCH_EINT_LOW),
 	MT6368_LDO_VT("vrf13-aif", VRF13_AIF, 3, 14),
 	MT6368_LDO_VT("vrf18-aif", VRF18_AIF, 3, 15),
+	MT6368_LDO_VT("vsim2", VSIM2, 1, 9),
 	MT6368_LDO_VT("vtp", VTP, 1, 20),
 	MT6368_LDO_VT("vusb", VUSB, 1, 12),
 };
diff --git a/include/linux/regulator/mt6368-regulator.h b/include/linux/regulator/mt6368-regulator.h
index 46305f284..ea7e9219c 100644
--- a/include/linux/regulator/mt6368-regulator.h
+++ b/include/linux/regulator/mt6368-regulator.h
@@ -57,6 +57,7 @@
 /* The VPA mode set bit forces continuous conduction as FCCM does */
 #define MT6368_RG_VPA_FCCM_ADDR			0x1876
 #define MT6368_RG_VPA_FCCM_BIT			1
+#define MT6368_RG_LDO_VSIM2_ADDR		0x1b66
 #define MT6368_RG_LDO_VUSB_ADDR			0x1b91
 #define MT6368_RG_LDO_VAUX18_ADDR		0x1b9f
 #define MT6368_RG_LDO_VRF13_AIF_ADDR		0x1bd7
@@ -79,6 +80,8 @@
 #define MT6368_RG_LDO_LP_BIT			1
 #define MT6368_RG_VAUX18_VOCAL_ADDR		0x1d58
 #define MT6368_RG_VAUX18_VOSEL_ADDR		0x1d59
+#define MT6368_RG_VSIM2_VOCAL_ADDR		0x1d60
+#define MT6368_RG_VSIM2_VOSEL_ADDR		0x1d61
 #define MT6368_RG_VUSB_VOCAL_ADDR		0x1d64
 #define MT6368_RG_VUSB_VOSEL_ADDR		0x1d65
 #define MT6368_RG_VIBR_VOCAL_ADDR		0x1d68
