From: buntOS contributors
Subject: [PATCH] dt-bindings: net: bluetooth: add the MediaTek MT6897 built-in Bluetooth

The Bluetooth radio in the connectivity subsystem of the MT6897 has an MCU
of its own, which the host talks HCI to through a pair of rings in the
memory of the subsystem. The bootloader loads its firmware, and the node of
the subsystem has everything about that memory, so this node has little
more than its registers.

Those windows overlap with those of the Wi-Fi and of the subsystem itself,
which also use registers of the common part.
---
 .../net/bluetooth/mediatek,mt6897-bluetooth.yaml   |   78 ++++++++++++++++++++
 1 file changed, 78 insertions(+)

diff --git a/Documentation/devicetree/bindings/net/bluetooth/mediatek,mt6897-bluetooth.yaml b/Documentation/devicetree/bindings/net/bluetooth/mediatek,mt6897-bluetooth.yaml
new file mode 100644
index 0000000..b6bbf5d
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/bluetooth/mediatek,mt6897-bluetooth.yaml
@@ -0,0 +1,78 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/bluetooth/mediatek,mt6897-bluetooth.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6897 built-in Bluetooth
+
+maintainers:
+  - Matthias Brugger <matthias.bgg@gmail.com>
+  - AngeloGioacchino Del Regno <angelogioacchino.delregno@collabora.com>
+
+description:
+  The Bluetooth radio in the connectivity subsystem of the MT6897. It has an MCU
+  of its own, whose firmware the bootloader loads, and the host talks HCI to it
+  through a pair of rings in the memory of the connectivity subsystem. The
+  register windows overlap with those of the other radios.
+
+allOf:
+  - $ref: bluetooth-controller.yaml#
+
+properties:
+  compatible:
+    const: mediatek,mt6897-bluetooth
+
+  reg:
+    items:
+      - description: the registers of the BGF subsystem with the MCU
+      - description: the registers of the common part it uses
+
+  reg-names:
+    items:
+      - const: bgf
+      - const: conn
+
+  interrupts:
+    items:
+      - description: the firmware has something for the host
+      - description: a bus access to the BGF subsystem has hung
+
+  interrupt-names:
+    items:
+      - const: sw
+      - const: bus-hang
+
+  mediatek,connsys:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The connectivity subsystem that powers this device
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - mediatek,connsys
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        bluetooth@18800000 {
+            compatible = "mediatek,mt6897-bluetooth";
+            reg = <0 0x18800000 0 0x21000>, <0 0x18000000 0 0x80000>;
+            reg-names = "bgf", "conn";
+            interrupts = <GIC_SPI 614 IRQ_TYPE_LEVEL_HIGH>,
+                         <GIC_SPI 891 IRQ_TYPE_LEVEL_HIGH>;
+            interrupt-names = "sw", "bus-hang";
+            mediatek,connsys = <&consys>;
+        };
+    };
