+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * MediaTek connectivity subsystem (connsys) base power driver
+ */
+
+#ifndef __SOC_MEDIATEK_MTK_CONNSYS_H
+#define __SOC_MEDIATEK_MTK_CONNSYS_H
+
+#include <linux/types.h>
+
+struct device;
+struct mtk_connsys;
+
+/* The numbers are the bits of the status words passed to the secure firmware */
+enum mtk_connsys_radio {
+	MTK_CONNSYS_RADIO_BT = 0,
+	MTK_CONNSYS_RADIO_FM = 1,
+	MTK_CONNSYS_RADIO_GPS = 2,
+	MTK_CONNSYS_RADIO_WIFI = 3,
+};
+
+struct mtk_connsys *devm_mtk_connsys_get(struct device *dev);
+int mtk_connsys_power_on(struct mtk_connsys *cs, enum mtk_connsys_radio radio);
+void mtk_connsys_power_off(struct mtk_connsys *cs,
+			   enum mtk_connsys_radio radio);
+void mtk_connsys_get_emi(struct mtk_connsys *cs, phys_addr_t *addr, u32 *size);
+
+#endif /* __SOC_MEDIATEK_MTK_CONNSYS_H */
