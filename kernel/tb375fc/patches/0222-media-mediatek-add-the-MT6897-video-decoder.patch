@@ -0,0 +1,18 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config VIDEO_MEDIATEK_MT6897_VDEC
+	tristate "MediaTek MT6897 video decoder"
+	depends on V4L_MEM2MEM_DRIVERS
+	depends on VIDEO_DEV
+	depends on MTK_MT6897_VCP
+	depends on COMMON_CLK && OF
+	select VIDEOBUF2_DMA_CONTIG
+	select V4L2_MEM2MEM_DEV
+	select MFD_SYSCON
+	help
+	  Say y or m here for the hardware video decoder of the MT6897 as a
+	  V4L2 stateful decoder. The stock video firmware on the video
+	  coprocessor does the decoding; this driver carries bitstream and
+	  frames between it and the application.
+
+	  The voltage request block (MTK_DVFSRC) must be on as well: the
+	  firmware asks it for a voltage level before every frame.
