From: buntOS contributors
Subject: [PATCH] drm/mediatek: mtk_disp_ovl: add the OVL_2L of MT6897

Add the OVL_2L of MT6897, with its golden settings. These come from
mtk_ovl_golden_setting() of the MediaTek driver, for a path to a DSI in
video mode. The fraction for the ROI timing is the one of the Lenovo
TB375FC and its stock module: the OnePlus kernel has 8/10 there.

A plane on two pipes can start on any pixel in the second one, so this
has no formats with two pixels in a word.

The interrupt of this block stays quiet until its clock is on, as a
bootloader can leave it pending and the registers do not answer before.
---
 drivers/gpu/drm/mediatek/mtk_disp_ovl.c | 141 +++++++++++++++++++++++-
 1 file changed, 138 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/mediatek/mtk_disp_ovl.c b/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
index 97a899e4bd99ca0f3236c1be1be9c2a28df064d6..fd7f7d4a8707c1ecb0d5de013f2dff03e9929e92 100644
--- a/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
+++ b/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
@@ -27,11 +27,16 @@
 #define DISP_REG_OVL_RST			0x0014
 #define DISP_REG_OVL_ROI_SIZE			0x0020
 #define DISP_REG_OVL_DATAPATH_CON		0x0024
+#define DISP_REG_OVL_DATAPATH_EXT_CON		0x0324
 #define OVL_LAYER_SMI_ID_EN				BIT(0)
 #define OVL_BGCLR_SEL_IN				BIT(2)
 #define OVL_LAYER_AFBC_EN(n)				BIT(4+n)
+#define OVL_GCLAST_EN					BIT(24)
+#define OVL_HDR_GCLAST_EN				BIT(25)
+#define OVL_OUTPUT_CLAMP				BIT(26)
 #define DISP_REG_OVL_ROI_BGCLR			0x0028
 #define DISP_REG_OVL_SRC_CON			0x002c
+#define OVL_FORCE_RELAY_MODE				BIT(8)
 #define DISP_REG_OVL_CON(n)			(0x0030 + 0x20 * (n))
 #define DISP_REG_OVL_SRC_SIZE(n)		(0x0038 + 0x20 * (n))
 #define DISP_REG_OVL_OFFSET(n)			(0x003c + 0x20 * (n))
@@ -41,6 +46,18 @@
 #define OVL_CONST_BLEND					BIT(28)
 #define DISP_REG_OVL_RDMA_CTRL(n)		(0x00c0 + 0x20 * (n))
 #define DISP_REG_OVL_RDMA_GMC(n)		(0x00c8 + 0x20 * (n))
+#define DISP_REG_OVL_RDMA_FIFO_CTRL(n)		(0x00d0 + 0x20 * (n))
+#define DISP_REG_OVL_RDMA_MEM_GMC_S2(n)		(0x01e0 + 0x04 * (n))
+#define DISP_REG_OVL_RDMA_BURST_CON1		0x01f4
+#define OVL_RDMA_BURST16_EN				BIT(28)
+#define DISP_REG_OVL_RDMA_GREQ_NUM		0x01f8
+#define DISP_REG_OVL_RDMA_GREQ_URG_NUM		0x01fc
+#define DISP_REG_OVL_GDRDY_PRD			0x0208
+#define DISP_REG_OVL_RDMA_ULTRA_SRC		0x020c
+#define DISP_REG_OVL_RDMA_BUF_LOW(n)		(0x0210 + 0x04 * (n))
+#define DISP_REG_OVL_RDMA_BUF_HIGH(n)		(0x0220 + 0x04 * (n))
+#define OVL_RDMA_BUF_HIGH_PREULTRA_DIS			BIT(31)
+#define DISP_REG_OVL_ROI_TIMING_0		0x0740
 #define DISP_REG_OVL_ADDR_MT2701		0x0040
 #define DISP_REG_OVL_CLRFMT_EXT			0x02d0
 #define OVL_CON_CLRFMT_BIT_DEPTH_MASK(n)		(GENMASK(1, 0) << (4 * (n)))
@@ -115,6 +132,22 @@ static const u32 mt8173_formats[] = {
 	DRM_FORMAT_YUYV,
 };
 
+/*
+ * A plane in the middle of the screen starts anywhere in the second pipe, which
+ * rules out the formats with two pixels in a word.
+ */
+static const u32 mt6897_formats[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888,
+	DRM_FORMAT_BGRX8888,
+	DRM_FORMAT_BGRA8888,
+	DRM_FORMAT_ABGR8888,
+	DRM_FORMAT_XBGR8888,
+	DRM_FORMAT_RGB888,
+	DRM_FORMAT_BGR888,
+	DRM_FORMAT_RGB565,
+};
+
 static const u32 mt8195_formats[] = {
 	DRM_FORMAT_XRGB8888,
 	DRM_FORMAT_ARGB8888,
@@ -150,6 +183,13 @@ struct mtk_disp_ovl_data {
 	const u32 *formats;
 	size_t num_formats;
 	bool supports_clrfmt_ext;
+	/* Thresholds for a direct link to the display, in the size of the FIFO */
+	unsigned int golden_fifo_size;
+	unsigned int golden_issue_req;
+	unsigned int golden_issue_req_urg;
+	unsigned int golden_greq_num;
+	/* The interrupt is on only with the clock, to be clear of the bootloader */
+	bool irq_with_clk;
 };
 
 /*
@@ -160,6 +200,7 @@ struct mtk_disp_ovl_data {
 struct mtk_disp_ovl {
 	struct drm_crtc			*crtc;
 	struct clk			*clk;
+	int				irq;
 	void __iomem			*regs;
 	struct cmdq_client_reg		cmdq_reg;
 	const struct mtk_disp_ovl_data	*data;
@@ -246,14 +287,28 @@ bool mtk_ovl_is_afbc_supported(struct device *dev)
 int mtk_ovl_clk_enable(struct device *dev)
 {
 	struct mtk_disp_ovl *ovl = dev_get_drvdata(dev);
+	int ret;
 
-	return clk_prepare_enable(ovl->clk);
+	ret = clk_prepare_enable(ovl->clk);
+	if (ret)
+		return ret;
+
+	if (ovl->data->irq_with_clk) {
+		writel(0, ovl->regs + DISP_REG_OVL_INTEN);
+		writel(0, ovl->regs + DISP_REG_OVL_INTSTA);
+		enable_irq(ovl->irq);
+	}
+
+	return 0;
 }
 
 void mtk_ovl_clk_disable(struct device *dev)
 {
 	struct mtk_disp_ovl *ovl = dev_get_drvdata(dev);
 
+	if (ovl->data->irq_with_clk)
+		disable_irq(ovl->irq);
+
 	clk_disable_unprepare(ovl->clk);
 }
 
@@ -266,9 +321,29 @@ void mtk_ovl_start(struct device *dev)
 
 		reg = readl(ovl->regs + DISP_REG_OVL_DATAPATH_CON);
 		reg = reg | OVL_LAYER_SMI_ID_EN;
+		/* Not what a bootloader left, and nothing blends into this overlay */
+		if (ovl->data->golden_fifo_size)
+			reg = OVL_LAYER_SMI_ID_EN | OVL_GCLAST_EN | OVL_HDR_GCLAST_EN |
+			      OVL_OUTPUT_CLAMP;
 		writel_relaxed(reg, ovl->regs + DISP_REG_OVL_DATAPATH_CON);
 	}
 	writel_relaxed(0x1, ovl->regs + DISP_REG_OVL_EN);
+
+	if (ovl->data->golden_fifo_size) {
+		unsigned int reg;
+
+		writel_relaxed(0, ovl->regs + DISP_REG_OVL_DATAPATH_EXT_CON);
+
+		reg = readl(ovl->regs + DISP_REG_OVL_SRC_CON);
+		writel_relaxed(reg | OVL_FORCE_RELAY_MODE,
+			       ovl->regs + DISP_REG_OVL_SRC_CON);
+
+		reg = readl(ovl->regs + DISP_REG_OVL_RDMA_BURST_CON1);
+		writel_relaxed(reg | OVL_RDMA_BURST16_EN,
+			       ovl->regs + DISP_REG_OVL_RDMA_BURST_CON1);
+
+		writel_relaxed(GENMASK(31, 0), ovl->regs + DISP_REG_OVL_GDRDY_PRD);
+	}
 }
 
 void mtk_ovl_stop(struct device *dev)
@@ -310,6 +385,36 @@ static void mtk_ovl_set_bit_depth(struct device *dev, int idx, u32 format,
 			   OVL_CON_CLRFMT_BIT_DEPTH_MASK(idx));
 }
 
+static void mtk_ovl_golden_setting(struct mtk_disp_ovl *ovl, unsigned int h,
+				   struct cmdq_pkt *cmdq_pkt)
+{
+	const struct mtk_disp_ovl_data *data = ovl->data;
+	unsigned int i;
+
+	mtk_ddp_write(cmdq_pkt, h * 9 / 10, &ovl->cmdq_reg, ovl->regs,
+		      DISP_REG_OVL_ROI_TIMING_0);
+
+	for (i = 0; i < data->layer_nr; i++) {
+		mtk_ddp_write(cmdq_pkt, data->golden_fifo_size << 16, &ovl->cmdq_reg,
+			      ovl->regs, DISP_REG_OVL_RDMA_FIFO_CTRL(i));
+		mtk_ddp_write(cmdq_pkt, data->golden_issue_req |
+			      data->golden_issue_req_urg << 16 | BIT(29),
+			      &ovl->cmdq_reg, ovl->regs,
+			      DISP_REG_OVL_RDMA_MEM_GMC_S2(i));
+		mtk_ddp_write(cmdq_pkt, 0, &ovl->cmdq_reg, ovl->regs,
+			      DISP_REG_OVL_RDMA_BUF_LOW(i));
+		mtk_ddp_write(cmdq_pkt, OVL_RDMA_BUF_HIGH_PREULTRA_DIS, &ovl->cmdq_reg,
+			      ovl->regs, DISP_REG_OVL_RDMA_BUF_HIGH(i));
+	}
+
+	mtk_ddp_write(cmdq_pkt, 0xf1ff0000 | data->golden_greq_num, &ovl->cmdq_reg,
+		      ovl->regs, DISP_REG_OVL_RDMA_GREQ_NUM);
+	mtk_ddp_write(cmdq_pkt, data->golden_greq_num, &ovl->cmdq_reg, ovl->regs,
+		      DISP_REG_OVL_RDMA_GREQ_URG_NUM);
+	mtk_ddp_write(cmdq_pkt, 0x8040, &ovl->cmdq_reg, ovl->regs,
+		      DISP_REG_OVL_RDMA_ULTRA_SRC);
+}
+
 void mtk_ovl_config(struct device *dev, unsigned int w,
 		    unsigned int h, unsigned int vrefresh,
 		    unsigned int bpc, struct cmdq_pkt *cmdq_pkt)
@@ -329,6 +434,9 @@ void mtk_ovl_config(struct device *dev, unsigned int w,
 
 	mtk_ddp_write(cmdq_pkt, 0x1, &ovl->cmdq_reg, ovl->regs, DISP_REG_OVL_RST);
 	mtk_ddp_write(cmdq_pkt, 0x0, &ovl->cmdq_reg, ovl->regs, DISP_REG_OVL_RST);
+
+	if (ovl->data->golden_fifo_size && h != 0)
+		mtk_ovl_golden_setting(ovl, h, cmdq_pkt);
 }
 
 unsigned int mtk_ovl_layer_nr(struct device *dev)
@@ -379,7 +487,9 @@ void mtk_ovl_layer_on(struct device *dev, unsigned int idx,
 		      (GMC_THRESHOLD_BITS - ovl->data->gmc_bits);
 	gmc_thrshd_h = GMC_THRESHOLD_HIGH >>
 		      (GMC_THRESHOLD_BITS - ovl->data->gmc_bits);
-	if (ovl->data->gmc_bits == 10)
+	if (ovl->data->golden_fifo_size)
+		gmc_value = GENMASK(9, 0) | GENMASK(9, 0) << 16;
+	else if (ovl->data->gmc_bits == 10)
 		gmc_value = gmc_thrshd_h | gmc_thrshd_h << 16;
 	else
 		gmc_value = gmc_thrshd_l | gmc_thrshd_l << 8 |
@@ -611,6 +721,7 @@ static int mtk_disp_ovl_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
 	struct mtk_disp_ovl *priv;
+	unsigned long irqflags = IRQF_TRIGGER_NONE;
 	int irq;
 	int ret;
 
@@ -640,8 +751,12 @@ static int mtk_disp_ovl_probe(struct platform_device *pdev)
 	priv->data = of_device_get_match_data(dev);
 	platform_set_drvdata(pdev, priv);
 
+	if (priv->data->irq_with_clk)
+		irqflags |= IRQF_NO_AUTOEN;
+
+	priv->irq = irq;
 	ret = devm_request_irq(dev, irq, mtk_disp_ovl_irq_handler,
-			       IRQF_TRIGGER_NONE, dev_name(dev), priv);
+			       irqflags, dev_name(dev), priv);
 	if (ret < 0)
 		return dev_err_probe(dev, ret, "Failed to request irq %d\n", irq);
 
@@ -749,9 +864,29 @@ static const struct mtk_disp_ovl_data mt8195_ovl_driver_data = {
 	.supports_clrfmt_ext = true,
 };
 
+static const struct mtk_disp_ovl_data mt6897_ovl_2l_driver_data = {
+	.addr = DISP_REG_OVL_ADDR_MT8173,
+	.gmc_bits = 10,
+	.layer_nr = 2,
+	.fmt_rgb565_is_0 = true,
+	.smi_id_en = true,
+	.blend_modes = BIT(DRM_MODE_BLEND_PREMULTI) |
+		       BIT(DRM_MODE_BLEND_COVERAGE) |
+		       BIT(DRM_MODE_BLEND_PIXEL_NONE),
+	.formats = mt6897_formats,
+	.num_formats = ARRAY_SIZE(mt6897_formats),
+	.golden_fifo_size = 1024,
+	.golden_issue_req = 511,
+	.golden_issue_req_urg = 255,
+	.golden_greq_num = 0xffff,
+	.irq_with_clk = true,
+};
+
 static const struct of_device_id mtk_disp_ovl_driver_dt_match[] = {
 	{ .compatible = "mediatek,mt2701-disp-ovl",
 	  .data = &mt2701_ovl_driver_data},
+	{ .compatible = "mediatek,mt6897-disp-ovl-2l",
+	  .data = &mt6897_ovl_2l_driver_data},
 	{ .compatible = "mediatek,mt8167-disp-ovl",
 	  .data = &mt8167_ovl_driver_data},
 	{ .compatible = "mediatek,mt8173-disp-ovl",
