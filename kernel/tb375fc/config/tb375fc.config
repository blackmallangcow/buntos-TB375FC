# TB375FC(MediaTek MT6897) 보드 설정 조각. build.sh가 arm64 defconfig(개발 빌드)에 합치고, 이미지용으로는
# Debian 설정에 합친다. 단계는 docs/tb375fc/DESIGN.md 3절과 같다. 업스트림에 드라이버가 없는 블록(클럭, 핀,
# 전원 도메인 데이터, NT36532 터치, soc7_0 Wi-Fi 등)은 패치 대기열의 드라이버가 들어올 때 여기에 더한다.
# 모든 기호는 Linux 7.2.12나 패치 대기열에 있는 것만 쓴다(build.sh config가 빠진 기호를 알린다).

CONFIG_LOCALVERSION="-tb375fc"
# 작업 트리가 git 저장소라 판 이름에 -g<커밋>이 붙지 않게 한다(판은 7.2.12-tb375fc)
# CONFIG_LOCALVERSION_AUTO is not set

## 2a 첫 부팅: UART와 화면 콘솔, 직전 부팅 기록, 부트로더가 켠 워치독
CONFIG_ARCH_MEDIATEK=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y
# init_boot의 initramfs는 LZ4 legacy다(원래 이미지와 같은 꼴)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZ4=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
# 기기에서 /proc/config.gz로 설정을 본다(Debian 설정은 끈다)
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

## 2b 저장장치·USB·PMIC·CPU 주파수
# 핀과 EINT(패치 0004~0006). SPMI의 rcs 인터럽트와 터치 IRQ가 EINT를 쓴다
CONFIG_PINCTRL_MT6897=y
# 클럭(패치 0009~0013). 2b에서 UFS 루트와 장치들이 기대므로 내장한다. 장치 트리의 클럭 컨트롤러는 2b까지 꺼져 있다.
# 부트 명령줄의 clk_ignore_unused는 그대로 둔다
CONFIG_COMMON_CLK_MT6897=y
CONFIG_COMMON_CLK_MT6897_UFSSYS=y
# Debian 설정은 SCSI·USB·xHCI를 모듈로 둔다. 그러면 아래 UFS·xHCI·USB 네트워크의 =y가 m으로 내려가고 MTU3가
# 가젯 전용이 된다. sd가 없으면 UFS 블록 장치도 생기지 않는다(arm64 defconfig는 넷 모두 y다)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=y
CONFIG_PHY_MTK_UFS=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_DUAL_ROLE=y
CONFIG_USB_XHCI_MTK=y
CONFIG_PHY_MTK_XSPHY=y
CONFIG_PHY_MTK_TPHY=y
# USB 가젯: 첫 부팅 initramfs가 ACM 시리얼과 NCM 이더넷으로 호스트에 붙는다
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_SPMI=y
CONFIG_SPMI_MTK_PMIF=y
# MT6363·MT6368 MFD(패치 0016·0026)가 regulator와 키를 띄운다. 키(패치 0018)는 전원·볼륨 올림이고, 전원 키로 깨운다.
# arm64 defconfig는 키가 모듈이라 initramfs에 모듈 없이 쓰려고 내장한다. MT6368 regulator(패치 0024)는 USB의 vusb33을
# 낸다. 보드가 ssusb에 이어 두어, 없으면 mtu3가 공급을 기다리며 뜨지 않는다(initramfs의 USB 가젯도)
CONFIG_MFD_MTK_SPMI_PMIC=y
CONFIG_REGULATOR_MT6315=y
CONFIG_REGULATOR_MT6363=y
CONFIG_REGULATOR_MT6368=y
CONFIG_KEYBOARD_MTK_PMIC=y
# MT6685 RTC(패치 0113). 네트워크 전에 시간을 맞추려고 내장한다. 노드를 켜기 전에는 돌지 않는다
CONFIG_RTC_DRV_MT6685=y
CONFIG_ARM_MEDIATEK_CPUFREQ_HW=y

## 2c 입력: 홀 센서(gpio-keys), 터치(SPI), 포고 키보드(serdev), 게이지·SAR가 붙는 I2C
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_TOUCHSCREEN=y
# NT36532 터치·펜(패치 0031). 펌웨어는 터치를 열 때 /lib/firmware에서 읽으므로 모듈로 둔다. 패널 VDDIO의 regulator-fixed는
# Debian 설정에서 모듈이고(arm64 defconfig는 내장), 터치는 그것을 기다렸다가 뜬다
CONFIG_TOUCHSCREEN_NOVATEK_NVT_SPI=m
# 포고 키보드 커버(패치 0033·0034). UART3의 serdev 장치이고, 모듈 별칭으로 올라온다. 패드 모드 레지스터는 8250_mtk가 쓴다(패치 0036)
CONFIG_KEYBOARD_ONEPLUS_POGO=m
CONFIG_SPI=y
CONFIG_SPI_MT65XX=y
CONFIG_I2C_MT65XX=y
# I2C 클럭 게이트(패치 0043·0044). I2C 컨트롤러(내장)가 기다리므로 내장한다
CONFIG_COMMON_CLK_MT6897_IMP_IIC_WRAP=y
# 화면·코덱 클럭 게이트(패치 0100~0104). 노드가 꺼져 있으면 돌지 않는다. VEN·MDP 도메인이 이 게이트를 쓰므로 scpsys처럼 내장한다
CONFIG_COMMON_CLK_MT6897_MMSYS=y
CONFIG_COMMON_CLK_MT6897_MDPSYS=y
CONFIG_COMMON_CLK_MT6897_VDECSYS=y
CONFIG_COMMON_CLK_MT6897_VENCSYS=y
# USB 호스트의 VBUS(패치 0045~0049). UFS 루트와 USB 가젯이 된 뒤 장치 트리에서 켠다. 처음에는 손으로 올려 보려고 모듈로 둔다.
# regulator-output은 TCPC 드라이버가 올 때까지 사용자 공간이 VBUS를 켜는 길이다
CONFIG_MFD_MT6375=m
CONFIG_CHARGER_MT6375=m
CONFIG_CHARGER_NU2115=m
CONFIG_REGULATOR_USERSPACE_CONSUMER=m
CONFIG_SERIAL_DEV_BUS=y

# NT36532 패널(패치 0082·0084). 화면 파이프라인이 오기 전에는 붙을 호스트가 없다. 켜 두면 Debian 설정에서도 빌드되는지 본다
CONFIG_DRM_PANEL_NOVATEK_NT36532=m

## 2d 무선: soc7_0 드라이버 전에는 USB 동글과 USB 이더넷으로 네트워크를 쓴다
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_RTL8152=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_MTK=y
# 전원 도메인(패치 0050~0054). conn 도메인이 먼저 쓴다. arm64 defconfig와 Debian 설정 모두 켜지만, 빠지면 알리게 적어 둔다
CONFIG_MTK_SCPSYS_PM_DOMAINS=y
# connsys Wi-Fi(패치 0055~0060). 장치 트리의 노드를 켜기 전에는 돌지 않는다. MT7921_SOC가 ARCH_HAS_DMA_OPS를 고른다
CONFIG_MTK_CONNSYS=m
CONFIG_MT7921_SOC=m
CONFIG_OF_RESERVED_MEM=y
# connsys Bluetooth(패치 0085~0086). 장치 트리의 노드를 켜기 전에는 돌지 않는다. h4_recv_buf 때문에 BT_HCIUART를 끌어온다
CONFIG_BT_MTKBEIF=m

## 2e GPU·전원·열
CONFIG_DRM_PANTHOR=m
CONFIG_MTK_GPUEB_MBOX=y
CONFIG_MTK_MFG_PM_DOMAIN=y
# 열 보호는 일찍 돌아야 하니 내장이다. 레지스터를 쓰지 않으니 디버그 파일은 켜 둔다(읽기만)
CONFIG_MTK_THERMAL=y
CONFIG_MTK_LVTS_THERMAL=y
CONFIG_MTK_LVTS_THERMAL_DEBUGFS=y
# 치명 온도에서 정상 종료가 걸리면 20초 뒤 강제로 끈다. 하드웨어 리셋을 믿을 수 없어 넣는다(기본 0은 강제 없음)
CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=20000
# LK가 넘기는 퓨즈. LVTS 보정값이 여기 있다
CONFIG_NVMEM_MTK_DEVINFO=y
CONFIG_FUEL_GAUGE_MM8013=y
# MT6375 TCPC(패치 0094~0096). 인터럽트와 TCPC 노드를 켠 뒤에만 뜬다. 처음에는 손으로 올려 보려고 모듈로 둔다
CONFIG_TYPEC_TCPCI_MT6375=m

## 3 최적화 단계에서 쓸 업스트림 드라이버 (SoC 기반이 생긴 뒤 켜진다)
CONFIG_HX9023S=m
CONFIG_SND_SOC_AW88166=m
